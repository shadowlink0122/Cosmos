//! platform: baremetal-x86
// cosmo-linux::net::udp - UDPプロトコル
//
// UDPデータグラムの解析と構築。
// 参照: RFC 768

import ../../include/types;
import ../../include/net;
import ../../lib/kstring;

// ============================================================
// UDP ヘッダ (8バイト)
// ============================================================

/// UDPヘッダ
export struct UdpHeader {
    ulong src_port;  // 送信元ポート
    ulong dst_port;  // 宛先ポート
    ulong length;    // ヘッダ+データ全体長
    ulong checksum;  // チェックサム (0でも可)
}

// ============================================================
// UDP 処理
// ============================================================

export struct Udp {}

impl Udp {
    /// UDPヘッダを解析
    static ulong parse(ulong data, UdpHeader* header) {
        if (data == 0) { return 0; }

        ulong b0 = Mem::read_byte(data);
        ulong b1 = Mem::read_byte(data + 1);
        header->src_port = (b0 << 8) | b1;

        b0 = Mem::read_byte(data + 2);
        b1 = Mem::read_byte(data + 3);
        header->dst_port = (b0 << 8) | b1;

        b0 = Mem::read_byte(data + 4);
        b1 = Mem::read_byte(data + 5);
        header->length = (b0 << 8) | b1;

        b0 = Mem::read_byte(data + 6);
        b1 = Mem::read_byte(data + 7);
        header->checksum = (b0 << 8) | b1;

        return 8;
    }

    /// UDPヘッダを構築
    static ulong build(ulong data, UdpHeader* header) {
        if (data == 0) { return 0; }

        Mem::write_byte(data,     (header->src_port >> 8) & 0xFF);
        Mem::write_byte(data + 1, header->src_port & 0xFF);

        Mem::write_byte(data + 2, (header->dst_port >> 8) & 0xFF);
        Mem::write_byte(data + 3, header->dst_port & 0xFF);

        Mem::write_byte(data + 4, (header->length >> 8) & 0xFF);
        Mem::write_byte(data + 5, header->length & 0xFF);

        // チェックサム: 0 (オプショナル for UDP over IPv4)
        Mem::write_byte(data + 6, 0);
        Mem::write_byte(data + 7, 0);

        return 8;
    }
}
