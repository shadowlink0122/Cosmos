//! platform: baremetal-x86
// cosmo-linux::net::socket - BSD Socket API
//
// ソケットインターフェース。FDテーブルと連携して
// socket/bind/listen/accept/connect/send/recv を提供。
// 参照: linux/net/socket.c

import ../../include/types;
import ../../include/net;
import ../../include/result;
import ../../include/errno;
import ../../lib/kstring;
import ../core/loopback;
import ../transport/tcp;
import ../core/ethernet;
import ../core/ip;
import ../core/arp;
import ../../drivers/virtio/virtio_net;

// ============================================================
// ソケットテーブル
// ============================================================

const ulong MAX_SOCKETS = 16;
const ulong SOCKET_TABLE_BASE = 0x1900000;  // 25MB地点 (High Mem)
const ulong SOCKET_ENTRY_SIZE = 112;

// フィールドオフセット
const ulong SOCK_USED       = 0;
const ulong SOCK_DOMAIN     = 8;
const ulong SOCK_TYPE       = 16;
const ulong SOCK_PROTOCOL   = 24;
const ulong SOCK_STATE      = 32;
const ulong SOCK_LOCAL_ADDR = 40;
const ulong SOCK_LOCAL_PORT = 48;
const ulong SOCK_REMOTE_ADDR= 56;
const ulong SOCK_REMOTE_PORT= 64;
const ulong SOCK_TCP_CONN   = 72;
const ulong SOCK_RECV_BUF   = 80;
const ulong SOCK_RECV_LEN   = 88;
const ulong SOCK_BACKLOG    = 96;
const ulong SOCK_FD         = 104;

// 受信バッファ領域
const ulong SOCK_RECV_BASE = 0x1910000;  // 25MB+64KB地点
const ulong SOCK_RECV_SLOT = 4096;

// ============================================================
// Socket 操作
// ============================================================

export struct Socket {}

impl Socket {
    /// ソケットテーブル初期化
    static void setup() {
        ulong i = 0;
        while (i < MAX_SOCKETS) {
            ulong base = SOCKET_TABLE_BASE + i * SOCKET_ENTRY_SIZE;
            ulong j = 0;
            while (j < SOCKET_ENTRY_SIZE) {
                ulong* ptr = (base + j) as ulong*;
                *ptr = 0;
                j = j + 8;
            }
            i = i + 1;
        }
    }

    /// ソケット作成
    static Result<long, long> create(ulong domain, ulong sock_type, ulong protocol) {
        ulong i = 0;
        while (i < MAX_SOCKETS) {
            ulong base = SOCKET_TABLE_BASE + i * SOCKET_ENTRY_SIZE;
            ulong* used_ptr = base as ulong*;
            if (*used_ptr == 0) {
                *used_ptr = 1;
                ulong* dom_ptr   = (base + SOCK_DOMAIN) as ulong*;
                ulong* type_ptr  = (base + SOCK_TYPE) as ulong*;
                ulong* proto_ptr = (base + SOCK_PROTOCOL) as ulong*;
                ulong* state_ptr = (base + SOCK_STATE) as ulong*;
                ulong* conn_ptr  = (base + SOCK_TCP_CONN) as ulong*;
                ulong* recv_ptr  = (base + SOCK_RECV_BUF) as ulong*;

                *dom_ptr = domain;
                *type_ptr = sock_type;

                if (protocol == 0) {
                    if (sock_type == SOCK_STREAM) {
                        *proto_ptr = IP_PROTO_TCP;
                    } else {
                        *proto_ptr = IP_PROTO_UDP;
                    }
                } else {
                    *proto_ptr = protocol;
                }

                *state_ptr = TCP_CLOSED;
                *conn_ptr = 0xFFFFFFFFFFFFFFFF;
                *recv_ptr = SOCK_RECV_BASE + i * SOCK_RECV_SLOT;

                return Result::Ok(i as long);
            }
            i = i + 1;
        }
        return Result::Err(ENOMEM);
    }

    /// ソケットにアドレスをバインド
    static Result<long, long> bind(ulong sock_id, ulong addr, ulong port) {
        if (sock_id >= MAX_SOCKETS) { return Result::Err(EBADF); }
        ulong base = SOCKET_TABLE_BASE + sock_id * SOCKET_ENTRY_SIZE;
        ulong* used_ptr = base as ulong*;
        if (*used_ptr == 0) { return Result::Err(EBADF); }

        ulong* laddr_ptr = (base + SOCK_LOCAL_ADDR) as ulong*;
        ulong* lport_ptr = (base + SOCK_LOCAL_PORT) as ulong*;
        *laddr_ptr = addr;
        *lport_ptr = port;

        return Result::Ok(0);
    }

    /// TCPリッスン
    static Result<long, long> listen(ulong sock_id, ulong backlog) {
        if (sock_id >= MAX_SOCKETS) { return Result::Err(EBADF); }
        ulong base = SOCKET_TABLE_BASE + sock_id * SOCKET_ENTRY_SIZE;
        ulong* type_ptr = (base + SOCK_TYPE) as ulong*;
        if (*type_ptr != SOCK_STREAM) { return Result::Err(EOPNOTSUPP); }

        ulong* state_ptr = (base + SOCK_STATE) as ulong*;
        ulong* bl_ptr    = (base + SOCK_BACKLOG) as ulong*;
        *state_ptr = TCP_LISTEN;
        *bl_ptr = backlog;

        long conn_id = -1;
        Result<long, long> tcr = Tcp::create();
        match (tcr) {
            Result::Ok(v) => { conn_id = v; }
            Result::Err(e) => {}
        }
        if (conn_id >= 0) {
            ulong* conn_ptr = (base + SOCK_TCP_CONN) as ulong*;
            *conn_ptr = conn_id as ulong;
            ulong* laddr_ptr = (base + SOCK_LOCAL_ADDR) as ulong*;
            ulong* lport_ptr = (base + SOCK_LOCAL_PORT) as ulong*;
            Tcp::bind_conn(conn_id as ulong, *laddr_ptr, *lport_ptr);
            Tcp::listen_conn(conn_id as ulong);
        }

        return Result::Ok(0);
    }

    /// TCP接続
    static Result<long, long> connect(ulong sock_id, ulong addr, ulong port) {
        if (sock_id >= MAX_SOCKETS) { return Result::Err(EBADF); }
        ulong base = SOCKET_TABLE_BASE + sock_id * SOCKET_ENTRY_SIZE;
        ulong* type_ptr = (base + SOCK_TYPE) as ulong*;
        if (*type_ptr != SOCK_STREAM) { return Result::Err(EOPNOTSUPP); }

        ulong* raddr_ptr = (base + SOCK_REMOTE_ADDR) as ulong*;
        ulong* rport_ptr = (base + SOCK_REMOTE_PORT) as ulong*;
        ulong* state_ptr = (base + SOCK_STATE) as ulong*;
        *raddr_ptr = addr;
        *rport_ptr = port;

        if (addr == LOOPBACK_ADDR) {
            *state_ptr = TCP_ESTABLISHED;
            long conn_id = -1;
            Result<long, long> tcr2 = Tcp::create();
            match (tcr2) {
                Result::Ok(v) => { conn_id = v; }
                Result::Err(e) => {}
            }
            if (conn_id >= 0) {
                ulong* conn_ptr = (base + SOCK_TCP_CONN) as ulong*;
                *conn_ptr = conn_id as ulong;
                ulong* laddr_ptr = (base + SOCK_LOCAL_ADDR) as ulong*;
                ulong* lport_ptr = (base + SOCK_LOCAL_PORT) as ulong*;
                Tcp::bind_conn(conn_id as ulong, *laddr_ptr, *lport_ptr);
                Tcp::set_state(conn_id as ulong, TCP_ESTABLISHED);
            }
            return Result::Ok(0);
        }

        // === 非ループバック: 実TCP SYN送信 ===
        // ローカルポート割当 (ephemeral: 49152+sock_id)
        ulong* lport_ptr = (base + SOCK_LOCAL_PORT) as ulong*;
        ulong* laddr_ptr = (base + SOCK_LOCAL_ADDR) as ulong*;
        if (*lport_ptr == 0) {
            *lport_ptr = 49152 + sock_id;
        }
        if (*laddr_ptr == 0) {
            *laddr_ptr = GUEST_IP;  // 10.0.2.15
        }

        // SYNパケット送信
        ulong init_seq = 1000 + sock_id * 100;  // 初期SEQ
        *state_ptr = TCP_SYN_SENT;
        Socket::send_tcp_packet(
            addr, port,
            *laddr_ptr, *lport_ptr,
            init_seq, 0,
            TCP_SYN, 0, 0
        );

        // SYN-ACK待ちループ (最大500回ポーリング)
        ulong wait = 0;
        while (wait < 500) {
            Socket::poll_net();
            if (*state_ptr == TCP_ESTABLISHED) {
                return Result::Ok(0);
            }
            wait = wait + 1;
        }

        // タイムアウト
        return Result::Err(ETIMEDOUT);
    }

    /// データ送信
    static Result<long, long> send(ulong sock_id, ulong data, ulong len) {
        if (sock_id >= MAX_SOCKETS) { return Result::Err(EBADF); }
        ulong base = SOCKET_TABLE_BASE + sock_id * SOCKET_ENTRY_SIZE;

        ulong* used_ptr = base as ulong*;
        if (*used_ptr == 0) { return Result::Err(EBADF); }

        ulong* raddr_ptr = (base + SOCK_REMOTE_ADDR) as ulong*;

        if (*raddr_ptr == LOOPBACK_ADDR) {
            ulong* rport_ptr = (base + SOCK_REMOTE_PORT) as ulong*;
            ulong target = Socket::find_by_port(*rport_ptr);
            if (target < MAX_SOCKETS) {
                ulong t_base = SOCKET_TABLE_BASE + target * SOCKET_ENTRY_SIZE;
                ulong* recv_buf  = (t_base + SOCK_RECV_BUF) as ulong*;
                ulong* recv_len  = (t_base + SOCK_RECV_LEN) as ulong*;

                ulong dst = *recv_buf + *recv_len;
                ulong i = 0;
                while (i < len) {
                    ulong b = Mem::read_byte(data + i);
                    Mem::write_byte(dst + i, b);
                    i = i + 1;
                }
                *recv_len = *recv_len + len;
                return Result::Ok(len as long);
            }
        }

        // === 非ループバック: TCPデータ送信 ===
        ulong* state_ptr = (base + SOCK_STATE) as ulong*;
        if (*state_ptr != TCP_ESTABLISHED) { return Result::Err(ENOTCONN); }

        ulong* rport_ptr = (base + SOCK_REMOTE_PORT) as ulong*;
        ulong* laddr_ptr = (base + SOCK_LOCAL_ADDR) as ulong*;
        ulong* lport_ptr = (base + SOCK_LOCAL_PORT) as ulong*;

        // 送信SEQ/ACK取得 (SOCK_TCP_CONN + SOCK_BACKLOGを一時利用)
        // send_seq = SOCK_BACKLOG, recv_seq = SOCK_FD
        ulong* send_seq_ptr = (base + SOCK_BACKLOG) as ulong*;
        ulong* recv_seq_ptr = (base + SOCK_FD) as ulong*;

        Socket::send_tcp_packet(
            *raddr_ptr, *rport_ptr,
            *laddr_ptr, *lport_ptr,
            *send_seq_ptr, *recv_seq_ptr,
            TCP_ACK | TCP_PSH, data, len
        );
        *send_seq_ptr = *send_seq_ptr + len;

        return Result::Ok(len as long);
    }

    /// データ受信
    static Result<long, long> recv(ulong sock_id, ulong buf, ulong buf_len) {
        if (sock_id >= MAX_SOCKETS) { return Result::Err(EBADF); }
        ulong base = SOCKET_TABLE_BASE + sock_id * SOCKET_ENTRY_SIZE;

        ulong* recv_buf_ptr = (base + SOCK_RECV_BUF) as ulong*;
        ulong* recv_len_ptr = (base + SOCK_RECV_LEN) as ulong*;
        ulong* state_ptr    = (base + SOCK_STATE) as ulong*;

        // 非ループバック: パケット受信ポーリング
        ulong* raddr_ptr = (base + SOCK_REMOTE_ADDR) as ulong*;
        if (*raddr_ptr != LOOPBACK_ADDR && *raddr_ptr != 0) {
            // データ到着までポーリング (最大2000回)
            ulong poll_count = 0;
            while (*recv_len_ptr == 0 && poll_count < 2000) {
                Socket::poll_net();
                poll_count = poll_count + 1;
                // 接続が閉じられた場合
                if (*state_ptr == TCP_CLOSE_WAIT || *state_ptr == TCP_CLOSED) {
                    break;
                }
            }
        }

        ulong available = *recv_len_ptr;
        if (available == 0) {
            // 接続が閉じられた場合は0を返す (EOF)
            if (*state_ptr == TCP_CLOSE_WAIT || *state_ptr == TCP_CLOSED) {
                return Result::Ok(0);
            }
            return Result::Err(EAGAIN);
        }

        ulong copy_len = available;
        if (copy_len > buf_len) { copy_len = buf_len; }

        ulong src = *recv_buf_ptr;
        ulong i = 0;
        while (i < copy_len) {
            ulong b = Mem::read_byte(src + i);
            Mem::write_byte(buf + i, b);
            i = i + 1;
        }

        if (copy_len < available) {
            ulong remaining = available - copy_len;
            i = 0;
            while (i < remaining) {
                ulong b = Mem::read_byte(src + copy_len + i);
                Mem::write_byte(src + i, b);
                i = i + 1;
            }
            *recv_len_ptr = remaining;
        } else {
            *recv_len_ptr = 0;
        }

        return Result::Ok(copy_len as long);
    }

    /// ソケットを閉じる
    static void close(ulong sock_id) {
        if (sock_id >= MAX_SOCKETS) { return; }
        ulong base = SOCKET_TABLE_BASE + sock_id * SOCKET_ENTRY_SIZE;

        ulong* conn_ptr = (base + SOCK_TCP_CONN) as ulong*;
        if (*conn_ptr != 0xFFFFFFFFFFFFFFFF) {
            Tcp::close_conn(*conn_ptr);
        }

        ulong j = 0;
        while (j < SOCKET_ENTRY_SIZE) {
            ulong* ptr = (base + j) as ulong*;
            *ptr = 0;
            j = j + 8;
        }
    }

    /// ポート番号からソケットを検索
    static ulong find_by_port(ulong port) {
        ulong i = 0;
        while (i < MAX_SOCKETS) {
            ulong base = SOCKET_TABLE_BASE + i * SOCKET_ENTRY_SIZE;
            ulong* used_ptr  = base as ulong*;
            ulong* lport_ptr = (base + SOCK_LOCAL_PORT) as ulong*;
            if (*used_ptr == 1) {
                if (*lport_ptr == port) {
                    return i;
                }
            }
            i = i + 1;
        }
        return MAX_SOCKETS;
    }

    /// ソケットの状態を取得
    static ulong get_state(ulong sock_id) {
        if (sock_id >= MAX_SOCKETS) { return TCP_CLOSED; }
        ulong base = SOCKET_TABLE_BASE + sock_id * SOCKET_ENTRY_SIZE;
        ulong* state_ptr = (base + SOCK_STATE) as ulong*;
        return *state_ptr;
    }

    /// ソケットが使用中か
    static ulong is_valid(ulong sock_id) {
        if (sock_id >= MAX_SOCKETS) { return 0; }
        ulong base = SOCKET_TABLE_BASE + sock_id * SOCKET_ENTRY_SIZE;
        ulong* used_ptr = base as ulong*;
        return *used_ptr;
    }

    /// ソケット状態を外部から設定 (net_rx.cmから呼ばれる)
    static void set_state_ext(ulong sock_id, ulong state) {
        if (sock_id >= MAX_SOCKETS) { return; }
        ulong base = SOCKET_TABLE_BASE + sock_id * SOCKET_ENTRY_SIZE;
        ulong* state_ptr = (base + SOCK_STATE) as ulong*;
        *state_ptr = state;
    }

    /// 送信SEQ/受信SEQを設定 (net_rx.cmから呼ばれる)
    static void set_seq(ulong sock_id, ulong send_seq, ulong recv_seq) {
        if (sock_id >= MAX_SOCKETS) { return; }
        ulong base = SOCKET_TABLE_BASE + sock_id * SOCKET_ENTRY_SIZE;
        // SOCK_BACKLOG/SOCK_FDをSEQ管理に流用
        ulong* send_seq_ptr = (base + SOCK_BACKLOG) as ulong*;
        ulong* recv_seq_ptr = (base + SOCK_FD) as ulong*;
        *send_seq_ptr = send_seq;
        *recv_seq_ptr = recv_seq;
    }

    /// 受信バッファにデータを追記 (net_rx.cmから呼ばれる)
    static void append_recv(ulong sock_id, ulong data, ulong len) {
        if (sock_id >= MAX_SOCKETS) { return; }
        ulong base = SOCKET_TABLE_BASE + sock_id * SOCKET_ENTRY_SIZE;
        ulong* recv_buf_ptr = (base + SOCK_RECV_BUF) as ulong*;
        ulong* recv_len_ptr = (base + SOCK_RECV_LEN) as ulong*;
        ulong dst = *recv_buf_ptr + *recv_len_ptr;
        ulong i = 0;
        while (i < len) {
            ulong b = Mem::read_byte(data + i);
            Mem::write_byte(dst + i, b);
            i = i + 1;
        }
        *recv_len_ptr = *recv_len_ptr + len;
    }

    // ============================================================
    // TCP パケット送受信ヘルパー
    // ============================================================

    /// ネットワーク受信ポーリング (VirtioNet→Eth→IP→TCP→ソケットバッファ)
    static void poll_net() {
        // 受信バッファ (固定メモリ)
        ulong rx_buf = 0x1970000;
        ulong rx_buf_size = 2048;

        ulong recv_len = VirtioNet::recv(rx_buf, rx_buf_size);
        if (recv_len == 0) { return; }

        // Ethernetヘッダ解析
        EthHeader eth_hdr = {
            dst_hi: 0, dst_lo: 0,
            src_hi: 0, src_lo: 0,
            eth_type: 0, padding: 0
        };
        ulong eth_len = Ethernet::parse(rx_buf, &eth_hdr);
        if (eth_len == 0) { return; }

        // ARP処理
        if (eth_hdr.eth_type == ETH_TYPE_ARP) {
            Arp::handle_packet(rx_buf + eth_len, recv_len - eth_len);
            return;
        }

        // IPv4のみ
        if (eth_hdr.eth_type != ETH_TYPE_IP) { return; }

        IpHeader ip_hdr = {
            version: 0, ihl: 0, tos: 0, total_len: 0,
            id: 0, flags: 0, frag_off: 0, ttl: 0,
            protocol: 0, checksum: 0,
            src_addr: 0, dst_addr: 0
        };
        ulong ip_len = Ip::parse(rx_buf + eth_len, &ip_hdr);
        if (ip_len == 0) { return; }

        // TCPのみ
        if (ip_hdr.protocol != IP_PROTO_TCP) { return; }

        TcpHeader tcp_hdr = {
            src_port: 0, dst_port: 0,
            seq_num: 0, ack_num: 0,
            data_offset: 0, flags: 0,
            window: 0, checksum: 0, urgent_ptr: 0
        };
        ulong tcp_offset = eth_len + ip_len;
        ulong tcp_len = Tcp::parse(rx_buf + tcp_offset, &tcp_hdr);
        if (tcp_len == 0) { return; }

        // ソケット検索
        ulong sock_id = Socket::find_by_port(tcp_hdr.dst_port);
        if (sock_id >= MAX_SOCKETS) { return; }

        ulong sock_state = Socket::get_state(sock_id);

        // SYN-ACK受信 (TCP_SYN_SENT状態)
        if (sock_state == TCP_SYN_SENT) {
            if ((tcp_hdr.flags & TCP_SYN) != 0 && (tcp_hdr.flags & TCP_ACK) != 0) {
                Socket::send_tcp_ack(
                    ip_hdr.src_addr, tcp_hdr.src_port,
                    ip_hdr.dst_addr, tcp_hdr.dst_port,
                    tcp_hdr.ack_num, tcp_hdr.seq_num + 1
                );
                Socket::set_state_ext(sock_id, TCP_ESTABLISHED);
                Socket::set_seq(sock_id, tcp_hdr.ack_num, tcp_hdr.seq_num + 1);
                return;
            }
        }

        // データ受信 (TCP_ESTABLISHED状態)
        if (sock_state == TCP_ESTABLISHED) {
            ulong tcp_header_bytes = tcp_hdr.data_offset * 4;
            ulong payload_offset = tcp_offset + tcp_header_bytes;
            ulong ip_payload_len = ip_hdr.total_len - ip_len;
            ulong payload_len = 0;
            if (ip_payload_len > tcp_header_bytes) {
                payload_len = ip_payload_len - tcp_header_bytes;
            }

            if (payload_len > 0) {
                Socket::append_recv(sock_id, rx_buf + payload_offset, payload_len);
                Socket::send_tcp_ack(
                    ip_hdr.src_addr, tcp_hdr.src_port,
                    ip_hdr.dst_addr, tcp_hdr.dst_port,
                    tcp_hdr.ack_num, tcp_hdr.seq_num + payload_len
                );
                Socket::set_seq(sock_id, tcp_hdr.ack_num, tcp_hdr.seq_num + payload_len);
            }

            // FIN受信
            if ((tcp_hdr.flags & TCP_FIN) != 0) {
                ulong fin_ack = tcp_hdr.seq_num + payload_len + 1;
                Socket::send_tcp_ack(
                    ip_hdr.src_addr, tcp_hdr.src_port,
                    ip_hdr.dst_addr, tcp_hdr.dst_port,
                    tcp_hdr.ack_num, fin_ack
                );
                Socket::set_state_ext(sock_id, TCP_CLOSE_WAIT);
                Socket::set_seq(sock_id, tcp_hdr.ack_num, fin_ack);
            }
        }
    }

    /// TCP ACKパケットを送信
    static void send_tcp_ack(ulong dst_ip, ulong dst_port,
        ulong src_ip, ulong src_port,
        ulong seq, ulong ack) {
        Socket::send_tcp_packet(dst_ip, dst_port, src_ip, src_port,
            seq, ack, TCP_ACK, 0, 0);
    }

    /// TCP パケットを構築して送信
    static void send_tcp_packet(ulong dst_ip, ulong dst_port,
        ulong src_ip, ulong src_port,
        ulong seq, ulong ack,
        ulong flags, ulong payload, ulong payload_len) {
        ulong buf = 0x1971000;  // NET_TX_BUF (High Mem)

        // ゲートウェイMAC取得
        ulong gw_mac = 0;
        Arp::lookup(dst_ip, &gw_mac);
        if (gw_mac == 0) {
            Arp::lookup(GATEWAY_IP, &gw_mac);
        }

        // ゲストMAC取得 (NIC_STATE_BASE + 8)
        ulong* mac_ptr = (0x1700008) as ulong*;
        ulong our_mac = *mac_ptr;

        // Ethernetヘッダ
        EthHeader eth_hdr = {
            dst_hi: (gw_mac >> 16) & 0xFFFFFFFF,
            dst_lo: gw_mac & 0xFFFF,
            src_hi: (our_mac >> 16) & 0xFFFFFFFF,
            src_lo: our_mac & 0xFFFF,
            eth_type: ETH_TYPE_IP,
            padding: 0
        };
        ulong eth_len = Ethernet::build(buf, &eth_hdr);

        // IPヘッダ
        ulong tcp_total_len = 20 + payload_len;
        IpHeader ip_hdr = {
            version: 4, ihl: 5, tos: 0,
            total_len: 20 + tcp_total_len,
            id: 0, flags: 2, frag_off: 0,
            ttl: 64, protocol: IP_PROTO_TCP,
            checksum: 0,
            src_addr: src_ip,
            dst_addr: dst_ip
        };
        ulong ip_len = Ip::build(buf + eth_len, &ip_hdr);

        // TCPヘッダ
        TcpHeader tcp_hdr = {
            src_port: src_port, dst_port: dst_port,
            seq_num: seq, ack_num: ack,
            data_offset: 5, flags: flags,
            window: 65535, checksum: 0, urgent_ptr: 0
        };
        ulong tcp_start = buf + eth_len + ip_len;
        Tcp::build(tcp_start, &tcp_hdr);

        // ペイロードコピー
        if (payload_len > 0 && payload != 0) {
            ulong i = 0;
            while (i < payload_len) {
                ulong b = Mem::read_byte(payload + i);
                Mem::write_byte(tcp_start + 20 + i, b);
                i = i + 1;
            }
        }

        // TCPチェックサム
        ulong tcp_cksum = Socket::tcp_checksum(
            src_ip, dst_ip, tcp_start, tcp_total_len);
        Mem::write_byte(tcp_start + 16, (tcp_cksum >> 8) & 0xFF);
        Mem::write_byte(tcp_start + 17, tcp_cksum & 0xFF);

        // 送信
        ulong total = eth_len + ip_len + tcp_total_len;
        VirtioNet::send(buf, total);
    }

    /// TCPチェックサム計算
    static ulong tcp_checksum(ulong src_ip, ulong dst_ip,
        ulong tcp_data, ulong tcp_len) {
        ulong sum = 0;
        // 疑似ヘッダ
        sum = sum + ((src_ip >> 16) & 0xFFFF);
        sum = sum + (src_ip & 0xFFFF);
        sum = sum + ((dst_ip >> 16) & 0xFFFF);
        sum = sum + (dst_ip & 0xFFFF);
        sum = sum + IP_PROTO_TCP;
        sum = sum + tcp_len;
        // TCPデータ
        ulong i = 0;
        while (i < tcp_len) {
            ulong hi = Mem::read_byte(tcp_data + i);
            ulong lo = 0;
            if (i + 1 < tcp_len) {
                lo = Mem::read_byte(tcp_data + i + 1);
            }
            sum = sum + ((hi << 8) | lo);
            i = i + 2;
        }
        // キャリー折り返し
        while ((sum >> 16) > 0) {
            sum = (sum & 0xFFFF) + (sum >> 16);
        }
        return (sum ^ 0xFFFF) & 0xFFFF;
    }
}
