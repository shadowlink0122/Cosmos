//! platform: baremetal-x86
// cosmo-linux::net::net_rx - ネットワーク受信ポーリング
//
// カーネルのアイドルループから呼ばれ、VirtioNetからパケットを受信して
// TCP/IPスタックで処理する。
// 受信TCP SYN-ACK → ACK送信 → ESTABLISHED遷移
// 受信TCPデータ → ソケット受信バッファへコピー

import ../../include/types;
import ../../include/net;
import ../../lib/kstring;
import ../../drivers/serial;
import ../../drivers/virtio/virtio_net;
import ../core/ethernet;
import ../core/ip;
import ../transport/tcp;
import ../core/arp;
import ../transport/socket;

// 受信バッファ (固定メモリ)
const ulong NET_RX_BUF = 0x1970000;  // High Mem
const ulong NET_RX_BUF_SIZE = 2048;

// パケット送信バッファ (TCP応答構築用)
const ulong NET_TX_BUF = 0x1971000;  // High Mem

// ゲストMAC取得ヘルパー
const ulong NIC_STATE_BASE_REF = 0x1700000;

export struct NetRx {}

impl NetRx {
    /// ネットワーク受信ポーリング（アイドルループから呼ばれる）
    /// 1パケットを処理して返る（0=パケットなし、1=処理済み）
    static ulong poll() {
        ulong recv_len = VirtioNet::recv(NET_RX_BUF, NET_RX_BUF_SIZE);
        if (recv_len == 0) { return 0; }

        // Ethernetヘッダ解析
        EthHeader eth_hdr = {
            dst_hi: 0, dst_lo: 0,
            src_hi: 0, src_lo: 0,
            eth_type: 0, padding: 0
        };
        ulong eth_len = Ethernet::parse(NET_RX_BUF, &eth_hdr);
        if (eth_len == 0) { return 0; }

        // ARP処理
        if (eth_hdr.eth_type == ETH_TYPE_ARP) {
            Arp::handle_packet(NET_RX_BUF + eth_len, recv_len - eth_len);
            return 1;
        }

        // IPv4のみ処理
        if (eth_hdr.eth_type != ETH_TYPE_IP) { return 0; }

        // IPヘッダ解析
        IpHeader ip_hdr = {
            version: 0, ihl: 0, tos: 0, total_len: 0,
            id: 0, flags: 0, frag_off: 0, ttl: 0,
            protocol: 0, checksum: 0,
            src_addr: 0, dst_addr: 0
        };
        ulong ip_len = Ip::parse(NET_RX_BUF + eth_len, &ip_hdr);
        if (ip_len == 0) { return 0; }

        // TCPのみ処理
        if (ip_hdr.protocol != IP_PROTO_TCP) { return 0; }

        // TCPヘッダ解析
        TcpHeader tcp_hdr = {
            src_port: 0, dst_port: 0,
            seq_num: 0, ack_num: 0,
            data_offset: 0, flags: 0,
            window: 0, checksum: 0, urgent_ptr: 0
        };
        ulong tcp_offset = eth_len + ip_len;
        ulong tcp_len = Tcp::parse(NET_RX_BUF + tcp_offset, &tcp_hdr);
        if (tcp_len == 0) { return 0; }

        // ソケット検索 (ローカルポートで)
        ulong sock_id = Socket::find_by_port(tcp_hdr.dst_port);
        if (sock_id >= 16) { return 0; }  // MAX_SOCKETS

        ulong sock_state = Socket::get_state(sock_id);

        // === SYN-ACK受信 (TCP_SYN_SENT状態) ===
        if (sock_state == TCP_SYN_SENT) {
            if ((tcp_hdr.flags & TCP_SYN) != 0 && (tcp_hdr.flags & TCP_ACK) != 0) {
                // SYN-ACK受信 → ACK送信 → ESTABLISHED
                NetRx::send_tcp_ack(
                    ip_hdr.src_addr, tcp_hdr.src_port,
                    ip_hdr.dst_addr, tcp_hdr.dst_port,
                    tcp_hdr.ack_num,     // 次の送信SEQ
                    tcp_hdr.seq_num + 1  // ACK番号 = 相手SEQ+1
                );
                Socket::set_state_ext(sock_id, TCP_ESTABLISHED);
                Socket::set_seq(sock_id, tcp_hdr.ack_num, tcp_hdr.seq_num + 1);
                return 1;
            }
        }

        // === データ受信 (TCP_ESTABLISHED状態) ===
        if (sock_state == TCP_ESTABLISHED) {
            ulong tcp_header_bytes = tcp_hdr.data_offset * 4;
            ulong payload_offset = tcp_offset + tcp_header_bytes;
            ulong ip_payload_len = ip_hdr.total_len - ip_len;
            ulong payload_len = 0;
            if (ip_payload_len > tcp_header_bytes) {
                payload_len = ip_payload_len - tcp_header_bytes;
            }

            if (payload_len > 0) {
                // ペイロードをソケット受信バッファにコピー
                Socket::append_recv(sock_id, NET_RX_BUF + payload_offset, payload_len);
                // ACK送信
                NetRx::send_tcp_ack(
                    ip_hdr.src_addr, tcp_hdr.src_port,
                    ip_hdr.dst_addr, tcp_hdr.dst_port,
                    tcp_hdr.ack_num,
                    tcp_hdr.seq_num + payload_len
                );
                Socket::set_seq(sock_id, tcp_hdr.ack_num, tcp_hdr.seq_num + payload_len);
            }

            // FIN受信
            if ((tcp_hdr.flags & TCP_FIN) != 0) {
                ulong fin_ack = tcp_hdr.seq_num + payload_len + 1;
                NetRx::send_tcp_ack(
                    ip_hdr.src_addr, tcp_hdr.src_port,
                    ip_hdr.dst_addr, tcp_hdr.dst_port,
                    tcp_hdr.ack_num, fin_ack
                );
                Socket::set_state_ext(sock_id, TCP_CLOSE_WAIT);
                Socket::set_seq(sock_id, tcp_hdr.ack_num, fin_ack);
            }

            return 1;
        }

        return 0;
    }

    /// TCP ACKパケットを送信
    static void send_tcp_ack(ulong dst_ip, ulong dst_port,
        ulong src_ip, ulong src_port,
        ulong seq, ulong ack) {
        NetRx::send_tcp_packet(dst_ip, dst_port, src_ip, src_port,
            seq, ack, TCP_ACK, 0, 0);
    }

    /// TCP パケットを構築して送信
    /// flags: TCP_SYN, TCP_ACK, TCP_FIN, TCP_PSH等
    /// payload: ペイロードデータ先頭 (0=なし)
    /// payload_len: ペイロード長
    static void send_tcp_packet(ulong dst_ip, ulong dst_port,
        ulong src_ip, ulong src_port,
        ulong seq, ulong ack,
        ulong flags, ulong payload, ulong payload_len) {
        ulong buf = NET_TX_BUF;

        // ゲートウェイMAC取得
        ulong gw_mac = 0;
        Arp::lookup(dst_ip, &gw_mac);
        if (gw_mac == 0) {
            // ゲートウェイ経由
            Arp::lookup(GATEWAY_IP, &gw_mac);
        }

        // ゲストMAC取得
        ulong* mac_ptr = (NIC_STATE_BASE_REF + 8) as ulong*;
        ulong our_mac = *mac_ptr;

        // === Ethernetヘッダ構築 (14バイト) ===
        EthHeader eth_hdr = {
            dst_hi: (gw_mac >> 16) & 0xFFFFFFFF,
            dst_lo: gw_mac & 0xFFFF,
            src_hi: (our_mac >> 16) & 0xFFFFFFFF,
            src_lo: our_mac & 0xFFFF,
            eth_type: ETH_TYPE_IP,
            padding: 0
        };
        ulong eth_len = Ethernet::build(buf, &eth_hdr);

        // === IPヘッダ構築 (20バイト) ===
        ulong tcp_total_len = 20 + payload_len;
        IpHeader ip_hdr = {
            version: 4, ihl: 5, tos: 0,
            total_len: 20 + tcp_total_len,  // IP hdr + TCP hdr + payload
            id: 0, flags: 2, frag_off: 0,   // Don't Fragment
            ttl: 64, protocol: IP_PROTO_TCP,
            checksum: 0,
            src_addr: src_ip,
            dst_addr: dst_ip
        };
        ulong ip_len = Ip::build(buf + eth_len, &ip_hdr);

        // === TCPヘッダ構築 (20バイト) ===
        TcpHeader tcp_hdr = {
            src_port: src_port, dst_port: dst_port,
            seq_num: seq, ack_num: ack,
            data_offset: 5, flags: flags,
            window: 65535, checksum: 0, urgent_ptr: 0
        };
        ulong tcp_start = buf + eth_len + ip_len;
        Tcp::build(tcp_start, &tcp_hdr);

        // ペイロードコピー
        if (payload_len > 0 && payload != 0) {
            ulong i = 0;
            while (i < payload_len) {
                ulong b = Mem::read_byte(payload + i);
                Mem::write_byte(tcp_start + 20 + i, b);
                i = i + 1;
            }
        }

        // TCPチェックサム計算 (疑似ヘッダ含む)
        ulong tcp_cksum = NetRx::tcp_checksum(
            src_ip, dst_ip, tcp_start, tcp_total_len);
        Mem::write_byte(tcp_start + 16, (tcp_cksum >> 8) & 0xFF);
        Mem::write_byte(tcp_start + 17, tcp_cksum & 0xFF);

        // 送信
        ulong total = eth_len + ip_len + tcp_total_len;
        VirtioNet::send(buf, total);
    }

    /// TCPチェックサム計算 (疑似ヘッダ + TCPデータ)
    static ulong tcp_checksum(ulong src_ip, ulong dst_ip,
        ulong tcp_data, ulong tcp_len) {
        ulong sum = 0;

        // 疑似ヘッダ (12バイト)
        // 送信元IP (4バイト)
        sum = sum + ((src_ip >> 16) & 0xFFFF);
        sum = sum + (src_ip & 0xFFFF);
        // 宛先IP (4バイト)
        sum = sum + ((dst_ip >> 16) & 0xFFFF);
        sum = sum + (dst_ip & 0xFFFF);
        // ゼロ + プロトコル(TCP=6) + TCP長
        sum = sum + IP_PROTO_TCP;
        sum = sum + tcp_len;

        // TCPデータ
        ulong i = 0;
        while (i < tcp_len) {
            ulong hi = Mem::read_byte(tcp_data + i);
            ulong lo = 0;
            if (i + 1 < tcp_len) {
                lo = Mem::read_byte(tcp_data + i + 1);
            }
            sum = sum + ((hi << 8) | lo);
            i = i + 2;
        }

        // キャリー折り返し
        while ((sum >> 16) > 0) {
            sum = (sum & 0xFFFF) + (sum >> 16);
        }

        return (sum ^ 0xFFFF) & 0xFFFF;
    }
}
