//! platform: baremetal-x86
// cosmo-linux::net::dns - DNSクライアント
//
// QEMU SLIRP DNSサーバ(10.0.2.3)にUDP/53でAレコードクエリを送信し、
// ホスト名→IPv4アドレスを解決する。
// 参照: RFC 1035

import ../../include/types;
import ../../include/net;
import ../../lib/kstring;
import ../../drivers/serial;
import ../../drivers/pci;
import ../../drivers/virtio/virtio;
import ../../drivers/virtio/virtio_net;
import ../core/ethernet;
import ../core/ip;
import ../transport/udp;
import ../core/arp;
import ../../drivers/timer/pit;

// DNS定数
const ulong DNS_PORT = 53;
const ulong DNS_BUF_BASE = 0xA53000;  // DNS送信バッファ
const ulong DNS_RX_BUF = 0xA54000;    // DNS受信バッファ

// DNSヘッダフラグ
const ulong DNS_FLAG_RD = 0x0100;  // Recursion Desired
const ulong DNS_TYPE_A = 1;        // Aレコード (IPv4)
const ulong DNS_CLASS_IN = 1;      // Internet

export struct Dns {}

impl Dns {
    /// ホスト名をIPv4アドレスに解決
    /// hostname: ホスト名文字列のアドレス (例: "google.com")
    /// 返り値: IPv4アドレス (0=失敗)
    static ulong resolve(ulong hostname) {
        if (hostname == 0) { return 0; }
        if (VirtioNet::is_ready() == 0) { return 0; }

        ulong pkt_buf = DNS_BUF_BASE;
        ulong pos = 0;

        ulong our_mac = VirtioNet::mac();
        ulong src_port = 12345;  // 送信元ポート (ephemeral)
        ulong tx_id = 0xABCD;    // Transaction ID

        // 1. Ethernetヘッダ (14バイト)
        // dst MAC = gateway MAC
        Mem::write_byte(pkt_buf, (GATEWAY_MAC >> 40) & 0xFF);
        Mem::write_byte(pkt_buf + 1, (GATEWAY_MAC >> 32) & 0xFF);
        Mem::write_byte(pkt_buf + 2, (GATEWAY_MAC >> 24) & 0xFF);
        Mem::write_byte(pkt_buf + 3, (GATEWAY_MAC >> 16) & 0xFF);
        Mem::write_byte(pkt_buf + 4, (GATEWAY_MAC >> 8) & 0xFF);
        Mem::write_byte(pkt_buf + 5, GATEWAY_MAC & 0xFF);
        // src MAC = our MAC
        Mem::write_byte(pkt_buf + 6, (our_mac >> 40) & 0xFF);
        Mem::write_byte(pkt_buf + 7, (our_mac >> 32) & 0xFF);
        Mem::write_byte(pkt_buf + 8, (our_mac >> 24) & 0xFF);
        Mem::write_byte(pkt_buf + 9, (our_mac >> 16) & 0xFF);
        Mem::write_byte(pkt_buf + 10, (our_mac >> 8) & 0xFF);
        Mem::write_byte(pkt_buf + 11, our_mac & 0xFF);
        // EtherType = IP
        Mem::write_byte(pkt_buf + 12, 0x08);
        Mem::write_byte(pkt_buf + 13, 0x00);
        pos = 14;

        // 2. DNSペイロード構築 (IPv4/UDPヘッダの後に配置)
        // IPv4ヘッダ(20) + UDPヘッダ(8) の後にDNSデータ
        ulong dns_start = pos + 20 + 8;
        ulong dns_pos = dns_start;

        // DNSヘッダ (12バイト)
        // Transaction ID
        Mem::write_byte(pkt_buf + dns_pos, (tx_id >> 8) & 0xFF);
        Mem::write_byte(pkt_buf + dns_pos + 1, tx_id & 0xFF);
        // Flags: 標準クエリ + RD (Recursion Desired)
        Mem::write_byte(pkt_buf + dns_pos + 2, (DNS_FLAG_RD >> 8) & 0xFF);
        Mem::write_byte(pkt_buf + dns_pos + 3, DNS_FLAG_RD & 0xFF);
        // QDCOUNT = 1
        Mem::write_byte(pkt_buf + dns_pos + 4, 0x00);
        Mem::write_byte(pkt_buf + dns_pos + 5, 0x01);
        // ANCOUNT = 0
        Mem::write_byte(pkt_buf + dns_pos + 6, 0x00);
        Mem::write_byte(pkt_buf + dns_pos + 7, 0x00);
        // NSCOUNT = 0
        Mem::write_byte(pkt_buf + dns_pos + 8, 0x00);
        Mem::write_byte(pkt_buf + dns_pos + 9, 0x00);
        // ARCOUNT = 0
        Mem::write_byte(pkt_buf + dns_pos + 10, 0x00);
        Mem::write_byte(pkt_buf + dns_pos + 11, 0x00);
        dns_pos = dns_pos + 12;

        // Question Section: ホスト名をDNS形式にエンコード
        // "google.com" → [6]google[3]com[0]
        dns_pos = Dns::encode_name(pkt_buf, dns_pos, hostname);

        // QTYPE = A (1)
        Mem::write_byte(pkt_buf + dns_pos, 0x00);
        Mem::write_byte(pkt_buf + dns_pos + 1, DNS_TYPE_A);
        dns_pos = dns_pos + 2;

        // QCLASS = IN (1)
        Mem::write_byte(pkt_buf + dns_pos, 0x00);
        Mem::write_byte(pkt_buf + dns_pos + 1, DNS_CLASS_IN);
        dns_pos = dns_pos + 2;

        ulong dns_len = dns_pos - dns_start;

        // 3. UDPヘッダ (8バイト)
        ulong udp_start = pos + 20;
        ulong udp_total = 8 + dns_len;
        UdpHeader udp_hdr = {
            src_port: src_port,
            dst_port: DNS_PORT,
            length: udp_total,
            checksum: 0
        };
        Udp::build(pkt_buf + udp_start, &udp_hdr);

        // 4. IPv4ヘッダ (20バイト)
        ulong ip_total = 20 + udp_total;
        IpHeader ip_hdr = {
            version: 4, ihl: 5, tos: 0,
            total_len: ip_total,
            id: 0x1234, flags: 0, frag_off: 0,
            ttl: 64, protocol: IP_PROTO_UDP,
            checksum: 0,
            src_addr: GUEST_IP,
            dst_addr: DNS_IP
        };
        Ip::build(pkt_buf + pos, &ip_hdr);

        ulong total_pkt = pos + ip_total;

        // 5. 送信
        VirtioNet::send(pkt_buf, total_pkt);

        // 6. 応答待機 (最大2秒 = 200 ticks)
        ulong start_tick = PIT::get_ticks();
        ulong timeout = start_tick + 200;
        ulong result_ip = 0;

        while (PIT::get_ticks() < timeout) {
            ulong rx_buf = DNS_RX_BUF;
            ulong rx_len = VirtioNet::recv(rx_buf, 1500);
            if (rx_len > 0) {
                // EtherType確認
                ulong et_hi = Mem::read_byte(rx_buf + 12);
                ulong et_lo = Mem::read_byte(rx_buf + 13);
                ulong etype = (et_hi << 8) | et_lo;

                if (etype == ETH_TYPE_ARP) {
                    // ARP Request応答
                    Arp::handle_packet(rx_buf + 14, rx_len - 14);
                } else if (etype == ETH_TYPE_IP) {
                    // IPv4パケット
                    ulong ip_proto = Mem::read_byte(rx_buf + 14 + 9);
                    if (ip_proto == IP_PROTO_UDP) {
                        // UDPパケット — IPv4ヘッダ長を取得
                        ulong ihl = Mem::read_byte(rx_buf + 14) & 0x0F;
                        ulong ip_hdr_len2 = ihl * 4;
                        ulong udp_data = rx_buf + 14 + ip_hdr_len2;

                        // UDPソースポートがDNS(53)か確認
                        ulong udp_sp_hi = Mem::read_byte(udp_data);
                        ulong udp_sp_lo = Mem::read_byte(udp_data + 1);
                        ulong udp_src = (udp_sp_hi << 8) | udp_sp_lo;

                        if (udp_src == DNS_PORT) {
                            // DNS応答解析
                            ulong dns_data = udp_data + 8;
                            result_ip = Dns::parse_response(dns_data, rx_len - 14 - ip_hdr_len2 - 8, tx_id);
                            if (result_ip != 0) { break; }
                        }
                    }
                }
            }
            __asm__(`pause`);
        }

        return result_ip;
    }

    /// DNS応答からAレコードのIPアドレスを抽出
    static ulong parse_response(ulong data, ulong len, ulong expected_id) {
        if (len < 12) { return 0; }

        // Transaction ID確認
        ulong resp_id_hi = Mem::read_byte(data);
        ulong resp_id_lo = Mem::read_byte(data + 1);
        ulong resp_id = (resp_id_hi << 8) | resp_id_lo;
        if (resp_id != expected_id) { return 0; }

        // Flags確認: bit15 = QR (1=応答)
        ulong flags_hi = Mem::read_byte(data + 2);
        if ((flags_hi & 0x80) == 0) { return 0; }  // クエリなら無視

        // RCODE確認 (下位4bit)
        ulong flags_lo = Mem::read_byte(data + 3);
        ulong rcode = flags_lo & 0x0F;
        if (rcode != 0) { return 0; }  // エラー

        // ANCOUNT
        ulong an_hi = Mem::read_byte(data + 6);
        ulong an_lo = Mem::read_byte(data + 7);
        ulong ancount = (an_hi << 8) | an_lo;
        if (ancount == 0) { return 0; }

        // Questionセクションをスキップ
        ulong qdcount_hi = Mem::read_byte(data + 4);
        ulong qdcount_lo = Mem::read_byte(data + 5);
        ulong qdcount = (qdcount_hi << 8) | qdcount_lo;

        ulong offset = 12;  // ヘッダ後
        ulong qi = 0;
        while (qi < qdcount) {
            // 名前をスキップ
            offset = Dns::skip_name(data, offset, len);
            offset = offset + 4;  // QTYPE(2) + QCLASS(2)
            qi = qi + 1;
        }

        // Answerセクション: 最初のAレコードを探す
        ulong ai = 0;
        while (ai < ancount && offset < len) {
            // 名前をスキップ
            offset = Dns::skip_name(data, offset, len);

            if (offset + 10 > len) { return 0; }

            // TYPE (2バイト)
            ulong type_hi = Mem::read_byte(data + offset);
            ulong type_lo = Mem::read_byte(data + offset + 1);
            ulong rtype = (type_hi << 8) | type_lo;

            // CLASS (2バイト)
            // offset + 2, + 3

            // TTL (4バイト)
            // offset + 4, + 5, + 6, + 7

            // RDLENGTH (2バイト)
            ulong rdlen_hi = Mem::read_byte(data + offset + 8);
            ulong rdlen_lo = Mem::read_byte(data + offset + 9);
            ulong rdlen = (rdlen_hi << 8) | rdlen_lo;

            offset = offset + 10;

            if (rtype == DNS_TYPE_A && rdlen == 4) {
                // Aレコード: 4バイトのIPv4アドレス
                ulong b0 = Mem::read_byte(data + offset);
                ulong b1 = Mem::read_byte(data + offset + 1);
                ulong b2 = Mem::read_byte(data + offset + 2);
                ulong b3 = Mem::read_byte(data + offset + 3);
                return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
            }

            offset = offset + rdlen;
            ai = ai + 1;
        }

        return 0;
    }

    /// DNS名前をエンコード: "google.com" → [6]google[3]com[0]
    static ulong encode_name(ulong buf, ulong pos, ulong hostname) {
        ulong i = 0;
        ulong label_start = pos;
        pos = pos + 1;  // ラベル長の位置をスキップ

        while (true) {
            ulong ch = Mem::read_byte(hostname + i);
            if (ch == 0 || ch == 32) {
                // 最後のラベルの長さを書き込み
                ulong label_len = pos - label_start - 1;
                Mem::write_byte(buf + label_start, label_len);
                // 終端の0
                Mem::write_byte(buf + pos, 0);
                pos = pos + 1;
                break;
            }
            if (ch == 46) {  // '.'
                // ラベルの長さを書き込み
                ulong label_len = pos - label_start - 1;
                Mem::write_byte(buf + label_start, label_len);
                // 次のラベルの開始
                label_start = pos;
                pos = pos + 1;
            } else {
                Mem::write_byte(buf + pos, ch);
                pos = pos + 1;
            }
            i = i + 1;
        }

        return pos;
    }

    /// DNS名前をスキップ (圧縮ポインタ対応)
    static ulong skip_name(ulong data, ulong offset, ulong len) {
        while (offset < len) {
            ulong b = Mem::read_byte(data + offset);
            if (b == 0) {
                return offset + 1;
            }
            if ((b & 0xC0) == 0xC0) {
                // 圧縮ポインタ: 2バイト
                return offset + 2;
            }
            // 通常ラベル: 長さ + データ
            offset = offset + 1 + b;
        }
        return offset;
    }
}
