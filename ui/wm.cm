//! platform: baremetal-x86
// cosmo-linux::ui::wm - ウィンドウマネージャ
//
// ウィンドウの描画順序管理と全画面再描画。

import ../include/types;
import ../include/config;
import ../drivers/video/framebuffer;
import ../drivers/video/font;
import ../ui/desktop;
import ../ui/menubar;
import ../ui/window;

/// Wm — ウィンドウマネージャ
export struct Wm {}

impl Wm {
    /// GUI環境初期化
    static void init() {
        // ウィンドウ状態をゼロクリア
        ulong i = 0;
        while (i < MAX_WINDOWS) {
            ulong b = Window::base(i);
            ulong j = 0;
            while (j < 128) {
                ulong addr = b + j;
                ulong zero = 0;
                __asm__(`
                    movq ${r:addr}, %rdi;
                    movq ${r:zero}, %rax;
                    movb %al, (%rdi)
                `);
                j = j + 1;
            }
            i = i + 1;
        }
    }

    /// 全画面を再描画
    static void compose() {
        // 1. デスクトップ背景
        Desktop::draw_background();

        // 2. ウィンドウ（Z-order順）
        ulong i = 0;
        while (i < MAX_WINDOWS) {
            if (Window::is_visible(i) != 0) {
                Window::draw(i);
            }
            i = i + 1;
        }

        // 3. メニューバー（常に最前面）
        MenuBar::draw();

        // 4. マウスカーソル（最前面）
        Desktop::draw_cursor();

        // 5. バックバッファ → VRAM
        Fb::flip();
    }

    /// ターミナルウィンドウを作成
    static ulong create_terminal() {
        // 画面中央に配置
        ulong sw = Fb::width();
        ulong sh = Fb::height();
        ulong tw = 640;
        ulong th = 400;
        ulong tx = (sw - tw) / 2;
        ulong ty = (sh - th) / 2 + 20;

        return Window::create(tx, ty, tw, th, "Terminal" as void*, 1);
    }
}
