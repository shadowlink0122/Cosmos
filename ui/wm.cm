//! platform: baremetal-x86
// cosmo-linux::ui::wm - ウィンドウマネージャ
//
// ウィンドウの描画順序管理と全画面再描画。

import ../include/types;
import ../include/config;
import ../drivers/video/framebuffer;
import ../drivers/video/font;
import ../drivers/input/mouse;
import ../ui/desktop;
import ../ui/menubar;
import ../ui/window;
import ../ui/dock;

/// Wm — ウィンドウマネージャ
export struct Wm {}

impl Wm {
    /// GUI環境初期化
    static void init() {
        // ウィンドウ状態をゼロクリア
        ulong i = 0;
        while (i < MAX_WINDOWS) {
            ulong b = Window::base(i);
            ulong j = 0;
            while (j < 128) {
                ulong addr = b + j;
                ulong zero = 0;
                __asm__(`
                    movq ${r:addr}, %rdi;
                    movq ${r:zero}, %rax;
                    movb %al, (%rdi)
                `);
                j = j + 1;
            }
            i = i + 1;
        }
    }

    /// 全画面を再描画
    static void compose() {
        // 1. デスクトップ背景
        Desktop::draw_background();

        // 2. ウィンドウ（Z-order順）
        ulong i = 0;
        while (i < MAX_WINDOWS) {
            if (Window::is_visible(i) != 0) {
                Window::draw(i);
            }
            i = i + 1;
        }

        // 3. Dock（画面下部）
        Dock::draw();

        // 4. メニューバー（常に最前面）
        MenuBar::draw();

        // 5. バックバッファ → VRAM（カーソルなし）
        Fb::flip();

        // 6. カーソルをVRAMに直接描画（バックバッファには描かない）
        Desktop::draw_cursor_direct();
    }

    /// ターミナルウィンドウを作成
    static ulong create_terminal() {
        ulong sw = Fb::width();
        ulong sh = Fb::height();
        ulong tw = 640;
        ulong th = 400;
        ulong tx = (sw - tw) / 2;
        ulong ty = (sh - th) / 2;

        return Window::create(tx, ty, tw, th, "Terminal" as void*, 1);
    }

    /// マウスイベント処理（高速版 — カーソルのみVRAM直描画）
    static void process_mouse() {
        if (Mouse::has_event() == 0) { return; }

        long dx = Mouse::get_dx();
        long dy = Mouse::get_dy();
        ulong buttons = Mouse::get_buttons();

        if (dx != 0 || dy != 0) {
            // 旧カーソル位置を保存
            ulong old_x = Desktop::cursor_x();
            ulong old_y = Desktop::cursor_y();

            // カーソル位置更新（PS/2はYが上向き正なので反転）
            Desktop::move_cursor(dx, 0 - dy);

            // 旧カーソル位置をバックバッファからVRAMに復元
            Desktop::restore_cursor(old_x, old_y);

            // 新カーソル位置をVRAMに直接描画
            Desktop::draw_cursor_direct();
        }

        // 左ボタンクリック判定
        ulong* prev_btn = 0xD80900 as ulong*;
        ulong was_pressed = *prev_btn & 1;
        ulong is_pressed = buttons & 1;
        *prev_btn = buttons;

        if (is_pressed != 0 && was_pressed == 0) {
            ulong mx = Desktop::cursor_x();
            ulong my = Desktop::cursor_y();

            ulong i = 0;
            while (i < MAX_WINDOWS) {
                if (Window::is_visible(i) != 0) {
                    ulong btn = Window::hit_button(i, mx, my);
                    if (btn == 1) {
                        Window::close(i);
                        Wm::compose();
                        break;
                    } else if (btn == 2) {
                        Window::close(i);
                        Wm::compose();
                        break;
                    } else if (btn == 3) {
                        Window::toggle_maximize(i);
                        Wm::compose();
                        break;
                    }
                }
                i = i + 1;
            }
        }
    }
}
