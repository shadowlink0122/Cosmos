//! platform: baremetal-x86
// cosmo-linux::ui::wm - ウィンドウマネージャ
//
// ウィンドウの描画順序管理と全画面再描画。

import ../include/types;
import ../include/config;
import ../drivers/video/framebuffer;
import ../drivers/video/font;
import ../drivers/input/mouse;
import ../ui/desktop;
import ../ui/menubar;
import ../ui/window;
import ../ui/dock;

/// Wm — ウィンドウマネージャ
export struct Wm {}

impl Wm {
    /// GUI環境初期化
    static void init() {
        // ウィンドウ状態をゼロクリア
        ulong i = 0;
        while (i < MAX_WINDOWS) {
            ulong b = Window::base(i);
            ulong j = 0;
            while (j < 128) {
                ulong addr = b + j;
                ulong zero = 0;
                __asm__(`
                    movq ${r:addr}, %rdi;
                    movq ${r:zero}, %rax;
                    movb %al, (%rdi)
                `);
                j = j + 1;
            }
            i = i + 1;
        }
    }

    /// 全画面を再描画
    static void compose() {
        // 1. デスクトップ背景
        Desktop::draw_background();

        // 2. ウィンドウ（Z-order順）
        ulong i = 0;
        while (i < MAX_WINDOWS) {
            if (Window::is_visible(i) != 0) {
                Window::draw(i);
            }
            i = i + 1;
        }

        // 3. Dock（画面下部）
        Dock::draw();

        // 4. メニューバー（常に最前面）
        MenuBar::draw();

        // 5. マウスカーソル（最前面）
        Desktop::draw_cursor();

        // 6. バックバッファ → VRAM
        Fb::flip();
    }

    /// ターミナルウィンドウを作成
    static ulong create_terminal() {
        ulong sw = Fb::width();
        ulong sh = Fb::height();
        ulong tw = 640;
        ulong th = 400;
        ulong tx = (sw - tw) / 2;
        ulong ty = (sh - th) / 2;

        return Window::create(tx, ty, tw, th, "Terminal" as void*, 1);
    }

    /// マウスイベント処理
    static void process_mouse() {
        if (Mouse::has_event() == 0) { return; }

        long dx = Mouse::get_dx();
        long dy = Mouse::get_dy();

        if (dx != 0 || dy != 0) {
            // PS/2マウスはYが上向き正なので反転
            Desktop::move_cursor(dx, 0 - dy);
            // 全画面再描画（バックバッファに描画してからflip）
            Wm::compose();
        }
    }

    /// 背景のみ再描画（キャッシュ利用で高速化）
    /// 初回描画後のデスクトップ背景は固定なので、
    /// バックバッファを直接VRAM にコピーすれば良い
    static void redraw_fast() {
        // バックバッファに全要素を描画
        Wm::compose();
    }
}
