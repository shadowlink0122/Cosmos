//! platform: baremetal-x86
// cosmo-linux::ui::terminal - GUIターミナルエミュレータ
//
// ウィンドウ内にテキスト入出力を提供するターミナル。

import ../include/types;
import ../include/config;
import ../drivers/video/framebuffer;
import ../drivers/video/font;
import ../ui/window;

// ============================================================
// ターミナル定数
// ============================================================

/// ターミナル背景色 (macOS Terminal風ダーク)
const ulong TERM_BG = 0x1E1E1E;
/// ターミナルテキスト色
const ulong TERM_FG = 0xCCCCCC;
/// プロンプト色 (緑)
const ulong TERM_PROMPT = 0x50FA7B;
/// ターミナルパディング
const ulong TERM_PAD = 4;

/// ターミナル状態アドレス
const PhysAddr TERM_STATE_ADDR = 0xD82000;
// レイアウト:
//   0x00: window_id (8B)
//   0x08: cursor_col (8B)
//   0x10: cursor_row (8B)
//   0x18: max_cols (8B)
//   0x20: max_rows (8B)

/// Terminal — GUIターミナル
export struct Terminal {}

impl Terminal {
    /// ターミナル初期化（ウィンドウIDを関連付け）
    static void init(ulong win_id) {
        ulong* wid = TERM_STATE_ADDR as ulong*;
        ulong* col = (TERM_STATE_ADDR + 8) as ulong*;
        ulong* row = (TERM_STATE_ADDR + 0x10) as ulong*;
        ulong* mc  = (TERM_STATE_ADDR + 0x18) as ulong*;
        ulong* mr  = (TERM_STATE_ADDR + 0x20) as ulong*;

        *wid = win_id;
        *col = 0;
        *row = 0;

        // コンテンツ領域からカラム・行数を計算
        ulong content_w = Window::get_w(win_id) - 2 - TERM_PAD * 2;
        ulong content_h = Window::get_h(win_id) - TITLEBAR_HEIGHT - 2 - TERM_PAD * 2;
        *mc = content_w / FONT_W;
        *mr = content_h / FONT_H;

        // ターミナル背景を描画
        Terminal::clear();
    }

    /// ターミナル背景クリア
    static void clear() {
        ulong* wid = TERM_STATE_ADDR as ulong*;
        ulong win_id = *wid;
        ulong x = Window::get_x(win_id) + 1 + TERM_PAD;
        ulong y = Window::get_y(win_id) + TITLEBAR_HEIGHT + 1 + TERM_PAD;
        ulong w = Window::get_w(win_id) - 2 - TERM_PAD * 2;
        ulong h = Window::get_h(win_id) - TITLEBAR_HEIGHT - 2 - TERM_PAD * 2;
        Fb::fill_rect(x, y, w, h, TERM_BG);
    }

    /// 1文字出力
    static void putc(ulong ch) {
        ulong* wid = TERM_STATE_ADDR as ulong*;
        ulong* col = (TERM_STATE_ADDR + 8) as ulong*;
        ulong* row = (TERM_STATE_ADDR + 0x10) as ulong*;
        ulong* mc  = (TERM_STATE_ADDR + 0x18) as ulong*;
        ulong* mr  = (TERM_STATE_ADDR + 0x20) as ulong*;

        ulong win_id = *wid;

        if (ch == 10) {
            // 改行
            *col = 0;
            *row = *row + 1;
            if (*row >= *mr) {
                // スクロール (簡易版: 画面クリア)
                *row = *mr - 1;
                Terminal::clear();
            }
            return;
        }

        // 文字描画位置
        ulong base_x = Window::get_x(win_id) + 1 + TERM_PAD;
        ulong base_y = Window::get_y(win_id) + TITLEBAR_HEIGHT + 1 + TERM_PAD;
        ulong px = base_x + (*col) * FONT_W;
        ulong py = base_y + (*row) * FONT_H;

        Font::draw_char(px, py, ch, TERM_FG, TERM_BG);

        *col = *col + 1;
        if (*col >= *mc) {
            *col = 0;
            *row = *row + 1;
            if (*row >= *mr) {
                *row = *mr - 1;
                Terminal::clear();
            }
        }
    }

    /// 文字列出力
    static void puts(void* str) {
        ulong src = str as ulong;
        ulong i = 0;
        while (true) {
            ulong addr = src + i;
            ulong ch = 0;
            __asm__(`
                movq ${r:addr}, %rdi;
                xorq %rax, %rax;
                movb (%rdi), %al;
                movq %rax, ${=r:ch}
            `);
            if (ch == 0) { return; }
            Terminal::putc(ch);
            i = i + 1;
        }
    }

    /// プロンプト表示
    static void prompt() {
        // 緑でプロンプト表示
        ulong* wid = TERM_STATE_ADDR as ulong*;
        ulong* col = (TERM_STATE_ADDR + 8) as ulong*;
        ulong* row = (TERM_STATE_ADDR + 0x10) as ulong*;

        ulong win_id = *wid;
        ulong base_x = Window::get_x(win_id) + 1 + TERM_PAD;
        ulong base_y = Window::get_y(win_id) + TITLEBAR_HEIGHT + 1 + TERM_PAD;

        // "cosmo $ "
        ulong px = base_x + (*col) * FONT_W;
        ulong py = base_y + (*row) * FONT_H;
        Font::draw_string(px, py, "cosmo" as void*, TERM_PROMPT, TERM_BG);
        *col = *col + 5;
        px = base_x + (*col) * FONT_W;
        Font::draw_string(px, py, " $ " as void*, TERM_FG, TERM_BG);
        *col = *col + 3;
    }
}
