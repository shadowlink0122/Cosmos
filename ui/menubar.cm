//! platform: baremetal-x86
// cosmo-linux::ui::menubar - macOS風メニューバー
//
// 画面最上部に半透明メニューバーを描画。
// 左にアプリ名、右に時刻表示（CMOS RTC）。

import ../include/types;
import ../include/config;
import ../drivers/video/framebuffer;
import ../drivers/video/font;
import ../include/color;
import ../drivers/timer/pit;
import ../drivers/timer/rtc;
import ../ui/mem;

// ============================================================
// メニューバー定数
// ============================================================

/// メニューバー高さ
export const ulong MENUBAR_HEIGHT = 24;

/// メニューバー背景色 (半透明白)
/// メニューバー背景色 (color.cmから参照)
const Rgb MENUBAR_BG = MENUBAR_BG_COLOR;
/// メニューバー文字色
const Rgb MENUBAR_FG = MENUBAR_FG_COLOR;
/// メニューバー下境界線
const Rgb MENUBAR_BORDER = MENUBAR_BORDER_COLOR;

/// MenuBar — macOS風メニューバー
export struct MenuBar {}

impl MenuBar {
    /// メニューバー描画
    static void draw() {
        ulong w = Fb::width();

        // 背景
        Fb::fill_rect(0, 0, w, MENUBAR_HEIGHT, MENUBAR_BG);

        // 下部ボーダー (1px)
        Fb::hline(0, MENUBAR_HEIGHT, w, MENUBAR_BORDER);

        // 左: アップルロゴ風 + アプリ名
        Font::draw_string(12, 4, "Cosmo" as void*, MENUBAR_FG, MENUBAR_BG);

        // メニュー項目
        Font::draw_string(72, 4, "File" as void*, MENUBAR_FG, MENUBAR_BG);
        Font::draw_string(120, 4, "Edit" as void*, MENUBAR_FG, MENUBAR_BG);
        Font::draw_string(168, 4, "View" as void*, MENUBAR_FG, MENUBAR_BG);
        Font::draw_string(216, 4, "Window" as void*, MENUBAR_FG, MENUBAR_BG);
        Font::draw_string(288, 4, "Help" as void*, MENUBAR_FG, MENUBAR_BG);

        // 右: 時刻表示（CMOS RTC）
        MenuBar::draw_clock();
    }

    /// 時刻表示 (CMOS RTCから実時刻を取得, HH:MM:SS形式)
    static void draw_clock() {
        ulong w = Fb::width();

        // CMOS RTCから現在時刻を取得
        ulong hh = Rtc::hours();
        ulong mm = Rtc::minutes();
        ulong ss = Rtc::seconds();

        // "HH:MM:SS" 形式で右端に表示 (8文字 × 8px = 64px + 余白)
        ulong clock_x = w - 80;

        ulong h1 = hh / 10;
        ulong h2 = hh % 10;
        ulong m1 = mm / 10;
        ulong m2 = mm % 10;
        ulong s1 = ss / 10;
        ulong s2 = ss % 10;

        Font::draw_char(clock_x,      4, ASCII_DIGIT_BASE + h1, MENUBAR_FG, MENUBAR_BG);
        Font::draw_char(clock_x + 8,  4, ASCII_DIGIT_BASE + h2, MENUBAR_FG, MENUBAR_BG);
        Font::draw_char(clock_x + 16, 4, 0x3A,      MENUBAR_FG, MENUBAR_BG);  // ':'
        Font::draw_char(clock_x + 24, 4, 0x30 + m1, MENUBAR_FG, MENUBAR_BG);
        Font::draw_char(clock_x + 32, 4, 0x30 + m2, MENUBAR_FG, MENUBAR_BG);
        Font::draw_char(clock_x + 40, 4, 0x3A,      MENUBAR_FG, MENUBAR_BG);  // ':'
        Font::draw_char(clock_x + 48, 4, 0x30 + s1, MENUBAR_FG, MENUBAR_BG);
        Font::draw_char(clock_x + 56, 4, 0x30 + s2, MENUBAR_FG, MENUBAR_BG);

        // 前回の秒数を保存（update_clockでの変化検出用）
        ulong* prev_sec = CLOCK_PREV_SEC_ADDR as ulong*;
        *prev_sec = ss;
    }

    /// 時計をリアルタイム更新（メインループから呼び出し）
    /// 秒が変化した場合のみバックバッファ更新→VRAM blitで再描画
    static void update_clock() {
        ulong ss = Rtc::seconds();
        ulong* prev_sec = CLOCK_PREV_SEC_ADDR as ulong*;
        if (ss == *prev_sec) { return; }  // 変化なし → スキップ

        // バックバッファに時計を再描画
        MenuBar::draw_clock();

        // 時計部分だけVRAMにblit (高速部分更新)
        ulong w = Fb::width();
        ulong clock_x = w - 80;
        Fb::blit_rect(clock_x, 0, 80, MENUBAR_HEIGHT);
    }
}
