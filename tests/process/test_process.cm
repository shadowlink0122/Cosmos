//! platform: baremetal-x86
// cosmo-linux::tests::process::test_process - Process テスト
//
// プロセステーブルの current/find_by_pid を検証。

import ../../include/types;
import ../../include/config;
import ../../include/scheduler;
import ../../include/result;
import ../../drivers/serial;
import ../../lib/printk;
import ../../sched/process;
import ../test_io;
import ../ktest;

/// Process テストスイート
export void test_process() {
    TestIO::set_color(14, 0);
    TestIO::writeln("[Process]" as void*);
    TestIO::set_color(7, 0);

    // 現在のプロセス
    Process* cur = Sched::current();
    ulong cur_addr = cur as ulong;
    KTest::assert_nonzero(cur_addr, "current process exists" as void*);

    if (cur_addr != 0) {
        if (cur->pid >= 0) {
            KTest::assert_true(1, "current PID >= 0" as void*);
        } else {
            KTest::assert_true(0, "current PID >= 0" as void*);
        }
    }

    // PID 0 (idle) を検索
    ulong idle_addr = 0;
    Option<ulong> idle_opt = ProcessTable::find_by_pid(0);
    match (idle_opt) {
        Option::Some(v) => { idle_addr = v; }
        Option::None => {}
    }
    KTest::assert_nonzero(idle_addr, "find PID 0 (idle)" as void*);

    // 存在しないPID
    ulong ghost_found = 0;
    Option<ulong> ghost_opt = ProcessTable::find_by_pid(999);
    match (ghost_opt) {
        Option::Some(v) => { ghost_found = 1; }
        Option::None => { ghost_found = 0; }
    }
    KTest::assert_eq(ghost_found, 0, "find PID 999 returns null" as void*);
}
