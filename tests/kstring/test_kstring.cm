//! platform: baremetal-x86
// cosmo-linux::tests::kstring::test_kstring - KString テスト
//
// strlen, strcmp, streq, memcpy, memzero のユニットテスト。

import ../../include/types;
import ../../include/config;
import ../../drivers/serial;
import ../../lib/printk;
import ../../lib/kstring;
import ../test_io;
import ../ktest;
import ../../ui/mem;

/// KString テストスイート
export void test_kstring() {
    TestIO::set_color(14, 0);
    TestIO::writeln("[KString]" as void*);
    TestIO::set_color(7, 0);

    // strlen
    Size len = KString::strlen("Hello" as void*);
    KTest::assert_eq(len, 5, "strlen(\"Hello\")=5" as void*);
    len = KString::strlen("" as void*);
    KTest::assert_eq(len, 0, "strlen(\"\")=0" as void*);

    // strcmp
    long cmp = KString::strcmp("abc" as void*, "abc" as void*);
    KTest::assert_eq(cmp as ulong, 0, "strcmp equal=0" as void*);
    cmp = KString::strcmp("abc" as void*, "abd" as void*);
    ulong cmp_neg = 0;
    if (cmp < 0) { cmp_neg = 1; }
    KTest::assert_eq(cmp_neg, 1, "strcmp \"abc\"<\"abd\"" as void*);

    // streq
    ulong eq = KString::streq("test" as void*, "test" as void*);
    KTest::assert_eq(eq, 1, "streq equal=1" as void*);
    eq = KString::streq("test" as void*, "rest" as void*);
    KTest::assert_eq(eq, 0, "streq differ=0" as void*);

    // memcpy — 配列でテストデータと期待値を定義
    ulong src_buf = 0x9F200;
    ulong dst_buf = 0x9F300;
    ulong[3] test_data;
    test_data[0] = 65;  // 'A'
    test_data[1] = 66;  // 'B'
    test_data[2] = 67;  // 'C'

    // 配列からソースバッファに書き込み
    ulong i = 0;
    while (i < 3) {
        Mem::write_byte(src_buf + i, test_data[i]);
        i = i + 1;
    }
    memzero(dst_buf as void*, 8);
    memcpy(dst_buf as void*, src_buf as void*, 3);

    // ループで検証
    i = 0;
    while (i < 3) {
        KTest::assert_eq(Mem::read_byte(dst_buf + i), test_data[i], "memcpy verify" as void*);
        i = i + 1;
    }

    // memzero — 配列で初期値を設定してゼロ化を検証
    ulong[2] fill;
    fill[0] = 0xFF;
    fill[1] = 0xFF;
    i = 0;
    while (i < 2) {
        Mem::write_byte(dst_buf + i, fill[i]);
        i = i + 1;
    }
    memzero(dst_buf as void*, 2);
    i = 0;
    while (i < 2) {
        KTest::assert_eq(Mem::read_byte(dst_buf + i), 0, "memzero verify" as void*);
        i = i + 1;
    }
}
