//! platform: baremetal-x86
// tests/irq/test_irq.cm - 割り込み処理テスト

import ../../include/types;
import ../../include/config;
import ../../drivers/serial;
import ../../lib/printk;
import ../../ui/mem;
import ../../arch/x86_64/idt;
import ../../drivers/timer/pit;
import ../ktest;

/// 割り込み処理テスト
export void test_irq() {
    // SIDT でIDTベースアドレスを取得
    ulong idt_base = 0;
    __asm__(`
        subq $$16, %rsp;
        sidt (%rsp);
        movq 2(%rsp), %rax;
        movq %rax, ${=r:idt_base};
        addq $$16, %rsp
    `);

    // Test 1: IDT[32] PIT IRQ0 が設定済み
    ulong* idt32 = (idt_base + 32 * 16) as ulong*;
    KTest::assert_nonzero(*idt32, "IDT[32] PIT IRQ0 set" as void*);

    // Test 2: IDT[33] Keyboard IRQ1 が設定済み
    ulong* idt33 = (idt_base + 33 * 16) as ulong*;
    KTest::assert_nonzero(*idt33, "IDT[33] Keyboard IRQ1 set" as void*);

    // Test 3: IDT[44] Mouse IRQ12 が設定済み
    ulong* idt44 = (idt_base + 44 * 16) as ulong*;
    KTest::assert_nonzero(*idt44, "IDT[44] Mouse IRQ12 set" as void*);

    // Test 4: IDT[14] Page Fault が設定済み
    ulong* idt14 = (idt_base + 14 * 16) as ulong*;
    KTest::assert_nonzero(*idt14, "IDT[14] PageFault set" as void*);

    // Test 5: PIC Master - IRQ0(PIT) 有効
    ulong master_mask = 0;
    __asm__(`
        inb $$0x21, %al;
        movzbq %al, %rax;
        movq %rax, ${=r:master_mask}
    `);
    KTest::assert_eq(master_mask & 1, 0, "PIC IRQ0 PIT enabled" as void*);

    // Test 6: PIC Master - IRQ1(KB) 有効
    KTest::assert_eq((master_mask >> 1) & 1, 0, "PIC IRQ1 KB enabled" as void*);

    // Test 7: PIC Master - IRQ2(カスケード) 有効
    KTest::assert_eq((master_mask >> 2) & 1, 0, "PIC IRQ2 cascade enabled" as void*);

    // Test 8: PIC Slave - IRQ12(マウス) 有効
    ulong slave_mask = 0;
    __asm__(`
        inb $$0xA1, %al;
        movzbq %al, %rax;
        movq %rax, ${=r:slave_mask}
    `);
    KTest::assert_eq((slave_mask >> 4) & 1, 0, "PIC IRQ12 Mouse enabled" as void*);

    // Test 9: PIT ticks が動作中
    ulong ticks = PIT::get_ticks();
    KTest::assert_nonzero(ticks, "PIT ticks > 0" as void*);
}
