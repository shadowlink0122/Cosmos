//! platform: uefi
// kernel::shell::cmd_help - helpコマンド

import ./shell_io;
import ../config;

/// helpコマンド: 利用可能なコマンドを表示
export void cmd_help() {
    shell_set_color(SHELL_COLOR_HEADER);
    shell_println("Available commands:" as void*);
    shell_set_color(SHELL_COLOR_OUTPUT);
    shell_println("  help           - Show this help" as void*);
    shell_println("  ps             - List tasks" as void*);
    shell_println("  mem            - Show memory usage" as void*);
    shell_println("  uptime         - Show system uptime" as void*);
    shell_println("  clear          - Clear screen" as void*);
    shell_println("  ls             - List files" as void*);
    shell_println("  touch <name>   - Create file" as void*);
    shell_println("  cat <name>     - Show file" as void*);
    shell_println("  rm <name>      - Delete file" as void*);
    shell_println("  write <n> <d>  - Write to file" as void*);
}
