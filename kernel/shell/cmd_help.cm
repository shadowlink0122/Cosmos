//! platform: uefi
// kernel::shell::cmd_help - helpコマンド

import ../drivers/serial;
import ../lib/print;

// グローバルFBConsoleアドレス
const ulong GLOBAL_FB_CONSOLE_ADDR = 0xE00;
const ulong SHELL_COLOR_HEADER = 0x00FFAA00;
const ulong SHELL_COLOR_OUTPUT = 0x0000FF00;

/// helpコマンド: 利用可能なコマンドを表示
export void cmd_help() {
    SerialPort serial(0x3F8);
    FBConsole* con = GLOBAL_FB_CONSOLE_ADDR as FBConsole*;

    serial.println("Available commands:" as void*);
    serial.println("  help    - Show this help" as void*);
    serial.println("  ps      - List tasks" as void*);
    serial.println("  mem     - Show memory usage" as void*);
    serial.println("  uptime  - Show system uptime" as void*);
    serial.println("  clear   - Clear screen" as void*);

    con->set_color(SHELL_COLOR_HEADER);
    con->println("Available commands:" as void*);
    con->set_color(SHELL_COLOR_OUTPUT);
    con->println("  help    - Show this help" as void*);
    con->println("  ps      - List tasks" as void*);
    con->println("  mem     - Show memory usage" as void*);
    con->println("  uptime  - Show system uptime" as void*);
    con->println("  clear   - Clear screen" as void*);
}
