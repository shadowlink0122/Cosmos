//! platform: uefi
// kernel::shell::cmd_mem - memコマンド（メモリ使用状況表示）

import ../drivers/serial;
import ../lib/print;
import ../sched/scheduler;
import ../mm/pmm;

// グローバルFBConsoleアドレス
const ulong GLOBAL_FB_CONSOLE_ADDR = 0xE00;
const ulong SHELL_COLOR_HEADER = 0x00FFAA00;
const ulong SHELL_COLOR_OUTPUT = 0x0000FF00;

/// memコマンド: メモリ使用状況表示
export void cmd_mem() {
    SerialPort serial(0x3F8);
    FBConsole* con = GLOBAL_FB_CONSOLE_ADDR as FBConsole*;

    PMM* pmm = sched_get_pmm();

    serial.println("Physical Memory (PMM):" as void*);
    serial.puts("  Total pages: " as void*);
    serial.print_hex(pmm->total_pages);
    serial.println("" as void*);
    serial.puts("  Free pages:  " as void*);
    serial.print_hex(pmm->free_pages);
    serial.println("" as void*);
    ulong total_kb = pmm->total_pages * 4;
    ulong free_kb = pmm->free_pages * 4;
    serial.puts("  Total: " as void*);
    serial.print_hex(total_kb);
    serial.println(" KB" as void*);
    serial.puts("  Free:  " as void*);
    serial.print_hex(free_kb);
    serial.println(" KB" as void*);

    con->set_color(SHELL_COLOR_HEADER);
    con->println("Physical Memory (PMM):" as void*);
    con->set_color(SHELL_COLOR_OUTPUT);
    con->puts("  Total pages: " as void*);
    con->print_hex(pmm->total_pages);
    con->newline();
    con->puts("  Free pages:  " as void*);
    con->print_hex(pmm->free_pages);
    con->newline();
    con->puts("  Total: " as void*);
    con->print_hex(total_kb);
    con->println(" KB" as void*);
    con->puts("  Free:  " as void*);
    con->print_hex(free_kb);
    con->println(" KB" as void*);
}
