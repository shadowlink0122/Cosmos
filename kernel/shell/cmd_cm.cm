//! platform: uefi
// kernel::shell::cmd_cm - Cm簡易コンパイラ＆VMランタイム
//
// cm <file> : .cmソースファイルを読み込み、簡易バイトコードにコンパイルして
//             a.out をCosmFSに作成する。
// a.out     : バイトコードを読み込んで簡易VMで実行する。
//
// サポートする構文:
//   print(数値);     → 数値を出力
//   print("文字列"); → 文字列を出力
//
// バイトコードフォーマット（各命令16バイト）:
//   [opcode: 8B] [operand: 8B]
//   OP_HALT      = 0 : プログラム終了
//   OP_PRINT_NUM = 1 : operandを10進数で出力
//   OP_PRINT_STR = 2 : operandバイト位置から文字列を出力（次命令に長さ）

import ../drivers/serial;
import ../drivers/debug_port;
import ../fs/cosmfs;
import ../mm/heap;
import ../config;
import ./shell_io;
import ./cmd_fs;

// CosmFS操作コード
const ulong CM_FS_CREATE  = 1;
const ulong CM_FS_WRITE   = 2;
const ulong CM_FS_SIZE    = 3;
const ulong CM_FS_DELETE  = 4;
const ulong CM_FS_FIND    = 5;
const ulong CM_FS_MEMCPY  = 10;
const ulong CM_FS_READ    = 12;

const ulong CM_NOT_FOUND = 0xFFFFFFFFFFFFFFFF;

// バイトコード命令
const ulong OP_HALT      = 0;
const ulong OP_PRINT_NUM = 1;
const ulong OP_PRINT_STR = 2;

// バイトコード1命令のサイズ（バイト）
const ulong INSTR_SIZE = 16;

// コンパイラ用一時領域（0xCE0-0xCEF）
const ulong CM_INSTR_COUNT = 0xCE0;  // 現在の命令カウンタ

/// バイトコードに命令を書き込む
export void cm_emit(ulong code_buf, ulong idx, ulong opcode, ulong operand) {
    ulong offset = idx * INSTR_SIZE;
    ulong op_addr = code_buf + offset;
    ulong* op_ptr = op_addr as ulong*;
    *op_ptr = opcode;
    ulong arg_addr = code_buf + offset + 8;
    ulong* arg_ptr = arg_addr as ulong*;
    *arg_ptr = operand;
}

/// ソースコード中の数値リテラルを解析する
export ulong cm_parse_number(ulong src, ulong pos, ulong len) {
    ulong result = 0;
    while (pos < len) {
        ulong ch = cmd_read_byte(src + pos);
        if (ch < 0x30) { return result; }
        if (ch > 0x39) { return result; }
        result = result * 10 + (ch - 0x30);
        pos = pos + 1;
    }
    return result;
}

/// print()パターンを1つ処理してバイトコード生成
/// 戻り値: 処理後のソース位置
export ulong cm_compile_print(ulong src, ulong print_pos, ulong src_len, ulong code_buf) {
    ulong* cnt_ptr = CM_INSTR_COUNT as ulong*;
    ulong idx = *cnt_ptr;

    ulong first_ch = cmd_read_byte(src + print_pos);

    if (first_ch == 0x22) {
        // '"' → 文字列リテラル print("...")
        ulong str_start = print_pos + 1;
        ulong str_pos = str_start;
        while (str_pos < src_len) {
            ulong sc = cmd_read_byte(src + str_pos);
            if (sc == 0x22) {
                ulong str_len = str_pos - str_start;
                // OP_PRINT_STR: 文字列の絶対アドレス
                cm_emit(code_buf, idx, OP_PRINT_STR, src + str_start);
                idx = idx + 1;
                // 次の命令に文字列長を格納
                cm_emit(code_buf, idx, str_len, 0);
                idx = idx + 1;
                *cnt_ptr = idx;
                return str_pos + 1;
            }
            str_pos = str_pos + 1;
        }
        *cnt_ptr = idx;
        return src_len;
    }

    // 数値リテラル print(42)
    ulong num = cm_parse_number(src, print_pos, src_len);
    cm_emit(code_buf, idx, OP_PRINT_NUM, num);
    idx = idx + 1;
    *cnt_ptr = idx;
    return print_pos + 1;
}

/// ソースコード全体をスキャンしてprint()を探す
export ulong cm_compile_source(ulong src, ulong src_len, ulong code_buf) {
    ulong* cnt_ptr = CM_INSTR_COUNT as ulong*;
    ulong zero = 0;
    *cnt_ptr = zero;

    ulong pos = 0;
    ulong max_instrs = 14;  // HALTの分を残す

    while (pos + 5 < src_len) {
        ulong idx = *cnt_ptr;
        if (idx >= max_instrs) {
            pos = src_len;  // 命令数上限
        } else {
            // "print(" パターン検索
            ulong c0 = cmd_read_byte(src + pos);
            if (c0 == 0x70) {  // 'p'
                ulong c1 = cmd_read_byte(src + pos + 1);
                ulong c2 = cmd_read_byte(src + pos + 2);
                ulong c3 = cmd_read_byte(src + pos + 3);
                ulong c4 = cmd_read_byte(src + pos + 4);
                ulong c5 = cmd_read_byte(src + pos + 5);
                // r=0x72, i=0x69, n=0x6E, t=0x74, (=0x28
                if (c1 == 0x72) {
                    if (c2 == 0x69) {
                        if (c3 == 0x6E) {
                            if (c4 == 0x74) {
                                if (c5 == 0x28) {
                                    pos = cm_compile_print(src, pos + 6, src_len, code_buf);
                                } else { pos = pos + 1; }
                            } else { pos = pos + 1; }
                        } else { pos = pos + 1; }
                    } else { pos = pos + 1; }
                } else { pos = pos + 1; }
            } else {
                pos = pos + 1;
            }
        }
    }

    // HALT命令を追加
    ulong final_idx = *cnt_ptr;
    cm_emit(code_buf, final_idx, OP_HALT, 0);
    final_idx = final_idx + 1;
    *cnt_ptr = final_idx;

    return final_idx * INSTR_SIZE;
}

/// cmコマンド: .cmファイルをコンパイルしてa.outを生成
export void cmd_cm(ulong buf_addr, ulong buf_len, Heap* heap) {
    // 引数解析: "cm <filename>"
    ulong arg_start = cmd_find_arg(buf_addr, buf_len);
    ulong arg_len = cmd_arg_len(buf_addr, arg_start, buf_len);

    if (arg_len == 0) {
        shell_set_color(0x00FFAA00);
        shell_println("Usage: cm <file.cm>" as void*);
        return;
    }

    // ファイル名をバッファにコピー
    ulong name_buf = heap->alloc(arg_len + 1);
    if (name_buf == 0) { return; }
    cosmfs_op(CM_FS_MEMCPY, name_buf, buf_addr + arg_start, arg_len, 0);
    cmd_write_byte(name_buf + arg_len, 0);  // NUL終端

    // ソースファイルの検索
    ulong idx = cosmfs_op(CM_FS_FIND, name_buf, 0, 0, 0);
    if (idx == CM_NOT_FOUND) {
        shell_set_color(0x00FF4444);
        shell_println("Error: file not found" as void*);
        return;
    }

    // ソースファイルのサイズ取得と読み込み
    ulong src_size = cosmfs_op(CM_FS_SIZE, name_buf, 0, 0, 0);
    if (src_size == 0) {
        shell_set_color(0x00FF4444);
        shell_println("Error: empty source file" as void*);
        return;
    }
    ulong src_buf = heap->alloc(src_size + 1);
    if (src_buf == 0) { return; }
    cosmfs_op(CM_FS_READ, name_buf, src_buf, src_size, 0);

    // バイトコードバッファ（最大16命令 = 256バイト）
    ulong code_buf = heap->alloc(256);
    if (code_buf == 0) { return; }

    // コンパイル実行
    ulong code_size = cm_compile_source(src_buf, src_size, code_buf);

    // a.out をCosmFSに作成
    ulong aout_name = heap->alloc(6);
    if (aout_name == 0) { return; }
    cosmfs_op(CM_FS_MEMCPY, aout_name, "a.out" as ulong, 6, 0);

    // 既存のa.outがあれば削除
    ulong existing = cosmfs_op(CM_FS_FIND, aout_name, 0, 0, 0);
    if (existing != CM_NOT_FOUND) {
        cosmfs_op(CM_FS_DELETE, aout_name, 0, 0, 0);
    }

    // a.out作成+書き込み
    ulong aout_data = heap->alloc(4096);
    if (aout_data == 0) { return; }
    cosmfs_op(CM_FS_CREATE, aout_name, aout_data, 4096, 0);
    cosmfs_op(CM_FS_WRITE, aout_name, code_buf, code_size, 0);

    shell_set_color(0x0000FF88);
    shell_println("Compiled successfully -> a.out" as void*);
}

/// a.outコマンド: バイトコードVMで実行
export void cmd_run_aout(Heap* heap) {
    // a.outの検索
    ulong aout_name = heap->alloc(6);
    if (aout_name == 0) { return; }
    cosmfs_op(CM_FS_MEMCPY, aout_name, "a.out" as ulong, 6, 0);

    ulong idx = cosmfs_op(CM_FS_FIND, aout_name, 0, 0, 0);
    if (idx == CM_NOT_FOUND) {
        shell_set_color(0x00FF4444);
        shell_println("Error: a.out not found" as void*);
        return;
    }

    // バイトコード読み込み
    ulong code_size = cosmfs_op(CM_FS_SIZE, aout_name, 0, 0, 0);
    if (code_size == 0) { return; }
    ulong code_buf = heap->alloc(code_size);
    if (code_buf == 0) { return; }
    cosmfs_op(CM_FS_READ, aout_name, code_buf, code_size, 0);

    // VM実行
    shell_set_color(0x00FFFFFF);
    cm_vm_exec(code_buf, code_size);
}

/// バイトコードVM実行エンジン
export void cm_vm_exec(ulong code_buf, ulong code_size) {
    ulong pc = 0;
    ulong steps = 0;
    ulong max_steps = 1000;

    while (steps < max_steps) {
        ulong offset = pc * INSTR_SIZE;
        if (offset >= code_size) {
            return;
        }

        ulong* op_ptr = (code_buf + offset) as ulong*;
        ulong opcode = *op_ptr;
        ulong* arg_ptr = (code_buf + offset + 8) as ulong*;
        ulong operand = *arg_ptr;

        if (opcode == OP_HALT) {
            return;
        }

        if (opcode == OP_PRINT_NUM) {
            shell_print_num(operand);
            shell_newline();
            pc = pc + 1;
        }

        if (opcode == OP_PRINT_STR) {
            // 次の命令から文字列長を取得
            ulong len_off = (pc + 1) * INSTR_SIZE;
            ulong* len_ptr = (code_buf + len_off) as ulong*;
            ulong str_len = *len_ptr;
            // 1文字ずつ出力
            ulong si = 0;
            while (si < str_len) {
                ulong ch = cmd_read_byte(operand + si);
                shell_putc(ch);
                si = si + 1;
            }
            shell_newline();
            pc = pc + 2;  // 文字列命令は2命令消費
        }

        // 不明な命令はスキップ
        if (opcode != OP_HALT) {
            if (opcode != OP_PRINT_NUM) {
                if (opcode != OP_PRINT_STR) {
                    pc = pc + 1;
                }
            }
        }

        steps = steps + 1;
    }
}
