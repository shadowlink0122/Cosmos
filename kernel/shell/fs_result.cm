//! platform: uefi
// kernel::shell::fs_result - FsResult型エラーハンドリング
//
// UEFIベアメタル環境でのエラーハンドリング。
// struct FsResult を使用。
//
// 使用パターン:
//   FsResult r = fs_from_alloc(heap->alloc(64));
//   if (r.is_err != 0) { fs_print_error(r.error); return; }
//   ulong val = r.value;

import ../drivers/serial;
import ../lib/print;
import ../config;
import ./shell_io;

// ============================================================
// FsResult構造体
// ============================================================

/// 成功または失敗を表す構造体
export struct FsResult {
    ulong is_err;   // 0=成功, 非0=エラー
    ulong value;    // 成功時の値
    ulong error;    // エラーコード
}

// ============================================================
// エラーコード定数
// ============================================================

const ulong FS_ERR_NONE      = 0;   // エラーなし
const ulong FS_ERR_NOT_FOUND = 1;   // ファイル未発見
const ulong FS_ERR_ALLOC     = 2;   // メモリ割当失敗
const ulong FS_ERR_EMPTY     = 3;   // ファイルが空
const ulong FS_ERR_FULL      = 4;   // 容量不足
const ulong FS_ERR_EXISTS    = 5;   // 既に存在
const ulong FS_ERR_WRITE     = 6;   // 書込み失敗
const ulong FS_ERR_READ      = 7;   // 読込み失敗
const ulong FS_ERR_CREATE    = 8;   // ファイル作成失敗
const ulong FS_ERR_NULL      = 9;   // NULLデータ

// CosmFSのエラーセンチネル値
const ulong FS_SENTINEL = 0xFFFFFFFFFFFFFFFF;

// ============================================================
// FsResult生成ヘルパー
// ============================================================

/// 成功FsResultを生成
export FsResult fs_ok(ulong value) {
    return {is_err: 0, value: value, error: FS_ERR_NONE};
}

/// エラーFsResultを生成
export FsResult fs_err(ulong code) {
    return {is_err: 1, value: 0, error: code};
}

/// cosmfs_opの戻り値をFsResultに変換（0xFFF...=エラー）
export FsResult fs_from_op(ulong result) {
    if (result == FS_SENTINEL) {
        return fs_err(FS_ERR_NOT_FOUND);
    }
    return fs_ok(result);
}

/// cosmfs_opの戻り値をFsResultに変換（0もエラーとみなす版）
export FsResult fs_from_op_nz(ulong result) {
    if (result == FS_SENTINEL) {
        return fs_err(FS_ERR_NOT_FOUND);
    }
    if (result == 0) {
        return fs_err(FS_ERR_EMPTY);
    }
    return fs_ok(result);
}

/// heap->alloc()の結果をFsResultに変換
export FsResult fs_from_alloc(ulong addr) {
    if (addr == 0) {
        return fs_err(FS_ERR_ALLOC);
    }
    return fs_ok(addr);
}

/// CREATE操作の結果をFsResultに変換（0=成功、非0=エラー）
export FsResult fs_from_create(ulong result) {
    if (result == 0) {
        return fs_ok(0 as ulong);
    }
    if (result == 2) {
        return fs_err(FS_ERR_EXISTS);
    }
    return fs_err(FS_ERR_CREATE);
}

// ============================================================
// エラー表示
// ============================================================

/// エラーコードに応じたメッセージを表示
export void fs_print_error(ulong err_code) {
    shell_set_color(0x00FF4444);
    if (err_code == FS_ERR_NOT_FOUND) {
        shell_println("Error: file not found" as void*);
    }
    if (err_code == FS_ERR_ALLOC) {
        shell_println("Error: memory allocation failed" as void*);
    }
    if (err_code == FS_ERR_EMPTY) {
        shell_println("Error: file is empty" as void*);
    }
    if (err_code == FS_ERR_FULL) {
        shell_println("Error: file is full" as void*);
    }
    if (err_code == FS_ERR_EXISTS) {
        shell_println("Error: file already exists" as void*);
    }
    if (err_code == FS_ERR_WRITE) {
        shell_println("Error: write failed" as void*);
    }
    if (err_code == FS_ERR_READ) {
        shell_println("Error: read failed" as void*);
    }
    if (err_code == FS_ERR_CREATE) {
        shell_println("Error: failed to create file" as void*);
    }
    if (err_code == FS_ERR_NULL) {
        shell_println("Error: null data" as void*);
    }
}
