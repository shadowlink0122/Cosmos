//! platform: uefi
// kernel::shell::fs_result - FsResult型エラーハンドリング
//
// UEFIベアメタル環境でのエラーハンドリング。
// struct FsResult を使用。
//
// 使用パターン:
//   FsResult r = fs_from_alloc(heap->alloc(64));
//   if (r.is_err != 0) { fs_print_error(r.error); return; }
//   ulong val = r.value;

import ../drivers/serial;
import ../lib/print;
import ../types;
import ../config;
import ./shell_io;

// ============================================================
// FsResult構造体
// ============================================================

/// 成功または失敗を表す構造体
export struct FsResult {
    ulong is_err;      // 0=成功, 非0=エラー
    ulong value;       // 成功時の値
    FsError error;     // エラーコード
}

// ============================================================
// エラーコード定数
// ============================================================

const FsError FS_ERR_NONE      = 0;   // エラーなし
const FsError FS_ERR_NOT_FOUND = 1;   // ファイル未発見
const FsError FS_ERR_ALLOC     = 2;   // メモリ割当失敗
const FsError FS_ERR_EMPTY     = 3;   // ファイルが空
const FsError FS_ERR_FULL      = 4;   // 容量不足
const FsError FS_ERR_EXISTS    = 5;   // 既に存在
const FsError FS_ERR_WRITE     = 6;   // 書込み失敗
const FsError FS_ERR_READ      = 7;   // 読込み失敗
const FsError FS_ERR_CREATE    = 8;   // ファイル作成失敗
const FsError FS_ERR_NULL      = 9;   // NULLデータ

// CosmFSのエラーセンチネル値（types.cmのINVALID_VALUEを使用）
const ulong FS_SENTINEL = INVALID_VALUE;

// ============================================================
// FsResult メソッド実装
// ============================================================

impl FsResult {
    /// 成功FsResultを生成
    static FsResult ok(ulong value) {
        return {is_err: 0, value: value, error: FS_ERR_NONE};
    }

    /// エラーFsResultを生成
    static FsResult err(ulong code) {
        return {is_err: 1, value: 0, error: code};
    }

    /// cosmfs_opの戻り値をFsResultに変換（0xFFF...=エラー）
    static FsResult from_op(ulong result) {
        if (result == FS_SENTINEL) {
            return FsResult::err(FS_ERR_NOT_FOUND);
        }
        return FsResult::ok(result);
    }

    /// cosmfs_opの戻り値をFsResultに変換（0もエラーとみなす版）
    static FsResult from_op_nz(ulong result) {
        if (result == FS_SENTINEL) {
            return FsResult::err(FS_ERR_NOT_FOUND);
        }
        if (result == 0) {
            return FsResult::err(FS_ERR_EMPTY);
        }
        return FsResult::ok(result);
    }

    /// heap->alloc()の結果をFsResultに変換
    static FsResult from_alloc(ulong addr) {
        if (addr == 0) {
            return FsResult::err(FS_ERR_ALLOC);
        }
        return FsResult::ok(addr);
    }

    /// CREATE操作の結果をFsResultに変換（0=成功、非0=エラー）
    static FsResult from_create(ulong result) {
        if (result == 0) {
            return FsResult::ok(0 as ulong);
        }
        if (result == 2) {
            return FsResult::err(FS_ERR_EXISTS);
        }
        return FsResult::err(FS_ERR_CREATE);
    }

    /// エラーコードに応じたメッセージを表示
    void print_error() {
        shell_set_color(0x00FF4444);
        switch (self.error) {
            case(1) { shell_println("Error: file not found" as void*); }
            case(2) { shell_println("Error: memory allocation failed" as void*); }
            case(3) { shell_println("Error: file is empty" as void*); }
            case(4) { shell_println("Error: file is full" as void*); }
            case(5) { shell_println("Error: file already exists" as void*); }
            case(6) { shell_println("Error: write failed" as void*); }
            case(7) { shell_println("Error: read failed" as void*); }
            case(8) { shell_println("Error: failed to create file" as void*); }
            case(9) { shell_println("Error: null data" as void*); }
        }
    }
}

