//! platform: uefi
// kernel::shell::shell_io - シェル出力ヘルパー
//
// serial + FBConsole への重複出力を統合するユーティリティ。
// 各シェルコマンドは serial.puts() + con.puts() の2行を
// shell_puts() の1行に置換できる。
//
// 使用例:
//   shell_println("Available commands:" as void*);
//   shell_puts("  Total: " as void*);
//   shell_print_hex(value);
//   shell_newline();

import ../drivers/serial;
import ../lib/print;
import ../config;

// ============================================================
// 統合出力関数
// ============================================================

/// serial + FBConsole にメッセージを同時出力（改行付き）
export void shell_println(void* msg) {
    SerialPort serial = {port: 0x3F8};
    FBConsole con = {addr: GLOBAL_FB_CONSOLE_ADDR};
    serial.println(msg);
    con.println(msg);
}

/// serial + FBConsole にメッセージを同時出力（改行なし）
export void shell_puts(void* msg) {
    SerialPort serial = {port: 0x3F8};
    FBConsole con = {addr: GLOBAL_FB_CONSOLE_ADDR};
    serial.puts(msg);
    con.puts(msg);
}

/// serial + FBConsole に16進数値を同時出力
export void shell_print_hex(ulong value) {
    SerialPort serial = {port: 0x3F8};
    FBConsole con = {addr: GLOBAL_FB_CONSOLE_ADDR};
    serial.print_hex(value);
    con.print_hex(value);
}

/// serial + FBConsole に改行を出力
export void shell_newline() {
    SerialPort serial = {port: 0x3F8};
    FBConsole con = {addr: GLOBAL_FB_CONSOLE_ADDR};
    serial.println("" as void*);
    con.newline();
}

/// serial + FBConsole に1文字出力
export void shell_putc(AsciiChar ch) {
    SerialPort serial = {port: 0x3F8};
    FBConsole con = {addr: GLOBAL_FB_CONSOLE_ADDR};
    serial.putc(ch);
    con.putc(ch);
}

/// FBConsole の色を設定
export void shell_set_color(Color color) {
    FBConsole con = {addr: GLOBAL_FB_CONSOLE_ADDR};
    con.set_color(color);
}

/// FBConsole の画面をクリアしカーソルをリセット
export void shell_clear() {
    FBConsole con = {addr: GLOBAL_FB_CONSOLE_ADDR};
    con.clear();
}

/// FBConsole のカーソル位置を設定（文字単位）
export void shell_set_cursor(ulong x, ulong y) {
    FBConsole con = {addr: GLOBAL_FB_CONSOLE_ADDR};
    ulong* px = (con.addr + 0x20) as ulong*;  // FB_OFF_CURSOR_X
    *px = x;
    ulong* py = (con.addr + 0x28) as ulong*;  // FB_OFF_CURSOR_Y
    *py = y;
}

/// FBConsole の最大行数を返す
export ulong shell_get_rows() {
    FBConsole con = {addr: GLOBAL_FB_CONSOLE_ADDR};
    return con.max_rows();
}

/// FBConsole の最大列数を返す
export ulong shell_get_cols() {
    FBConsole con = {addr: GLOBAL_FB_CONSOLE_ADDR};
    return con.max_cols();
}

/// serial + FBConsole に10進数値を出力
/// 一時バッファとして0xCF0-0xCFF（16バイト）を使用
export void shell_print_num(ulong value) {
    if (value == 0) {
        shell_putc(0x30);  // '0'
        return;
    }
    // 0xCF0を一時バッファとして使用（最大20桁だが10桁で十分）
    MemAddr tmp_buf = 0xCF0;
    ulong cnt = 0;
    ulong n = value;

    // 桁を逆順でバッファに格納
    while (n > 0) {
        ulong rem = n - ((n / 10) * 10);  // n % 10
        MemAddr addr = tmp_buf + cnt;
        __asm__(`
            movq ${r:addr}, %rdi;
            movq ${r:rem}, %rax;
            addb $$0x30, %al;
            movb %al, (%rdi)
        `);
        n = n / 10;
        cnt = cnt + 1;
    }

    // 逆順で出力
    ulong i = cnt;
    while (i > 0) {
        i = i - 1;
        MemAddr raddr = tmp_buf + i;
        AsciiChar ch = 0;
        __asm__(`
            movq ${r:raddr}, %rdi;
            xorq %rax, %rax;
            movb (%rdi), %al;
            movq %rax, ${=r:ch}
        `);
        shell_putc(ch);
    }
}
