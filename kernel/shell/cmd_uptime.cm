//! platform: uefi
// kernel::shell::cmd_uptime - uptimeコマンド（システム稼働時間表示）

import ../drivers/serial;
import ../lib/print;

// グローバルFBConsoleアドレス
const ulong SHELL_COLOR_OUTPUT = 0x0000FF00;

/// uptimeコマンド: システム稼働時間表示
export void cmd_uptime() {
    SerialPort serial(0x3F8);
    FBConsole* con = fb_get_global_console();

    ulong* tick_ptr = 0x900 as ulong*;
    ulong ticks = *tick_ptr;
    ulong seconds = ticks / 100;

    serial.puts("Uptime: " as void*);
    serial.print_hex(seconds);
    serial.puts(" seconds (" as void*);
    serial.print_hex(ticks);
    serial.println(" ticks)" as void*);

    fb_set_color(con, SHELL_COLOR_OUTPUT);
    fb_puts(con, "Uptime: " as void*);
    fb_print_hex(con, seconds);
    fb_puts(con, " seconds (" as void*);
    fb_print_hex(con, ticks);
    fb_println(con, " ticks)" as void*);
}
