//! platform: uefi
// kernel::shell::cmd_fs - ファイルシステムコマンド
//
// シェルから使用するCosmFSファイル操作コマンド群。
// cosmfs_op()のディスパッチパターンを使用。
//
// 対応コマンド:
//   ls              — ファイル一覧表示
//   touch <name>    — 空ファイル作成
//   cat <name>      — ファイル内容表示
//   rm <name>       — ファイル削除
//   write <name> <data> — ファイルに文字列書き込み（上書き）
//   append <name> <data> — ファイル末尾に追記

import ./shell_io;
import ./fs_result;
import ../config;
import ../fs/cosmfs;
import ../mm/heap;

// ============================================================
// CosmFS操作コード（cosmfs.cmと一致させる）
// ============================================================

const ulong FS_OP_CREATE    = 1;
const ulong FS_OP_WRITE     = 2;
const ulong FS_OP_SIZE      = 3;
const ulong FS_OP_DELETE    = 4;
const ulong FS_OP_FIND      = 5;
const ulong FS_OP_GET_DATA  = 6;
const ulong FS_OP_COUNT     = 7;
const ulong FS_OP_ENTRY_RD  = 8;
const ulong FS_OP_STRLEN    = 9;
const ulong FS_OP_MEMCPY    = 10;
const ulong FS_OP_APPEND    = 11;

// ============================================================
// 引数解析ヘルパー
// ============================================================

/// 1バイト読み取り
export ulong cmd_read_byte(ulong addr) {
    ulong result = 0;
    __asm__(`
        movq ${r:addr}, %rdi;
        xorq %rax, %rax;
        movb (%rdi), %al;
        movq %rax, ${=r:result}
    `);
    return result;
}

/// 1バイト書き込み
export void cmd_write_byte(ulong addr, ulong val) {
    __asm__(`
        movq ${r:addr}, %rdi;
        movq ${r:val}, %rax;
        movb %al, (%rdi)
    `);
}

/// コマンドバッファから最初のスペース以降の引数の開始位置を返す
export ulong cmd_find_arg(ulong buf_addr, ulong buf_len) {
    ulong i = 0;
    while (i < buf_len) {
        ulong ch = cmd_read_byte(buf_addr + i);
        if (ch == 0x20) {
            i = i + 1;
            return i;
        }
        i = i + 1;
    }
    return buf_len;
}

/// 引数の長さを返す
export ulong cmd_arg_len(ulong buf_addr, ulong arg_start, ulong buf_len) {
    ulong len = 0;
    ulong i = arg_start;
    while (i < buf_len) {
        ulong ch = cmd_read_byte(buf_addr + i);
        if (ch == 0x20) {
            return len;
        }
        len = len + 1;
        i = i + 1;
    }
    return len;
}

// ============================================================
// ls コマンド
// ============================================================

export void cmd_ls() {
    shell_set_color(SHELL_COLOR_HEADER);
    shell_println("Files:" as void*);

    ulong count = cosmfs_op(FS_OP_COUNT, 0, 0, 0, 0);
    if (count == 0) {
        shell_set_color(SHELL_COLOR_OUTPUT);
        shell_println("  (empty)" as void*);
        return;
    }

    shell_set_color(SHELL_COLOR_OUTPUT);
    ulong i = 0;
    while (i < count) {
        ulong name_addr = cosmfs_op(FS_OP_ENTRY_RD, i, 0, 0, 0);
        ulong file_size = cosmfs_op(FS_OP_ENTRY_RD, i, 16, 0, 0);
        if (name_addr != 0) {
            shell_puts("  " as void*);
            shell_puts(name_addr as void*);
            shell_puts("  (" as void*);
            shell_print_hex(file_size);
            shell_puts(" bytes)" as void*);
            shell_newline();
        }
        i = i + 1;
    }
}

// ============================================================
// touch コマンド
// ============================================================

export void cmd_touch(ulong buf_addr, ulong buf_len, Heap* heap) {
    ulong arg_start = cmd_find_arg(buf_addr, buf_len);
    if (arg_start >= buf_len) {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_println("Usage: touch <filename>" as void*);
        return;
    }

    ulong arg_len = cmd_arg_len(buf_addr, arg_start, buf_len);
    ulong name_src = buf_addr + arg_start;
    cmd_write_byte(name_src + arg_len, 0);  // NUL終端

    // ファイル名バッファ確保（ヒープ）
    ulong name_size = arg_len + 1;
    FsResult r_name = fs_from_alloc(heap->alloc(name_size));
    if (r_name.ok == 0) {
        fs_print_error(r_name.error);
        return;
    }
    ulong name_buf = r_name.value;
    // ファイル名コピー
    cosmfs_op(FS_OP_MEMCPY, name_buf, name_src, arg_len, 0);
    cmd_write_byte(name_buf + arg_len, 0);  // NUL終端

    // データバッファ確保（4096バイト = 4KB）
    FsResult r_data = fs_from_alloc(heap->alloc(4096));
    if (r_data.ok == 0) {
        fs_print_error(r_data.error);
        return;
    }

    FsResult r_create = fs_from_create(cosmfs_op(FS_OP_CREATE, name_buf, r_data.value, 4096, 0));
    if (r_create.ok == 0) {
        fs_print_error(r_create.error);
        return;
    }

    shell_set_color(SHELL_COLOR_OUTPUT);
    shell_puts("Created: " as void*);
    shell_puts(name_buf as void*);
    shell_newline();
}

// ============================================================
// cat コマンド
// ============================================================

export void cmd_cat(ulong buf_addr, ulong buf_len) {
    ulong arg_start = cmd_find_arg(buf_addr, buf_len);
    if (arg_start >= buf_len) {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_println("Usage: cat <filename>" as void*);
        return;
    }

    ulong arg_len = cmd_arg_len(buf_addr, arg_start, buf_len);
    ulong name_addr = buf_addr + arg_start;
    cmd_write_byte(name_addr + arg_len, 0);

    FsResult r_size = fs_from_op(cosmfs_op(FS_OP_SIZE, name_addr, 0, 0, 0));
    if (r_size.ok == 0) {
        fs_print_error(r_size.error);
        return;
    }
    ulong fsize = r_size.value;

    if (fsize == 0) {
        shell_set_color(SHELL_COLOR_OUTPUT);
        shell_println("(empty file)" as void*);
        return;
    }

    FsResult r_data = fs_from_op_nz(cosmfs_op(FS_OP_GET_DATA, name_addr, 0, 0, 0));
    if (r_data.ok == 0) {
        fs_print_error(r_data.error);
        return;
    }

    shell_set_color(SHELL_COLOR_OUTPUT);
    ulong i = 0;
    while (i < fsize) {
        ulong ch = cmd_read_byte(r_data.value + i);
        shell_putc(ch);
        i = i + 1;
    }
    shell_newline();
}

// ============================================================
// rm コマンド
// ============================================================

export void cmd_rm(ulong buf_addr, ulong buf_len) {
    ulong arg_start = cmd_find_arg(buf_addr, buf_len);
    if (arg_start >= buf_len) {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_println("Usage: rm <filename>" as void*);
        return;
    }

    ulong arg_len = cmd_arg_len(buf_addr, arg_start, buf_len);
    ulong name_addr = buf_addr + arg_start;
    cmd_write_byte(name_addr + arg_len, 0);

    ulong result = cosmfs_op(FS_OP_DELETE, name_addr, 0, 0, 0);
    if (result == 0) {
        shell_set_color(SHELL_COLOR_OUTPUT);
        shell_puts("Deleted: " as void*);
        shell_puts(name_addr as void*);
        shell_newline();
    } else {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_puts("File not found: " as void*);
        shell_puts(name_addr as void*);
        shell_newline();
    }
}

// ============================================================
// write コマンド
// ============================================================

export void cmd_write(ulong buf_addr, ulong buf_len, Heap* heap) {
    ulong arg_start = cmd_find_arg(buf_addr, buf_len);
    if (arg_start >= buf_len) {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_println("Usage: write <filename> <data>" as void*);
        return;
    }

    ulong name_len = cmd_arg_len(buf_addr, arg_start, buf_len);
    ulong name_addr = buf_addr + arg_start;
    ulong data_start = arg_start + name_len;

    if (data_start < buf_len) {
        ulong ch = cmd_read_byte(buf_addr + data_start);
        if (ch == 0x20) {
            data_start = data_start + 1;
        }
    }

    if (data_start >= buf_len) {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_println("Usage: write <filename> <data>" as void*);
        return;
    }

    cmd_write_byte(name_addr + name_len, 0);  // NUL終端

    // ファイルが存在しなければ作成
    FsResult r_check = fs_from_op(cosmfs_op(FS_OP_SIZE, name_addr, 0, 0, 0));
    if (r_check.ok == 0) {
        // 新規作成: ファイル名コピー
        ulong ns = name_len + 1;
        FsResult r_nb = fs_from_alloc(heap->alloc(ns));
        if (r_nb.ok == 0) { fs_print_error(r_nb.error); return; }
        ulong nb = r_nb.value;
        cosmfs_op(FS_OP_MEMCPY, nb, name_addr, name_len, 0);
        cmd_write_byte(nb + name_len, 0);
        FsResult r_db = fs_from_alloc(heap->alloc(4096));
        if (r_db.ok == 0) { fs_print_error(r_db.error); return; }
        FsResult r_cr = fs_from_create(cosmfs_op(FS_OP_CREATE, nb, r_db.value, 4096, 0));
        if (r_cr.ok == 0) { fs_print_error(r_cr.error); return; }
    }

    ulong data_addr = buf_addr + data_start;
    ulong data_len = buf_len - data_start;
    FsResult r_write = fs_from_op(cosmfs_op(FS_OP_WRITE, name_addr, data_addr, data_len, 0));

    if (r_write.ok == 0) {
        fs_print_error(r_write.error);
    } else if (r_write.value > 0) {
        shell_set_color(SHELL_COLOR_OUTPUT);
        shell_puts("Wrote " as void*);
        shell_print_hex(r_write.value);
        shell_puts(" bytes to " as void*);
        shell_puts(name_addr as void*);
        shell_newline();
    } else {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_println("Error: write failed (0 bytes)" as void*);
    }
}

// ============================================================
// append コマンド
// ============================================================

export void cmd_append(ulong buf_addr, ulong buf_len, Heap* heap) {
    ulong arg_start = cmd_find_arg(buf_addr, buf_len);
    if (arg_start >= buf_len) {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_println("Usage: append <filename> <data>" as void*);
        return;
    }

    ulong name_len = cmd_arg_len(buf_addr, arg_start, buf_len);
    ulong name_addr = buf_addr + arg_start;
    ulong data_start = arg_start + name_len;

    if (data_start < buf_len) {
        ulong ch = cmd_read_byte(buf_addr + data_start);
        if (ch == 0x20) {
            data_start = data_start + 1;
        }
    }

    if (data_start >= buf_len) {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_println("Usage: append <filename> <data>" as void*);
        return;
    }

    cmd_write_byte(name_addr + name_len, 0);  // NUL終端

    // ファイルが存在しなければ作成
    FsResult r_check = fs_from_op(cosmfs_op(FS_OP_SIZE, name_addr, 0, 0, 0));
    if (r_check.ok == 0) {
        ulong ns = name_len + 1;
        FsResult r_nb = fs_from_alloc(heap->alloc(ns));
        if (r_nb.ok == 0) { fs_print_error(r_nb.error); return; }
        ulong nb = r_nb.value;
        cosmfs_op(FS_OP_MEMCPY, nb, name_addr, name_len, 0);
        cmd_write_byte(nb + name_len, 0);
        FsResult r_db = fs_from_alloc(heap->alloc(4096));
        if (r_db.ok == 0) { fs_print_error(r_db.error); return; }
        FsResult r_cr = fs_from_create(cosmfs_op(FS_OP_CREATE, nb, r_db.value, 4096, 0));
        if (r_cr.ok == 0) { fs_print_error(r_cr.error); return; }
    }

    ulong data_addr = buf_addr + data_start;
    ulong data_len = buf_len - data_start;
    FsResult r_append = fs_from_op(cosmfs_op(FS_OP_APPEND, name_addr, data_addr, data_len, 0));

    if (r_append.ok == 0) {
        fs_print_error(r_append.error);
    } else if (r_append.value > 0) {
        shell_set_color(SHELL_COLOR_OUTPUT);
        shell_puts("Appended " as void*);
        shell_print_hex(r_append.value);
        shell_puts(" bytes to " as void*);
        shell_puts(name_addr as void*);
        shell_newline();
    } else {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_println("Error: append failed (file full)" as void*);
    }
}

// ============================================================
// mkdir コマンド（ディレクトリマーカー作成）
// ============================================================

export void cmd_mkdir(ulong buf_addr, ulong buf_len, Heap* heap) {
    ulong arg_start = cmd_find_arg(buf_addr, buf_len);
    if (arg_start >= buf_len) {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_println("Usage: mkdir <dirname>" as void*);
        return;
    }

    ulong arg_len = cmd_arg_len(buf_addr, arg_start, buf_len);
    ulong name_addr = buf_addr + arg_start;
    cmd_write_byte(name_addr + arg_len, 0);  // NUL終端

    // 既存チェック
    FsResult r_find = fs_from_op(cosmfs_op(FS_OP_FIND, name_addr, 0, 0, 0));
    if (r_find.ok != 0) {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_puts("Already exists: " as void*);
        shell_puts(name_addr as void*);
        shell_newline();
        return;
    }

    // 空ファイルとして作成（ディレクトリマーカー）
    FsResult r_db = fs_from_alloc(heap->alloc(64));
    if (r_db.ok == 0) { fs_print_error(r_db.error); return; }

    // NUL終端のバッファ名をコピー
    FsResult r_nb = fs_from_alloc(heap->alloc(64));
    if (r_nb.ok == 0) { fs_print_error(r_nb.error); return; }
    cosmfs_op(FS_OP_MEMCPY, r_nb.value, name_addr, arg_len + 1, 0);

    FsResult r_create = fs_from_create(cosmfs_op(FS_OP_CREATE, r_nb.value, r_db.value, 64, 0));
    if (r_create.ok == 0) {
        fs_print_error(r_create.error);
        return;
    }

    shell_set_color(SHELL_COLOR_OUTPUT);
    shell_puts("Created: " as void*);
    shell_puts(name_addr as void*);
    shell_newline();
}

// ============================================================
// cp コマンド（ファイルコピー）
// ============================================================

export void cmd_cp(ulong buf_addr, ulong buf_len, Heap* heap) {
    // "cp src dst" — 引数を2つ解析
    ulong arg1_start = cmd_find_arg(buf_addr, buf_len);
    if (arg1_start >= buf_len) {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_println("Usage: cp <src> <dst>" as void*);
        return;
    }
    ulong arg1_len = cmd_arg_len(buf_addr, arg1_start, buf_len);
    ulong src_addr = buf_addr + arg1_start;

    // 2番目の引数
    ulong arg2_start = arg1_start + arg1_len;
    // スペースをスキップ
    ulong sk = arg2_start;
    while (sk < buf_len) {
        ulong sch = cmd_read_byte(buf_addr + sk);
        if (sch != 0x20) {
            arg2_start = sk;
            sk = buf_len;  // break
        } else {
            sk = sk + 1;
        }
    }
    if (arg2_start >= buf_len) {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_println("Usage: cp <src> <dst>" as void*);
        return;
    }
    ulong arg2_len = cmd_arg_len(buf_addr, arg2_start, buf_len);
    ulong dst_addr = buf_addr + arg2_start;

    // NUL終端
    cmd_write_byte(src_addr + arg1_len, 0);
    cmd_write_byte(dst_addr + arg2_len, 0);

    // ソースファイル確認
    FsResult r_size = fs_from_op(cosmfs_op(FS_OP_SIZE, src_addr, 0, 0, 0));
    if (r_size.ok == 0) {
        fs_print_error(r_size.error);
        return;
    }
    ulong src_size = r_size.value;

    // コピー先に新ファイル作成
    FsResult r_dst = fs_from_op(cosmfs_op(FS_OP_FIND, dst_addr, 0, 0, 0));
    if (r_dst.ok == 0) {
        // 新規作成
        FsResult r_db = fs_from_alloc(heap->alloc(4096));
        if (r_db.ok == 0) { fs_print_error(r_db.error); return; }
        FsResult r_nb = fs_from_alloc(heap->alloc(64));
        if (r_nb.ok == 0) { fs_print_error(r_nb.error); return; }
        cosmfs_op(FS_OP_MEMCPY, r_nb.value, dst_addr, arg2_len + 1, 0);
        FsResult r_cr = fs_from_create(cosmfs_op(FS_OP_CREATE, r_nb.value, r_db.value, 4096, 0));
        if (r_cr.ok == 0) { fs_print_error(r_cr.error); return; }
    }

    // ソースデータ取得+コピー先に書き込み
    FsResult r_data = fs_from_op_nz(cosmfs_op(FS_OP_GET_DATA, src_addr, 0, 0, 0));
    if (r_data.ok == 0) { fs_print_error(r_data.error); return; }

    FsResult r_write = fs_from_op(cosmfs_op(FS_OP_WRITE, dst_addr, r_data.value, src_size, 0));
    if (r_write.ok == 0) {
        fs_print_error(r_write.error);
    } else if (r_write.value > 0) {
        shell_set_color(SHELL_COLOR_OUTPUT);
        shell_puts("Copied " as void*);
        shell_puts(src_addr as void*);
        shell_puts(" -> " as void*);
        shell_puts(dst_addr as void*);
        shell_puts(" (" as void*);
        shell_print_hex(r_write.value);
        shell_puts(" bytes)" as void*);
        shell_newline();
    } else {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_println("Error: copy failed (0 bytes written)" as void*);
    }
}

// ============================================================
// mv コマンド（ファイル移動）
// ============================================================

export void cmd_mv(ulong buf_addr, ulong buf_len, Heap* heap) {
    // "mv src dst" — 引数を2つ解析
    ulong arg1_start = cmd_find_arg(buf_addr, buf_len);
    if (arg1_start >= buf_len) {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_println("Usage: mv <src> <dst>" as void*);
        return;
    }
    ulong arg1_len = cmd_arg_len(buf_addr, arg1_start, buf_len);
    ulong src_addr = buf_addr + arg1_start;

    // 2番目の引数
    ulong arg2_start = arg1_start + arg1_len;
    ulong sk = arg2_start;
    while (sk < buf_len) {
        ulong sch = cmd_read_byte(buf_addr + sk);
        if (sch != 0x20) {
            arg2_start = sk;
            sk = buf_len;  // break
        } else {
            sk = sk + 1;
        }
    }
    if (arg2_start >= buf_len) {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_println("Usage: mv <src> <dst>" as void*);
        return;
    }
    ulong arg2_len = cmd_arg_len(buf_addr, arg2_start, buf_len);
    ulong dst_addr = buf_addr + arg2_start;

    // NUL終端
    cmd_write_byte(src_addr + arg1_len, 0);
    cmd_write_byte(dst_addr + arg2_len, 0);

    // ソースファイル確認
    FsResult r_size = fs_from_op(cosmfs_op(FS_OP_SIZE, src_addr, 0, 0, 0));
    if (r_size.ok == 0) {
        fs_print_error(r_size.error);
        return;
    }
    ulong src_size = r_size.value;

    // コピー先に新ファイル作成
    FsResult r_dst = fs_from_op(cosmfs_op(FS_OP_FIND, dst_addr, 0, 0, 0));
    if (r_dst.ok == 0) {
        FsResult r_db = fs_from_alloc(heap->alloc(4096));
        if (r_db.ok == 0) { fs_print_error(r_db.error); return; }
        FsResult r_nb = fs_from_alloc(heap->alloc(64));
        if (r_nb.ok == 0) { fs_print_error(r_nb.error); return; }
        cosmfs_op(FS_OP_MEMCPY, r_nb.value, dst_addr, arg2_len + 1, 0);
        FsResult r_cr = fs_from_create(cosmfs_op(FS_OP_CREATE, r_nb.value, r_db.value, 4096, 0));
        if (r_cr.ok == 0) { fs_print_error(r_cr.error); return; }
    }

    // ソースデータ取得+コピー先に書き込み
    FsResult r_data = fs_from_op_nz(cosmfs_op(FS_OP_GET_DATA, src_addr, 0, 0, 0));
    if (r_data.ok == 0) { fs_print_error(r_data.error); return; }

    FsResult r_write = fs_from_op(cosmfs_op(FS_OP_WRITE, dst_addr, r_data.value, src_size, 0));
    if (r_write.ok == 0) {
        fs_print_error(r_write.error);
    } else if (r_write.value > 0) {
        cosmfs_op(FS_OP_DELETE, src_addr, 0, 0, 0);
        shell_set_color(SHELL_COLOR_OUTPUT);
        shell_puts("Moved " as void*);
        shell_puts(src_addr as void*);
        shell_puts(" -> " as void*);
        shell_puts(dst_addr as void*);
        shell_newline();
    } else {
        shell_set_color(SHELL_COLOR_ERROR);
        shell_println("Error: move failed (0 bytes written)" as void*);
    }
}
