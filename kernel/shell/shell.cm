//! platform: uefi
// kernel::shell - カーネルシェル（メインループ）
//
// PS/2キーボードからの入力を受け取り、コマンドを解釈・実行する。
// serial + FBConsole のデュアル出力対応。
//
// コマンド実装は個別ファイルに分割:
//   cmd_help.cm, cmd_ps.cm, cmd_mem.cm, cmd_uptime.cm

import ../drivers/serial;
import ../drivers/debug_port;
import ../drivers/keyboard;
import ../lib/print;
import ../config;
import ./cmd_help;
import ./cmd_ps;
import ./cmd_mem;
import ./cmd_uptime;
import ./cmd_fs;
import ../mm/heap;
import ../apps/aria/aria;

// ============================================================
// 定数
// ============================================================

// コマンドバッファ
const ulong SHELL_BUF_ADDR = 0xD00;  // コマンドバッファ（128バイト）
const ulong SHELL_BUF_SIZE = 128;
const ulong SHELL_POS_ADDR = 0xD80;  // バッファ位置

// ============================================================
// 文字列比較ヘルパー
// ============================================================

/// 2つの文字列を比較する（固定アドレスの文字列 vs リテラル）
/// 一致すれば1、不一致なら0を返す
export ulong shell_streq(ulong buf_addr, ulong buf_len, void* target) {
    ulong target_addr = target as ulong;

    // ターゲット文字列の長さを計算
    ulong target_len = 0;
    ulong zero_byte = 0;
    while (true) {
        ulong ch = 0;
        ulong check_addr = target_addr + target_len;
        __asm__(`
            movq ${r:check_addr}, %rdi;
            xorq %rax, %rax;
            movb (%rdi), %al;
            movq %rax, ${=r:ch}
        `);
        if (ch == zero_byte) {
            break;
        }
        target_len = target_len + 1;
    }

    if (buf_len != target_len) {
        return 0;
    }

    ulong i = 0;
    while (i < buf_len) {
        ulong ch_buf = 0;
        ulong buf_byte_addr = buf_addr + i;
        __asm__(`
            movq ${r:buf_byte_addr}, %rdi;
            xorq %rax, %rax;
            movb (%rdi), %al;
            movq %rax, ${=r:ch_buf}
        `);

        ulong ch_target = 0;
        ulong target_byte_addr = target_addr + i;
        __asm__(`
            movq ${r:target_byte_addr}, %rdi;
            xorq %rax, %rax;
            movb (%rdi), %al;
            movq %rax, ${=r:ch_target}
        `);

        if (ch_buf != ch_target) {
            return 0;
        }
        i = i + 1;
    }

    return 1;
}

/// コマンドバッファが指定プレフィックスで始まるか判定
/// 一致すれば1、不一致なら0を返す
export ulong shell_starts_with(ulong buf_addr, ulong buf_len, void* prefix, ulong prefix_len) {
    if (buf_len < prefix_len) {
        return 0;
    }

    ulong prefix_addr = prefix as ulong;
    ulong i = 0;
    while (i < prefix_len) {
        ulong ch_buf = 0;
        ulong buf_byte_addr = buf_addr + i;
        __asm__(`
            movq ${r:buf_byte_addr}, %rdi;
            xorq %rax, %rax;
            movb (%rdi), %al;
            movq %rax, ${=r:ch_buf}
        `);

        ulong ch_prefix = 0;
        ulong prefix_byte_addr = prefix_addr + i;
        __asm__(`
            movq ${r:prefix_byte_addr}, %rdi;
            xorq %rax, %rax;
            movb (%rdi), %al;
            movq %rax, ${=r:ch_prefix}
        `);

        if (ch_buf != ch_prefix) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// ============================================================
// コマンド実行
// ============================================================

/// コマンドバッファにバイトを書込む
export void shell_buf_write(ulong pos, ulong byte_val) {
    ulong addr = SHELL_BUF_ADDR + pos;
    __asm__(`
        movq ${r:addr}, %rdi;
        movq ${r:byte_val}, %rax;
        movb %al, (%rdi)
    `);
}

/// コマンドを実行する
export void shell_exec(ulong buf_addr, ulong buf_len) {
    SerialPort serial(0x3F8);
    DebugPort debug(0xE9);
    FBConsole con();

    if (buf_len == 0) {
        return;
    }

    debug.puts("[SHELL] cmd len=" as void*);
    debug.print_hex(buf_len);
    debug.println("" as void*);

    ulong matched = 0;

    if (shell_streq(buf_addr, buf_len, "help" as void*) != 0) {
        cmd_help();
        matched = 1;
    }
    if (shell_streq(buf_addr, buf_len, "ps" as void*) != 0) {
        cmd_ps();
        matched = 1;
    }
    if (shell_streq(buf_addr, buf_len, "mem" as void*) != 0) {
        cmd_mem();
        matched = 1;
    }
    if (shell_streq(buf_addr, buf_len, "uptime" as void*) != 0) {
        cmd_uptime();
        matched = 1;
    }
    if (shell_streq(buf_addr, buf_len, "clear" as void*) != 0) {
        serial.puts("\x1B[2J\x1B[H" as void*);
        con.clear();
        con.set_color(0x00FFFFFF);
        con.println("  CosmOS v0.6.0" as void*);
        con.newline();
        matched = 1;
    }

    // --- ファイルシステムコマンド ---

    if (shell_streq(buf_addr, buf_len, "ls" as void*) != 0) {
        cmd_ls();
        matched = 1;
    }

    ulong is_touch = shell_starts_with(buf_addr, buf_len, "touch " as void*, 6);
    if (is_touch != 0) {
        ulong* heap_ptr = ADDR_GLOBAL_HEAP as ulong*;
        ulong heap_addr = *heap_ptr;
        Heap* heap = heap_addr as Heap*;
        cmd_touch(buf_addr, buf_len, heap);
        matched = 1;
    }

    ulong is_cat = shell_starts_with(buf_addr, buf_len, "cat " as void*, 4);
    if (is_cat != 0) {
        cmd_cat(buf_addr, buf_len);
        matched = 1;
    }

    ulong is_rm = shell_starts_with(buf_addr, buf_len, "rm " as void*, 3);
    if (is_rm != 0) {
        cmd_rm(buf_addr, buf_len);
        matched = 1;
    }

    ulong is_write = shell_starts_with(buf_addr, buf_len, "write " as void*, 6);
    if (is_write != 0) {
        ulong* heap_ptr2 = ADDR_GLOBAL_HEAP as ulong*;
        ulong heap_addr2 = *heap_ptr2;
        Heap* heap2 = heap_addr2 as Heap*;
        cmd_write(buf_addr, buf_len, heap2);
        matched = 1;
    }

    ulong is_append = shell_starts_with(buf_addr, buf_len, "append " as void*, 7);
    if (is_append != 0) {
        ulong* heap_ptr3 = ADDR_GLOBAL_HEAP as ulong*;
        ulong heap_addr3 = *heap_ptr3;
        Heap* heap3 = heap_addr3 as Heap*;
        cmd_append(buf_addr, buf_len, heap3);
        matched = 1;
    }

    ulong is_mkdir = shell_starts_with(buf_addr, buf_len, "mkdir " as void*, 6);
    if (is_mkdir != 0) {
        ulong* heap_ptr4 = ADDR_GLOBAL_HEAP as ulong*;
        ulong heap_addr4 = *heap_ptr4;
        Heap* heap4 = heap_addr4 as Heap*;
        cmd_mkdir(buf_addr, buf_len, heap4);
        matched = 1;
    }

    ulong is_cp = shell_starts_with(buf_addr, buf_len, "cp " as void*, 3);
    if (is_cp != 0) {
        ulong* heap_ptr5 = ADDR_GLOBAL_HEAP as ulong*;
        ulong heap_addr5 = *heap_ptr5;
        Heap* heap5 = heap_addr5 as Heap*;
        cmd_cp(buf_addr, buf_len, heap5);
        matched = 1;
    }

    ulong is_mv = shell_starts_with(buf_addr, buf_len, "mv " as void*, 3);
    if (is_mv != 0) {
        ulong* heap_ptr6 = ADDR_GLOBAL_HEAP as ulong*;
        ulong heap_addr6 = *heap_ptr6;
        Heap* heap6 = heap_addr6 as Heap*;
        cmd_mv(buf_addr, buf_len, heap6);
        matched = 1;
    }

    // --- Aria エディタ ---
    ulong is_aria = shell_starts_with(buf_addr, buf_len, "aria " as void*, 5);
    if (is_aria != 0) {
        // ファイル名取得
        ulong fname_start = 5;  // "aria " の後
        ulong fname_len = buf_len - fname_start;
        ulong fname_addr = buf_addr + fname_start;
        // Aria初期化+ファイルオープン
        aria_init();
        aria_op(1, fname_addr, fname_len, 0, 0);  // OPEN
        // 初回描画
        aria_op(3, 0, 0, 0, 0);  // RENDER
        matched = 1;
    }

    if (matched == 0) {
        serial.puts("Unknown command. Type 'help'" as void*);
        serial.println("" as void*);

        con.set_color(SHELL_COLOR_ERROR);
        con.println("Unknown command. Type 'help'" as void*);
        con.set_color(SHELL_COLOR_INPUT);
    }
}

// ============================================================
// 入力処理
// ============================================================

/// シェルのメインループ（idle_loopから呼ばれる）
export void shell_process_input() {
    SerialPort serial(0x3F8);
    FBConsole con();

    // Ariaモードチェック
    ulong aria_running = aria_op(4, 0, 0, 0, 0);  // IS_RUNNING
    if (aria_running != 0) {
        ulong ch = kb_read_char();
        if (ch == 0) {
            return;
        }
        // キー入力をAriaに転送
        aria_op(2, ch, 0, 0, 0);  // KEY_INPUT
        // まだ実行中か確認
        ulong still_running = aria_op(4, 0, 0, 0, 0);
        if (still_running != 0) {
            // 再描画
            aria_op(3, 0, 0, 0, 0);  // RENDER
        } else {
            // Aria終了 — シェルに復帰
            shell_set_color(SHELL_COLOR_OUTPUT);
            shell_println("[Aria closed]" as void*);
            serial.puts("CosmOS > " as void*);
            con.set_color(SHELL_COLOR_PROMPT);
            con.puts("CosmOS > " as void*);
            con.set_color(SHELL_COLOR_INPUT);
        }
        return;
    }

    ulong* pos_ptr = SHELL_POS_ADDR as ulong*;
    ulong pos = *pos_ptr;

    ulong ch = kb_read_char();
    if (ch == 0) {
        return;
    }

    // Enter (0x0A)
    ulong enter = 0x0A;
    if (ch == enter) {
        serial.println("" as void*);
        con.newline();
        shell_exec(SHELL_BUF_ADDR, pos);
        ulong zero = 0;
        *pos_ptr = zero;
        // プロンプト再表示
        serial.puts("CosmOS > " as void*);
        con.set_color(SHELL_COLOR_PROMPT);
        con.puts("CosmOS > " as void*);
        con.set_color(SHELL_COLOR_INPUT);
        return;
    }

    // Backspace (0x08)
    ulong backspace = 0x08;
    if (ch == backspace) {
        if (pos > 0) {
            pos = pos - 1;
            *pos_ptr = pos;
            serial.putc(0x08);
            serial.putc(0x20);
            serial.putc(0x08);
            con.backspace();
        }
        return;
    }

    // 通常文字
    ulong max_pos = SHELL_BUF_SIZE - 1;
    if (pos < max_pos) {
        shell_buf_write(pos, ch);
        pos = pos + 1;
        *pos_ptr = pos;
        serial.putc(ch);
        con.set_color(SHELL_COLOR_INPUT);
        con.putc(ch);
    }
}

// ============================================================
// 初期化
// ============================================================

/// シェルを初期化する
export void shell_init() {
    SerialPort serial(0x3F8);
    DebugPort debug(0xE9);
    FBConsole con();

    // バッファをクリア
    ulong zero = 0;
    ulong* pos_ptr = SHELL_POS_ADDR as ulong*;
    *pos_ptr = zero;

    ulong i = 0;
    ulong buf_qwords = 16;
    while (i < buf_qwords) {
        ulong addr = SHELL_BUF_ADDR + (i * 8);
        ulong* ptr = addr as ulong*;
        *ptr = zero;
        i = i + 1;
    }

    // serial バナー
    serial.println("" as void*);
    serial.println("================================" as void*);
    serial.println("  CosmOS v0.6.0 Kernel Shell" as void*);
    serial.println("  Type 'help' for commands" as void*);
    serial.println("================================" as void*);
    serial.puts("CosmOS> " as void*);

    // FBConsole バナー + プロンプト
    con.set_color(0x00FFFFFF);
    con.println("================================" as void*);
    con.println("  CosmOS v0.6.0 Kernel Shell" as void*);
    con.println("  Type 'help' for commands" as void*);
    con.println("================================" as void*);
    con.set_color(SHELL_COLOR_PROMPT);
    con.puts("CosmOS > " as void*);
    con.set_color(SHELL_COLOR_INPUT);

    debug.println("[SHELL] shell initialized" as void*);
}
