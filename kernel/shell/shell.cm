//! platform: uefi
// kernel::shell - カーネルシェル（メインループ）
//
// PS/2キーボードからの入力を受け取り、コマンドを解釈・実行する。
// serial + FBConsole のデュアル出力対応。
//
// コマンド実装は個別ファイルに分割:
//   cmd_help.cm, cmd_ps.cm, cmd_mem.cm, cmd_uptime.cm

import ../drivers/serial;
import ../drivers/debug_port;
import ../drivers/keyboard;
import ../lib/print;
import ../config;
import ../mm/heap;
import ../apps/aria/aria;
import ../sys/exec;
import ./shell_io;

// ============================================================
// 定数
// ============================================================

// コマンドバッファ
const ulong SHELL_BUF_ADDR = 0xD00;  // コマンドバッファ（128バイト）
const ulong SHELL_BUF_SIZE = 128;
const ulong SHELL_POS_ADDR = 0xD80;  // バッファ位置

// ============================================================
// 文字列比較ヘルパー
// ============================================================

/// 2つの文字列を比較する（固定アドレスの文字列 vs リテラル）
/// 一致すれば1、不一致なら0を返す
export ulong shell_streq(ulong buf_addr, ulong buf_len, void* target) {
    ulong target_addr = target as ulong;

    // ターゲット文字列の長さを計算
    ulong target_len = 0;
    ulong zero_byte = 0;
    while (true) {
        ulong ch = 0;
        ulong check_addr = target_addr + target_len;
        __asm__(`
            movq ${r:check_addr}, %rdi;
            xorq %rax, %rax;
            movb (%rdi), %al;
            movq %rax, ${=r:ch}
        `);
        if (ch == zero_byte) {
            break;
        }
        target_len = target_len + 1;
    }

    if (buf_len != target_len) {
        return 0;
    }

    ulong i = 0;
    while (i < buf_len) {
        ulong ch_buf = 0;
        ulong buf_byte_addr = buf_addr + i;
        __asm__(`
            movq ${r:buf_byte_addr}, %rdi;
            xorq %rax, %rax;
            movb (%rdi), %al;
            movq %rax, ${=r:ch_buf}
        `);

        ulong ch_target = 0;
        ulong target_byte_addr = target_addr + i;
        __asm__(`
            movq ${r:target_byte_addr}, %rdi;
            xorq %rax, %rax;
            movb (%rdi), %al;
            movq %rax, ${=r:ch_target}
        `);

        if (ch_buf != ch_target) {
            return 0;
        }
        i = i + 1;
    }

    return 1;
}

/// コマンドバッファが指定プレフィックスで始まるか判定
/// 一致すれば1、不一致なら0を返す
export ulong shell_starts_with(ulong buf_addr, ulong buf_len, void* prefix, ulong prefix_len) {
    if (buf_len < prefix_len) {
        return 0;
    }

    ulong prefix_addr = prefix as ulong;
    ulong i = 0;
    while (i < prefix_len) {
        ulong ch_buf = 0;
        ulong buf_byte_addr = buf_addr + i;
        __asm__(`
            movq ${r:buf_byte_addr}, %rdi;
            xorq %rax, %rax;
            movb (%rdi), %al;
            movq %rax, ${=r:ch_buf}
        `);

        ulong ch_prefix = 0;
        ulong prefix_byte_addr = prefix_addr + i;
        __asm__(`
            movq ${r:prefix_byte_addr}, %rdi;
            xorq %rax, %rax;
            movb (%rdi), %al;
            movq %rax, ${=r:ch_prefix}
        `);

        if (ch_buf != ch_prefix) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// ============================================================
// コマンド実行
// ============================================================

/// コマンドバッファにバイトを書込む
export void shell_buf_write(ulong pos, ulong byte_val) {
    ulong addr = SHELL_BUF_ADDR + pos;
    __asm__(`
        movq ${r:addr}, %rdi;
        movq ${r:byte_val}, %rax;
        movb %al, (%rdi)
    `);
}

/// コマンドバッファからバイトを読取る
export ulong shell_buf_read(ulong pos) {
    ulong addr = SHELL_BUF_ADDR + pos;
    ulong val = 0;
    __asm__(`
        movq ${r:addr}, %rdi;
        xorq %rax, %rax;
        movb (%rdi), %al;
        movq %rax, ${=r:val}
    `);
    return val;
}

/// カーソル位置以降のバッファ内容を再描画する（FBConsole）
/// prompt_len: プロンプト文字列の長さ（"CosmOS > " = 9文字）
export void shell_redraw_from(ulong cursor, ulong len) {
    FBConsole con = {addr: GLOBAL_FB_CONSOLE_ADDR};
    SerialPort serial = {port: 0x3F8};
    ulong prompt_len = 9;  // "CosmOS > " の長さ

    // FBConsoleのカーソルX位置をcursor+prompt_lenに設定
    con._write(0x20, prompt_len + cursor);  // FB_OFF_CURSOR_X

    // カーソル位置から末尾まで描画
    ulong i = cursor;
    while (i < len) {
        ulong ch = shell_buf_read(i);
        ulong px = (prompt_len + i) * 8;   // FONT_WIDTH
        ulong cy = con._read(0x28);        // FB_OFF_CURSOR_Y
        ulong py = cy * 16;                // FONT_HEIGHT
        con.set_color(SHELL_COLOR_INPUT);
        con.draw_char(px, py, ch);
        i = i + 1;
    }

    // 末尾の残り文字をクリア（削除時のゴミ除去）
    ulong clear_px = (prompt_len + len) * 8;
    ulong cy2 = con._read(0x28);
    ulong py2 = cy2 * 16;
    con.draw_char(clear_px, py2, 0x20);  // 空白で消去

    // FBConsoleカーソルをcursor位置に戻す
    con._write(0x20, prompt_len + cursor);

    // シリアル: カーソル位置も同期
    // (シリアルではESCシーケンスで対応)
    // まず行頭に戻ってプロンプト後から再描画
    serial.putc(0x0D);  // CR
    serial.puts("CosmOS > " as void*);
    ulong j = 0;
    while (j < len) {
        ulong ch2 = shell_buf_read(j);
        serial.putc(ch2);
        j = j + 1;
    }
    serial.putc(0x20);  // 末尾クリア
    // カーソルをcursor位置に移動（ESC[nG）
    serial.putc(0x0D);
    ulong k = 0;
    ulong target = prompt_len + cursor;
    while (k < target) {
        serial.putc(0x1B);
        serial.putc(0x5B);  // [
        serial.putc(0x43);  // C (right)
        k = k + 1;
    }
}

/// コマンドを実行する
export void shell_exec(ulong buf_addr, ulong buf_len) {
    SerialPort serial = {port: 0x3F8};
    DebugPort debug(0xE9);
    FBConsole con = {addr: GLOBAL_FB_CONSOLE_ADDR};

    if (buf_len == 0) {
        return;
    }

    debug.puts("[SHELL] cmd len=" as void*);
    debug.print_hex(buf_len);
    debug.println("" as void*);

    // Aria エディタ（シェルモード切替が必要なため、ここで処理）
    ulong is_aria = shell_starts_with(buf_addr, buf_len, "aria " as void*, 5);
    if (is_aria != 0) {
        ulong fname_start = 5;
        ulong fname_len = buf_len - fname_start;
        ulong fname_addr = buf_addr + fname_start;
        aria_init();
        aria_op(1, fname_addr, fname_len, 0, 0);
        aria_op(3, 0, 0, 0, 0);
        return;
    }

    // コマンド実行エンジンに委譲
    ulong result = exec_command(buf_addr, buf_len);
    if (result != 0) {
        serial.puts("Unknown command. Type 'help'" as void*);
        serial.println("" as void*);

        con.set_color(SHELL_COLOR_ERROR);
        con.println("Unknown command. Type 'help'" as void*);
        con.set_color(SHELL_COLOR_INPUT);
    }
}

// ============================================================
// 入力処理
// ============================================================

/// シェルのメインループ（idle_loopから呼ばれる）
export void shell_process_input() {
    SerialPort serial = {port: 0x3F8};
    FBConsole con = {addr: GLOBAL_FB_CONSOLE_ADDR};

    // Ariaモードチェック
    ulong aria_running = aria_op(4, 0, 0, 0, 0);  // IS_RUNNING
    if (aria_running != 0) {
        ulong ch = kb_read_char();
        if (ch == 0) {
            return;
        }
        // キー入力をAriaに転送
        aria_op(2, ch, 0, 0, 0);  // KEY_INPUT
        // まだ実行中か確認
        ulong still_running = aria_op(4, 0, 0, 0, 0);
        if (still_running != 0) {
            // 再描画
            aria_op(3, 0, 0, 0, 0);  // RENDER
        } else {
            // Aria終了 — シェルに復帰（画面クリア）
            shell_clear();
            shell_set_color(SHELL_COLOR_OUTPUT);
            shell_println("[Aria closed]" as void*);
            serial.puts("CosmOS > " as void*);
            con.set_color(SHELL_COLOR_PROMPT);
            con.puts("CosmOS > " as void*);
            con.set_color(SHELL_COLOR_INPUT);
        }
        return;
    }

    ulong* pos_ptr = SHELL_POS_ADDR as ulong*;
    ulong pos = *pos_ptr;
    ulong* cur_ptr = 0xDA8 as ulong*;  // ADDR_SHELL_CURSOR
    ulong cursor = *cur_ptr;

    ulong ch = kb_read_char();
    if (ch == 0) {
        return;
    }

    // ← 左矢印 (VKEY_LEFT = 0x82)
    if (ch == 0x82) {
        if (cursor > 0) {
            cursor = cursor - 1;
            *cur_ptr = cursor;
            // シリアル: カーソル左移動
            serial.putc(0x1B);
            serial.putc(0x5B);  // [
            serial.putc(0x44);  // D
            // FBConsoleカーソルX更新
            ulong new_x = 9 + cursor;
            con._write(0x20, new_x);
        }
        return;
    }

    // → 右矢印 (VKEY_RIGHT = 0x83)
    if (ch == 0x83) {
        if (cursor < pos) {
            cursor = cursor + 1;
            *cur_ptr = cursor;
            // シリアル: カーソル右移動
            serial.putc(0x1B);
            serial.putc(0x5B);  // [
            serial.putc(0x43);  // C
            // FBConsoleカーソルX更新
            ulong new_x2 = 9 + cursor;
            con._write(0x20, new_x2);
        }
        return;
    }

    // Enter (0x0A)
    ulong enter = 0x0A;
    if (ch == enter) {
        serial.println("" as void*);
        con.newline();
        shell_exec(SHELL_BUF_ADDR, pos);
        ulong zero = 0;
        *pos_ptr = zero;
        *cur_ptr = zero;
        // プロンプト再表示
        serial.puts("CosmOS > " as void*);
        con.set_color(SHELL_COLOR_PROMPT);
        con.puts("CosmOS > " as void*);
        con.set_color(SHELL_COLOR_INPUT);
        return;
    }

    // Backspace (0x08)
    ulong backspace = 0x08;
    if (ch == backspace) {
        if (cursor > 0) {
            // cursor位置の前の文字を削除
            // cursor以降を左に1バイトシフト
            ulong shift_i = cursor - 1;
            while (shift_i < pos - 1) {
                ulong next_ch = shell_buf_read(shift_i + 1);
                shell_buf_write(shift_i, next_ch);
                shift_i = shift_i + 1;
            }
            pos = pos - 1;
            cursor = cursor - 1;
            *pos_ptr = pos;
            *cur_ptr = cursor;
            // 再描画
            shell_redraw_from(cursor, pos);
            // FBConsoleカーソルをedit cursor位置に合わせる
            con._write(0x20, 9 + cursor);
        }
        return;
    }

    // 通常文字（0x20-0x7E のみ）
    if (ch >= 0x20) {
        if (ch < 0x7F) {
            ulong max_pos = SHELL_BUF_SIZE - 1;
            if (pos < max_pos) {
                // cursor位置に挿入（cursor以降を右に1バイトシフト）
                ulong shift_j = pos;
                while (shift_j > cursor) {
                    ulong prev_ch = shell_buf_read(shift_j - 1);
                    shell_buf_write(shift_j, prev_ch);
                    shift_j = shift_j - 1;
                }
                shell_buf_write(cursor, ch);
                pos = pos + 1;
                cursor = cursor + 1;
                *pos_ptr = pos;
                *cur_ptr = cursor;
                // 再描画
                shell_redraw_from(cursor - 1, pos);
                // FBConsoleカーソルをedit cursor位置に合わせる
                con._write(0x20, 9 + cursor);
            }
        }
    }
}

// ============================================================
// 初期化
// ============================================================

/// シェルを初期化する
export void shell_init() {
    SerialPort serial = {port: 0x3F8};
    DebugPort debug(0xE9);
    FBConsole con = {addr: GLOBAL_FB_CONSOLE_ADDR};

    // バッファをクリア
    ulong zero = 0;
    ulong* pos_ptr = SHELL_POS_ADDR as ulong*;
    *pos_ptr = zero;

    ulong i = 0;
    ulong buf_qwords = 16;
    while (i < buf_qwords) {
        ulong addr = SHELL_BUF_ADDR + (i * 8);
        ulong* ptr = addr as ulong*;
        *ptr = zero;
        i = i + 1;
    }

    // serial バナー
    serial.println("" as void*);
    serial.println("================================" as void*);
    serial.println("  CosmOS v0.6.0 Kernel Shell" as void*);
    serial.println("  Type 'help' for commands" as void*);
    serial.println("================================" as void*);
    serial.puts("CosmOS> " as void*);

    // FBConsole バナー + プロンプト
    con.set_color(0x00FFFFFF);
    con.println("================================" as void*);
    con.println("  CosmOS v0.6.0 Kernel Shell" as void*);
    con.println("  Type 'help' for commands" as void*);
    con.println("================================" as void*);
    con.set_color(SHELL_COLOR_PROMPT);
    con.puts("CosmOS > " as void*);
    con.set_color(SHELL_COLOR_INPUT);

    debug.println("[SHELL] shell initialized" as void*);

    // カーソル点滅有効化（OS標準機能）
    con.cursor_enable();

    // 編集カーソル位置リセット
    ulong init_zero = 0;
    ulong* cursor_pos = 0xDA8 as ulong*;
    *cursor_pos = init_zero;
}

// ============================================================
// 例外復帰
// ============================================================

/// 例外ハンドラから復帰した後の復旧処理
/// バッファをクリアし、エラーメッセージとプロンプトを再表示する
export void shell_recover() {
    SerialPort serial = {port: 0x3F8};
    FBConsole con = {addr: GLOBAL_FB_CONSOLE_ADDR};

    // シェルバッファをクリア
    ulong zero = 0;
    ulong* pos_ptr = SHELL_POS_ADDR as ulong*;
    *pos_ptr = zero;

    ulong i = 0;
    ulong buf_qwords = 16;
    while (i < buf_qwords) {
        ulong addr = SHELL_BUF_ADDR + (i * 8);
        ulong* ptr = addr as ulong*;
        *ptr = zero;
        i = i + 1;
    }

    // エラーから復帰したメッセージ
    con.set_color(SHELL_COLOR_ERROR);
    con.newline();
    con.println("[Recovered from exception]" as void*);
    serial.println("" as void*);
    serial.println("[Recovered from exception]" as void*);

    // プロンプト再表示
    serial.puts("CosmOS > " as void*);
    con.set_color(SHELL_COLOR_PROMPT);
    con.puts("CosmOS > " as void*);
    con.set_color(SHELL_COLOR_INPUT);

    // カーソル点滅リセット（OS標準機能）
    con.cursor_enable();

    // 編集カーソル位置リセット
    ulong* cursor_pos = 0xDA8 as ulong*;
    *cursor_pos = zero;
}
