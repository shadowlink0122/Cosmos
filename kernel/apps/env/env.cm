//! platform: uefi
// kernel::apps::env - envコマンド（環境変数表示）

import ../../shell/shell_io;
import ../../config;
import ../../sys/env;

/// envコマンド: 全環境変数を表示する
export ulong app_env(ulong argc, ulong argv) {
    shell_set_color(SHELL_COLOR_HEADER);
    shell_println("Environment:" as void*);

    ulong count = env_count();
    ulong i = 0;
    while (i < count) {
        ulong key = env_get_key(i);
        ulong val = env_get_val(i);
        if (key != 0) {
            shell_set_color(SHELL_COLOR_OUTPUT);
            shell_puts(key as void*);
            shell_putc(0x3D);  // '='
            shell_puts(val as void*);
            shell_newline();
        }
        i = i + 1;
    }
    return 0;
}
