//! platform: uefi
// kernel::shell::cmd_cm - Cm簡易コンパイラ＆VMランタイム
//
// cm <file> : .cmソースファイルを読み込み、簡易バイトコードにコンパイルして
//             a.out をCosmFSに作成する。
// cm help   : cmコマンドのヘルプを表示する。
// a.out     : バイトコードを読み込んで簡易VMで実行する。
//
// ※ バイトコードインタプリタ方式（ネイティブバイナリ実行ではない）
//
// サポートする構文:
//   print(数値);     → 数値を出力
//   print("文字列"); → 文字列を出力
//
// バイトコードフォーマット（各命令16バイト）:
//   [opcode: 8B] [operand: 8B]
//   OP_HALT      = 0 : プログラム終了
//   OP_PRINT_NUM = 1 : operandを10進数で出力
//   OP_PRINT_STR = 2 : operandバイト位置から文字列を出力（次命令に長さ）
//
// エラーコード定数:
//   CM_OK            = 0  成功
//   CM_ERR_ALLOC     = 2  メモリ割当失敗
//   CM_ERR_NOT_FOUND = 3  ファイル未発見
//   CM_ERR_EMPTY     = 4  ファイルが空

import ../../drivers/serial;
import ../../drivers/debug_port;
import ../../types;
import ../../fs/cosmfs;
import ../../mm/heap;
import ../../config;
import ../../shell/shell_io;
import ../fs/fs;
import ../../shell/fs_result;

// CosmFS操作コード — cosmfs.cm から import（export const で定義済み）

const MemAddr CM_NOT_FOUND = 0xFFFFFFFFFFFFFFFF;

// バイトコード命令
const FsOpCode OP_HALT      = 0;
const FsOpCode OP_PRINT_NUM = 1;
const FsOpCode OP_PRINT_STR = 2;

// バイトコード1命令のサイズ（バイト）
const ByteSize INSTR_SIZE = 16;

// コンパイラ用一時領域
const MemAddr CM_INSTR_COUNT = 0xCE0;

// エラーコード定数
const FsError CM_OK            = 0;
const FsError CM_ERR_ALLOC     = 2;
const FsError CM_ERR_NOT_FOUND = 3;
const FsError CM_ERR_EMPTY     = 4;

/// cmコマンドのヘルプを表示
export void cm_help() {
    shell_set_color(0x0000AAFF);
    shell_println("Cm Bytecode Compiler" as void*);
    shell_set_color(0x00CCCCCC);
    shell_println("" as void*);
    shell_println("Usage:" as void*);
    shell_println("  cm <file.cm>  - Compile to a.out" as void*);
    shell_println("  cm help       - Show this help" as void*);
    shell_println("  a.out         - Run compiled program" as void*);
    shell_println("" as void*);
    shell_println("Supported syntax:" as void*);
    shell_println("  print(N);      -> numeric output" as void*);
    shell_println("  print(\"...\");   -> string output" as void*);
    shell_println("" as void*);
    shell_println("Note: bytecode VM (not native binary)" as void*);
}

/// バイトコードに命令を書き込む
export void cm_emit(MemAddr code_buf, Count idx, FsOpCode opcode, ulong operand) {
    ulong offset = idx * INSTR_SIZE;
    ulong* op_ptr = (code_buf + offset) as ulong*;
    *op_ptr = opcode;
    ulong* arg_ptr = (code_buf + offset + 8) as ulong*;
    *arg_ptr = operand;
}

/// ソースコード中の数値リテラルを解析する
export ulong cm_parse_number(MemAddr src, ByteOffset pos, ByteSize len) {
    ulong result = 0;
    while (pos < len) {
        ulong ch = cmd_read_byte(src + pos);
        if (ch < 0x30) { return result; }
        if (ch > 0x39) { return result; }
        result = result * 10 + (ch - 0x30);
        pos = pos + 1;
    }
    return result;
}

/// print()パターンを1つ処理してバイトコード生成
export ByteOffset cm_compile_print(MemAddr src, ByteOffset print_pos, ByteSize src_len, MemAddr code_buf) {
    ulong* cnt_ptr = CM_INSTR_COUNT as ulong*;
    ulong idx = *cnt_ptr;
    ulong first_ch = cmd_read_byte(src + print_pos);

    if (first_ch == 0x22) {
        ulong str_start = print_pos + 1;
        ulong str_pos = str_start;
        while (str_pos < src_len) {
            ulong sc = cmd_read_byte(src + str_pos);
            if (sc == 0x22) {
                ulong str_len = str_pos - str_start;
                cm_emit(code_buf, idx, OP_PRINT_STR, src + str_start);
                idx = idx + 1;
                cm_emit(code_buf, idx, str_len, 0);
                idx = idx + 1;
                *cnt_ptr = idx;
                return str_pos + 1;
            }
            str_pos = str_pos + 1;
        }
        *cnt_ptr = idx;
        return src_len;
    }

    ulong num = cm_parse_number(src, print_pos, src_len);
    cm_emit(code_buf, idx, OP_PRINT_NUM, num);
    idx = idx + 1;
    *cnt_ptr = idx;
    return print_pos + 1;
}

/// ソースコード全体をスキャンしてprint()を探す
export ByteSize cm_compile_source(MemAddr src, ByteSize src_len, MemAddr code_buf) {
    ulong* cnt_ptr = CM_INSTR_COUNT as ulong*;
    ulong zero = 0;
    *cnt_ptr = zero;
    ulong pos = 0;
    ulong max_instrs = 14;

    while (pos + 5 < src_len) {
        ulong idx = *cnt_ptr;
        if (idx >= max_instrs) {
            pos = src_len;
        } else {
            ulong c0 = cmd_read_byte(src + pos);
            if (c0 == 0x70) {
                ulong c1 = cmd_read_byte(src + pos + 1);
                ulong c2 = cmd_read_byte(src + pos + 2);
                ulong c3 = cmd_read_byte(src + pos + 3);
                ulong c4 = cmd_read_byte(src + pos + 4);
                ulong c5 = cmd_read_byte(src + pos + 5);
                if (c1 == 0x72) {
                    if (c2 == 0x69) {
                        if (c3 == 0x6E) {
                            if (c4 == 0x74) {
                                if (c5 == 0x28) {
                                    pos = cm_compile_print(src, pos + 6, src_len, code_buf);
                                } else { pos = pos + 1; }
                            } else { pos = pos + 1; }
                        } else { pos = pos + 1; }
                    } else { pos = pos + 1; }
                } else { pos = pos + 1; }
            } else {
                pos = pos + 1;
            }
        }
    }

    ulong final_idx = *cnt_ptr;
    cm_emit(code_buf, final_idx, OP_HALT, 0);
    final_idx = final_idx + 1;
    *cnt_ptr = final_idx;
    return final_idx * INSTR_SIZE;
}

/// a.outファイルを作成してバイトコードを書き込む
/// 戻り値: Result（成功時value=0、失敗時errorにコード）
export FsResult cm_create_aout(MemAddr code_buf, ByteSize code_size, Heap* heap) {
    MemAddr __r_name_addr = heap->alloc(6);

    FsResult r_name = FsResult::from_alloc(__r_name_addr);
    if (r_name.is_err != 0) { return r_name; }
    ulong aout_name = r_name.value;
    cosmfs_op(FS_OP_MEMCPY, aout_name, "a.out" as ulong, 6, 0);

    ulong existing = cosmfs_op(FS_OP_FIND, aout_name, 0, 0, 0);
    if (existing != CM_NOT_FOUND) {
        cosmfs_op(FS_OP_DELETE, aout_name, 0, 0, 0);
    }

    MemAddr __r_data_addr = heap->alloc(4096);


    FsResult r_data = FsResult::from_alloc(__r_data_addr);
    if (r_data.is_err != 0) { return r_data; }

    FsResult r_create = FsResult::from_create(cosmfs_op(FS_OP_CREATE, aout_name, r_data.value, 4096, 0));
    if (r_create.is_err != 0) { return r_create; }

    FsResult r_write = FsResult::from_op(cosmfs_op(FS_OP_WRITE, aout_name, code_buf, code_size, 0));
    if (r_write.is_err != 0) { return r_write; }

    return FsResult::ok(0 as ulong);
}

/// cmコマンド: .cmファイルをコンパイルしてa.outを生成
export void cmd_cm(MemAddr buf_addr, ByteSize buf_len, Heap* heap) {
    ulong arg_start = cmd_find_arg(buf_addr, buf_len);
    ulong arg_len = cmd_arg_len(buf_addr, arg_start, buf_len);

    // 引数なし → Usage表示
    if (arg_len == 0) {
        shell_set_color(0x00FFAA00);
        shell_println("Usage: cm <file.cm>" as void*);
        shell_println("  cm help  - Show help" as void*);
        return;
    }

    // "help" チェック（h=0x68, e=0x65, l=0x6C, p=0x70）
    if (arg_len == 4) {
        ulong h0 = cmd_read_byte(buf_addr + arg_start);
        ulong h1 = cmd_read_byte(buf_addr + arg_start + 1);
        ulong h2 = cmd_read_byte(buf_addr + arg_start + 2);
        ulong h3 = cmd_read_byte(buf_addr + arg_start + 3);
        if (h0 == 0x68) {
            if (h1 == 0x65) {
                if (h2 == 0x6C) {
                    if (h3 == 0x70) {
                        cm_help();
                        return;
                    }
                }
            }
        }
    }

    // ファイル名をバッファにコピー
    MemAddr __r_name_addr = heap->alloc(arg_len + 1);

    FsResult r_name = FsResult::from_alloc(__r_name_addr);
    if (r_name.is_err != 0) { r_name.print_error(); return; }
    ulong name_buf = r_name.value;
    cosmfs_op(FS_OP_MEMCPY, name_buf, buf_addr + arg_start, arg_len, 0);
    cmd_write_byte(name_buf + arg_len, 0);

    // ソースファイルの検索
    FsResult r_find = FsResult::from_op(cosmfs_op(FS_OP_FIND, name_buf, 0, 0, 0));
    if (r_find.is_err != 0) { r_find.print_error(); return; }

    // ソースファイル読み込み
    FsResult r_size = FsResult::from_op_nz(cosmfs_op(FS_OP_SIZE, name_buf, 0, 0, 0));
    if (r_size.is_err != 0) { r_size.print_error(); return; }
    ulong src_size = r_size.value;

    MemAddr __r_src_addr = heap->alloc(src_size + 1);


    FsResult r_src = FsResult::from_alloc(__r_src_addr);
    if (r_src.is_err != 0) { r_src.print_error(); return; }

    FsResult r_read = FsResult::from_op_nz(cosmfs_op(FS_OP_READ, name_buf, r_src.value, src_size, 0));
    if (r_read.is_err != 0) { r_read.print_error(); return; }

    // バイトコードバッファ
    MemAddr __r_code_addr = heap->alloc(256);

    FsResult r_code = FsResult::from_alloc(__r_code_addr);
    if (r_code.is_err != 0) { r_code.print_error(); return; }

    // コンパイル実行
    ulong code_size = cm_compile_source(r_src.value, src_size, r_code.value);

    // a.out作成
    FsResult r_aout = cm_create_aout(r_code.value, code_size, heap);
    if (r_aout.is_err != 0) { r_aout.print_error(); return; }

    shell_set_color(0x0000FF88);
    shell_println("Compiled successfully -> a.out" as void*);
}

/// a.outコマンド: バイトコードVMで実行
export void cmd_run_aout(Heap* heap) {
    MemAddr __r_name_addr = heap->alloc(6);

    FsResult r_name = FsResult::from_alloc(__r_name_addr);
    if (r_name.is_err != 0) { r_name.print_error(); return; }
    ulong aout_name = r_name.value;
    cosmfs_op(FS_OP_MEMCPY, aout_name, "a.out" as ulong, 6, 0);

    FsResult r_find = FsResult::from_op(cosmfs_op(FS_OP_FIND, aout_name, 0, 0, 0));
    if (r_find.is_err != 0) {
        shell_set_color(0x00FF4444);
        shell_println("Error: a.out not found" as void*);
        shell_println("  Compile first: cm <file.cm>" as void*);
        return;
    }

    FsResult r_size = FsResult::from_op_nz(cosmfs_op(FS_OP_SIZE, aout_name, 0, 0, 0));
    if (r_size.is_err != 0) { r_size.print_error(); return; }
    ulong code_size = r_size.value;

    MemAddr __r_buf_addr = heap->alloc(code_size);


    FsResult r_buf = FsResult::from_alloc(__r_buf_addr);
    if (r_buf.is_err != 0) { r_buf.print_error(); return; }

    FsResult r_read = FsResult::from_op_nz(cosmfs_op(FS_OP_READ, aout_name, r_buf.value, code_size, 0));
    if (r_read.is_err != 0) { r_read.print_error(); return; }

    shell_set_color(0x00FFFFFF);
    cm_vm_exec(r_buf.value, code_size);
}

/// バイトコードVM実行エンジン
export void cm_vm_exec(MemAddr code_buf, ByteSize code_size) {
    ulong pc = 0;
    ulong steps = 0;
    ulong max_steps = 1000;

    while (steps < max_steps) {
        ulong offset = pc * INSTR_SIZE;
        if (offset >= code_size) { return; }

        ulong* op_ptr = (code_buf + offset) as ulong*;
        ulong opcode = *op_ptr;
        ulong* arg_ptr = (code_buf + offset + 8) as ulong*;
        ulong operand = *arg_ptr;

        if (opcode == OP_HALT) { return; }

        if (opcode == OP_PRINT_NUM) {
            shell_print_num(operand);
            shell_newline();
            pc = pc + 1;
        }

        if (opcode == OP_PRINT_STR) {
            ulong len_off = (pc + 1) * INSTR_SIZE;
            ulong* len_ptr = (code_buf + len_off) as ulong*;
            ulong str_len = *len_ptr;
            ulong si = 0;
            while (si < str_len) {
                ulong ch = cmd_read_byte(operand + si);
                shell_putc(ch);
                si = si + 1;
            }
            shell_newline();
            pc = pc + 2;
        }

        if (opcode != OP_HALT) {
            if (opcode != OP_PRINT_NUM) {
                if (opcode != OP_PRINT_STR) {
                    pc = pc + 1;
                }
            }
        }

        steps = steps + 1;
    }
}
