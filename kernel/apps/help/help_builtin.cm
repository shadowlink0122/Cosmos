//! platform: uefi
// kernel::apps::help - helpコマンド（カーネル組み込み）
//
// 使用可能なコマンド一覧を表示する。
// ps, mem, uptime 等と同じくカーネルに直接組み込み。

import ../../shell/shell_io;
import ../../config;

/// helpコマンド: 使用可能なコマンド一覧を表示
export ulong app_help(ulong argc, ulong argv) {
    shell_set_color(SHELL_COLOR_OUTPUT);
    shell_puts("Available commands:" as void*);
    shell_newline();
    shell_puts("  help           - Show this help" as void*);
    shell_newline();
    shell_puts("  ps             - List tasks" as void*);
    shell_newline();
    shell_puts("  mem            - Show memory usage" as void*);
    shell_newline();
    shell_puts("  uptime         - Show system uptime" as void*);
    shell_newline();
    shell_puts("  clear          - Clear screen" as void*);
    shell_newline();
    shell_puts("  env            - Show environment" as void*);
    shell_newline();
    shell_puts("  ls             - List files" as void*);
    shell_newline();
    shell_puts("  touch <name>   - Create file" as void*);
    shell_newline();
    shell_puts("  cat <name>     - Show file" as void*);
    shell_newline();
    shell_puts("  rm <name>      - Delete file" as void*);
    shell_newline();
    shell_puts("  write <n> <d>  - Write to file" as void*);
    shell_newline();
    shell_puts("  append <n> <d> - Append to file" as void*);
    shell_newline();
    shell_puts("  mkdir <name>   - Create directory" as void*);
    shell_newline();
    shell_puts("  cp <src> <dst> - Copy file" as void*);
    shell_newline();
    shell_puts("  mv <src> <dst> - Move/rename file" as void*);
    shell_newline();
    shell_puts("  aria <file>    - Text editor (vi-like)" as void*);
    shell_newline();
    shell_puts("  cm <file>      - Compile .cm file" as void*);
    shell_newline();
    shell_puts("  a.out          - Run compiled program" as void*);
    shell_newline();
    return 0;
}
