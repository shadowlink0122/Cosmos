//! platform: uefi
// kernel::idt - IDT（割り込みディスクリプタテーブル）設定
//
// x86_64 Long Mode用のIDT。256エントリ、各16バイト。
// CPU例外（ベクタ0-31）およびハードウェア割り込み（ベクタ32+）を処理。
//
// impl IDT { ... } パターンでメソッド呼び出しを提供:
//   idt.init();
//   idt.set_gate(0, handler_addr, IDT_INTERRUPT_GATE);
//   idt.load();

import ../drivers/serial;

// ============================================================
// 定数
// ============================================================

// IDTエントリ数
const ulong IDT_ENTRIES = 256;

// セレクタ: カーネルコードセグメント（GDT[1] = 0x08）
const ulong IDT_CS = 0x08;

// ゲートタイプ
export const ulong IDT_INTERRUPT_GATE = 0x8E;  // P=1, DPL=0, Interrupt Gate
export const ulong IDT_TRAP_GATE      = 0x8F;  // P=1, DPL=0, Trap Gate

// ============================================================
// IDT 構造体
// ============================================================

/// 割り込みディスクリプタテーブル
export struct IDT {
    uint* table;    // IDTテーブルのベースアドレス（256エントリ × 16バイト）
}

// ============================================================
// デフォルトハンドラ（フリー関数 — fn_addrで参照するため）
// ============================================================

/// 未登録ベクタのデフォルトハンドラ（iretqで即リターン）
export void idt_default_handler() {
    __asm__(`iretq`);
}

// ============================================================
// IDT メソッド実装
// ============================================================

impl IDT {
    /// 引数付きコンストラクタ: テーブルポインタ設定 + 全エントリ初期化 + ロード
    /// 使用例: IDT idt(table_ptr);
    overload self(uint* table_ptr) {
        self.table = table_ptr;
        self.init();
    }

    /// IDTテーブルの指定ベクタにゲートディスクリプタを設定する
    void set_gate(ulong vector, ulong handler, ulong type_attr) {
        // 各エントリは4つのuint（16バイト）
        ulong four = 4 as ulong;
        ulong idx = vector * four;

        // ビットマスク定数
        ulong mask_16 = 0xFFFF as ulong;
        ulong sixteen = 16 as ulong;
        ulong thirtytwo = 32 as ulong;
        ulong eight = 8 as ulong;

        // ハンドラアドレスの分割
        ulong offset_low  = handler & mask_16;
        ulong offset_mid  = (handler >> sixteen) & mask_16;
        ulong offset_high = handler >> thirtytwo;

        // selector = KERNEL_CS(0x08)
        ulong selector = IDT_CS;

        // [0] offset_low(16) | selector(16)
        ulong entry0 = (selector << sixteen) | offset_low;

        // [1] IST(0) | reserved(0) | type_attr(8) | offset_mid(16)
        ulong entry1 = (offset_mid << sixteen) | (type_attr << eight);

        // ポインタ演算でエントリの各uintにアクセス
        ulong base_addr = self.table as ulong;
        ulong entry_size = 4 as ulong;  // sizeof(uint) = 4
        ulong byte_offset = idx * entry_size;

        uint* p0 = (base_addr + byte_offset) as uint*;
        ulong es = entry_size;
        uint* p1 = (base_addr + byte_offset + es) as uint*;
        uint* p2 = (base_addr + byte_offset + es + es) as uint*;
        uint* p3 = (base_addr + byte_offset + es + es + es) as uint*;

        *p0 = entry0 as uint;
        *p1 = entry1 as uint;
        *p2 = offset_high as uint;
        *p3 = 0 as uint;
    }

    /// IDTRを構築し、lidt命令でIDTをCPUにロードする
    void load() {
        ulong idt_addr = self.table as ulong;
        ulong idt_limit = 4095 as ulong;  // 256 * 16 - 1

        __asm__(`
            subq $$16, %rsp;
            movq ${r:idt_limit}, %rax;
            movw %ax, (%rsp);
            movq ${r:idt_addr}, %rax;
            movq %rax, 2(%rsp);
            lidt (%rsp);
            addq $$16, %rsp
        `);
    }

    /// IDTを初期化してCPUにロードする
    void init() {
        // デフォルトハンドラのアドレスを取得
        void* handler_ptr = idt_default_handler as void*;
        ulong default_addr = handler_ptr as ulong;

        // 全256エントリをデフォルトハンドラで初期化
        ulong i = 0;
        ulong one = 1 as ulong;
        while (i < IDT_ENTRIES) {
            self.set_gate(i, default_addr, IDT_INTERRUPT_GATE);
            i = i + one;
        }

        // IDTをCPUにロード
        self.load();
    }
}
