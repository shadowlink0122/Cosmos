//! platform: uefi
// kernel::isr - ISR（割り込みサービスルーチン）と例外ハンドラ
//
// CPU例外（ベクタ0-31）の処理を行う。
// 各ISRスタブはフリー関数として定義（fn_addrでIDTに登録するため）。
// ISRManager構造体でIDTへの登録をメソッドとして管理。
//
// impl ISRManager { ... } パターン:
//   isr.init();

import ./idt;
import ../drivers/serial;
import ../drivers/debug_port;

// ============================================================
// 例外名テーブル（フリー関数）
// ============================================================

/// ベクタ番号に対する例外名を返す
export void* exception_name(ulong vector) {
    if (vector == 0)  { return "Division Error (#DE)" as void*; }
    if (vector == 1)  { return "Debug (#DB)" as void*; }
    if (vector == 2)  { return "NMI" as void*; }
    if (vector == 3)  { return "Breakpoint (#BP)" as void*; }
    if (vector == 4)  { return "Overflow (#OF)" as void*; }
    if (vector == 5)  { return "Bound Range (#BR)" as void*; }
    if (vector == 6)  { return "Invalid Opcode (#UD)" as void*; }
    if (vector == 7)  { return "Device Not Available (#NM)" as void*; }
    if (vector == 8)  { return "Double Fault (#DF)" as void*; }
    if (vector == 10) { return "Invalid TSS (#TS)" as void*; }
    if (vector == 11) { return "Segment Not Present (#NP)" as void*; }
    if (vector == 12) { return "Stack Fault (#SS)" as void*; }
    if (vector == 13) { return "General Protection (#GP)" as void*; }
    if (vector == 14) { return "Page Fault (#PF)" as void*; }
    if (vector == 16) { return "x87 FP Error (#MF)" as void*; }
    if (vector == 17) { return "Alignment Check (#AC)" as void*; }
    if (vector == 18) { return "Machine Check (#MC)" as void*; }
    if (vector == 19) { return "SIMD FP Error (#XM)" as void*; }
    return "Unknown Exception" as void*;
}

// ============================================================
// 共通例外ハンドラ（フリー関数）
// ============================================================

/// 例外発生時にシリアルにデバッグ情報を出力し、HLTループに入る
export void exception_handler(ulong vector, ulong error_code) {
    // シリアルポート・デバッグポートを直接初期化して使用
    SerialPort serial;
    serial.port = 0x3F8;

    DebugPort debug;
    debug.port = 0xE9;

    serial.println("" as void*);
    serial.println("========================================" as void*);
    serial.println("[EXCEPTION] CPU Exception Caught!" as void*);
    serial.println("========================================" as void*);

    serial.puts("  Vector: " as void*);
    serial.print_hex(vector);
    serial.puts(" (" as void*);
    serial.puts(exception_name(vector));
    serial.println(")" as void*);

    serial.puts("  Error Code: " as void*);
    serial.print_hex(error_code);
    serial.println("" as void*);

    serial.println("========================================" as void*);
    serial.println("[EXCEPTION] System halted." as void*);

    // デバッグポートにも出力（テスト検出用）
    debug.puts("[EXCEPTION] vector=" as void*);
    debug.print_hex(vector);
    debug.println("" as void*);

    // HLTループ
    while (true) {
        __asm__("hlt");
    }
}

// ============================================================
// ISRスタブ — フリー関数（fn_addrでIDTに登録）
// ============================================================

export void isr_0()  { exception_handler(0, 0); }
export void isr_1()  { exception_handler(1, 0); }
export void isr_2()  { exception_handler(2, 0); }
export void isr_3()  { exception_handler(3, 0); }
export void isr_4()  { exception_handler(4, 0); }
export void isr_5()  { exception_handler(5, 0); }
export void isr_6()  { exception_handler(6, 0); }
export void isr_7()  { exception_handler(7, 0); }
export void isr_8()  { exception_handler(8, 0); }
export void isr_9()  { exception_handler(9, 0); }
export void isr_10() { exception_handler(10, 0); }
export void isr_11() { exception_handler(11, 0); }
export void isr_12() { exception_handler(12, 0); }
export void isr_13() { exception_handler(13, 0); }
export void isr_14() { exception_handler(14, 0); }
export void isr_15() { exception_handler(15, 0); }
export void isr_16() { exception_handler(16, 0); }
export void isr_17() { exception_handler(17, 0); }
export void isr_18() { exception_handler(18, 0); }
export void isr_19() { exception_handler(19, 0); }
export void isr_20() { exception_handler(20, 0); }
export void isr_21() { exception_handler(21, 0); }
export void isr_22() { exception_handler(22, 0); }
export void isr_23() { exception_handler(23, 0); }
export void isr_24() { exception_handler(24, 0); }
export void isr_25() { exception_handler(25, 0); }
export void isr_26() { exception_handler(26, 0); }
export void isr_27() { exception_handler(27, 0); }
export void isr_28() { exception_handler(28, 0); }
export void isr_29() { exception_handler(29, 0); }
export void isr_30() { exception_handler(30, 0); }
export void isr_31() { exception_handler(31, 0); }

// ============================================================
// ISR登録ヘルパー
// ============================================================

/// 関数ポインタをulongアドレスに変換するヘルパー
export ulong fn_addr(void* fn) {
    return fn as ulong;
}

// ============================================================
// ISRManager 構造体
// ============================================================

/// ISR管理（IDTへのISRスタブ登録）
export struct ISRManager {
    uint* idt_table;    // IDTテーブルへのポインタ
}

// ============================================================
// ISRManager メソッド実装
// ============================================================

impl ISRManager {
    /// 引数付きコンストラクタ: IDTテーブル設定 + 全ISRスタブ登録
    /// 使用例: ISRManager isr(idt_table);
    overload self(uint* table_ptr) {
        self.idt_table = table_ptr;
        self.init();
    }

    /// 全例外ISR（0-31）をIDTに登録する
    void init() {
        // IDTインスタンスを作成してset_gateを呼ぶ
        IDT idt;
        idt.table = self.idt_table;

        // ベクタ3（ブレークポイント）以外はInterrupt Gate
        idt.set_gate(0,  fn_addr(isr_0  as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(1,  fn_addr(isr_1  as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(2,  fn_addr(isr_2  as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(3,  fn_addr(isr_3  as void*), IDT_TRAP_GATE);
        idt.set_gate(4,  fn_addr(isr_4  as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(5,  fn_addr(isr_5  as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(6,  fn_addr(isr_6  as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(7,  fn_addr(isr_7  as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(8,  fn_addr(isr_8  as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(9,  fn_addr(isr_9  as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(10, fn_addr(isr_10 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(11, fn_addr(isr_11 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(12, fn_addr(isr_12 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(13, fn_addr(isr_13 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(14, fn_addr(isr_14 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(15, fn_addr(isr_15 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(16, fn_addr(isr_16 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(17, fn_addr(isr_17 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(18, fn_addr(isr_18 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(19, fn_addr(isr_19 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(20, fn_addr(isr_20 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(21, fn_addr(isr_21 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(22, fn_addr(isr_22 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(23, fn_addr(isr_23 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(24, fn_addr(isr_24 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(25, fn_addr(isr_25 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(26, fn_addr(isr_26 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(27, fn_addr(isr_27 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(28, fn_addr(isr_28 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(29, fn_addr(isr_29 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(30, fn_addr(isr_30 as void*), IDT_INTERRUPT_GATE);
        idt.set_gate(31, fn_addr(isr_31 as void*), IDT_INTERRUPT_GATE);
    }
}
