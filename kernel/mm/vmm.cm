//! platform: uefi
// kernel::mm::vmm - 仮想メモリマネージャ (VMM)
//
// x86_64 4レベルページテーブル管理。
// UEFIが構築したアイデンティティマッピングを継承し、
// map_page/unmap_page によるページマッピング操作を提供。
//
// ページテーブル構造 (x86_64 4レベル):
//   CR3 → PML4 → PDPT → PD → PT → 物理ページ
//   各レベル512エントリ (9bit index)、エントリ8バイト
//
// 使用例:
//   VMM vmm();
//   vmm.map_page(0x200000, 0x200000, PTE_KERNEL_RW, &pmm);  // アイデンティティマップ
//   vmm.map_page(0x400000, 0x300000, PTE_USER_RW, &pmm);    // ユーザ空間マップ
//   vmm.unmap_page(0x400000);                                 // マッピング解除

import ../config;
import ../drivers/serial;
import ../drivers/debug_port;
import ./pmm;

// ============================================================
// 定数
// ============================================================

// ページサイズ
const ulong VMM_PAGE_SIZE = 4096;

// ページテーブルエントリのフラグ
const ulong PTE_PRESENT    = 1;        // ビット0: Present
const ulong PTE_WRITABLE   = 2;        // ビット1: Read/Write
const ulong PTE_USER       = 4;        // ビット2: User/Supervisor
const ulong PTE_WRITE_THRU = 8;        // ビット3: Write-Through
const ulong PTE_NO_CACHE   = 16;       // ビット4: Cache Disable
const ulong PTE_ACCESSED   = 32;       // ビット5: Accessed
const ulong PTE_DIRTY      = 64;       // ビット6: Dirty

// 複合フラグ
const ulong PTE_KERNEL_RW  = 3;        // Present + Writable
const ulong PTE_USER_RW    = 7;        // Present + Writable + User
const ulong PTE_USER_RO    = 5;        // Present + User (読取専用)

// ページテーブルのエントリ数
const ulong PT_ENTRIES = 512;

// 各レベルのインデックス抽出用シフト量
const ulong PML4_SHIFT = 39;
const ulong PDPT_SHIFT = 30;
const ulong PD_SHIFT   = 21;
const ulong PT_SHIFT   = 12;

// インデックスマスク（9ビット = 0x1FF）
const ulong INDEX_MASK = 511;

// エントリのアドレスマスク（ビット12-51）
const ulong PTE_ADDR_MASK = 0x000FFFFFFFFFF000;

// ============================================================
// メモリアクセスヘルパー
// ============================================================

/// 指定アドレスから8バイト値を読み取る
ulong vmm_read64(MemAddr addr) {
    ulong result = 0;
    __asm__(`
        movq ${r:addr}, %rdi;
        movq (%rdi), %rax;
        movq %rax, ${=r:result}
    `);
    return result;
}

/// 指定アドレスに8バイト値を書き込む
void vmm_write64(MemAddr addr, ulong value) {
    ulong dummy = 0;
    __asm__(`
        movq ${r:addr}, %rdi;
        movq ${r:value}, %rax;
        movq %rax, (%rdi);
        movq %rax, ${=r:dummy}
    `);
}

/// ページのゼロクリア（4096バイト）
void vmm_zero_page(MemAddr addr) {
    ulong i = 0;
    while (i < VMM_PAGE_SIZE) {
        vmm_write64(addr + i, 0);
        i = i + 8;
    }
}

/// TLBエントリの無効化
void vmm_invlpg(MemAddr virt_addr) {
    __asm__(`
        movq ${r:virt_addr}, %rax;
        invlpg (%rax)
    `);
}

// ============================================================
// VMM 構造体
// ============================================================

/// 仮想メモリマネージャ
/// UEFIのページテーブルを継承し、map/unmap操作を提供
export struct VMM {
    MemAddr cr3_value;    // 現在のCR3レジスタ値（PML4物理アドレス）
    ulong is_active;      // ページング有効フラグ
    Count map_count;      // マッピング操作カウント
}

// ============================================================
// VMM メソッド実装
// ============================================================

impl VMM {
    /// コンストラクタ: 現在のCR3値を読み取りUEFIページテーブルを継承
    overload self() {
        DebugPort debug(0xE9);

        // 現在のCR3レジスタを読み取り
        self.cr3_value = 0;
        ulong* cr3_ptr = &self.cr3_value;
        __asm__(`
            movq %cr3, %rax;
            movq %rax, (${r:cr3_ptr})
        `);

        self.is_active = 1;
        self.map_count = 0;

        debug.puts("[VMM] inherited UEFI CR3=0x" as void*);
        debug.print_hex(self.cr3_value);
        debug.println("" as void*);
    }

    /// ページマッピング: 仮想アドレスを物理アドレスに対応付ける
    ///
    /// virt_addr:  仮想アドレス（4KB アラインメント必須）
    /// phys_addr:  物理アドレス（4KB アラインメント必須）
    /// flags:      ページテーブルエントリのフラグ (PTE_KERNEL_RW 等)
    /// pmm:        中間テーブル割当用の物理メモリマネージャ
    ///
    /// 戻り値: 0=成功, 1=PMMからの割当失敗
    ulong map_page(MemAddr virt_addr, MemAddr phys_addr, ulong flags, PMM* pmm) {
        DebugPort debug(0xE9);

        // PML4テーブルのベースアドレス
        MemAddr pml4_base = self.cr3_value & PTE_ADDR_MASK;

        // Level 4: PML4 → PDPT
        ulong pml4_index = (virt_addr >> PML4_SHIFT) & INDEX_MASK;
        MemAddr pml4_entry_addr = pml4_base + (pml4_index * 8);
        ulong pml4_entry = vmm_read64(pml4_entry_addr);

        MemAddr pdpt_base = 0;
        if ((pml4_entry & PTE_PRESENT) != 0) {
            // 既存のPDPTテーブルを使用
            pdpt_base = pml4_entry & PTE_ADDR_MASK;
        } else {
            // 新しいPDPTテーブルを割当
            pdpt_base = pmm->alloc_page();
            if (pdpt_base == 0) {
                debug.println("[VMM] ERROR: cannot alloc PDPT page" as void*);
                return 1;
            }
            vmm_zero_page(pdpt_base);
            // PML4エントリに書き込み（Present + Writable + User許可）
            ulong new_entry = pdpt_base | PTE_PRESENT | PTE_WRITABLE | PTE_USER;
            vmm_write64(pml4_entry_addr, new_entry);
        }

        // Level 3: PDPT → PD
        ulong pdpt_index = (virt_addr >> PDPT_SHIFT) & INDEX_MASK;
        MemAddr pdpt_entry_addr = pdpt_base + (pdpt_index * 8);
        ulong pdpt_entry = vmm_read64(pdpt_entry_addr);

        MemAddr pd_base = 0;
        if ((pdpt_entry & PTE_PRESENT) != 0) {
            pd_base = pdpt_entry & PTE_ADDR_MASK;
        } else {
            pd_base = pmm->alloc_page();
            if (pd_base == 0) {
                debug.println("[VMM] ERROR: cannot alloc PD page" as void*);
                return 1;
            }
            vmm_zero_page(pd_base);
            ulong new_entry = pd_base | PTE_PRESENT | PTE_WRITABLE | PTE_USER;
            vmm_write64(pdpt_entry_addr, new_entry);
        }

        // Level 2: PD → PT
        ulong pd_index = (virt_addr >> PD_SHIFT) & INDEX_MASK;
        MemAddr pd_entry_addr = pd_base + (pd_index * 8);
        ulong pd_entry = vmm_read64(pd_entry_addr);

        MemAddr pt_base = 0;
        if ((pd_entry & PTE_PRESENT) != 0) {
            pt_base = pd_entry & PTE_ADDR_MASK;
        } else {
            pt_base = pmm->alloc_page();
            if (pt_base == 0) {
                debug.println("[VMM] ERROR: cannot alloc PT page" as void*);
                return 1;
            }
            vmm_zero_page(pt_base);
            ulong new_entry = pt_base | PTE_PRESENT | PTE_WRITABLE | PTE_USER;
            vmm_write64(pd_entry_addr, new_entry);
        }

        // Level 1: PT エントリ設定（最終マッピング）
        ulong pt_index = (virt_addr >> PT_SHIFT) & INDEX_MASK;
        MemAddr pt_entry_addr = pt_base + (pt_index * 8);
        ulong pt_entry = phys_addr | flags | PTE_PRESENT;
        vmm_write64(pt_entry_addr, pt_entry);

        // TLBフラッシュ
        vmm_invlpg(virt_addr);

        self.map_count = self.map_count + 1;
        return 0;
    }

    /// ページマッピング解除: 仮想アドレスのマッピングを無効化
    ///
    /// virt_addr: マッピングを解除する仮想アドレス（4KB アラインメント必須）
    ///
    /// 戻り値: 0=成功, 1=マッピングが存在しない
    ulong unmap_page(MemAddr virt_addr) {
        // PML4テーブルのベースアドレス
        MemAddr pml4_base = self.cr3_value & PTE_ADDR_MASK;

        // Level 4: PML4 → PDPT
        ulong pml4_index = (virt_addr >> PML4_SHIFT) & INDEX_MASK;
        MemAddr pml4_entry_addr = pml4_base + (pml4_index * 8);
        ulong pml4_entry = vmm_read64(pml4_entry_addr);
        if ((pml4_entry & PTE_PRESENT) == 0) {
            return 1;  // PML4エントリが存在しない
        }

        // Level 3: PDPT → PD
        MemAddr pdpt_base = pml4_entry & PTE_ADDR_MASK;
        ulong pdpt_index = (virt_addr >> PDPT_SHIFT) & INDEX_MASK;
        MemAddr pdpt_entry_addr = pdpt_base + (pdpt_index * 8);
        ulong pdpt_entry = vmm_read64(pdpt_entry_addr);
        if ((pdpt_entry & PTE_PRESENT) == 0) {
            return 1;  // PDPTエントリが存在しない
        }

        // Level 2: PD → PT
        MemAddr pd_base = pdpt_entry & PTE_ADDR_MASK;
        ulong pd_index = (virt_addr >> PD_SHIFT) & INDEX_MASK;
        MemAddr pd_entry_addr = pd_base + (pd_index * 8);
        ulong pd_entry = vmm_read64(pd_entry_addr);
        if ((pd_entry & PTE_PRESENT) == 0) {
            return 1;  // PDエントリが存在しない
        }

        // Level 1: PTエントリをクリア
        MemAddr pt_base = pd_entry & PTE_ADDR_MASK;
        ulong pt_index = (virt_addr >> PT_SHIFT) & INDEX_MASK;
        MemAddr pt_entry_addr = pt_base + (pt_index * 8);
        vmm_write64(pt_entry_addr, 0);  // エントリクリア

        // TLBフラッシュ
        vmm_invlpg(virt_addr);

        return 0;
    }

    /// 仮想アドレスの物理アドレスを取得（ページテーブルウォーク）
    ///
    /// virt_addr: 仮想アドレス
    ///
    /// 戻り値: 物理アドレス（マッピングなしの場合は0）
    MemAddr translate(MemAddr virt_addr) {
        MemAddr pml4_base = self.cr3_value & PTE_ADDR_MASK;

        // Level 4
        ulong pml4_index = (virt_addr >> PML4_SHIFT) & INDEX_MASK;
        ulong pml4_entry = vmm_read64(pml4_base + (pml4_index * 8));
        if ((pml4_entry & PTE_PRESENT) == 0) {
            return 0;
        }

        // Level 3
        MemAddr pdpt_base = pml4_entry & PTE_ADDR_MASK;
        ulong pdpt_index = (virt_addr >> PDPT_SHIFT) & INDEX_MASK;
        ulong pdpt_entry = vmm_read64(pdpt_base + (pdpt_index * 8));
        if ((pdpt_entry & PTE_PRESENT) == 0) {
            return 0;
        }

        // Level 2
        MemAddr pd_base = pdpt_entry & PTE_ADDR_MASK;
        ulong pd_index = (virt_addr >> PD_SHIFT) & INDEX_MASK;
        ulong pd_entry = vmm_read64(pd_base + (pd_index * 8));
        if ((pd_entry & PTE_PRESENT) == 0) {
            return 0;
        }

        // Level 1
        MemAddr pt_base = pd_entry & PTE_ADDR_MASK;
        ulong pt_index = (virt_addr >> PT_SHIFT) & INDEX_MASK;
        ulong pt_entry = vmm_read64(pt_base + (pt_index * 8));
        if ((pt_entry & PTE_PRESENT) == 0) {
            return 0;
        }

        // 物理アドレス = PTエントリのアドレス部分 + ページ内オフセット
        MemAddr page_phys = pt_entry & PTE_ADDR_MASK;
        ulong page_offset = virt_addr & 4095;  // 下位12ビット
        return page_phys + page_offset;
    }

    /// 統計情報出力
    void print_stats() {
        SerialPort serial = {port: 0x3F8};
        DebugPort debug(0xE9);

        serial.puts("[VMM] CR3=0x" as void*);
        serial.print_hex(self.cr3_value);
        serial.puts(", paging=" as void*);
        if (self.is_active == 1) {
            serial.puts("active" as void*);
        }
        serial.puts(", maps=" as void*);
        serial.print_hex(self.map_count);
        serial.putc(10);

        debug.puts("[VMM] CR3=0x" as void*);
        debug.print_hex(self.cr3_value);
        debug.puts(", maps=" as void*);
        debug.print_hex(self.map_count);
        debug.println("" as void*);
    }
}
