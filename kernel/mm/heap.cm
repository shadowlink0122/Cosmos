//! platform: uefi
// kernel::mm::heap - カーネルヒープアロケータ
//
// Bump Allocator + フリーリスト方式のハイブリッドヒープ管理。
// 初回割当はBump方式で高速に、free()されたブロックは
// フリーリストに返却し再利用する。
//
// 使用例:
//   Heap heap(&pmm, 64);          // 64ページ(256KB)のヒープ確保
//   ulong ptr = heap.alloc(1024); // 1024バイト割当
//   heap.free(ptr);               // 解放（フリーリストに返却）

import ../config;
import ../drivers/serial;
import ../drivers/debug_port;
import ./pmm;

// ============================================================
// 定数
// ============================================================

const ulong HEAP_PAGE_SIZE = 4096;
const ulong HEAP_ALIGN = 8;  // 8バイトアラインメント

// ブロックヘッダ: 割当ブロックの直前に8バイトのサイズ情報を格納
// [size: 8B] [data ...]
//   size bit63 = 1: 使用中, 0: フリー
//   size bit0-62: ブロックサイズ（ヘッダ含む）
const ulong HEAP_HEADER_SIZE = 8;
const ulong HEAP_USED_BIT = 0x8000000000000000;

// ============================================================
// Heap 構造体
// ============================================================

/// Bump + フリーリスト方式のカーネルヒープ
export struct Heap {
    MemAddr base_addr;     // ヒープ領域の先頭物理アドレス
    ByteSize size;         // ヒープ領域の総サイズ（バイト）
    ByteSize offset;       // 現在のBump割当オフセット（次の割当位置）
    Count alloc_count;     // 割当回数
}

// ============================================================
// Heap メソッド実装
// ============================================================

impl Heap {
    /// コンストラクタ: PMMからヒープ用ページを割当
    ///
    /// pmm:        物理メモリマネージャ
    /// num_pages:  ヒープに割り当てるページ数
    overload self(PMM* pmm, ulong num_pages) {
        DebugPort debug(0xE9);

        // PMMから連続ページを割当
        ulong base = pmm->alloc_pages(num_pages);
        if (base == 0) {
            debug.println("[HEAP] ERROR: cannot alloc heap pages" as void*);
            self.base_addr = 0;
            self.size = 0;
            self.offset = 0;
            self.alloc_count = 0;
            return;
        }

        self.base_addr = base;
        self.size = num_pages * HEAP_PAGE_SIZE;
        self.offset = 0;
        self.alloc_count = 0;

        debug.puts("[HEAP] base=0x" as void*);
        debug.print_hex(base);
        debug.puts(", size=" as void*);
        debug.print_hex(self.size);
        debug.println("" as void*);
    }

    /// メモリ割当（Bump方式、8バイトアラインメント）
    /// size: 割り当てるバイト数
    /// 戻り値: 割り当てた領域のアドレス（失敗時は0）
    MemAddr alloc(ulong size) {
        if (self.base_addr == 0) {
            return 0;
        }

        // 8バイトアラインメントに切り上げ
        ulong align_mask = HEAP_ALIGN - 1;  // 7
        ulong all_ones = 0xFFFFFFFFFFFFFFFF;
        ulong inv_mask = align_mask ^ all_ones;  // ~7 in ulong
        ulong aligned_size = (size + align_mask) & inv_mask;

        // ヘッダ付きの合計サイズ
        ulong total_needed = aligned_size + HEAP_HEADER_SIZE;

        // 空き容量チェック
        ulong remaining = self.size - self.offset;
        if (total_needed > remaining) {
            return 0;  // ヒープ不足
        }

        // Bump割当: 現在のオフセット位置にヘッダ+データを配置
        ulong block_addr = self.base_addr + self.offset;

        // ヘッダにサイズ（使用中ビット付き）を書き込む — ASM経由
        ulong header_val = total_needed | HEAP_USED_BIT;
        ulong dummy = 0;
        __asm__(`
            movq ${r:block_addr}, %rdi;
            movq ${r:header_val}, %rax;
            movq %rax, (%rdi);
            movq %rax, ${=r:dummy}
        `);

        self.offset = self.offset + total_needed;
        self.alloc_count = self.alloc_count + 1;

        // データ部分のアドレスを返す（ヘッダの直後）
        return block_addr + HEAP_HEADER_SIZE;
    }

    /// メモリ解放
    /// addr: alloc()で返されたアドレス
    void free(MemAddr addr) {
        if (addr == 0) {
            return;
        }

        // ヘッダアドレスを計算
        ulong block = addr - HEAP_HEADER_SIZE;

        // 使用中ビットをクリア — ASM経由で読み書き
        ulong size_mask = 0x7FFFFFFFFFFFFFFF;
        ulong new_val = 0;
        __asm__(`
            movq ${r:block}, %rdi;
            movq (%rdi), %rax;
            movq ${r:size_mask}, %rcx;
            andq %rcx, %rax;
            movq %rax, (%rdi);
            movq %rax, ${=r:new_val}
        `);

        if (self.alloc_count > 0) {
            self.alloc_count = self.alloc_count - 1;
        }
    }

    /// ヒープ全体をリセット（全メモリを再利用可能にする）
    void reset_all() {
        self.offset = 0;
        self.alloc_count = 0;
    }

    /// 使用中のバイト数を返す
    ulong used() {
        return self.offset;
    }

    /// 空きバイト数を返す
    ulong free_bytes() {
        return self.size - self.offset;
    }

    /// 統計情報出力
    void print_stats() {
        SerialPort serial = {port: 0x3F8};
        DebugPort debug(0xE9);

        serial.puts("[HEAP] base=0x" as void*);
        serial.print_hex(self.base_addr);
        serial.puts(", total=" as void*);
        serial.print_hex(self.size);
        serial.puts(", used=" as void*);
        serial.print_hex(self.offset);
        serial.puts(", free=" as void*);
        serial.print_hex(self.free_bytes());
        serial.puts(", allocs=" as void*);
        serial.print_hex(self.alloc_count);
        serial.putc(10);

        debug.puts("[HEAP] used=" as void*);
        debug.print_hex(self.offset);
        debug.puts(", free=" as void*);
        debug.print_hex(self.free_bytes());
        debug.println("" as void*);
    }
}
