//! platform: uefi
// kernel::boot::gdt - GDT（グローバルディスクリプタテーブル）設定
//
// x86_64 Long Mode用のフラットセグメントモデル。
// ExitBootServices後に自前のGDTを設定するために使用。
//
// GDTエントリ構成:
//   [0] Null Descriptor       (必須)
//   [1] Kernel Code Segment   (CS: 64-bit, Ring 0)
//   [2] Kernel Data Segment   (DS: Ring 0)
//
// 注意: x86_64 Long Modeでは、ベース/リミットはほとんど無視される。
//       Code Segmentの L(Long) ビットとDB=0 が重要。
//
// 重要: GDTデータは永続メモリに配置する必要がある。
//       lgdt後もCPUがGDTを参照し続けるため、一時メモリ
//       （関数のスタックフレーム等）に配置すると、
//       割り込み発生時にCPUがGDTを読み直した際に#GPが起きる。

import ./drivers/serial;
import ./drivers/debug_port;

// ============================================================
// GDTエントリ定数（8バイト = ulong 1個）
// ============================================================

// Null Descriptor: すべてゼロ
const ulong GDT_NULL = 0x0000000000000000;

// Kernel Code Segment (Ring 0, 64-bit long mode):
//   Byte layout: 0x00AF9A000000FFFF
const ulong GDT_KERNEL_CODE = 0x00AF9A000000FFFF;

// Kernel Data Segment (Ring 0):
//   Byte layout: 0x00CF92000000FFFF
const ulong GDT_KERNEL_DATA = 0x00CF92000000FFFF;

// セグメントセレクタ（GDTエントリのインデックス * 8）
const ulong KERNEL_CS = 0x08;  // GDT[1]
const ulong KERNEL_DS = 0x10;  // GDT[2]

// GDTデータの永続配置アドレス
// UEFIアイデンティティマッピング下で安全に使用可能な低メモリ領域
// 0x800は従来のBDA/IVT領域の上で、UEFIでは通常未使用
const ulong GDT_PERMANENT_ADDR = 0x800;

// ============================================================
// GDT読み込み
// ============================================================

/// GDTを初期化してCPUにロードし、セグメントレジスタを再設定する
///
/// GDTデータは固定アドレス(0x800)に配置する。
/// この領域はUEFI環境ではカーネルが自由に使用できる。
export void gdt_init() {
    DebugPort debug;
    debug.port = 0xE9;
    debug.println("[BOOT] gdt_init: start" as void*);

    // GDT定数をローカル変数にコピー（ASMから参照するため）
    ulong gdt_null = GDT_NULL;
    ulong gdt_code = GDT_KERNEL_CODE;
    ulong gdt_data = GDT_KERNEL_DATA;
    ulong cs_sel = KERNEL_CS;
    ulong ds_sel = KERNEL_DS;
    ulong gdt_limit = 23 as ulong;  // 3 * 8 - 1
    ulong gdt_addr = GDT_PERMANENT_ADDR;

    // GDTエントリを固定アドレスに書き込み、lgdtでロード
    // far returnでCSを再設定し、DS/ES/SS/FS/GSを設定
    __asm__(`
        // 永続GDTアドレスをRDIにロード
        movq ${r:gdt_addr}, %rdi;

        // GDTエントリを永続メモリに書き込み
        movq ${r:gdt_null}, %rax;
        movq %rax, (%rdi);          // [0] Null Descriptor
        movq ${r:gdt_code}, %rax;
        movq %rax, 8(%rdi);         // [1] Kernel Code
        movq ${r:gdt_data}, %rax;
        movq %rax, 16(%rdi);        // [2] Kernel Data

        // GDTR構造体を構築（offset 24に配置）
        movq ${r:gdt_limit}, %rax;
        movw %ax, 24(%rdi);         // limit = 23
        movq %rdi, %rax;
        movq %rax, 26(%rdi);        // base = GDT先頭アドレス

        // lgdt: GDTをCPUにロード
        lgdt 24(%rdi);

        // セグメントレジスタを再設定
        movq ${r:ds_sel}, %rax;
        movw %ax, %ds;
        movw %ax, %es;
        movw %ax, %ss;
        movw $$0, %ax;
        movw %ax, %fs;
        movw %ax, %gs;

        // far return でCSを再設定
        leaq 2f(%rip), %rax;
        pushq ${r:cs_sel};
        pushq %rax;
        lretq;
        2:
    `);

    debug.println("[BOOT] gdt_init: done" as void*);
    SerialPort serial;
    serial.port = 0x3F8;
    serial.println("[Cosmos] GDT initialized" as void*);
}
