//! platform: uefi
// kernel::isr - ISR（割り込みサービスルーチン）と例外ハンドラ
//
// CPU例外（ベクタ0-31）の処理を行う。
// 各ISRはCm関数として実装し、例外発生時にベクタ番号を
// シリアルに出力してHLTループに入る。
//
// アーキテクチャ:
//   ISRスタブ関数 → exception_handler() → HLTループ
//
// 注意: Cmコンパイラの__asm__内からCm関数シンボルを
//       直接参照できないため、各ISRスタブは独立したASMブロックで
//       iretq まで完結する設計とする。

import ./idt;
import ./drivers/serial;
import ./drivers/debug_port;

// ============================================================
// 例外名テーブル
// ============================================================

/// ベクタ番号に対する例外名を返す
export void* exception_name(ulong vector) {
    if (vector == 0)  { return "Division Error (#DE)" as void*; }
    if (vector == 1)  { return "Debug (#DB)" as void*; }
    if (vector == 2)  { return "NMI" as void*; }
    if (vector == 3)  { return "Breakpoint (#BP)" as void*; }
    if (vector == 4)  { return "Overflow (#OF)" as void*; }
    if (vector == 5)  { return "Bound Range (#BR)" as void*; }
    if (vector == 6)  { return "Invalid Opcode (#UD)" as void*; }
    if (vector == 7)  { return "Device Not Available (#NM)" as void*; }
    if (vector == 8)  { return "Double Fault (#DF)" as void*; }
    if (vector == 10) { return "Invalid TSS (#TS)" as void*; }
    if (vector == 11) { return "Segment Not Present (#NP)" as void*; }
    if (vector == 12) { return "Stack Fault (#SS)" as void*; }
    if (vector == 13) { return "General Protection (#GP)" as void*; }
    if (vector == 14) { return "Page Fault (#PF)" as void*; }
    if (vector == 16) { return "x87 FP Error (#MF)" as void*; }
    if (vector == 17) { return "Alignment Check (#AC)" as void*; }
    if (vector == 18) { return "Machine Check (#MC)" as void*; }
    if (vector == 19) { return "SIMD FP Error (#XM)" as void*; }
    return "Unknown Exception" as void*;
}

// ============================================================
// 共通例外ハンドラ (Cm)
// ============================================================

/// 例外発生時にシリアルにデバッグ情報を出力し、HLTループに入る
export void exception_handler(ulong vector, ulong error_code) {
    serial_println("" as void*);
    serial_println("========================================" as void*);
    serial_println("[EXCEPTION] CPU Exception Caught!" as void*);
    serial_println("========================================" as void*);

    serial_puts("  Vector: " as void*);
    serial_print_hex(vector);
    serial_puts(" (" as void*);
    serial_puts(exception_name(vector));
    serial_println(")" as void*);

    serial_puts("  Error Code: " as void*);
    serial_print_hex(error_code);
    serial_println("" as void*);

    serial_println("========================================" as void*);
    serial_println("[EXCEPTION] System halted." as void*);

    // デバッグポートにも出力（テスト検出用）
    debug_puts("[EXCEPTION] vector=" as void*);
    debug_print_hex(vector);
    debug_println("" as void*);

    // HLTループ
    while (true) {
        __asm__("hlt");
    }
}

// ============================================================
// ISRスタブ — 各ベクタ用の独立関数
// ============================================================
// CPU例外発生時、CPUはスタックにSS/RSP/RFLAGS/CS/RIP(+エラーコード)をpush
// ISRスタブはスタックからエラーコード（ある場合）を読み取り、
// exception_handlerを呼び出す。
// 注意: これらの関数は割り込みハンドラとして呼ばれるため、
//       通常のcall規約ではなくiretqで戻る必要がある。
//       ただしexception_handlerはHLTループなので実質戻らない。

// --- エラーコードなしの例外 ---

export void isr_0() {
    // #DE: Division Error
    exception_handler(0, 0);
}

export void isr_1() {
    // #DB: Debug
    exception_handler(1, 0);
}

export void isr_2() {
    // NMI
    exception_handler(2, 0);
}

export void isr_3() {
    // #BP: Breakpoint
    exception_handler(3, 0);
}

export void isr_4() {
    // #OF: Overflow
    exception_handler(4, 0);
}

export void isr_5() {
    // #BR: Bound Range Exceeded
    exception_handler(5, 0);
}

export void isr_6() {
    // #UD: Invalid Opcode
    exception_handler(6, 0);
}

export void isr_7() {
    // #NM: Device Not Available
    exception_handler(7, 0);
}

// --- エラーコードありの例外 ---
// エラーコードはCPUがスタックにpushするが、
// Cmの通常関数として呼ばれた場合はスタックを読めないため
// 暫定的にerror_code=0で処理する

export void isr_8() {
    // #DF: Double Fault
    exception_handler(8, 0);
}

export void isr_9() {
    // 予約
    exception_handler(9, 0);
}

export void isr_10() {
    // #TS: Invalid TSS
    exception_handler(10, 0);
}

export void isr_11() {
    // #NP: Segment Not Present
    exception_handler(11, 0);
}

export void isr_12() {
    // #SS: Stack Segment Fault
    exception_handler(12, 0);
}

export void isr_13() {
    // #GP: General Protection Fault
    exception_handler(13, 0);
}

export void isr_14() {
    // #PF: Page Fault
    exception_handler(14, 0);
}

export void isr_15() {
    // 予約
    exception_handler(15, 0);
}

export void isr_16() {
    // #MF: x87 Floating-Point Error
    exception_handler(16, 0);
}

export void isr_17() {
    // #AC: Alignment Check
    exception_handler(17, 0);
}

export void isr_18() {
    // #MC: Machine Check
    exception_handler(18, 0);
}

export void isr_19() {
    // #XM: SIMD Floating-Point Exception
    exception_handler(19, 0);
}

export void isr_20() { exception_handler(20, 0); }
export void isr_21() { exception_handler(21, 0); }
export void isr_22() { exception_handler(22, 0); }
export void isr_23() { exception_handler(23, 0); }
export void isr_24() { exception_handler(24, 0); }
export void isr_25() { exception_handler(25, 0); }
export void isr_26() { exception_handler(26, 0); }
export void isr_27() { exception_handler(27, 0); }
export void isr_28() { exception_handler(28, 0); }
export void isr_29() { exception_handler(29, 0); }
export void isr_30() { exception_handler(30, 0); }
export void isr_31() { exception_handler(31, 0); }

// ============================================================
// ISR登録ヘルパー: 関数ポインタをulongアドレスとして取得
// ============================================================

/// 関数ポインタをulongアドレスに変換するヘルパー
export ulong fn_addr(void* fn) {
    return fn as ulong;
}

// ============================================================
// ISR登録
// ============================================================

/// 全例外ISR（0-31）をIDTに登録する
export void isr_init(uint* idt_table) {
    // ベクタ3（ブレークポイント）以外はInterrupt Gate
    idt_set_gate(idt_table, 0,  fn_addr(isr_0  as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 1,  fn_addr(isr_1  as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 2,  fn_addr(isr_2  as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 3,  fn_addr(isr_3  as void*), IDT_TRAP_GATE);
    idt_set_gate(idt_table, 4,  fn_addr(isr_4  as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 5,  fn_addr(isr_5  as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 6,  fn_addr(isr_6  as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 7,  fn_addr(isr_7  as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 8,  fn_addr(isr_8  as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 9,  fn_addr(isr_9  as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 10, fn_addr(isr_10 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 11, fn_addr(isr_11 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 12, fn_addr(isr_12 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 13, fn_addr(isr_13 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 14, fn_addr(isr_14 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 15, fn_addr(isr_15 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 16, fn_addr(isr_16 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 17, fn_addr(isr_17 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 18, fn_addr(isr_18 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 19, fn_addr(isr_19 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 20, fn_addr(isr_20 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 21, fn_addr(isr_21 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 22, fn_addr(isr_22 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 23, fn_addr(isr_23 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 24, fn_addr(isr_24 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 25, fn_addr(isr_25 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 26, fn_addr(isr_26 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 27, fn_addr(isr_27 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 28, fn_addr(isr_28 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 29, fn_addr(isr_29 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 30, fn_addr(isr_30 as void*), IDT_INTERRUPT_GATE);
    idt_set_gate(idt_table, 31, fn_addr(isr_31 as void*), IDT_INTERRUPT_GATE);

    serial_println("[Cosmos] ISR stubs registered (vectors 0-31)" as void*);
}
