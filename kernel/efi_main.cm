//! platform: uefi
// Cosmos OS - Cm言語で開発するOS
//
// 全モジュールでinterface/implパターンを使用:
//   serial.println(), debug.println(), pic.init(),
//   idt.init(), isr.init(), console.println()
//
// ビルド: make clean && make && make run

import ./libs/efi_core;
import ./libs/efi_text;
import ./libs/efi_input;
import ./libs/efi_memmap;
import ./libs/efi_gop;
import ./util/menu;
import ./util/memmap;
import ./util/keyboard;
import ./util/sysinfo;
import ./util/convert;
import ./util/graphics;
import ./boot_info;
import ./gdt;
import ./idt;
import ./isr;
import ./drivers/serial;
import ./drivers/debug_port;
import ./drivers/pic;
import ./lib/font;
import ./lib/print;
import ./mm/pmm;
import ./mm/vmm;

// ============================================================
// ExitBootServices
// ============================================================

/// ExitBootServices (BootServices + 0xE8)
ulong efi_exit_boot_services(void* system_table, void* image_handle, ulong map_key) {
    ulong* st = system_table as ulong*;
    ulong bs_addr = *(st + 12);  // offset 0x60 = BootServices
    ulong* bs = bs_addr as ulong*;

    ulong exit_fn = *(bs + 29);

    ulong fn_val = exit_fn;
    ulong ih_val = image_handle as ulong;

    ulong result = 0;
    __asm__(`
        pushq ${r:fn_val};
        pushq ${r:ih_val};
        pushq ${r:map_key};
        popq %rdx;
        popq %rcx;
        popq %r10;
        subq $$32, %rsp;
        callq *%r10;
        addq $$32, %rsp;
        movq %rax, ${=r:result}
    `);
    return result;
}

// ============================================================
// BootInfo収集
// ============================================================

/// GOP情報をBootInfoに収集する
void collect_fb_info(void* system_table, BootInfo* info) {
    // シリアルポートをローカル生成（コンストラクタで初期化済み）
    SerialPort serial(0x3F8);

    ulong fb_base = 0;
    ulong width = 0;
    ulong height = 0;
    ulong stride = 0;

    ulong status = gop_init(system_table, &fb_base, &width, &height, &stride);
    long signed_status = status as long;
    if (signed_status < 0) {
        serial.println("[Cosmos] WARNING: GOP init failed" as void*);
        return;
    }

    info->fb.base_addr = fb_base;
    info->fb.width = width as uint;
    info->fb.height = height as uint;
    info->fb.stride = stride as uint;
    info->fb.pixel_format = 0;  // BGRA（デフォルト）
    info->fb.size = height * stride * 4;

    serial.println("[Cosmos] Framebuffer info collected" as void*);
    serial.puts("[Cosmos]   Resolution: " as void*);
    serial.print_hex(width);
    serial.puts(" x " as void*);
    serial.print_hex(height);
    serial.putc(10);
}

/// メモリマップを取得してBootInfoに格納する
ulong collect_memory_map(void* system_table, BootInfo* info) {
    // デバッグ・シリアルポート初期化
    DebugPort debug(0xE9);
    SerialPort serial(0x3F8);
    debug.println("[BOOT] collect_memory_map: start" as void*);

    ulong map_size = 0;
    ulong map_key = 0;
    ulong desc_size = 0;
    ulong desc_ver = 0;

    ulong status = efi_get_memory_map(system_table, &map_size, 0 as void*, &map_key, &desc_size, &desc_ver);

    ulong alloc_size = map_size + 4096;

    void* map_buffer = 0 as void*;
    status = efi_alloc_pool(system_table, alloc_size, &map_buffer);

    long signed_status = status as long;
    if (signed_status < 0) {
        debug.println("[BOOT] collect_memory_map: FAIL alloc" as void*);
        return status;
    }

    ulong actual_map_size = alloc_size;
    status = efi_get_memory_map(system_table, &actual_map_size, map_buffer, &map_key, &desc_size, &desc_ver);

    signed_status = status as long;
    if (signed_status < 0) {
        debug.println("[BOOT] collect_memory_map: FAIL get_map" as void*);
        return status;
    }

    info->mmap.map_buffer = map_buffer;
    info->mmap.map_size = actual_map_size;
    info->mmap.map_key = map_key;
    info->mmap.desc_size = desc_size;
    info->mmap.desc_version = desc_ver as uint;
    info->mmap.entry_count = (actual_map_size / desc_size) as uint;

    debug.println("[BOOT] collect_memory_map: OK" as void*);
    return 0;
}

// ============================================================
// カーネルメイン（ExitBootServices後）
// ============================================================

/// ExitBootServices後のカーネルエントリポイント
void kernel_main(BootInfo* info) {
    // シリアル・デバッグポート初期化
    SerialPort serial(0x3F8);
    DebugPort debug(0xE9);

    debug.println("[BOOT] kernel_main entered" as void*);
    serial.println("[Cosmos] === Kernel Main ===" as void*);
    serial.println("[Cosmos] ExitBootServices completed successfully" as void*);

    // GDT設定
    gdt_init();

    // PIC 8259A初期化（IRQリマップ 32-47、全マスク）
    PIC8259A pic();
    pic.init();
    serial.println("[Cosmos] PIC initialized (IRQ remapped to vectors 32-47)" as void*);
    debug.println("[BOOT] PIC initialized" as void*);

    // IDT初期化（256エントリ + lidt）
    uint* idt_table = info->mmap.map_buffer as uint*;
    IDT idt(idt_table);
    serial.println("[Cosmos] IDT initialized (256 entries)" as void*);
    debug.println("[BOOT] IDT initialized" as void*);

    // ISRスタブ登録（例外0-31）
    ISRManager isr(idt_table);
    serial.println("[Cosmos] ISR stubs registered (vectors 0-31)" as void*);
    debug.println("[BOOT] ISR registered" as void*);

    // IDTを再ロード（ISR登録後）
    idt.load();
    serial.println("[Cosmos] IDT loaded with ISR stubs" as void*);
    debug.println("[BOOT] IDT reloaded" as void*);

    // 物理メモリマネージャ初期化
    PMM pmm(info->mmap.map_buffer, info->mmap.map_size,
            info->mmap.desc_size as ulong, info->mmap.entry_count as ulong);
    pmm.print_stats();
    serial.println("[Cosmos] PMM initialized (bitmap physical memory manager)" as void*);
    debug.println("[BOOT] PMM initialized" as void*);

    // PMM基本テスト: alloc → free → re-alloc
    ulong page1 = pmm.alloc_page();
    serial.puts("[PMM] alloc_page() = 0x" as void*);
    serial.print_hex(page1);
    serial.putc(10);
    ulong page2 = pmm.alloc_page();
    pmm.free_page(page1);
    ulong page3 = pmm.alloc_page();
    serial.puts("[PMM] alloc-free-alloc test: page3=0x" as void*);
    serial.print_hex(page3);
    serial.putc(10);
    // page3 should == page1 (reuse freed page)
    pmm.free_page(page2);
    pmm.free_page(page3);
    debug.println("[BOOT] PMM alloc/free test OK" as void*);

    // ページテーブル管理（UEFIのアイデンティティマッピングを継承）
    VMM vmm();
    vmm.print_stats();
    serial.println("[Cosmos] Paging enabled (identity mapped)" as void*);
    debug.println("[BOOT] paging enabled" as void*);

    // フレームバッファテキストコンソール初期化
    ulong fb = info->fb.base_addr;
    ulong fb_w = info->fb.width as ulong;
    ulong fb_h = info->fb.height as ulong;
    ulong fb_stride = info->fb.stride as ulong;

    if (fb != 0) {
        serial.println("[Cosmos] Initializing framebuffer console..." as void*);

        // FBConsole構造体をスタック上に確保・初期化（Consoleインターフェース実装）
        FBConsole console;
        fb_init(&console, fb, fb_w, fb_h, fb_stride);

        // 画面クリア
        console.clear();
        serial.println("[Cosmos] Framebuffer cleared" as void*);

        // ブートメッセージをフレームバッファに表示
        console.println("" as void*);
        console.set_color(0x00FFFFFF);  // 白
        console.println("  ========================================" as void*);
        console.println("  Cosmos OS v0.2.0" as void*);
        console.println("  ========================================" as void*);
        console.println("" as void*);

        console.set_color(0x0000FF00);  // 緑
        console.println("  [OK] ExitBootServices" as void*);
        console.println("  [OK] GDT initialized" as void*);
        console.println("  [OK] PIC initialized (IRQ 32-47)" as void*);
        console.println("  [OK] IDT initialized (256 entries)" as void*);
        console.println("  [OK] ISR registered (exceptions 0-31)" as void*);
        console.println("  [OK] Serial console (COM1 115200 8N1)" as void*);
        console.println("  [OK] Framebuffer console" as void*);
        console.println("" as void*);

        console.set_color(0x00FFFFFF);  // 白
        console.puts("  Framebuffer: " as void*);
        serial.print_hex(fb_w);
        console.puts("  Resolution: " as void*);
        console.println("" as void*);
        console.println("" as void*);

        console.set_color(0x0000FFFF);  // シアン
        console.println("  Cosmos OS v0.2.0 booted successfully!" as void*);
        console.println("" as void*);

        console.set_color(0x00808080);  // グレー
        console.println("  Written in Cm - a systems programming language" as void*);

        serial.println("[Cosmos] Boot messages displayed on framebuffer" as void*);
    } else {
        serial.println("[Cosmos] WARNING: No framebuffer available" as void*);
    }

    serial.println("[Cosmos] ==============================" as void*);
    serial.println("[Cosmos] Cosmos OS v0.2.0 booted successfully!" as void*);
    serial.println("[Cosmos] ==============================" as void*);

    // HLTループ（カーネル待機）
    serial.println("[Cosmos] Entering halt loop" as void*);
    debug.println("[BOOT] halt" as void*);
    while (true) {
        __asm__("hlt");
    }
}

// ============================================================
// UEFI メインエントリ
// ============================================================

ulong efi_main(void* image_handle, void* system_table) {
    // デバッグ・シリアルポート初期化
    DebugPort debug(0xE9);
    debug.println("[BOOT] efi_main entered" as void*);

    SerialPort serial(0x3F8);
    serial.println("[Cosmos] Serial console initialized" as void*);
    serial.println("[Cosmos] UEFI boot started" as void*);
    debug.println("[BOOT] serial_init completed" as void*);

    efi_clear_screen(system_table);

    // バナー表示
    efi_println(system_table, "========================================" as void*);
    efi_println(system_table, "  Cosmos OS v0.1.0" as void*);
    efi_println(system_table, "========================================" as void*);
    efi_println(system_table, "" as void*);

    // ============================================================
    // Phase 1: BootInfo収集
    // ============================================================

    efi_println(system_table, "[Phase 1] Collecting boot information..." as void*);
    serial.println("[Cosmos] Phase 1: Collecting boot information" as void*);

    // BootInfo構造体をスタック上に確保
    BootInfo boot_info;
    boot_info.fb.base_addr = 0;
    boot_info.fb.size = 0;
    boot_info.fb.width = 0 as uint;
    boot_info.fb.height = 0 as uint;
    boot_info.fb.stride = 0 as uint;
    boot_info.fb.pixel_format = 0 as uint;
    boot_info.mmap.map_buffer = 0 as void*;
    boot_info.mmap.map_size = 0;
    boot_info.mmap.map_key = 0;
    boot_info.mmap.desc_size = 0;
    boot_info.mmap.desc_version = 0 as uint;
    boot_info.mmap.entry_count = 0 as uint;
    boot_info.acpi_rsdp = 0;

    // GOP（フレームバッファ）情報の収集
    efi_println(system_table, "  Initializing GOP..." as void*);
    collect_fb_info(system_table, &boot_info);

    // メモリマップの収集
    efi_println(system_table, "  Getting memory map..." as void*);
    ulong mmap_status = collect_memory_map(system_table, &boot_info);
    long signed_mmap_status = mmap_status as long;
    if (signed_mmap_status < 0) {
        efi_println(system_table, "  ERROR: Memory map collection failed!" as void*);
        efi_println(system_table, "  System halted." as void*);
        while (true) {
            __asm__("hlt");
        }
    }

    efi_println(system_table, "  Boot information collected." as void*);
    efi_println(system_table, "" as void*);

    // ============================================================
    // Phase 1: ExitBootServices
    // ============================================================

    efi_println(system_table, "[Phase 1] Calling ExitBootServices..." as void*);
    serial.println("[Cosmos] Calling ExitBootServices..." as void*);
    debug.println("[BOOT] calling ExitBootServices" as void*);

    ulong exit_status = efi_exit_boot_services(system_table, image_handle, boot_info.mmap.map_key);
    long signed_exit = exit_status as long;

    if (signed_exit < 0) {
        serial.println("[Cosmos] ExitBootServices failed, retrying..." as void*);

        ulong retry_map_size = boot_info.mmap.map_size + 4096;
        ulong retry_map_key = 0;
        ulong retry_desc_size = 0;
        ulong retry_desc_ver = 0;
        efi_get_memory_map(system_table, &retry_map_size, boot_info.mmap.map_buffer,
        &retry_map_key, &retry_desc_size, &retry_desc_ver);

        boot_info.mmap.map_key = retry_map_key;

        exit_status = efi_exit_boot_services(system_table, image_handle, retry_map_key);
        signed_exit = exit_status as long;

        if (signed_exit < 0) {
            serial.println("[Cosmos] FATAL: ExitBootServices retry failed!" as void*);
            debug.println("[BOOT] FATAL: ExitBootServices retry failed" as void*);
            while (true) {
                __asm__("hlt");
            }
        }
    }

    // ============================================================
    // ExitBootServices成功 — ここからはBoot Services使用不可
    // ============================================================

    serial.println("[Cosmos] ExitBootServices OK" as void*);
    debug.println("[BOOT] ExitBootServices OK" as void*);

    // カーネルメインに制御を移す
    kernel_main(&boot_info);

    // ここには到達しない
    return 0;
}
