//! platform: uefi
// CosmOS - Cm言語で開発するOS
//
// 全モジュールでinterface/implパターンを使用:
//   serial.println(), debug.println(), pic.init(),
//   idt.init(), isr.init(), console.println()
//
// ビルド: make clean && make && make run

import ./libs/efi_core;
import ./libs/efi_text;
import ./libs/efi_input;
import ./libs/efi_memmap;
import ./libs/efi_gop;
import ./libs/efi_file;
import ./util/menu;
import ./util/memmap;
import ./util/keyboard;
import ./util/sysinfo;
import ./util/convert;
import ./util/graphics;
import ./arch/boot_info;
import ./arch/gdt;
import ./arch/idt;
import ./arch/isr;
import ./arch/tss;
import ./drivers/serial;
import ./drivers/debug_port;
import ./drivers/pic;
import ./drivers/pit;
import ./drivers/keyboard;
import ./lib/font;
import ./lib/print;
import ./mm/pmm;
import ./mm/vmm;
import ./mm/heap;
import ./sched/task;
import ./sched/scheduler;
import ./shell/shell;
import ./fs/cosmfs;
import ./fs/initramfs;
import ./tasks/demo;
import ./libs/boot_services;
import ./arch/usermode;
import ./sys/syscall;
import ./sys/env;

// ============================================================
// カーネルメイン（ExitBootServices後）
// ============================================================

/// ExitBootServices後のカーネルエントリポイント
void kernel_main(BootInfo* info) {
    // シリアル・デバッグポート初期化
    SerialPort serial(0x3F8);
    DebugPort debug(0xE9);

    debug.println("[BOOT] kernel_main entered" as void*);
    serial.println("[CosmOS] === Kernel Main ===" as void*);
    serial.println("[CosmOS] ExitBootServices completed successfully" as void*);

    // GDT設定（固定アドレス0x800に永続配置）
    gdt_init();

    // PIC 8259A初期化（IRQリマップ 32-47、全マスク）
    PIC8259A pic();
    pic.init();
    serial.println("[CosmOS] PIC initialized (IRQ remapped to vectors 32-47)" as void*);
    debug.println("[BOOT] PIC initialized" as void*);

    // IDT初期化（仮テーブル: メモリマップバッファを一時利用）
    // 注: この領域はPMM初期化で上書きされるため、
    //     PMM初期化後に専用ページで再構築する
    uint* idt_table = info->mmap.map_buffer as uint*;
    IDT idt(idt_table);
    serial.println("[CosmOS] IDT initialized (temporary)" as void*);
    debug.println("[BOOT] IDT initialized" as void*);

    // ISRスタブ登録（例外0-31）
    ISRManager isr(idt_table);
    serial.println("[CosmOS] ISR stubs registered (vectors 0-31)" as void*);
    debug.println("[BOOT] ISR registered" as void*);

    // IDTを再ロード（ISR登録後）
    idt.load();
    serial.println("[CosmOS] IDT loaded with ISR stubs" as void*);
    debug.println("[BOOT] IDT reloaded" as void*);

    // 物理メモリマネージャ初期化
    PMM pmm(info->mmap.map_buffer, info->mmap.map_size,
    info->mmap.desc_size as ulong, info->mmap.entry_count as ulong);
    pmm.print_stats();
    serial.println("[CosmOS] PMM initialized (bitmap physical memory manager)" as void*);
    debug.println("[BOOT] PMM initialized" as void*);

    // ページテーブル管理（UEFIのアイデンティティマッピングを継承）
    VMM vmm();
    vmm.print_stats();
    serial.println("[CosmOS] Paging enabled (identity mapped)" as void*);
    debug.println("[BOOT] paging enabled" as void*);

    // カーネルヒープ初期化（64ページ = 256KB）
    Heap heap(&pmm, 64);
    heap.print_stats();
    serial.println("[CosmOS] Kernel heap initialized (free-list allocator)" as void*);
    debug.println("[BOOT] heap initialized" as void*);

    // フレームバッファテキストコンソール初期化
    ulong fb = info->fb.base_addr;
    ulong fb_w = info->fb.width as ulong;
    ulong fb_h = info->fb.height as ulong;
    ulong fb_stride = info->fb.stride as ulong;

    if (fb != 0) {
        serial.println("[CosmOS] Initializing framebuffer console..." as void*);

        // グローバルFBConsoleを固定アドレスに初期化
        fb_init_global(fb, fb_w, fb_h, fb_stride);

        // バックバッファ確保（ダブルバッファリング用）
        // 固定アドレス 0x200000 (2MB) に配置。PMM reserved 0-1MB 以降の利用可能領域。
        ulong bb_bytes = fb_stride * fb_h * 4;
        MemAddr bb = 0x200000;
        // バックバッファを黒で初期化（REP STOSQ使用）
        ulong bb_qwords = bb_bytes / 8;
        ulong zero_val = 0;
        __asm__(`
            movq ${r:bb}, %rdi;
            movq ${r:zero_val}, %rax;
            movq ${r:bb_qwords}, %rcx;
            cld;
            rep stosq
        `);
        fb_set_backbuffer(bb);
        serial.println("[CosmOS] Backbuffer at 0x200000 for double-buffering" as void*);

        // implラッパー経由で操作
        FBConsole gcon();
        gcon.clear();

        // ブートバナー表示（QEMU画面）
        gcon.set_color(0x00FFFFFF);
        gcon.puts("  CosmOS v0.6.0" as void*);

        gcon.newline();
        gcon.newline();
        gcon.set_color(0x0000FF00);
        gcon.puts("  [OK] Boot completed" as void*);
        gcon.newline();
        gcon.set_color(0x0000FFFF);
        gcon.puts("  Written in Cm" as void*);
        gcon.newline();
        gcon.newline();

        serial.println("[CosmOS] Framebuffer initialized" as void*);
    } else {
        serial.println("[CosmOS] WARNING: No framebuffer available" as void*);
    }

    // PITタイマー初期化（100Hz）
    PIT pit();
    pit.init(&pic, idt_table);
    serial.println("[CosmOS] PIT timer initialized (100Hz)" as void*);
    debug.println("[BOOT] PIT initialized" as void*);

    // スケジューラ初期化
    sched_init(&pmm);
    serial.println("[CosmOS] Scheduler initialized" as void*);
    debug.println("[BOOT] scheduler initialized" as void*);

    // 割り込み有効化（sti）
    __asm__(`sti`);
        serial.println("[CosmOS] Interrupts enabled" as void*);
        debug.println("[BOOT] interrupts enabled" as void*);

        // TSS初期化（現在のRSPをカーネルスタックとして使用）
        ulong current_rsp = 0;
    __asm__(`
    movq %rsp, ${=r:current_rsp}
    `);
        tss_init(current_rsp);
        tss_install_gdt();
        serial.println("[CosmOS] TSS initialized" as void*);
        debug.println("[BOOT] TSS initialized" as void*);

        // syscall/sysret MSR初期化（高速パス有効化）
        MemAddr fast_handler = fn_addr(syscall_entry_fast as void*);
        usermode_init(fast_handler);
        debug.println("[BOOT] syscall/sysret fast path enabled" as void*);

        // キーボード初期化
        keyboard_init(&pic, idt_table);
        debug.println("[BOOT] keyboard initialized" as void*);

        // syscallハンドラー初期化（int 0x80）
        syscall_init(idt_table);
        debug.println("[BOOT] syscall handler initialized" as void*);

        // IPC メッセージキュー初期化
        ipc_init();
        debug.println("[BOOT] IPC initialized" as void*);

        // ============================================================
        // デモタスク生成（マルチタスク動作確認用）
        // ============================================================
        serial.println("[CosmOS] Spawning demo tasks... (DISABLED for rendering check)" as void*);
        // demo_spawn_tasks();
        sched_enable();
        serial.println("[CosmOS] Scheduler enabled" as void*);

        // デモタスクを開始（schedule呼出しで最初のタスクに切替）
        schedule();

        // CosmFS初期化
        cosmfs_init();
        debug.println("[BOOT] CosmFS initialized" as void*);

        // 環境変数初期化
        env_init();
        debug.println("[BOOT] environment variables initialized" as void*);

        // グローバルHeapポインタを保存（シェルコマンドからアクセス用）
        Heap* heap_ref = &heap;
        ulong heap_addr_val = heap_ref as ulong;
        ulong* global_heap_ptr = ADDR_GLOBAL_HEAP as ulong*;
        *global_heap_ptr = heap_addr_val;

        // initramfs: サンプルファイルをCosmFSにロード
        initramfs_load(&heap, info);
        debug.println("[BOOT] initramfs loaded" as void*);

        // シェル初期化（デモタスク完了後にプロンプト表示）
        shell_init();
        debug.println("[BOOT] shell initialized" as void*);

        // idleループ（タイマー割り込み+シェル+スケジューラ統合）
        serial.println("[CosmOS] Entering idle loop with shell" as void*);
        debug.println("[BOOT] entering idle loop" as void*);

        // リカバリーポイントを設定（例外発生時にここに復帰する）
        // RSPを保存し、復帰先アドレス(1:ラベル)をRIPとして記録
        // 初回: jmp 2f でスキップ → while loopへ
        // 復帰時: 1:ラベルから実行 → shell_recover() → while loopへ
        ulong recovery_rsp = 0;
        ulong recovery_rip = 0;
        ulong is_recovery = 0;
    __asm__(`
    movq %rsp, ${=r:recovery_rsp};
    leaq 1f(%rip), %rax;
    movq %rax, ${=r:recovery_rip};
    xorq %rcx, %rcx;
    movq %rcx, ${=r:is_recovery};
    jmp 2f;
    1:;
    movq $$1, ${=r:is_recovery};
    2:
    `);
        // リカバリーポイントを固定メモリに保存
        ulong* rsp_save = 0xD88 as ulong*;
        ulong* rip_save = 0xD90 as ulong*;
        *rsp_save = recovery_rsp;
        *rip_save = recovery_rip;

        // 例外から復帰した場合、シェルを復旧
        if (is_recovery != 0) {
        shell_recover();
        }

        while (true) {
        // 省電力待機（次のIRQで起床）
        __asm__("hlt");

        // OS標準カーソル点滅更新
        FBConsole con();
        con.cursor_update();

        // シェル入力処理
        shell_process_input();

        // need_reschedフラグを確認
        ulong resched = pit_check_resched();
        if (resched != 0) {
        // タイムスライスをデクリメント
        sched_timer_tick();
        ulong current_id = sched_current_id();
        ulong remaining = tcb_read(current_id, TCB_OFF_TIMESLICE);
        if (remaining == 0) {
        schedule();
        }
        }
        }
        }

        // ============================================================
        // UEFI メインエントリ
        // ============================================================

        ulong efi_main(void* image_handle, void* system_table) {
        // デバッグ・シリアルポート初期化
        DebugPort debug(0xE9);
        debug.println("[BOOT] efi_main entered" as void*);

        SerialPort serial(0x3F8);
        serial.println("[CosmOS] Serial console initialized" as void*);
        serial.println("[CosmOS] UEFI boot started" as void*);
        debug.println("[BOOT] serial_init completed" as void*);

        efi_clear_screen(system_table);

        // バナー表示
        efi_println(system_table, "========================================" as void*);
        efi_println(system_table, "  CosmOS v0.6.0" as void*);
        efi_println(system_table, "========================================" as void*);
        efi_println(system_table, "" as void*);

        // ============================================================
        // Phase 1: BootInfo収集
        // ============================================================

        efi_println(system_table, "[Phase 1] Collecting boot information..." as void*);
        serial.println("[CosmOS] Phase 1: Collecting boot information" as void*);

        // BootInfo構造体をスタック上に確保
        BootInfo boot_info = {
        fb: {
        base_addr: 0,
        size: 0,
        width: 0 as uint,
        height: 0 as uint,
        stride: 0 as uint,
        pixel_format: 0 as uint
        },
        mmap: {
        map_buffer: 0 as void*,
        map_size: 0, map_key: 0,
        desc_size: 0,
        desc_version: 0 as uint,
        entry_count: 0 as uint
        },
        acpi_rsdp: 0,
        initramfs_base: 0,
        initramfs_size: 0
        };

        // GOP（フレームバッファ）情報の収集
        efi_println(system_table, "  Initializing GOP..." as void*);
        collect_fb_info(system_table, &boot_info);

        // メモリマップの収集
        efi_println(system_table, "  Getting memory map..." as void*);
        ulong mmap_status = collect_memory_map(system_table, &boot_info);
        long signed_mmap_status = mmap_status as long;
        if (signed_mmap_status < 0) {
        efi_println(system_table, "  ERROR: Memory map collection failed!" as void*);
        efi_println(system_table, "  System halted." as void*);
        while (true) {
        __asm__("hlt");
        }
        }

        efi_println(system_table, "  Boot information collected." as void*);
        efi_println(system_table, "" as void*);

        // initramfsロード: ESPからhelp.cosmexeを読み込み
        efi_println(system_table, "  Loading initramfs from ESP..." as void*);
        // UCS-2ファイル名を固定メモリ(0xCE0)に構築
        efi_ascii_to_ucs2("\\help.cosmexe" as ulong, 0xCE0, 14);
        ulong initramfs_buf = 0;
        ulong initramfs_sz = 0;
        ulong load_status = efi_load_file(system_table, 0xCE0, &initramfs_buf, &initramfs_sz);
        long signed_load = load_status as long;
        if (signed_load < 0) {
        efi_println(system_table, "  WARNING: help.cosmexe not found on ESP" as void*);
        serial.println("[CosmOS] WARNING: initramfs load failed" as void*);
        }
        if (signed_load >= 0) {
        boot_info.initramfs_base = initramfs_buf;
        boot_info.initramfs_size = initramfs_sz;
        efi_println(system_table, "  initramfs loaded." as void*);
        serial.println("[CosmOS] initramfs loaded from ESP" as void*);
        }

        // ============================================================
        // Phase 1: ExitBootServices
        // ============================================================

        efi_println(system_table, "[Phase 1] Calling ExitBootServices..." as void*);
        serial.println("[CosmOS] Calling ExitBootServices..." as void*);
        debug.println("[BOOT] calling ExitBootServices" as void*);

        ulong exit_status = efi_exit_boot_services(system_table, image_handle, boot_info.mmap.map_key);
        long signed_exit = exit_status as long;

        if (signed_exit < 0) {
        serial.println("[CosmOS] ExitBootServices failed, retrying..." as void*);

        ulong retry_map_size = boot_info.mmap.map_size + 4096;
        ulong retry_map_key = 0;
        ulong retry_desc_size = 0;
        ulong retry_desc_ver = 0;
        efi_get_memory_map(system_table, &retry_map_size, boot_info.mmap.map_buffer,
        &retry_map_key, &retry_desc_size, &retry_desc_ver);

        boot_info.mmap.map_key = retry_map_key;

        exit_status = efi_exit_boot_services(system_table, image_handle, retry_map_key);
        signed_exit = exit_status as long;

        if (signed_exit < 0) {
        serial.println("[CosmOS] FATAL: ExitBootServices retry failed!" as void*);
        debug.println("[BOOT] FATAL: ExitBootServices retry failed" as void*);
        while (true) {
        __asm__("hlt");
        }
        }
        }

        // ============================================================
        // ExitBootServices成功 — ここからはBoot Services使用不可
        // ============================================================

        serial.println("[CosmOS] ExitBootServices OK" as void*);
        debug.println("[BOOT] ExitBootServices OK" as void*);

        // カーネルメインに制御を移す
        kernel_main(&boot_info);

        // ここには到達しない
        return 0;
        }
