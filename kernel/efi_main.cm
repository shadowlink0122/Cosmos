//! platform: uefi
// Cosmos OS - Cm言語で開発するOS
//
// Phase 1: UEFI Boot → 情報収集 → ExitBootServices → GDT → カーネル起動
//
// ビルド: make clean && make && make run

import ./libs/efi_core;
import ./libs/efi_text;
import ./libs/efi_input;
import ./libs/efi_memmap;
import ./libs/efi_gop;
import ./util/menu;
import ./util/memmap;
import ./util/keyboard;
import ./util/sysinfo;
import ./util/convert;
import ./util/graphics;
import ./boot_info;
import ./gdt;
import ./drivers/serial;
import ./drivers/debug_port;

// ============================================================
// ExitBootServices
// ============================================================

/// ExitBootServices (BootServices + 0xE8)
/// image_handle: efi_mainの第1引数
/// map_key:      GetMemoryMapから取得したキー
/// 戻り値: EFI_STATUS (0=成功)
ulong efi_exit_boot_services(void* system_table, void* image_handle, ulong map_key) {
    ulong* st = system_table as ulong*;
    ulong bs_addr = *(st + 12);  // offset 0x60 = BootServices
    ulong* bs = bs_addr as ulong*;

    // ExitBootServices = BootServices offset 0xE8 = index 29
    ulong exit_fn = *(bs + 29);

    ulong fn_val = exit_fn;
    ulong ih_val = image_handle as ulong;

    ulong result = 0;
    __asm__(`
        pushq ${r:fn_val};
        pushq ${r:ih_val};
        pushq ${r:map_key};
        popq %rdx;
        popq %rcx;
        popq %r10;
        subq $$32, %rsp;
        callq *%r10;
        addq $$32, %rsp;
        movq %rax, ${=r:result}
    `);
    return result;
}

// ============================================================
// BootInfo収集
// ============================================================

/// GOP情報をBootInfoに収集する
void collect_fb_info(void* system_table, BootInfo* info) {
    ulong fb_base = 0;
    ulong width = 0;
    ulong height = 0;
    ulong stride = 0;

    ulong status = gop_init(system_table, &fb_base, &width, &height, &stride);
    long signed_status = status as long;
    if (signed_status < 0) {
        serial_println("[Cosmos] WARNING: GOP init failed" as void*);
        return;
    }

    (*info).fb.base_addr = fb_base;
    (*info).fb.width = width as uint;
    (*info).fb.height = height as uint;
    (*info).fb.stride = stride as uint;
    (*info).fb.pixel_format = 0;  // BGRA（デフォルト）
    // size = height * stride * 4(bytes per pixel)
    (*info).fb.size = height * stride * 4;

    serial_println("[Cosmos] Framebuffer info collected" as void*);
    serial_puts("[Cosmos]   Resolution: " as void*);
    serial_print_hex(width);
    serial_puts(" x " as void*);
    serial_print_hex(height);
    serial_putc(10);
}

/// メモリマップを取得してBootInfoに格納する
/// 戻り値: 0=成功
ulong collect_memory_map(void* system_table, BootInfo* info) {
    debug_println("[BOOT] collect_memory_map: start" as void*);

    // まずサイズを問い合わせ
    ulong map_size = 0;
    ulong map_key = 0;
    ulong desc_size = 0;
    ulong desc_ver = 0;

    // 最初の呼び出しでサイズを取得（バッファNULL）
    ulong status = efi_get_memory_map(system_table, &map_size, 0 as void*, &map_key, &desc_size, &desc_ver);

    // バッファサイズに余裕を持たせる
    ulong alloc_size = map_size + 4096;

    // バッファを確保
    void* map_buffer = 0 as void*;
    status = efi_alloc_pool(system_table, alloc_size, &map_buffer);

    long signed_status = status as long;
    if (signed_status < 0) {
        debug_println("[BOOT] collect_memory_map: FAIL alloc" as void*);
        return status;
    }

    // メモリマップを取得
    ulong actual_map_size = alloc_size;
    status = efi_get_memory_map(system_table, &actual_map_size, map_buffer, &map_key, &desc_size, &desc_ver);

    signed_status = status as long;
    if (signed_status < 0) {
        debug_println("[BOOT] collect_memory_map: FAIL get_map" as void*);
        return status;
    }

    // BootInfoに格納
    (*info).mmap.map_buffer = map_buffer;
    (*info).mmap.map_size = actual_map_size;
    (*info).mmap.map_key = map_key;
    (*info).mmap.desc_size = desc_size;
    (*info).mmap.desc_version = desc_ver as uint;
    (*info).mmap.entry_count = (actual_map_size / desc_size) as uint;

    debug_println("[BOOT] collect_memory_map: OK" as void*);
    return 0;
}

// ============================================================
// カーネルメイン（ExitBootServices後）
// ============================================================

/// ExitBootServices後のカーネルエントリポイント
/// Boot Servicesは使用不可。シリアルとFBのみ使用可能。
void kernel_main(BootInfo* info) {
    debug_println("[BOOT] kernel_main entered" as void*);
    serial_println("[Cosmos] === Kernel Main ===" as void*);
    serial_println("[Cosmos] ExitBootServices completed successfully" as void*);

    // GDT設定
    gdt_init();
    serial_println("[Cosmos] GDT initialized" as void*);

    // フレームバッファにピクセルを書き込んでテスト
    ulong fb = (*info).fb.base_addr;
    ulong stride = (*info).fb.stride as ulong;
    if (fb != 0) {
        serial_println("[Cosmos] Writing to framebuffer..." as void*);
        // 画面上部に白いラインを描画（動作確認用）
        uint* fb_ptr = fb as uint*;
        ulong x = 0;
        while (x < stride) {
            // BGRAフォーマット: 白 = 0xFFFFFFFF
            *(fb_ptr + x) = 0xFFFFFFFF as uint;
            x += 1;
        }
        serial_println("[Cosmos] Framebuffer test line drawn" as void*);
    }

    serial_println("[Cosmos] ==============================" as void*);
    serial_println("[Cosmos] Cosmos OS v0.1.0 booted successfully!" as void*);
    serial_println("[Cosmos] ==============================" as void*);

    // HLTループ（カーネル待機）
    serial_println("[Cosmos] Entering halt loop" as void*);
    debug_println("[BOOT] halt" as void*);
    while (true) {
        __asm__("hlt");
    }
}

// ============================================================
// UEFI メインエントリ
// ============================================================

ulong efi_main(void* image_handle, void* system_table) {
    // シリアルコンソール初期化（UART COM1 115200 8N1）
    // デバッグポート出力（テスト検証用）
    debug_println("[BOOT] efi_main entered" as void*);

    serial_init();
    serial_println("[Cosmos] Serial console initialized" as void*);
    serial_println("[Cosmos] UEFI boot started" as void*);
    debug_println("[BOOT] serial_init completed" as void*);

    efi_clear_screen(system_table);

    // バナー表示
    efi_println(system_table, "========================================" as void*);
    efi_println(system_table, "  Cosmos OS v0.1.0" as void*);
    efi_println(system_table, "========================================" as void*);
    efi_println(system_table, "" as void*);

    // ============================================================
    // Phase 1: BootInfo収集
    // ============================================================

    efi_println(system_table, "[Phase 1] Collecting boot information..." as void*);
    serial_println("[Cosmos] Phase 1: Collecting boot information" as void*);

    // BootInfo構造体をスタック上に確保
    BootInfo boot_info;
    boot_info.fb.base_addr = 0;
    boot_info.fb.size = 0;
    boot_info.fb.width = 0 as uint;
    boot_info.fb.height = 0 as uint;
    boot_info.fb.stride = 0 as uint;
    boot_info.fb.pixel_format = 0 as uint;
    boot_info.mmap.map_buffer = 0 as void*;
    boot_info.mmap.map_size = 0;
    boot_info.mmap.map_key = 0;
    boot_info.mmap.desc_size = 0;
    boot_info.mmap.desc_version = 0 as uint;
    boot_info.mmap.entry_count = 0 as uint;
    boot_info.acpi_rsdp = 0;

    // GOP（フレームバッファ）情報の収集
    efi_println(system_table, "  Initializing GOP..." as void*);
    collect_fb_info(system_table, &boot_info);

    // メモリマップの収集（ExitBootServicesに必要なmap_keyも取得）
    efi_println(system_table, "  Getting memory map..." as void*);
    ulong mmap_status = collect_memory_map(system_table, &boot_info);
    long signed_mmap_status = mmap_status as long;
    if (signed_mmap_status < 0) {
        efi_println(system_table, "  ERROR: Memory map collection failed!" as void*);
        efi_println(system_table, "  System halted." as void*);
        while (true) {
            __asm__("hlt");
        }
    }

    efi_println(system_table, "  Boot information collected." as void*);
    efi_println(system_table, "" as void*);

    // ============================================================
    // Phase 1: ExitBootServices
    // ============================================================

    efi_println(system_table, "[Phase 1] Calling ExitBootServices..." as void*);
    serial_println("[Cosmos] Calling ExitBootServices..." as void*);
    debug_println("[BOOT] calling ExitBootServices" as void*);

    // ExitBootServices呼び出し
    // 注意: この後 ConOut 等の Boot Services は一切使用不可
    ulong exit_status = efi_exit_boot_services(system_table, image_handle, boot_info.mmap.map_key);
    long signed_exit = exit_status as long;

    if (signed_exit < 0) {
        // ExitBootServicesが失敗した場合、メモリマップを再取得してリトライ
        serial_println("[Cosmos] ExitBootServices failed, retrying..." as void*);

        // メモリマップを再取得
        ulong retry_map_size = boot_info.mmap.map_size + 4096;
        ulong retry_map_key = 0;
        ulong retry_desc_size = 0;
        ulong retry_desc_ver = 0;
        efi_get_memory_map(system_table, &retry_map_size, boot_info.mmap.map_buffer,
        &retry_map_key, &retry_desc_size, &retry_desc_ver);

        boot_info.mmap.map_key = retry_map_key;

        // 2回目のExitBootServices
        exit_status = efi_exit_boot_services(system_table, image_handle, retry_map_key);
        signed_exit = exit_status as long;

        if (signed_exit < 0) {
            serial_println("[Cosmos] FATAL: ExitBootServices retry failed!" as void*);
            debug_println("[BOOT] FATAL: ExitBootServices retry failed" as void*);
            while (true) {
                __asm__("hlt");
            }
        }
    }

    // ============================================================
    // ExitBootServices成功 — ここからはBoot Services使用不可
    // シリアルコンソールとフレームバッファのみ使用可能
    // ============================================================

    serial_println("[Cosmos] ExitBootServices OK" as void*);
    debug_println("[BOOT] ExitBootServices OK" as void*);

    // カーネルメインに制御を移す
    kernel_main(&boot_info);

    // ここには到達しない
    return 0;
}
