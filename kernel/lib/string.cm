//! platform: uefi
// kernel::lib::string - 文字列・メモリ操作ライブラリ
//
// カーネル内で使用するメモリ操作・文字列操作関数群。
// 全てインラインASMまたはバイト単位ポインタ操作で実装。
//
// 提供関数:
//   メモリ操作: k_memcpy, k_memset, k_memmove, k_memcmp
//   文字列操作: k_strlen, k_strcmp, k_strncmp, k_strcpy, k_strncpy

// ============================================================
// メモリ操作
// ============================================================

/// メモリコピー（src → dst、len バイト）
/// 領域の重なりは非対応（重なる場合は k_memmove を使用）
export void k_memcpy(ulong dst, ulong src, ulong len) {
    ulong i = 0;
    while (i < len) {
        ulong src_addr = src + i;
        ulong dst_addr = dst + i;
        ulong byte_val = 0;
        __asm__(`
            movq ${r:src_addr}, %rsi;
            xorq %rax, %rax;
            movb (%rsi), %al;
            movq ${r:dst_addr}, %rdi;
            movb %al, (%rdi);
            movq %rax, ${=r:byte_val}
        `);
        i = i + 1;
    }
}

/// メモリを指定バイト値で埋める
export void k_memset(ulong dst, ulong value, ulong len) {
    ulong i = 0;
    while (i < len) {
        ulong addr = dst + i;
        __asm__(`
            movq ${r:addr}, %rdi;
            movq ${r:value}, %rax;
            movb %al, (%rdi)
        `);
        i = i + 1;
    }
}

/// メモリコピー（重なり対応）
/// src < dst の場合は末尾からコピー
export void k_memmove(ulong dst, ulong src, ulong len) {
    if (len == 0) {
        return;
    }
    if (dst == src) {
        return;
    }

    if (dst < src) {
        // 前方コピー（通常）
        k_memcpy(dst, src, len);
    } else {
        // 後方コピー（重なり回避）
        ulong i = len;
        while (i > 0) {
            i = i - 1;
            ulong src_addr = src + i;
            ulong dst_addr = dst + i;
            ulong byte_val = 0;
            __asm__(`
                movq ${r:src_addr}, %rsi;
                xorq %rax, %rax;
                movb (%rsi), %al;
                movq ${r:dst_addr}, %rdi;
                movb %al, (%rdi);
                movq %rax, ${=r:byte_val}
            `);
        }
    }
}

/// メモリ比較（一致なら0、不一致なら非ゼロ）
export ulong k_memcmp(ulong addr1, ulong addr2, ulong len) {
    ulong i = 0;
    while (i < len) {
        ulong a1 = addr1 + i;
        ulong a2 = addr2 + i;
        ulong b1 = 0;
        ulong b2 = 0;
        __asm__(`
            movq ${r:a1}, %rsi;
            xorq %rax, %rax;
            movb (%rsi), %al;
            movq %rax, ${=r:b1}
        `);
        __asm__(`
            movq ${r:a2}, %rsi;
            xorq %rax, %rax;
            movb (%rsi), %al;
            movq %rax, ${=r:b2}
        `);
        if (b1 != b2) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// ============================================================
// 1バイト読み書きヘルパー
// ============================================================

/// 指定アドレスから1バイト読み取る
export ulong k_read_byte(ulong addr) {
    ulong val = 0;
    __asm__(`
        movq ${r:addr}, %rsi;
        xorq %rax, %rax;
        movb (%rsi), %al;
        movq %rax, ${=r:val}
    `);
    return val;
}

/// 指定アドレスに1バイト書き込む
export void k_write_byte(ulong addr, ulong byte_val) {
    __asm__(`
        movq ${r:addr}, %rdi;
        movq ${r:byte_val}, %rax;
        movb %al, (%rdi)
    `);
}

// ============================================================
// 文字列操作
// ============================================================

/// NUL終端文字列の長さを返す
export ulong k_strlen(ulong str) {
    ulong len = 0;
    while (true) {
        ulong ch = k_read_byte(str + len);
        if (ch == 0) {
            return len;
        }
        len = len + 1;
    }
    return len;
}

/// 2つのNUL終端文字列を比較する
/// 一致なら0、不一致なら非ゼロ
export ulong k_strcmp(ulong s1, ulong s2) {
    ulong i = 0;
    while (true) {
        ulong c1 = k_read_byte(s1 + i);
        ulong c2 = k_read_byte(s2 + i);
        if (c1 != c2) {
            return 1;
        }
        if (c1 == 0) {
            return 0;  // 両方NULに到達 = 一致
        }
        i = i + 1;
    }
    return 0;
}

/// 最大nバイトまで文字列を比較する
export ulong k_strncmp(ulong s1, ulong s2, ulong n) {
    ulong i = 0;
    while (i < n) {
        ulong c1 = k_read_byte(s1 + i);
        ulong c2 = k_read_byte(s2 + i);
        if (c1 != c2) {
            return 1;
        }
        if (c1 == 0) {
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

/// 文字列をコピーする（NUL終端含む）
export void k_strcpy(ulong dst, ulong src) {
    ulong i = 0;
    while (true) {
        ulong ch = k_read_byte(src + i);
        k_write_byte(dst + i, ch);
        if (ch == 0) {
            return;
        }
        i = i + 1;
    }
}

/// 最大nバイトまで文字列をコピーする
export void k_strncpy(ulong dst, ulong src, ulong n) {
    ulong i = 0;
    while (i < n) {
        ulong ch = k_read_byte(src + i);
        k_write_byte(dst + i, ch);
        if (ch == 0) {
            return;  // NULに到達
        }
        i = i + 1;
    }
}
