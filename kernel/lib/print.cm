//! platform: uefi
// kernel::lib::print - フレームバッファテキスト描画（printk相当）
//
// ExitBootServices後のフレームバッファへの文字列描画を提供する。
// 8x16ビットマップフォントを使用してピクセル単位で文字を描画。
//
// impl FBConsole for Console パターンで抽象化:
//   con->clear();
//   con->set_color(0x0000FF00);
//   con->println("Hello" as void*);

import ./font;
import ../drivers/serial;

// ============================================================
// Console インターフェース（テキスト出力抽象化）
// ============================================================

/// テキストコンソールの共通インターフェース
/// FBConsole以外の実装（シリアルコンソール等）も将来追加可能
export interface Console {
    void putc(ulong ch);
    void puts(void* data);
    void println(void* data);
    void clear();
    void set_color(ulong fg);
    void newline();
}

// ============================================================
// テキストカーソル管理用構造体
// ============================================================

/// フレームバッファテキストコンソール状態
export struct FBConsole {
    ulong fb_addr;     // フレームバッファの物理アドレス
    ulong width;       // 水平解像度（ピクセル）
    ulong height;      // 垂直解像度（ピクセル）
    ulong stride;      // 1行あたりのピクセル数
    ulong cursor_x;    // テキストカーソル列（文字単位）
    ulong cursor_y;    // テキストカーソル行（文字単位）
    ulong fg_color;    // 前景色（BGRA）
    ulong bg_color;    // 背景色（BGRA）
}

// ============================================================
// カラー定数
// ============================================================

const ulong FB_COLOR_WHITE = 0x00FFFFFF;
const ulong FB_COLOR_BLACK = 0x00000000;
const ulong FB_COLOR_GREEN = 0x0000FF00;
const ulong FB_COLOR_DARK_BG = 0x00101020;

// ============================================================
// FBConsole メソッド実装
// ============================================================

impl FBConsole for Console {

    // --------------------------------------------------------
    // 初期化
    // --------------------------------------------------------

    /// FBConsoleを初期化する
    void init(ulong fb_addr, ulong width, ulong height, ulong stride) {
        self.fb_addr = fb_addr;
        self.width = width;
        self.height = height;
        self.stride = stride;
        self.cursor_x = 0;
        self.cursor_y = 0;
        self.fg_color = FB_COLOR_GREEN;   // デフォルト: 緑文字
        self.bg_color = FB_COLOR_DARK_BG; // デフォルト: 暗い背景
    }

    // --------------------------------------------------------
    // 前景色設定（Console IF）
    // --------------------------------------------------------

    /// 前景色を設定する
    void set_color(ulong fg) {
        self.fg_color = fg;
    }

    // --------------------------------------------------------
    // 補助計算
    // --------------------------------------------------------

    /// テキストカーソルで管理される列数の最大値
    ulong max_cols() {
        return self.width / FONT_WIDTH;
    }

    /// テキストカーソルで管理される行数の最大値
    ulong max_rows() {
        return self.height / FONT_HEIGHT;
    }

    // --------------------------------------------------------
    // 文字描画（内部用）
    // --------------------------------------------------------

    /// 指定位置に1文字を描画する（ピクセル座標で指定）
    void draw_char(ulong px, ulong py, ulong ch) {
        ulong fb = self.fb_addr;
        ulong screen_w = self.width;
        ulong screen_h = self.height;
        ulong stride = self.stride;
        ulong fg = self.fg_color;
        ulong bg = self.bg_color;

        if (fb == 0) { return; }

        ulong row = 0;
        while (row < FONT_HEIGHT) {
            ulong bits = font_get_row(ch, row);
            ulong col = 0;
            while (col < FONT_WIDTH) {
                ulong sx = px + col;
                ulong sy = py + row;

                // 画面外チェック
                if (sx < screen_w) {
                    if (sy < screen_h) {
                        ulong offset = (sy * stride + sx) * 4;
                        uint* pixel = (fb + offset) as uint*;

                        // ビットパターンのMSBが左端: bit7=col0, bit6=col1, ...
                        ulong bit_pos = 7 - col;
                        ulong mask = 1 << bit_pos;
                        if ((bits & mask) != 0) {
                            *pixel = fg as uint;
                        } else {
                            *pixel = bg as uint;
                        }
                    }
                }
                col += 1;
            }
            row += 1;
        }
    }

    // --------------------------------------------------------
    // 画面操作
    // --------------------------------------------------------

    /// 画面を背景色でクリアする（Console IF）
    void clear() {
        ulong fb = self.fb_addr;
        ulong stride = self.stride;
        ulong height = self.height;
        ulong bg = self.bg_color;

        if (fb == 0) { return; }

        // 1行ずつ塗りつぶし
        ulong y = 0;
        while (y < height) {
            ulong x = 0;
            while (x < stride) {
                ulong offset = (y * stride + x) * 4;
                uint* pixel = (fb + offset) as uint*;
                *pixel = bg as uint;
                x += 1;
            }
            y += 1;
        }

        // カーソルをリセット
        self.cursor_x = 0;
        self.cursor_y = 0;
    }

    /// 画面を1行分上にスクロールする
    void scroll_up() {
        ulong fb = self.fb_addr;
        ulong stride = self.stride;
        ulong height = self.height;
        ulong bg = self.bg_color;

        if (fb == 0) { return; }

        // FONT_HEIGHT行分のピクセルを上にコピー
        ulong y = 0;
        ulong copy_height = height - FONT_HEIGHT;
        while (y < copy_height) {
            ulong src_y = y + FONT_HEIGHT;
            ulong x = 0;
            while (x < stride) {
                ulong dst_offset = (y * stride + x) * 4;
                ulong src_offset = (src_y * stride + x) * 4;
                uint* dst = (fb + dst_offset) as uint*;
                uint* src = (fb + src_offset) as uint*;
                *dst = *src;
                x += 1;
            }
            y += 1;
        }

        // 最下行を背景色でクリア
        ulong clear_y = copy_height;
        while (clear_y < height) {
            ulong x = 0;
            while (x < stride) {
                ulong offset = (clear_y * stride + x) * 4;
                uint* pixel = (fb + offset) as uint*;
                *pixel = bg as uint;
                x += 1;
            }
            clear_y += 1;
        }
    }

    // --------------------------------------------------------
    // テキスト出力
    // --------------------------------------------------------

    /// 改行処理（画面下端でスクロール）（Console IF）
    void newline() {
        self.cursor_x = 0;
        ulong rows = self.max_rows();
        ulong next_y = self.cursor_y + 1;
        if (next_y >= rows) {
            // 画面下端に達した場合、スクロール
            self.scroll_up();
            self.cursor_y = rows - 1;
        } else {
            self.cursor_y = next_y;
        }
    }

    /// 1文字を出力（テキストカーソル自動進行）（Console IF）
    void putc(ulong ch) {
        // 改行文字
        if (ch == 10) {
            self.newline();
            return;
        }
        // キャリッジリターン
        if (ch == 13) {
            self.cursor_x = 0;
            return;
        }

        // テキスト座標 → ピクセル座標
        ulong px = self.cursor_x * FONT_WIDTH;
        ulong py = self.cursor_y * FONT_HEIGHT;

        // 文字を描画
        self.draw_char(px, py, ch);

        // カーソル前進
        ulong cols = self.max_cols();
        ulong next_x = self.cursor_x + 1;
        if (next_x >= cols) {
            self.newline();
        } else {
            self.cursor_x = next_x;
        }
    }

    /// NUL終端文字列を出力（Console IF）
    void puts(void* data) {
        ulong data_val = data as ulong;
        ulong i = 0;

        while (true) {
            ulong byte_val = 0;
            ulong addr = data_val + i;
            __asm__(`
                movq ${r:addr}, %r10;
                xorq %rax, %rax;
                movzbl (%r10), %eax;
                movq %rax, ${=r:byte_val}
            `);
            if (byte_val == 0) {
                break;
            }
            self.putc(byte_val);
            i += 1;
        }
    }

    /// 文字列を改行付きで出力（Console IF）
    void println(void* data) {
        self.puts(data);
        self.newline();
    }

    // --------------------------------------------------------
    // 16進数出力
    // --------------------------------------------------------

    /// 16進数値をFBConsoleに出力（0xプレフィックス + 16桁）
    void print_hex(ulong value) {
        self.puts("0x" as void*);
        ulong i = 0;
        while (i < 16) {
            ulong shift = (15 - i) * 4;
            ulong nibble = (value >> shift) & 0xF;
            ulong ch = 0;
            if (nibble < 10) {
                ch = nibble + 0x30;  // '0'-'9'
            } else {
                ch = nibble - 10 + 0x41;  // 'A'-'F'
            }
            self.putc(ch);
            i += 1;
        }
    }

    // --------------------------------------------------------
    // バックスペース処理
    // --------------------------------------------------------

    /// カーソルを1つ戻して空白で上書き（Backspace用）
    void backspace() {
        if (self.cursor_x > 0) {
            self.cursor_x = self.cursor_x - 1;
            // カーソル位置に空白を描画
            ulong px = self.cursor_x * FONT_WIDTH;
            ulong py = self.cursor_y * FONT_HEIGHT;
            self.draw_char(px, py, 0x20);
        }
    }
}
