    if (index == 183) { return ((0x1818180E as ulong) << (32 as ulong)); }
    if (index == 184) { return ((0x1818 as ulong) << (32 as ulong)) | (0x18180018 as ulong); }
    if (index == 185) { return ((0x18181818 as ulong) << (32 as ulong)); }
    if (index == 186) { return ((0x7018 as ulong) << (32 as ulong)) | (0x18180E18 as ulong); }
    if (index == 187) { return ((0x18181870 as ulong) << (32 as ulong)); }
    if (index == 188) { return ((0x76DC as ulong) << (32 as ulong)); }
    if (index == 189) { return 0; }
