}

/// メインディスパッチ関数
export ulong font_data(ulong index) {
    if (index < 40) { return font_data_g0(index); }
    if (index < 80) { return font_data_g1(index); }
    if (index < 120) { return font_data_g2(index); }
    if (index < 160) { return font_data_g3(index); }
    if (index < 190) { return font_data_g4(index); }
    return 0;
}
