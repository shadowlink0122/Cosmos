//! platform: uefi
// kernel::lib::font - 8x16 ビットマップフォント（VGA標準）
//
// ASCII印字可能文字（0x20〜0x7E = 95文字）の標準VGA 8x16フォント。
// 各文字は16行、1行あたり8ビット。MSBが左端。
//
// データ格納: 1文字=2つのulong、各ulongに8行分を上位バイトから格納。
// Cmコンパイラの64bitリテラル切り捨てバグ回避のため、32bit分割で構築。
// ___chkstk_ms回避のため、グループ分割関数方式を採用。

// ============================================================
// フォント定数
// ============================================================

export const ulong FONT_WIDTH = 8;
export const ulong FONT_HEIGHT = 16;

const ulong FONT_FIRST_CHAR = 0x20;
const ulong FONT_LAST_CHAR = 0x7E;

// ============================================================
// Font 構造体
// ============================================================

/// 8x16ビットマップフォント
export struct Font {
    ulong first_char;   // 最初の文字コード（0x20）
    ulong last_char;    // 最後の文字コード（0x7E）
}

// ============================================================
// Font メソッド実装
// ============================================================

impl Font {
    /// 指定した文字の指定した行のビットパターンを返す
    ulong get_row(ulong ch, ulong row) {
        if (ch < self.first_char) { return 0; }
        if (ch > self.last_char) { return 0; }
        if (row >= FONT_HEIGHT) { return 0; }

        ulong char_index = ch - self.first_char;
        ulong data_index = char_index * 2;

        ulong packed = 0;
        if (row < 8) {
            packed = font_data(data_index);
        } else {
            packed = font_data(data_index + 1);
        }

        ulong sub_row = row;
        if (row >= 8) {
            sub_row = row - 8;
        }
        ulong shift = (7 - sub_row) * 8;
        ulong mask_ff = 0xFF as ulong;
        ulong byte_val = (packed >> shift) & mask_ff;
        return byte_val;
    }
}

/// font_get_row互換ラッパー（他モジュールから呼び出し用）
export ulong font_get_row(ulong ch, ulong row) {
    Font f;
    f.first_char = FONT_FIRST_CHAR;
    f.last_char = FONT_LAST_CHAR;
    return f.get_row(ch, row);
}

// ============================================================
// フォントデータ（グループ分割方式）
// ============================================================

/// フォントデータグループ 0（インデックス 0-39）
export ulong font_data_g0(ulong index) {
    if (index == 0) { return 0; }
    if (index == 1) { return 0; }
    if (index == 2) { return ((0x183C as ulong) << (32 as ulong)) | (0x3C3C1818 as ulong); }
    if (index == 3) { return ((0x18001818 as ulong) << (32 as ulong)); }
    if (index == 4) { return ((0x666666 as ulong) << (32 as ulong)) | (0x24000000 as ulong); }
    if (index == 5) { return 0; }
    if (index == 6) { return ((0x6C as ulong) << (32 as ulong)) | (0x6CFE6C6C as ulong); }
    if (index == 7) { return ((0x6CFE6C6C as ulong) << (32 as ulong)); }
    if (index == 8) { return ((0x18187CC6 as ulong) << (32 as ulong)) | ((0x61603E03 as ulong) << (1 as ulong)); }
    if (index == 9) { return ((0x686C67C as ulong) << (32 as ulong)) | (0x18180000 as ulong); }
    if (index == 10) { return ((0x6163060C as ulong) << (1 as ulong)); }
    if (index == 11) { return ((0x3060C686 as ulong) << (32 as ulong)); }
    if (index == 12) { return ((0x386C as ulong) << (32 as ulong)) | (0x6C3876DC as ulong); }
    if (index == 13) { return (((0x6666663B as ulong) << (1 as ulong)) << (32 as ulong)); }
    if (index == 14) { return ((0x303030 as ulong) << (32 as ulong)) | (0x60000000 as ulong); }
    if (index == 15) { return 0; }
    if (index == 16) { return ((0xC18 as ulong) << (32 as ulong)) | (0x30303030 as ulong); }
    if (index == 17) { return ((0x3030180C as ulong) << (32 as ulong)); }
    if (index == 18) { return ((0x3018 as ulong) << (32 as ulong)) | (0xC0C0C0C as ulong); }
    if (index == 19) { return ((0xC0C1830 as ulong) << (32 as ulong)); }
    if (index == 20) { return 0x663CFF; }
    if (index == 21) { return ((0x3C660000 as ulong) << (32 as ulong)); }
    if (index == 22) { return 0x18187E; }
    if (index == 23) { return ((0x18180000 as ulong) << (32 as ulong)); }
    if (index == 24) { return 0; }
    if (index == 25) { return ((0x181818 as ulong) << (32 as ulong)) | (0x30000000 as ulong); }
    if (index == 26) { return 0xFE; }
    if (index == 27) { return 0; }
    if (index == 28) { return 0; }
    if (index == 29) { return ((0x1818 as ulong) << (32 as ulong)); }
    if (index == 30) { return 0x2060C18; }
    if (index == 31) { return ((0x3060C080 as ulong) << (32 as ulong)); }
    if (index == 32) { return ((0x3C66 as ulong) << (32 as ulong)) | (((0x61E1EDED as ulong) << (1 as ulong)) | (1 as ulong)); }
    if (index == 33) { return (((0x61E1B31E as ulong) << (1 as ulong)) << (32 as ulong)); }
    if (index == 34) { return ((0x1838 as ulong) << (32 as ulong)) | (0x78181818 as ulong); }
    if (index == 35) { return ((0x1818187E as ulong) << (32 as ulong)); }
    if (index == 36) { return ((0x7CC6 as ulong) << (32 as ulong)) | (0x60C1830 as ulong); }
    if (index == 37) { return ((0x60C0C6FE as ulong) << (32 as ulong)); }
    if (index == 38) { return ((0x7CC6 as ulong) << (32 as ulong)) | (0x6063C06 as ulong); }
    if (index == 39) { return ((0x606C67C as ulong) << (32 as ulong)); }
    return 0;
}

