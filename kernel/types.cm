//! platform: uefi
// kernel::types - カーネル共通型定義（typedef）
//
// 全モジュールで使用される意味的な型エイリアスを一元定義する。
// 生のプリミティブ（ulong）の使用を最小限に抑え、
// コードの可読性と型安全性を向上させる。

// ============================================================
// メモリ・アドレス関連
// ============================================================

/// メモリアドレス型 — 固定メモリ領域やポインタ先アドレスを表す
export typedef MemAddr = ulong;

/// バイトサイズ型 — バッファサイズやデータ長を表す
export typedef ByteSize = ulong;

/// バイトオフセット型 — 構造体やバッファ内のオフセットを表す
export typedef ByteOffset = ulong;

/// ページ数型 — 物理メモリページ（4KiB単位）の数
export typedef PageCount = ulong;

// ============================================================
// I/O関連
// ============================================================

/// I/Oポート型 — x86のI/Oポート番号（0x3F8等）を表す
export typedef IoPort = ulong;

/// ASCII文字型 — ASCII文字コード（0-127）
export typedef AsciiChar = ulong;

// ============================================================
// タスク・プロセス関連
// ============================================================

/// タスクID型 — カーネル内部のタスク識別子
export typedef TaskId = ulong;

/// タスク状態型 — READY/RUNNING/BLOCKED/TERMINATED
export typedef TaskState = ulong;

/// 終了コード型 — プロセスの終了コード
export typedef ExitCode = ulong;

/// プロセスID型 — ユーザー空間のプロセス識別子
export typedef Pid = ulong;

// ============================================================
// 割り込み・ハードウェア関連
// ============================================================

/// IRQ番号型 — ハードウェア割り込み番号（0-15）
export typedef IrqNr = ulong;

/// IDTベクタ番号型 — CPU例外・割り込みベクタ（0-255）
export typedef IdtVector = ulong;

/// GDTセレクタ型 — GDTセグメントセレクタ値
export typedef GdtSelector = ulong;

/// タイマーtick型 — PITタイマーのtickカウント
export typedef Tick = ulong;

// ============================================================
// キーボード関連
// ============================================================

/// スキャンコード型 — PS/2キーボードのスキャンコード
export typedef ScanCode = ulong;

/// キーコード型 — マップ後の仮想キーコード（文字 or VKEY_*）
export typedef KeyCode = ulong;

// ============================================================
// グラフィック関連
// ============================================================

/// 色値型 — BGRA形式の32ビットピクセル色を表す
export typedef Color = ulong;

/// ピクセル座標型 — フレームバッファ上のx/y座標
export typedef Pixel = ulong;

/// フレームバッファ寸法型 — width/height/stride
export typedef FbDimension = ulong;

// ============================================================
// ファイルシステム関連
// ============================================================

/// ファイルインデックス型 — ファイルテーブル内のインデックス
export typedef FileIndex = ulong;

/// FSオペレーションコード型 — CosmFSの操作コード
export typedef FsOpCode = ulong;

/// FSエラーコード型 — ファイルシステムエラー
export typedef FsError = ulong;

// ============================================================
// Syscall関連
// ============================================================

/// Syscall番号型 — システムコール番号
export typedef SyscallNr = ulong;

/// Syscall結果型 — システムコールの戻り値
export typedef SyscallResult = ulong;

/// ファイルディスクリプタ型
export typedef Fd = ulong;

// ============================================================
// 汎用カウント型
// ============================================================

/// 汎用カウント型 — エントリ数やアイテム数
export typedef Count = ulong;

// ============================================================
// 共通定数
// ============================================================

/// 無効値センチネル — エラーや「見つからない」を表す共通値
export const ulong INVALID_VALUE = 0xFFFFFFFFFFFFFFFF;
