//! platform: uefi
// kernel::drivers::pit - PIT 8254 タイマードライバ
//
// Programmable Interval Timer (8254) を100Hzに設定し、
// IRQ0経由で定期的な割り込みを生成する。
//
// tickカウンタは固定メモリアドレス(0x900)に配置。
// need_rescheduleフラグは0x908に配置。
// IRQ0ハンドラ内でtickインクリメントとフラグ設定を行う。
// 実際のコンテキストスイッチは非割り込みコンテキストで実行する。

import ./serial;
import ./debug_port;
import ./pic;
import ../arch/idt;

// ============================================================
// 定数
// ============================================================

// tickカウンタのメモリアドレス（固定位置）
const ulong PIT_TICK_ADDR = 0x900;
// リスケジュールフラグの固定位置
const ulong PIT_RESCHED_ADDR = 0x908;

// ============================================================
// PIT 構造体
// ============================================================

/// PITタイマードライバ
export struct PIT {
    ulong tick_count;    // タイマー割り込み回数（ローカルコピー）
    ulong frequency;     // 設定されたHz値
}

// ============================================================
// IRQ0ハンドラ（フリー関数）
// ============================================================

// IRQ0ハンドラ（純ASM関数 → naked属性自動適用、prologue/epilogueなし）:
//   1. RAX, RCX を退避
//   2. 固定アドレス0x900のtickカウンタをインクリメント
//   3. 固定アドレス0x908のneed_rescheduleフラグを1に設定
//   4. PIC EOI (0x20 → port 0x20) を送信
//   5. RAX, RCX を復元
//   6. iretq で割り込みから復帰
export void irq0_handler() {
    __asm__(`
        pushq %rax;
        pushq %rcx;

        // tickカウンタをインクリメント
        movq $$0x900, %rcx;
        movq (%rcx), %rax;
        incq %rax;
        movq %rax, (%rcx);

        // need_rescheduleフラグを1に設定
        movq $$0x908, %rcx;
        movq $$1, (%rcx);

        // PIC EOIを送信
        movb $$0x20, %al;
        outb %al, $$0x20;

        popq %rcx;
        popq %rax;
        iretq
    `);
}

// ============================================================
// リスケジュールフラグ操作
// ============================================================

/// need_rescheduleフラグを取得してクリアする
export ulong pit_check_resched() {
    ulong* ptr = PIT_RESCHED_ADDR as ulong*;
    ulong val = *ptr;
    ulong zero = 0;
    *ptr = zero;
    return val;
}

// ============================================================
// PIT メソッド実装
// ============================================================

impl PIT {
    /// コンストラクタ: PIT初期化
    overload self() {
        self.tick_count = 0;
        self.frequency = 0;
    }

    /// 現在のtickカウントを取得（固定アドレスから読み取り）
    ulong get_ticks() {
        ulong* tick_ptr = PIT_TICK_ADDR as ulong*;
        return *tick_ptr;
    }

    /// PITを初期化し、100Hzのタイマー割り込みを開始する
    /// pic: PIC8259Aへのポインタ（IRQ0アンマスク用）
    /// idt_table: IDTテーブルへのポインタ（ベクタ32登録用）
    void init(PIC8259A* pic, uint* idt_table) {
        DebugPort debug(0xE9);
        SerialPort serial(0x3F8);

        // tickカウンタを0に初期化
        ulong* tick_ptr = PIT_TICK_ADDR as ulong*;
        ulong zero = 0;
        *tick_ptr = zero;

        // リスケジュールフラグを0に初期化
        ulong* resched_ptr = PIT_RESCHED_ADDR as ulong*;
        *resched_ptr = zero;

        // PITコマンド送信: Channel 0, Access LSB/MSB, Mode 2 (Rate Generator)
        ulong cmd_port = 0x43;
        ulong cmd_val = 0x34;
        outb(cmd_port, cmd_val);
        io_wait();

        // 100Hz (1193182 / 100 = 11932)
        ulong ch0_port = 0x40;
        ulong divisor = 11932;
        ulong low_byte = divisor & 0xFF;
        ulong high_byte = (divisor >> 8) & 0xFF;
        outb(ch0_port, low_byte);
        io_wait();
        outb(ch0_port, high_byte);
        io_wait();

        // IDTにベクタ32（IRQ0）のハンドラを登録
        IDT idt = {table: idt_table};
        ulong vec32 = 32;
        idt.set_gate(vec32, fn_addr(irq0_handler as void*), IDT_INTERRUPT_GATE);

        // IDTを再ロード
        idt.load();

        // PICのIRQ0をアンマスク（有効化）
        ulong irq0 = 0;
        pic->unmask(irq0);

        self.frequency = 100;

        debug.println("[PIT] 100Hz timer initialized" as void*);
        serial.puts("[PIT] initialized at 100Hz, divisor=" as void*);
        serial.print_hex(divisor);
        serial.putc(10);
    }
}
