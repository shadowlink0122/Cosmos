//! platform: uefi
// kernel::drivers::debug_port - QEMUデバッグポートドライバ
//
// QEMU固有のデバッグコンソール（ポート0xE9）への出力を提供する。
// OVMFのシリアル出力と干渉しないクリーンなデバッグチャネル。
//
// QEMU起動時に以下のオプションで有効化:
//   -debugcon file:debug.log
//
// 注意: このポートはQEMU固有。実機では使用不可。

import ./serial;  // outb関数を再利用

// ============================================================
// 定数
// ============================================================

// QEMUデバッグコンソールポート
const ulong DEBUG_PORT = 0xE9;

// ============================================================
// デバッグ出力
// ============================================================

/// デバッグポートに1バイト出力
export void debug_putc(ulong ch) {
    outb(DEBUG_PORT, ch);
}

/// デバッグポートにNUL終端文字列を出力
export void debug_puts(void* data) {
    ulong data_val = data as ulong;
    ulong i = 0;

    // Cmコンパイラのwhile(byte_val != 0)バグ回避:
    // __asm__出力変数の値がwhile条件に反映されないため、
    // while(true) + if + break パターンを使用
    while (true) {
        ulong byte_val = 0;
        ulong addr = data_val + i;
        __asm__(`
            movq ${r:addr}, %r10;
            xorq %rax, %rax;
            movzbl (%r10), %eax;
            movq %rax, ${=r:byte_val}
        `);
        if (byte_val == 0) {
            break;
        }
        outb(DEBUG_PORT, byte_val);
        i += 1;
    }
}

/// デバッグポートに文字列を改行付きで出力
export void debug_println(void* data) {
    debug_puts(data);
    outb(DEBUG_PORT, 13);  // CR
    outb(DEBUG_PORT, 10);  // LF
}

/// デバッグポートに16進数出力
export void debug_print_hex(ulong value) {
    outb(DEBUG_PORT, 48);   // '0'
    outb(DEBUG_PORT, 120);  // 'x'

    ulong mask = 15 as ulong;
    ulong char_0 = 48;
    ulong char_A = 65;
    ulong max_digits = 16;
    ulong i = 0;
    while (i < max_digits) {
        ulong shift = (15 - i) * 4;
        ulong nibble = (value >> shift) & mask;
        ulong ten = 10;
        if (nibble < ten) {
            outb(DEBUG_PORT, char_0 + nibble);
        } else {
            outb(DEBUG_PORT, char_A + nibble - ten);
        }
        i += 1;
    }
}
