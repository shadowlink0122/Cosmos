//! platform: uefi
// kernel::drivers::debug_port - QEMUデバッグポートドライバ
//
// QEMU固有のデバッグコンソール（ポート0xE9）への出力を提供する。
// OVMFのシリアル出力と干渉しないクリーンなデバッグチャネル。
//
// impl DebugPort { ... } パターンでメソッド呼び出しを提供:
// impl DebugPort for OutputWriter で共通出力インターフェースを実装:

import ./serial;  // outb関数を再利用
import ./output_writer;
import ../config;

// ============================================================
// DebugPort 構造体
// ============================================================

/// QEMUデバッグコンソールポート
export struct DebugPort {
    IoPort port;    // デバッグI/Oポートアドレス（QEMU = 0xE9）
}

// ============================================================
// DebugPort メソッド実装
// ============================================================

impl DebugPort {
    /// 引数付きコンストラクタ: ポートアドレス設定
    /// 使用例: DebugPort debug(0xE9);
    overload self(IoPort port_addr) {
        self.port = port_addr;
    }

    // putc/puts/println/print_hex は impl DebugPort for OutputWriter で定義
}

// ============================================================
// OutputWriter インターフェース実装
// ============================================================

impl DebugPort for OutputWriter {
    void putc(AsciiChar ch) {
        outb(self.port, ch);
    }

    void puts(void* data) {
        MemAddr data_val = data as ulong;
        ulong i = 0;
        while (true) {
            AsciiChar byte_val = 0;
            MemAddr addr = data_val + i;
            __asm__(`
                movq ${r:addr}, %r10;
                xorq %rax, %rax;
                movzbl (%r10), %eax;
                movq %rax, ${=r:byte_val}
            `);
            if (byte_val == 0) { break; }
            outb(self.port, byte_val);
            i += 1;
        }
    }

    void println(void* data) {
        self.puts(data);
        outb(self.port, 13);
        outb(self.port, 10);
    }

    void print_hex(ulong value) {
        outb(self.port, 48);
        outb(self.port, 120);
        ulong mask = 15;
        ulong char_0 = 48;
        ulong char_A = 65;
        ulong i = 0;
        while (i < 16) {
            ulong shift = (15 - i) * 4;
            ulong nibble = (value >> shift) & mask;
            ulong ten = 10;
            if (nibble < ten) {
                outb(self.port, char_0 + nibble);
            } else {
                outb(self.port, char_A + nibble - ten);
            }
            i += 1;
        }
    }
}
