//! platform: uefi
// kernel::drivers::serial - UART シリアルコンソールドライバ
//
// COM1 (0x3F8) への出力を提供する。
// x86 I/Oポート命令（out/in）を使用するため、
// ExitBootServices前後どちらでも動作する。
//
// レジスタマップ (COM1: 0x3F8):
//   +0 (DLAB=0): データ送受信 (THR/RBR)
//   +1 (DLAB=0): 割り込み有効レジスタ (IER)
//   +0 (DLAB=1): ボーレート除数下位 (DLL)
//   +1 (DLAB=1): ボーレート除数上位 (DLM)
//   +2: FIFO制御レジスタ (FCR)
//   +3: 回線制御レジスタ (LCR)
//   +4: モデム制御レジスタ (MCR)
//   +5: 回線ステータスレジスタ (LSR)

// ============================================================
// 定数
// ============================================================

const ulong COM1_PORT = 0x3F8;

// レジスタオフセット
const ulong REG_DATA = 0;       // データ送受信 / ボーレート下位(DLAB=1)
const ulong REG_IER  = 1;       // 割り込み有効 / ボーレート上位(DLAB=1)
const ulong REG_FCR  = 2;       // FIFO制御
const ulong REG_LCR  = 3;       // 回線制御
const ulong REG_MCR  = 4;       // モデム制御
const ulong REG_LSR  = 5;       // 回線ステータス

// LCR ビット
const ulong LCR_DLAB = 0x80;    // Divisor Latch Access Bit
const ulong LCR_8N1  = 0x03;    // 8データビット, パリティなし, 1ストップビット

// LSR ビット
const ulong LSR_THRE = 0x20;    // 送信保持レジスタ空

// ============================================================
// I/Oポート操作（ASM）
// ============================================================

/// I/Oポートに1バイト出力
export void outb(ulong port, ulong value) {
    must {
        __asm__(`
            movq ${r:value}, %rax;
            movq ${r:port}, %rdx;
            outb %al, %dx
        `);
    }
}

/// I/Oポートから1バイト入力
export ulong inb(ulong port) {
    ulong result = 0;
    must {
        __asm__(`
            movq ${r:port}, %rdx;
            xorq %rax, %rax;
            inb %dx, %al;
            movq %rax, ${=r:result}
        `);
    }
    return result;
}

// ============================================================
// シリアルポート初期化
// ============================================================

/// COM1 シリアルポートを初期化
/// ボーレート: 115200, 8N1, FIFO有効
export void serial_init() {
    ulong base = COM1_PORT;

    // 割り込みを無効化
    outb(base + REG_IER, 0x00);

    // DLABをセットしてボーレート設定モードに入る
    outb(base + REG_LCR, LCR_DLAB);

    // ボーレート除数 = 1 (115200 baud)
    // 基底クロック 1843200 / (16 * 115200) = 1
    outb(base + REG_DATA, 0x01);   // 除数下位バイト
    outb(base + REG_IER, 0x00);    // 除数上位バイト

    // 8N1: 8データビット, パリティなし, 1ストップビット
    // DLABもクリアされる
    outb(base + REG_LCR, LCR_8N1);

    // FIFO有効化: 14バイトしきい値, FIFO クリア
    outb(base + REG_FCR, 0xC7);

    // DTR + RTS + OUT2（割り込み用、将来的に必要）
    outb(base + REG_MCR, 0x0B);

    // ループバックモードでテスト
    outb(base + REG_MCR, 0x1E);    // ループバック設定
    outb(base + REG_DATA, 0xAE);   // テストバイト送信

    // テストバイトが返ってくるか確認
    ulong test_result = inb(base + REG_DATA);
    // ループバック解除して通常モードに戻す
    // テスト失敗しても続行（QEMUでは常に成功するため）
    outb(base + REG_MCR, 0x0F);
}

// ============================================================
// シリアル出力
// ============================================================

/// 送信バッファが空になるまで待機
export void serial_wait_ready() {
    ulong base = COM1_PORT;
    // LSRのTHREビット(bit 5)が1になるまでポーリング
    ulong status = inb(base + REG_LSR);
    ulong thre = status & LSR_THRE;
    while (thre == 0) {
        status = inb(base + REG_LSR);
        thre = status & LSR_THRE;
    }
}

/// 1バイト出力
export void serial_putc(ulong ch) {
    serial_wait_ready();
    outb(COM1_PORT + REG_DATA, ch);
}

/// NUL終端文字列を出力
export void serial_puts(void* data) {
    ulong data_val = data as ulong;
    ulong i = 0;
    // 1バイトずつ読んで出力
    ulong byte_val = 0;
    must {
        __asm__(`
            movq ${r:data_val}, %r10;
            xorq %rax, %rax;
            movzbl (%r10), %eax;
            movq %rax, ${=r:byte_val}
        `);
    }
    while (byte_val != 0) {
        // '\n' の場合は '\r\n' に変換
        if (byte_val == 10) {
            serial_putc(13);
        }
        serial_putc(byte_val);
        i += 1;
        ulong addr = data_val + i;
        must {
            __asm__(`
                movq ${r:addr}, %r10;
                xorq %rax, %rax;
                movzbl (%r10), %eax;
                movq %rax, ${=r:byte_val}
            `);
        }
    }
}

/// 文字列を改行付きで出力
export void serial_println(void* data) {
    serial_puts(data);
    serial_putc(13);  // CR
    serial_putc(10);  // LF
}

/// 16進数出力（0x + 16桁）
export void serial_print_hex(ulong value) {
    serial_putc(48);   // '0'
    serial_putc(120);  // 'x'

    ulong mask = 15;
    ulong char_0 = 48;   // '0'
    ulong char_A = 65;   // 'A'
    ulong max_digits = 16;
    ulong i = 0;
    while (i < max_digits) {
        ulong shift = (15 - i) * 4;
        ulong nibble = (value >> shift) & mask;
        ulong ten = 10;
        if (nibble < ten) {
            serial_putc(char_0 + nibble);
        } else {
            serial_putc(char_A + nibble - ten);
        }
        i += 1;
    }
}
