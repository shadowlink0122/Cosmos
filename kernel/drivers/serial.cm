//! platform: uefi
// kernel::drivers::serial - UART シリアルコンソールドライバ
import ../config;
import ./output_writer;
//
// COM1 (0x3F8) への出力を提供する。
// x86 I/Oポート命令（out/in）を使用するため、
// ExitBootServices前後どちらでも動作する。
//
// impl SerialPort { ... } パターンでメソッド呼び出しを提供:
// impl SerialPort for OutputWriter で共通出力インターフェースを実装:
//   serial.init();
//   serial.println("Hello" as void*);

// ============================================================
// I/Oポート操作（ASM） — フリー関数として維持（他モジュールから参照）
// ============================================================

/// I/Oポートに1バイト出力
export void outb(IoPort port, ulong value) {
    __asm__(`
        movq ${r:value}, %rax;
        movq ${r:port}, %rdx;
        outb %al, %dx
    `);
}

/// I/Oポートから1バイト入力
export ulong inb(IoPort port) {
    ulong result = 0;
    __asm__(`
        movq ${r:port}, %rdx;
        xorq %rax, %rax;
        inb %dx, %al;
        movq %rax, ${=r:result}
    `);
    return result;
}

// ============================================================
// SerialPort 構造体
// ============================================================

/// UARTシリアルポート（COM1等）
export struct SerialPort {
    IoPort port;    // ベースI/Oポートアドレス（COM1 = 0x3F8）
}

// ============================================================
// SerialPort メソッド実装
// ============================================================

impl SerialPort {
    /// 引数付きコンストラクタ: ポートアドレス設定 + ハードウェア初期化
    /// 使用例: SerialPort serial(0x3F8);
    overload self(IoPort port_addr) {
        self.port = port_addr;

        // 割り込みを無効化
        outb(port_addr + 1, 0x00);
        // DLABをセットしてボーレート設定モードに入る
        outb(port_addr + 3, 0x80);
        // ボーレート除数 = 1 (115200 baud)
        outb(port_addr, 0x01);
        outb(port_addr + 1, 0x00);
        // 8N1: 8データビット, パリティなし, 1ストップビット
        outb(port_addr + 3, 0x03);
        // FIFO有効化
        outb(port_addr + 2, 0xC7);
        // DTR + RTS + OUT2
        outb(port_addr + 4, 0x0B);
        // ループバックテスト
        outb(port_addr + 4, 0x1E);
        outb(port_addr, 0xAE);
        ulong test_result = inb(port_addr);
        // 通常モードに戻す
        outb(port_addr + 4, 0x0F);
    }

    /// シリアルポートを初期化（ボーレート115200, 8N1, FIFO有効）
    void init() {
        IoPort p = self.port;

        // 割り込みを無効化
        outb(p + 1, 0x00);  // IER

        // DLABをセットしてボーレート設定モードに入る
        outb(p + 3, 0x80);  // LCR, DLAB = 0x80

        // ボーレート除数 = 1 (115200 baud)
        outb(p, 0x01);      // DLL
        outb(p + 1, 0x00);  // DLM

        // 8N1: 8データビット, パリティなし, 1ストップビット
        outb(p + 3, 0x03);  // LCR, 8N1

        // FIFO有効化: 14バイトしきい値, FIFO クリア
        outb(p + 2, 0xC7);  // FCR

        // DTR + RTS + OUT2
        outb(p + 4, 0x0B);  // MCR

        // ループバックモードでテスト
        outb(p + 4, 0x1E);  // MCR ループバック設定
        outb(p, 0xAE);      // DATA テストバイト送信

        // テストバイトが返ってくるか確認
        ulong test_result = inb(p);
        // ループバック解除して通常モードに戻す
        outb(p + 4, 0x0F);  // MCR
    }

    /// 送信バッファが空になるまで待機
    void wait_ready() {
        IoPort lsr_port = self.port + 5;  // LSR
        ulong thre_mask = 0x20;
        ulong status = inb(lsr_port);
        ulong thre = status & thre_mask;
        while (thre == 0) {
            status = inb(lsr_port);
            thre = status & thre_mask;
        }
    }

    // putc/puts/println/print_hex は impl SerialPort for OutputWriter で定義
}

// ============================================================
// OutputWriter インターフェース実装
// ============================================================

impl SerialPort for OutputWriter {
    void putc(ulong ch) {
        self.wait_ready();
        outb(self.port, ch);
    }

    void puts(void* data) {
        MemAddr data_val = data as ulong;
        ulong i = 0;
        while (true) {
            AsciiChar byte_val = 0;
            MemAddr addr = data_val + i;
            __asm__(`
                movq ${r:addr}, %r10;
                xorq %rax, %rax;
                movzbl (%r10), %eax;
                movq %rax, ${=r:byte_val}
            `);
            if (byte_val == 0) { break; }
            if (byte_val == 10) { self.putc(13); }
            self.putc(byte_val);
            i += 1;
        }
    }

    void println(void* data) {
        self.puts(data);
        self.putc(13);
        self.putc(10);
    }

    void print_hex(ulong value) {
        self.putc(48);
        self.putc(120);
        ulong mask = 15;
        ulong char_0 = 48;
        ulong char_A = 65;
        ulong i = 0;
        while (i < 16) {
            ulong shift = (15 - i) * 4;
            ulong nibble = (value >> shift) & mask;
            ulong ten = 10;
            if (nibble < ten) {
                self.putc(char_0 + nibble);
            } else {
                self.putc(char_A + nibble - ten);
            }
            i += 1;
        }
    }
}
