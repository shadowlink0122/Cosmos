//! platform: uefi
// kernel::sys::loader - CosmEXE アプリケーションローダー
//
// CosmFSからCosmEXEバイナリを読み込み、ヒープにロードして実行する。
//
// CosmEXEフォーマット:
//   [0x00] magic:     8B  = 0x004558456D736F43 ("CosmEXE\0")
//   [0x08] entry:     8B  = エントリポイントオフセット
//   [0x10] code_size: 8B  = コードセクションサイズ
//   [0x18] flags:     8B  = 予約（0）
//   [0x20] code:      ... = 実行コード
//
// API:
//   loader_exec(name_addr) → 0=成功, 非0=エラー

import ../config;
import ../drivers/debug_port;
import ../drivers/serial;
import ../fs/cosmfs;
import ../mm/heap;
import ../mm/pmm;
import ../mm/user_pgtable;
import ../loader/elf_loader;
import ../arch/usermode;
import ../shell/shell_io;

// CosmFS操作コード
const ulong LDR_FS_FIND    = 5;
const ulong LDR_FS_SIZE    = 3;
const ulong LDR_FS_READ    = 12;
const ulong LDR_NOT_FOUND  = 0xFFFFFFFFFFFFFFFF;

// ============================================================
// ヘルパー
// ============================================================

/// 8バイト読み取り（リトルエンディアン）
export ulong loader_read_u64(MemAddr addr) {
    ulong val = 0;
    __asm__(`
        movq ${r:addr}, %rdi;
        movq (%rdi), %rax;
        movq %rax, ${=r:val}
    `);
    return val;
}

// ============================================================
// CosmEXEローダー
// ============================================================

/// CosmEXEバイナリを検証して実行する（バッファ指定版）
/// buf_addr: CosmEXEデータが読み込まれたバッファアドレス
/// buf_size: バッファサイズ
/// 戻り値: 0=成功, 5=magic不一致
export ulong loader_exec_buf(MemAddr buf_addr, ulong buf_size) {
    DebugPort debug(0xE9);

    // CosmEXEヘッダ検証
    ulong magic = loader_read_u64(buf_addr);
    if (magic != COSMEXE_MAGIC) {
        debug.puts("[LOADER] error: bad magic: " as void*);
        debug.print_hex(magic);
        debug.println("" as void*);
        return 5;
    }

    ulong entry_offset = loader_read_u64(buf_addr + 8);
    ulong code_size = loader_read_u64(buf_addr + 16);

    debug.puts("[LOADER] entry=" as void*);
    debug.print_hex(entry_offset);
    debug.puts(" code_size=" as void*);
    debug.print_hex(code_size);
    debug.println("" as void*);

    // エントリポイントに制御を移す
    // コードはヘッダ(32B)の後に配置されている
    MemAddr code_base = buf_addr + COSMEXE_HEADER_SIZE;
    MemAddr entry_addr = code_base + entry_offset;

    debug.puts("[LOADER] jumping to " as void*);
    debug.print_hex(entry_addr);
    debug.println("" as void*);

    // アプリのエントリポイントを呼び出す
    // efi_main(0, 0) → 戻り値を返す
    ulong ret = 0;
    __asm__(`
        movq ${r:entry_addr}, %rax;
        xorq %rdi, %rdi;
        xorq %rsi, %rsi;
        call *%rax;
        movq %rax, ${=r:ret}
    `);

    debug.puts("[LOADER] app returned: " as void*);
    debug.print_hex(ret);
    debug.println("" as void*);

    return 0;
}

/// CosmEXEバイナリをCosmFSからロードし実行する（ヒープ自動確保版）
/// name_addr: ファイル名のアドレス（NUL終端）
/// 戻り値: 0=成功, 1=ファイル未発見, 2=サイズ取得失敗, 3=サイズ超過,
///         4=読込失敗, 5=magic不一致, 6=ヒープ割当失敗
export ulong loader_exec(MemAddr name_addr) {
    DebugPort debug(0xE9);

    debug.puts("[LOADER] loading: " as void*);
    debug.puts(name_addr as void*);
    debug.println("" as void*);

    // 1. CosmFSでファイル検索
    ulong find_result = cosmfs_op(LDR_FS_FIND, name_addr, 0, 0, 0);
    if (find_result == LDR_NOT_FOUND) {
        debug.println("[LOADER] error: file not found" as void*);
        return 1;
    }

    // 2. ファイルサイズ取得
    ulong size = cosmfs_op(LDR_FS_SIZE, name_addr, 0, 0, 0);
    if (size == 0) {
        debug.println("[LOADER] error: empty file" as void*);
        return 2;
    }
    if (size > APP_MAX_SIZE) {
        debug.println("[LOADER] error: binary too large" as void*);
        return 3;
    }

    debug.puts("[LOADER] size=" as void*);
    debug.print_hex(size);
    debug.println("" as void*);

    // 3. ヒープにバッファ確保して読み込み
    ulong* heap_ptr = ADDR_GLOBAL_HEAP as ulong*;
    MemAddr heap_addr = *heap_ptr;
    Heap* heap = heap_addr as Heap*;
    MemAddr load_addr = heap->alloc(size);
    if (load_addr == 0) {
        debug.println("[LOADER] error: heap alloc failed" as void*);
        return 6;
    }

    ulong read_result = cosmfs_op(LDR_FS_READ, name_addr, load_addr, size, 0);
    if (read_result == 0) {
        debug.println("[LOADER] error: read failed" as void*);
        return 4;
    }

    // 4. バッファ指定版で実行
    return loader_exec_buf(load_addr, size);
}

// ============================================================
// ELF64ローダー
// ============================================================

/// ELF64バイナリをCosmFSからロードしRing 3で実行する
/// name_addr: ファイル名のアドレス（NUL終端）
/// 戻り値: 0=成功, 1=ファイル未発見, 2=読み込み失敗, 7=ELFエラー
export ulong loader_exec_elf(MemAddr name_addr) {
    DebugPort debug(0xE9);
    SerialPort serial = {port: 0x3F8};

    debug.puts("[ELF-LOADER] loading: " as void*);
    debug.puts(name_addr as void*);
    debug.println("" as void*);

    // 1. CosmFSでファイル検索
    ulong find_result = cosmfs_op(LDR_FS_FIND, name_addr, 0, 0, 0);
    if (find_result == LDR_NOT_FOUND) {
        shell_set_color(0x00FF4444);
        shell_println("Error: file not found" as void*);
        return 1;
    }

    // 2. ファイルサイズ取得
    ulong size = cosmfs_op(LDR_FS_SIZE, name_addr, 0, 0, 0);
    if (size == 0) {
        shell_set_color(0x00FF4444);
        shell_println("Error: empty file" as void*);
        return 2;
    }

    // 3. ヒープにバッファ確保して読み込み
    ulong* heap_ptr = ADDR_GLOBAL_HEAP as ulong*;
    MemAddr heap_addr = *heap_ptr;
    Heap* heap = heap_addr as Heap*;

    MemAddr elf_buf = heap->alloc(size);
    if (elf_buf == 0) {
        shell_set_color(0x00FF4444);
        shell_println("Error: heap alloc failed" as void*);
        return 2;
    }

    ulong read_result = cosmfs_op(LDR_FS_READ, name_addr, elf_buf, size, 0);
    if (read_result == 0) {
        shell_set_color(0x00FF4444);
        shell_println("Error: read failed" as void*);
        return 2;
    }

    // 4. ELF64ロード
    MemAddr entry_mem = heap->alloc(8);
    if (entry_mem == 0) { return 2; }
    ulong* entry_ptr = entry_mem as ulong*;
    ulong elf_err = elf_load(elf_buf, size, entry_ptr);
    if (elf_err != 0) {
        shell_set_color(0x00FF4444);
        shell_puts("ELF error: " as void*);
        shell_print_num(elf_err);
        shell_newline();
        return 7;
    }

    ulong entry = *entry_ptr;

    // 5. ユーザスタック確保（8KB）
    ulong user_stack_size = 8192;
    MemAddr user_stack_base = heap->alloc(user_stack_size);
    if (user_stack_base == 0) {
        shell_set_color(0x00FF4444);
        shell_println("Error: stack alloc failed" as void*);
        return 2;
    }
    MemAddr user_stack_top = user_stack_base + user_stack_size;

    // 6. Ring 3でELFエントリポイントに遷移
    shell_set_color(0x0000FF88);
    shell_puts("Executing ELF at 0x" as void*);
    serial.puts("[ELF] entry=0x" as void*);
    serial.print_hex(entry);
    serial.println("" as void*);

    debug.puts("[ELF-LOADER] entering usermode: entry=0x" as void*);
    debug.print_hex(entry);
    debug.puts(", stack=0x" as void*);
    debug.print_hex(user_stack_top);
    debug.println("" as void*);

    // カーネルスタック設定 + Ring 3遷移
    // カーネルスタック用のメモリ確保（8KB）
    MemAddr kern_stack = heap->alloc(8192);
    if (kern_stack != 0) {
        usermode_set_kernel_stack(kern_stack + 8192);
    }

    // Linuxモードフラグを設定
    ulong* linux_flag = 0xE40 as ulong*;  // USERMODE_LINUX_MODE
    ulong one = 1;
    *linux_flag = one;

    // カーネルコンテキストを保存（syscall exit復帰用）
    // テストモードと同じ固定アドレスに保存
    __asm__(`
        movq %rbx, (0xDD0);
        movq %rbp, (0xDD8);
        movq %r12, (0xDE0);
        movq %r13, (0xDE8);
        movq %r14, (0xDF0);
        movq %r15, (0xDF8);
        movq %rsp, (0xE00);
        movq %cr3, %rax;
        movq %rax, (0xE38);
        leaq 1f(%rip), %rax;
        movq %rax, (0xE48);
        1:
    `);

    // フラグが0になっていれば復帰してきた
    ulong* check_flag = 0xE40 as ulong*;
    if (*check_flag == 0) {
        // ELFプログラムが終了した
        ulong* exit_code = 0xE28 as ulong*;  // USERMODE_TEST_EXIT_CODE
        ulong ec = *exit_code;

        shell_set_color(0x0000FF88);
        shell_puts("ELF exited with code " as void*);
        shell_print_num(ec);
        shell_newline();
        return 0;
    }

    enter_usermode(entry, user_stack_top);

    // enter_usermode は戻らない（syscall exit で上の leaq 1f 地点に戻る）
    return 0;
}

// ============================================================
// ユーザモードCosmEXE実行（Ring 3, 独立ページテーブル）
// ============================================================

/// CosmEXEバイナリをRing 3（ユーザモード）で実行する
///
/// 手順:
///   1. ユーザCR3（独立PML4）を作成
///   2. CosmEXEをユーザ空間(0x400000)にロード＆マッピング
///   3. ユーザスタック(0x800000)を割り当て
///   4. CR3を切替 → sysretqでRing 3に遷移
///   5. SYS_EXITでカーネルに復帰 → ページテーブル解放
///
/// buf_addr: カーネル空間に読み込まれたCosmEXEバッファ
/// buf_size: バッファサイズ
///
/// 戻り値: 終了コード
export ulong loader_exec_usermode(MemAddr buf_addr, ulong buf_size) {
    DebugPort debug(0xE9);
    SerialPort serial = {port: 0x3F8};

    debug.println("[LOADER] === User Mode Execution ===" as void*);
    serial.println("[CosmOS] Starting Ring 3 process" as void*);

    // CosmEXE マジック検証
    ulong magic = loader_read_u64(buf_addr);
    if (magic != COSMEXE_MAGIC) {
        debug.println("[LOADER] ERROR: bad magic" as void*);
        shell_set_color(0x00FF4444);
        shell_println("Error: not a valid CosmEXE" as void*);
        return 1;
    }

    // PMM取得（グローバルPMMポインタ経由）
    ulong* pmm_ptr = ADDR_GLOBAL_PMM as ulong*;
    MemAddr pmm_addr = *pmm_ptr;
    PMM* pmm = pmm_addr as PMM*;

    // Step 1: ユーザページテーブル作成
    MemAddr user_cr3 = user_pgtable_create(pmm);
    if (user_cr3 == 0) {
        shell_set_color(0x00FF4444);
        shell_println("Error: cannot create user page table" as void*);
        return 2;
    }

    // Step 2: CosmEXEをユーザ空間にロード
    MemAddr user_entry = user_pgtable_load_cosmexe(user_cr3, buf_addr, buf_size, pmm);
    if (user_entry == 0) {
        user_pgtable_destroy(user_cr3, pmm);
        shell_set_color(0x00FF4444);
        shell_println("Error: cannot load program" as void*);
        return 3;
    }

    MemAddr user_stack_top = USER_STACK_TOP;

    // Step 3: カーネルコンテキスト保存（SYS_EXIT復帰用）
    ulong* test_flag = USERMODE_TEST_FLAG as ulong*;
    ulong one = 1;
    *test_flag = one;

    // カーネルCR3を保存
    ulong kernel_cr3 = 0;
    __asm__(` movq %cr3, %rax; movq %rax, ${=r:kernel_cr3} `);
    ulong* kcr3_save = USERMODE_TEST_KERNEL_CR3 as ulong*;
    *kcr3_save = kernel_cr3;

    // callee-savedレジスタとRSPを保存
    __asm__(`
        movq %rbx, (0xDD0);
        movq %rbp, (0xDD8);
        movq %r12, (0xDE0);
        movq %r13, (0xDE8);
        movq %r14, (0xDF0);
        movq %r15, (0xDF8);
        movq %rsp, (0xE00);
        leaq 1f(%rip), %rax;
        movq %rax, (0xE30);
        1:
    `);

    // SYS_EXITから復帰した場合
    ulong* check_flag2 = USERMODE_TEST_FLAG as ulong*;
    if (*check_flag2 == 0) {
        ulong* exit_code_ptr = USERMODE_TEST_EXIT_CODE as ulong*;
        ulong ec = *exit_code_ptr;

        // ユーザページテーブルを解放
        user_pgtable_destroy(user_cr3, pmm);

        shell_set_color(0x0000FF88);
        shell_puts("Process exited (Ring 3) code=" as void*);
        shell_print_num(ec);
        shell_newline();
        return ec;
    }

    // Step 4: CR3をユーザ空間に切替
    debug.puts("[LOADER] switching CR3 to 0x" as void*);
    debug.print_hex(user_cr3);
    debug.println("" as void*);
    __asm__(`
        movq ${r:user_cr3}, %rax;
        movq %rax, %cr3
    `);

    // Step 5: Ring 3に遷移
    enter_usermode(user_entry, user_stack_top);

    // ここには到達しない
    return 0;
}

