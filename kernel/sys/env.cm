//! platform: uefi
// kernel::sys::env - 環境変数管理
//
// 固定メモリ領域に環境変数（キー=値ペア）を格納・取得する。
//
// メモリレイアウト (ADDR_ENV_TABLE):
//   16エントリ × 64B = 1024B
//   各エントリ: [key: 24B (NUL終端)] [value: 40B (NUL終端)]
//
// API:
//   env_init()            — 初期変数設定
//   env_get(key) → value  — 値のアドレスを返す (0=未発見)
//   env_set(key, value)   — 設定 or 更新
//   env_count() → 数      — 変数数を返す

import ../config;
import ../drivers/debug_port;

// ============================================================
// 定数
// ============================================================

const ulong ENV_ENTRY_SIZE = 64;   // 各エントリのサイズ
const ulong ENV_KEY_SIZE   = 24;   // キー領域のサイズ
const ulong ENV_VAL_OFFSET = 24;   // 値のオフセット（エントリ内）
const ulong ENV_VAL_SIZE   = 40;   // 値領域のサイズ
const ulong ENV_MAX_ENTRIES = 16;  // 最大変数数

// ============================================================
// ヘルパー
// ============================================================

/// 1バイト読み取り
export ulong env_read_byte(ulong addr) {
    ulong ch = 0;
    __asm__(`
        movq ${r:addr}, %rdi;
        xorq %rax, %rax;
        movb (%rdi), %al;
        movq %rax, ${=r:ch}
    `);
    return ch;
}

/// 1バイト書き込み
export ulong env_write_byte(ulong addr, ulong val) {
    __asm__(`
        movq ${r:addr}, %rdi;
        movq ${r:val}, %rax;
        movb %al, (%rdi)
    `);
    return 0;
}

/// 文字列比較（NUL終端）
export ulong env_streq(ulong a, ulong b) {
    ulong i = 0;
    ulong max_len = 256;
    while (i < max_len) {
        ulong ch_a = env_read_byte(a + i);
        ulong ch_b = env_read_byte(b + i);
        if (ch_a != ch_b) {
            return 0;
        }
        if (ch_a == 0) {
            return 1;  // 両方NULに到達 → 一致
        }
        i = i + 1;
    }
    return 0;
}

/// 文字列コピー（最大max_lenバイト、NUL終端含む）
export ulong env_strcpy(ulong dst, ulong src, ulong max_len) {
    ulong i = 0;
    while (i < max_len) {
        ulong ch = env_read_byte(src + i);
        env_write_byte(dst + i, ch);
        if (ch == 0) {
            return i;
        }
        i = i + 1;
    }
    // 末尾NUL
    env_write_byte(dst + max_len - 1, 0);
    return max_len - 1;
}

// ============================================================
// API
// ============================================================

/// 環境変数テーブルをゼロクリアし、初期変数を設定
export void env_init() {
    // テーブルをゼロクリア
    ulong total = ENV_MAX_ENTRIES * ENV_ENTRY_SIZE;
    ulong i = 0;
    while (i < total) {
        env_write_byte(ADDR_ENV_TABLE + i, 0);
        i = i + 1;
    }
    // 変数数=0
    ulong* count_ptr = ADDR_ENV_COUNT as ulong*;
    ulong zero = 0;
    *count_ptr = zero;

    // 初期変数を設定
    env_set("PATH" as ulong, "/bin" as ulong);
    env_set("HOME" as ulong, "/home" as ulong);
    env_set("PWD" as ulong, "/" as ulong);
    env_set("SHELL" as ulong, "/bin/csh" as ulong);

    DebugPort debug(0xE9);
    debug.println("[ENV] initialized with 4 variables" as void*);
}

/// 環境変数数を返す
export ulong env_count() {
    ulong* count_ptr = ADDR_ENV_COUNT as ulong*;
    return *count_ptr;
}

/// キーで環境変数を検索し、値のアドレスを返す（0=未発見）
export ulong env_get(ulong key_addr) {
    ulong* count_ptr = ADDR_ENV_COUNT as ulong*;
    ulong count = *count_ptr;
    ulong i = 0;
    while (i < count) {
        ulong entry_addr = ADDR_ENV_TABLE + (i * ENV_ENTRY_SIZE);
        ulong first_byte = env_read_byte(entry_addr);
        if (first_byte != 0) {
            if (env_streq(entry_addr, key_addr) != 0) {
                // 値のアドレスを返す
                return entry_addr + ENV_VAL_OFFSET;
            }
        }
        i = i + 1;
    }
    return 0;  // 未発見
}

/// 環境変数を設定する（既存なら更新、新規なら追加）
export void env_set(ulong key_addr, ulong val_addr) {
    ulong* count_ptr = ADDR_ENV_COUNT as ulong*;
    ulong count = *count_ptr;

    // 既存のキーを検索
    ulong i = 0;
    while (i < count) {
        ulong entry_addr = ADDR_ENV_TABLE + (i * ENV_ENTRY_SIZE);
        ulong first_byte = env_read_byte(entry_addr);
        if (first_byte != 0) {
            if (env_streq(entry_addr, key_addr) != 0) {
                // 値を更新
                env_strcpy(entry_addr + ENV_VAL_OFFSET, val_addr, ENV_VAL_SIZE);
                return;
            }
        }
        i = i + 1;
    }

    // 新規追加
    if (count >= ENV_MAX_ENTRIES) {
        return;  // テーブル満杯
    }
    ulong entry_addr = ADDR_ENV_TABLE + (count * ENV_ENTRY_SIZE);
    env_strcpy(entry_addr, key_addr, ENV_KEY_SIZE);
    env_strcpy(entry_addr + ENV_VAL_OFFSET, val_addr, ENV_VAL_SIZE);
    ulong nc = count + 1;
    *count_ptr = nc;
}

/// 全環境変数を列挙する（デバッグ用）
/// コールバックの代わりにインデックスでアクセス:
///   env_get_key(idx) → キーアドレス
///   env_get_val(idx) → 値アドレス
export ulong env_get_key(ulong idx) {
    ulong* count_ptr = ADDR_ENV_COUNT as ulong*;
    ulong count = *count_ptr;
    if (idx >= count) { return 0; }
    return ADDR_ENV_TABLE + (idx * ENV_ENTRY_SIZE);
}

export ulong env_get_val(ulong idx) {
    ulong* count_ptr = ADDR_ENV_COUNT as ulong*;
    ulong count = *count_ptr;
    if (idx >= count) { return 0; }
    return ADDR_ENV_TABLE + (idx * ENV_ENTRY_SIZE) + ENV_VAL_OFFSET;
}
