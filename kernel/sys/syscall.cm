//! platform: uefi
// kernel::sys::syscall - syscallディスパッチャ
//
// int 0x80 ソフトウェア割り込みを受け取り、raxのsyscall番号に基づいて
// 適切なハンドラにディスパッチする。
//
// ABI規約:
//   rax = syscall番号
//   rdi = 引数1
//   rsi = 引数2
//   rdx = 引数3
//   r10 = 引数4
//   戻り値: rax
//
// 使用方法:
//   syscall_init(idt_table) を呼んでベクタ0x80を登録

import ../arch/idt;
import ../arch/isr;
import ../drivers/serial;
import ../drivers/debug_port;
import ../lib/print;
import ./syscall_table;
import ./env;
import ./screen;
import ./fs_syscall;
import ./process;
import ./sbrk;
// IPC: Bug #14回避のため ipc.cm を独立モジュールにせず直接記述

// ============================================================
// syscallハンドラエントリポイント（アセンブリスタブ）
// ============================================================

/// int 0x80 ハンドラ — Cmプロローグのスタック操作を考慮した安全な実装
///
/// 注意: この関数はASM文とCmコード（syscall_dispatch呼出し）が混在するため、
///       コンパイラのnaked属性は適用されない（純ASM関数のみnaked化される）。
///       通常のプロローグ（push rbp; sub rsp, $X 等）が自動生成される。
///
/// 問題: Cmプロローグにより`iretq`時にinterruptフレーム(RIP,CS,RFLAGS,RSP,SS)が
///       スタックの正しい位置にない。
/// 解決: 固定メモリ(0xDA0)にプロローグ直後のRSPを保存。
///       dispatch後、保存したRSPからinterruptフレーム位置を逆算して復元。
export void syscall_entry() {
    // Cmプロローグ直後のRSPを固定メモリに保存
    // interruptフレームはプロローグ前のRSP位置にある
    __asm__(`
        movq %rsp, %r11;
        movq %r11, (0xDA0)
    `);

    // int 0x80 時のレジスタ状態を取得
    SyscallNr syscall_nr = 0;
    ulong arg1 = 0;
    ulong arg2 = 0;
    ulong arg3 = 0;
    __asm__(`
        movq %rax, ${=r:syscall_nr};
        movq %rdi, ${=r:arg1};
        movq %rsi, ${=r:arg2};
        movq %rdx, ${=r:arg3}
    `);

    SyscallResult result = syscall_dispatch(syscall_nr, arg1, arg2, arg3);

    // dispatch結果をraxに設定し、スタックをinterruptフレーム先頭に復元
    // 保存RSP = プロローグ完了後のRSP
    // interruptフレーム = 保存RSP + プロローグサイズ（0xb8）
    __asm__(`
        movq ${r:result}, %rax;
        movq (0xDA0), %rsp;
        addq $$0xb8, %rsp;
        iretq
    `);
}

// ============================================================
// syscallディスパッチャ
// ============================================================

/// syscall番号に基づいてハンドラを呼び出す
export SyscallResult syscall_dispatch(SyscallNr nr, ulong arg1, ulong arg2, ulong arg3) {
    if (nr == SYS_WRITE) {
        return sys_write(arg1, arg2, arg3);
    }
    if (nr == SYS_READ) {
        return sys_read(arg1, arg2, arg3);
    }
    if (nr == SYS_EXIT) {
        sys_exit(arg1);
        return 0;
    }
    if (nr == SYS_GETENV) {
        return env_get(arg1);
    }

    // 画面I/O syscall (10-18)
    if (nr == SYS_SCREEN_CLEAR) {
        return sys_screen_clear();
    }
    if (nr == SYS_SCREEN_PUTC) {
        return sys_screen_putc(arg1);
    }
    if (nr == SYS_SCREEN_PUTS) {
        return sys_screen_puts(arg1, arg2);
    }
    if (nr == SYS_SCREEN_SET_COLOR) {
        return sys_screen_set_color(arg1);
    }
    if (nr == SYS_SCREEN_GET_SIZE) {
        return sys_screen_get_size();
    }
    if (nr == SYS_SCREEN_SET_CURSOR) {
        return sys_screen_set_cursor(arg1, arg2);
    }
    if (nr == SYS_SCREEN_NEWLINE) {
        return sys_screen_newline();
    }
    if (nr == SYS_SCREEN_PRINT_NUM) {
        return sys_screen_print_num(arg1);
    }
    if (nr == SYS_SCREEN_PRINT_HEX) {
        return sys_screen_print_hex(arg1);
    }
    if (nr == SYS_SCREEN_BATCH) {
        if (arg1 != 0) { return sys_screen_begin_batch(); }
        return sys_screen_end_batch();
    }

    // ファイルI/O syscall (20-25)
    if (nr == SYS_FS_OPEN) {
        return sys_fs_open(arg1, arg2);
    }
    if (nr == SYS_FS_READ) {
        return sys_fs_read(arg1, arg2, arg3);
    }
    if (nr == SYS_FS_WRITE) {
        return sys_fs_write(arg1, arg2, arg3);
    }
    if (nr == SYS_FS_CREATE) {
        return sys_fs_create(arg1, arg2, arg3);
    }
    if (nr == SYS_FS_SIZE) {
        return sys_fs_size(arg1);
    }
    if (nr == SYS_FS_MEMCPY) {
        return sys_fs_memcpy(arg1, arg2, arg3);
    }

    // プロセスsyscall (30-35)
    if (nr == SYS_SPAWN) {
        return sys_spawn(arg1);
    }
    if (nr == SYS_KILL) {
        return sys_kill(arg1);
    }
    if (nr == SYS_WAIT) {
        return sys_wait(arg1);
    }
    if (nr == SYS_GETPID) {
        return sys_getpid();
    }

    // メモリ管理syscall (40-49)
    if (nr == SYS_SBRK) {
        return sys_sbrk(arg1);
    }

    // IPC syscall (50-59)
    if (nr == SYS_SEND) { return ipc_send(arg1, arg2, arg3); }
    if (nr == SYS_RECV) { return ipc_recv(arg1); }
    if (nr == SYS_REPLY) { return ipc_send(arg1, 0xFFFF, arg2); }
    if (nr == SYS_NOTIFY) { return ipc_notify(arg1, arg2); }
    if (nr == SYS_GET_NOTIFY) { return ipc_get_notify(); }

    // 未実装syscall
    DebugPort debug = {port: 0xE9};
    debug.puts("[SYSCALL] unknown nr=" as void*);
    debug.print_hex(nr);
    debug.println("" as void*);
    return SYSCALL_ENOSYS;
}

// ============================================================
// IPC メッセージパッシング（インライン実装）
// ============================================================
// メモリレイアウト:
//   0x3000: メッセージキュー (8タスク × 4エントリ × 64B = 2KB)
//   0x3800: 通知ビットマスク (8 × 8B = 64B)

const MemAddr IPC_BASE = 0x3000;
const ulong IPC_MSG_SZ = 64;
const ulong IPC_Q_SIZE = 4;
const ulong IPC_TASK_SZ = 256;
const ulong MSG_S_SENDER = 0;
const ulong MSG_S_TYPE = 16;
const ulong MSG_S_ARG0 = 24;
const ulong MSG_S_ARG1 = 32;
const ulong MSG_S_STATUS = 56;
const MemAddr IPC_NOTIFY = 0x3800;
const ulong IPC_ANY_PID = 0xFFFFFFFFFFFFFFFF;

ulong ipc_rd(MemAddr a, ulong o) { ulong* p = (a + o) as ulong*; return *p; }
void ipc_wr(MemAddr a, ulong o, ulong v) { ulong* p = (a + o) as ulong*; *p = v; }
MemAddr ipc_slot(ulong tid, ulong s) { return IPC_BASE + tid * IPC_TASK_SZ + s * IPC_MSG_SZ; }

export void ipc_init() {
    ulong i = 0;
    while (i < 2048) { ulong* p = (IPC_BASE + i) as ulong*; ulong z = 0; *p = z; i = i + 8; }
    ulong j = 0;
    while (j < 64) { ulong* p = (IPC_NOTIFY + j) as ulong*; ulong z = 0; *p = z; j = j + 8; }
}

SyscallResult ipc_send(ulong target, ulong mtype, ulong a0) {
    TaskId sender = sched_current_id();
    ulong count = sched_task_count();
    if (target >= count) { return SYSCALL_EINVAL; }
    ulong s = 0;
    while (s < IPC_Q_SIZE) {
        MemAddr ma = ipc_slot(target, s);
        if (ipc_rd(ma, MSG_S_STATUS) == 0) {
            ipc_wr(ma, MSG_S_SENDER, sender);
            ipc_wr(ma, MSG_S_TYPE, mtype);
            ipc_wr(ma, MSG_S_ARG0, a0);
            ulong one = 1;
            ipc_wr(ma, MSG_S_STATUS, one);
            // 受信側がBLOCKEDなら起床
            TaskState st = tcb_read(target, TCB_OFF_STATE);
            if (st == TASK_BLOCKED) {
                TaskId wf = tcb_read(target, TCB_OFF_WAIT_FOR);
                if (wf == IPC_ANY_PID) { tcb_write(target, TCB_OFF_STATE, TASK_READY); }
                if (wf == sender) { tcb_write(target, TCB_OFF_STATE, TASK_READY); }
            }
            return 0;
        }
        s = s + 1;
    }
    return SYSCALL_ERR;  // キュー満杠
}

SyscallResult ipc_scan(TaskId rcv, ulong filter) {
    ulong s = 0;
    while (s < IPC_Q_SIZE) {
        MemAddr ma = ipc_slot(rcv, s);
        if (ipc_rd(ma, MSG_S_STATUS) != 0) {
            ulong sender = ipc_rd(ma, MSG_S_SENDER);
            ulong ok = 0;
            if (filter == IPC_ANY_PID) { ok = 1; }
            if (filter == sender) { ok = 1; }
            if (ok != 0) {
                ulong mt = ipc_rd(ma, MSG_S_TYPE);
                ulong a0 = ipc_rd(ma, MSG_S_ARG0);
                ulong z = 0;
                ipc_wr(ma, MSG_S_STATUS, z);
                return mt * 0x100000000 + a0;
            }
        }
        s = s + 1;
    }
    return SYSCALL_ERR;
}

SyscallResult ipc_recv(ulong filter) {
    TaskId rcv = sched_current_id();
    SyscallResult r = ipc_scan(rcv, filter);
    if (r != SYSCALL_ERR) { return r; }
    // BLOCKED
    tcb_write(rcv, TCB_OFF_STATE, TASK_BLOCKED);
    tcb_write(rcv, TCB_OFF_WAIT_FOR, filter);
    schedule();
    return ipc_scan(rcv, filter);
}

SyscallResult ipc_notify(ulong target, ulong bits) {
    ulong count = sched_task_count();
    if (target >= count) { return SYSCALL_EINVAL; }
    ulong* np = (IPC_NOTIFY + target * 8) as ulong*;
    ulong cur = *np;
    ulong upd = cur | bits;
    *np = upd;
    TaskState st = tcb_read(target, TCB_OFF_STATE);
    if (st == TASK_BLOCKED) { tcb_write(target, TCB_OFF_STATE, TASK_READY); }
    return 0;
}

SyscallResult ipc_get_notify() {
    TaskId c = sched_current_id();
    ulong* np = (IPC_NOTIFY + c * 8) as ulong*;
    ulong b = *np;
    ulong z = 0;
    *np = z;
    return b;
}

// ============================================================
// sys_write — fd, buf, len → bytes_written
// ============================================================

/// fd=1(stdout) or fd=2(stderr) に書き込む
export SyscallResult sys_write(Fd fd, MemAddr buf, ulong len) {
    if (fd == FD_STDOUT) {
        // FBConsole + シリアルに出力
        FBConsole con = {addr: GLOBAL_FB_CONSOLE_ADDR};
        SerialPort serial = {port: 0x3F8};
        ulong i = 0;
        while (i < len) {
            AsciiChar ch = 0;
            MemAddr byte_addr = buf + i;
            __asm__(`
                movq ${r:byte_addr}, %rdi;
                xorq %rax, %rax;
                movb (%rdi), %al;
                movq %rax, ${=r:ch}
            `);
            con.putc(ch);
            serial.putc(ch);
            i = i + 1;
        }
        return len;
    }
    if (fd == FD_STDERR) {
        // シリアルのみに出力（エラー出力）
        SerialPort serial = {port: 0x3F8};
        ulong i = 0;
        while (i < len) {
            AsciiChar ch = 0;
            MemAddr byte_addr = buf + i;
            __asm__(`
                movq ${r:byte_addr}, %rdi;
                xorq %rax, %rax;
                movb (%rdi), %al;
                movq %rax, ${=r:ch}
            `);
            serial.putc(ch);
            i = i + 1;
        }
        return len;
    }
    return SYSCALL_EBADF;
}

// ============================================================
// sys_read — fd, buf, len → bytes_read
// ============================================================

/// fd=0(stdin) から読み込む（現在は未実装、0を返す）
export SyscallResult sys_read(Fd fd, MemAddr buf, ulong len) {
    if (fd == FD_STDIN) {
        // TODO: キーボードバッファから読み取る
        return 0;
    }
    return SYSCALL_EBADF;
}

// ============================================================
// sys_exit — プロセス終了
// ============================================================

/// 現在のプロセスを終了する
export void sys_exit(ExitCode code) {
    DebugPort debug = {port: 0xE9};
    debug.puts("[SYSCALL] sys_exit code=" as void*);
    debug.print_hex(code);
    debug.println("" as void*);
    // プロセスマネージャ経由でタスク終了
    sys_exit_task(code);
}

// ============================================================
// 初期化
// ============================================================

/// syscallハンドラをIDTベクタ0x80に登録する
export void syscall_init(uint* idt_table) {
    IDT idt = {table: idt_table};

    // DPL=3 のTrap Gate (0xEF) を使用
    // P=1, DPL=3, Trap Gate = 1110_1111 = 0xEF
    // Trap Gateを使用する理由: syscall中に割り込みを有効に保つ
    MemAddr handler = fn_addr(syscall_entry as void*);
    idt.set_gate(0x80, handler, 0xEF);

    DebugPort debug = {port: 0xE9};
    debug.println("[SYSCALL] handler registered at vector 0x80" as void*);
}
