//! platform: uefi
// kernel::tests::apps::test_aria - Ariaテキストエディタテスト
//
// Ariaの初期化、ファイルオープン、キー入力処理、モード遷移を検証。
// ヒープを使わず固定メモリアドレスにバッファを配置。
// テスト実行前にcosmfs_init()が呼ばれていること。

import ../../drivers/serial;
import ../../drivers/debug_port;
import ../../fs/cosmfs;
import ../../apps/aria/aria;
import ../../config;
import ../test_runner;

// Aria操作コード
const ulong T_OP_OPEN       = 1;
const ulong T_OP_KEY_INPUT  = 2;
const ulong T_OP_IS_RUNNING = 4;
const ulong T_OP_GET_MODE   = 6;

// モード定数
const ulong T_MODE_NORMAL  = 0;
const ulong T_MODE_INSERT  = 1;
const ulong T_MODE_COMMAND = 2;

// キーコード
const ulong T_KEY_ESC   = 0x1B;
const ulong T_KEY_COLON = 0x3A;
const ulong T_KEY_i     = 0x69;
const ulong T_KEY_q     = 0x71;
const ulong T_KEY_h     = 0x68;
const ulong T_KEY_l     = 0x6C;

// テスト用固定メモリ領域（0x6000以降）
const ulong T_A_FNAME_BUF = 0x6000;  // ファイル名 64B
const ulong T_A_DATA_BUF  = 0x6100;  // データバッファ 4KB
const ulong T_A_WRITE_BUF = 0x7100;  // 書き込みバッファ 64B

/// バイト書き込みヘルパー
export void ta_write_byte(ulong addr, ulong val) {
    __asm__(`
        movq ${r:addr}, %rdi;
        movq ${r:val}, %rax;
        movb %al, (%rdi)
    `);
}

/// Ariaテストを実行する
export void test_aria(TestRunner* runner) {
    SerialPort serial(0x3F8);
    serial.println("[TEST] === Aria Tests ===" as void*);

    // --- テスト前準備: CosmFSにテストファイルを作成 ---
    // ファイル名 "a.txt"
    ta_write_byte(T_A_FNAME_BUF, 0x61);      // 'a'
    ta_write_byte(T_A_FNAME_BUF + 1, 0x2E);  // '.'
    ta_write_byte(T_A_FNAME_BUF + 2, 0x74);  // 't'
    ta_write_byte(T_A_FNAME_BUF + 3, 0x78);  // 'x'
    ta_write_byte(T_A_FNAME_BUF + 4, 0x74);  // 't'
    ta_write_byte(T_A_FNAME_BUF + 5, 0);     // NUL

    // CREATE
    cosmfs_op(1, T_A_FNAME_BUF, T_A_DATA_BUF, 4096, 0);
    // WRITE "AB"
    ta_write_byte(T_A_WRITE_BUF, 0x41);      // 'A'
    ta_write_byte(T_A_WRITE_BUF + 1, 0x42);  // 'B'
    cosmfs_op(2, T_A_FNAME_BUF, T_A_WRITE_BUF, 2, 0);

    // --- テスト1: aria_init ---
    aria_init();
    runner->assert_true(1, "Aria: init completes" as void*);

    // --- テスト2: 初期状態でIS_RUNNING=0 ---
    ulong r0 = aria_op(T_OP_IS_RUNNING, 0, 0, 0, 0);
    runner->assert_eq(r0, 0, "Aria: initially not running" as void*);

    // --- テスト3: OPEN でファイルを開く ---
    aria_op(T_OP_OPEN, T_A_FNAME_BUF, 5, 0, 0);
    ulong r1 = aria_op(T_OP_IS_RUNNING, 0, 0, 0, 0);
    runner->assert_eq(r1, 1, "Aria: running after OPEN" as void*);

    // --- テスト4: OPEN後のモードはNORMAL ---
    ulong m0 = aria_op(T_OP_GET_MODE, 0, 0, 0, 0);
    runner->assert_eq(m0, T_MODE_NORMAL, "Aria: NORMAL after OPEN" as void*);

    // --- テスト5: バッファにデータがロードされた ---
    ulong* bs_ptr = (ADDR_ARIA_STATE + 24) as ulong*;
    ulong bs = *bs_ptr;
    runner->assert_eq(bs, 2, "Aria: buffer loaded 2 bytes" as void*);

    // --- テスト6: 'i' でINSERTモード ---
    aria_op(T_OP_KEY_INPUT, T_KEY_i, 0, 0, 0);
    ulong m1 = aria_op(T_OP_GET_MODE, 0, 0, 0, 0);
    runner->assert_eq(m1, T_MODE_INSERT, "Aria: 'i' -> INSERT" as void*);

    // --- テスト7: ESC でNORMAL復帰 ---
    aria_op(T_OP_KEY_INPUT, T_KEY_ESC, 0, 0, 0);
    ulong m2 = aria_op(T_OP_GET_MODE, 0, 0, 0, 0);
    runner->assert_eq(m2, T_MODE_NORMAL, "Aria: ESC -> NORMAL" as void*);

    // --- テスト8: ':' でCOMMANDモード ---
    aria_op(T_OP_KEY_INPUT, T_KEY_COLON, 0, 0, 0);
    ulong m3 = aria_op(T_OP_GET_MODE, 0, 0, 0, 0);
    runner->assert_eq(m3, T_MODE_COMMAND, "Aria: ':' -> COMMAND" as void*);

    // --- テスト9: ESC でCOMMAND→NORMAL ---
    aria_op(T_OP_KEY_INPUT, T_KEY_ESC, 0, 0, 0);
    ulong m4 = aria_op(T_OP_GET_MODE, 0, 0, 0, 0);
    runner->assert_eq(m4, T_MODE_NORMAL, "Aria: ESC COMMAND -> NORMAL" as void*);

    // --- テスト10: 'l' でカーソル右移動 ---
    ulong* cx_ptr = (ADDR_ARIA_STATE + 8) as ulong*;
    ulong cx0 = *cx_ptr;
    aria_op(T_OP_KEY_INPUT, T_KEY_l, 0, 0, 0);
    ulong cx1 = *cx_ptr;
    ulong moved = 0;
    if (cx1 > cx0) {
        moved = 1;
    }
    runner->assert_true(moved, "Aria: 'l' moves cursor right" as void*);

    // --- テスト11: 'h' でカーソル左移動 ---
    aria_op(T_OP_KEY_INPUT, T_KEY_h, 0, 0, 0);
    ulong cx2 = *cx_ptr;
    runner->assert_eq(cx2, cx0, "Aria: 'h' moves cursor left" as void*);

    // --- テスト12: :q で終了 ---
    aria_op(T_OP_KEY_INPUT, T_KEY_COLON, 0, 0, 0);
    aria_op(T_OP_KEY_INPUT, T_KEY_q, 0, 0, 0);
    aria_op(T_OP_KEY_INPUT, 0x0A, 0, 0, 0);  // Enter
    ulong r_quit = aria_op(T_OP_IS_RUNNING, 0, 0, 0, 0);
    runner->assert_eq(r_quit, 0, "Aria: ':q' quits editor" as void*);

    serial.println("[TEST] Aria tests complete" as void*);
}
