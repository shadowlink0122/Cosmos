//! platform: uefi
// kernel::tests::test_pmm - PMM（物理メモリマネージャ）テスト

import ../../drivers/serial;
import ../../mm/pmm;
import ../test_runner;

// ============================================================
// PMM テスト
// ============================================================

/// PMM基本テストを実行する
export void test_pmm(TestRunner* runner, PMM* pmm) {
    SerialPort serial(0x3F8);
    serial.println("[TEST] === PMM Tests ===" as void*);

    // テスト1: alloc_pageが非ゼロアドレスを返す
    ulong page1 = pmm->alloc_page();
    runner->assert_nonzero(page1, "PMM alloc_page returns nonzero" as void*);

    // テスト2: 2回目のallocが異なるアドレスを返す
    ulong page2 = pmm->alloc_page();
    ulong different = 0;
    if (page1 != page2) {
        different = 1;
    }
    runner->assert_true(different, "PMM alloc returns different pages" as void*);

    // テスト3: free後のre-allocでページが再利用される
    pmm->free_page(page1);
    ulong page3 = pmm->alloc_page();
    runner->assert_eq(page3, page1, "PMM free/realloc reuses page" as void*);

    // クリーンアップ
    pmm->free_page(page2);
    pmm->free_page(page3);

    serial.println("[TEST] PMM tests complete" as void*);
}
