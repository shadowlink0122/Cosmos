//! platform: uefi
// kernel::tests::test_usermode - ユーザモード遷移テスト
//
// MSR設定、GDT User Codeセグメント、usermode_init の検証。
// 実際のRing 3遷移は統合テストとして別途実施。

import ../../drivers/serial;
import ../../drivers/debug_port;
import ../../arch/gdt;
import ../../arch/usermode;
import ../../config;
import ../test_runner;

// ============================================================
// ユーザモード テスト
// ============================================================

/// ユーザモードテストを実行する
export void test_usermode(TestRunner* runner) {
    SerialPort serial = {port: 0x3F8};
    serial.println("[TEST] === Usermode Tests ===" as void*);

    // テスト1: GDT User Data セグメントが正しく設定されている
    // GDT[3] (offset 24) = User Data
    ulong* gdt_udata = (GDT_PERMANENT_ADDR + 24) as ulong*;
    ulong udata_val = *gdt_udata;
    runner->assert_eq(udata_val, GDT_USER_DATA, "GDT: User Data segment" as void*);

    // テスト2: GDT User Code セグメントが正しく設定されている
    // GDT[4] (offset 32) = User Code
    ulong* gdt_ucode = (GDT_PERMANENT_ADDR + 32) as ulong*;
    ulong ucode_val = *gdt_ucode;
    runner->assert_eq(ucode_val, GDT_USER_CODE, "GDT: User Code segment" as void*);

    // テスト3: User Data セレクタが正しい (0x18 | RPL=3 = 0x1B)
    runner->assert_eq(GDT_USER_DATA_SEL, 0x1B, "GDT: User Data selector = 0x1B" as void*);

    // テスト4: User Code セレクタが正しい (0x20 | RPL=3 = 0x23)
    runner->assert_eq(GDT_USER_CODE_SEL, 0x23, "GDT: User Code selector = 0x23" as void*);

    // テスト5: usermode_init を呼び出してMSR設定
    MemAddr handler = fn_addr(syscall_entry_fast as void*);
    usermode_init(handler);

    // テスト6: EFER.SCE が有効化されている
    ulong efer = msr_read(MSR_EFER);
    ulong sce_bit = efer & EFER_SCE;
    runner->assert_eq(sce_bit, 1, "EFER: SCE bit enabled" as void*);

    // テスト7: STAR MSR が正しく設定されている
    ulong star = msr_read(MSR_STAR);
    // STAR[47:32] = 0x08 (Kernel CS)
    ulong shift32 = 32;
    ulong shift48 = 48;
    ulong star_kernel_cs = (star >> shift32) & 0xFFFF;
    runner->assert_eq(star_kernel_cs, 0x08, "STAR: kernel CS = 0x08" as void*);
    // STAR[63:48] = 0x10 (sysret base)
    ulong star_sysret = (star >> shift48) & 0xFFFF;
    runner->assert_eq(star_sysret, 0x10, "STAR: sysret base = 0x10" as void*);

    // テスト8: LSTAR が syscall_entry_fast を指している
    ulong lstar = msr_read(MSR_LSTAR);
    runner->assert_eq(lstar, handler, "LSTAR: points to syscall_entry_fast" as void*);

    // テスト9: SFMASK が IF|TF|DF をマスクしている
    ulong sfmask = msr_read(MSR_SFMASK);
    ulong expected_mask = RFLAGS_IF | RFLAGS_TF | RFLAGS_DF;
    runner->assert_eq(sfmask, expected_mask, "SFMASK: IF|TF|DF masked" as void*);

    serial.println("[TEST] Usermode tests complete" as void*);
}
