//! platform: uefi
// kernel::tests::test_kernel - カーネルコアテストスイート
//
// boot, pmm, heap, pit, tss, keyboard, scheduler, cosmfs, loaderの
// カーネルコアテストを一括実行する。

import ../drivers/serial;
import ../arch/boot_info;
import ../mm/pmm;
import ../mm/heap;
import ../mm/vmm;
import ../drivers/pit;
import ./test_runner;
import ./boot/test_boot;
import ./mm/test_pmm;
import ./mm/test_heap;
import ./drivers/test_pit;
import ./arch/test_tss;
import ./drivers/test_keyboard;
import ./sched/test_scheduler;
import ./fs/test_cosmfs;
import ./sys/test_loader;
import ./sys/test_process;
import ./sys/test_syscall;
import ./integration/test_integration;
import ./mm/test_vmm;

/// カーネルコアテストスイートを実行
export void test_kernel(TestRunner* runner, BootInfo* info, PMM* pmm, Heap* heap, PIT* pit, VMM* vmm) {
    SerialPort serial = {port: 0x3F8};
    serial.println("[CosmOS] --- Kernel Core Tests ---" as void*);

    test_boot(runner, info, pmm, heap);
    test_pmm(runner, pmm);
    test_heap(runner, heap);
    test_pit(runner, pit);
    test_tss(runner);
    test_keyboard(runner);
    test_scheduler(runner);
    test_process(runner);
    test_cosmfs(runner);
    test_syscall(runner);
    test_loader(runner, heap);
    test_integration(runner, heap, pmm);
    test_vmm(runner, vmm, pmm);

    serial.println("[CosmOS] --- Kernel Core Tests Done ---" as void*);
}
