//! platform: uefi
// kernel::tests::test_runner - テスト実行フレームワーク
//
// カーネル統合テストの結果カウント・出力を管理する。
// debug_port経由で[TEST]タグ付きの結果を出力し、
// MakefileのgrepでPASS/FAILを判定する。
//
// impl TestRunner でアサーション関数を定義。
// Cm v0.14.1 では self 変更が正常に反映される。

import ../drivers/serial;
import ../drivers/debug_port;

// ============================================================
// TestRunner 構造体
// ============================================================

/// テスト実行結果を管理する構造体
export struct TestRunner {
    ulong pass_count;   // PASSしたテスト数
    ulong fail_count;   // FAILしたテスト数
}

// ============================================================
// TestRunner メソッド実装
// ============================================================

impl TestRunner {
    /// コンストラクタ
    overload self() {
        self.pass_count = 0;
        self.fail_count = 0;
    }

    /// 条件が真であることをアサート
    void assert_true(ulong condition, void* test_name) {
        DebugPort debug(0xE9);
        SerialPort serial(0x3F8);
        ulong one = 1 as ulong;

        if (condition != 0) {
            debug.puts("[TEST] PASS: " as void*);
            debug.println(test_name);
            serial.puts("[TEST] PASS: " as void*);
            serial.println(test_name);
            self.pass_count = self.pass_count + one;
        } else {
            debug.puts("[TEST] FAIL: " as void*);
            debug.println(test_name);
            serial.puts("[TEST] FAIL: " as void*);
            serial.println(test_name);
            self.fail_count = self.fail_count + one;
        }
    }

    /// 2つの値が等しいことをアサート
    void assert_eq(ulong a, ulong b, void* test_name) {
        ulong condition = 0;
        if (a == b) {
            condition = 1;
        }
        self.assert_true(condition, test_name);
    }

    /// aがbより大きいことをアサート
    void assert_gt(ulong a, ulong b, void* test_name) {
        ulong condition = 0;
        if (a > b) {
            condition = 1;
        }
        self.assert_true(condition, test_name);
    }

    /// aが0でないことをアサート
    void assert_nonzero(ulong a, void* test_name) {
        ulong condition = 0;
        if (a != 0) {
            condition = 1;
        }
        self.assert_true(condition, test_name);
    }

    /// 2つの値が異なることをアサート
    void assert_ne(ulong a, ulong b, void* test_name) {
        ulong condition = 0;
        if (a != b) {
            condition = 1;
        }
        self.assert_true(condition, test_name);
    }

    /// メモリアドレスに書込み→読み戻しが一致することをアサート
    /// addr: テスト対象アドレス（0の場合はスキップしてFAIL）
    /// pattern: 書き込む値
    void assert_mem_write(ulong addr, ulong pattern, void* test_name) {
        if (addr == 0) {
            self.assert_true(0, test_name);
            return;
        }
        // パターンを書き込み
        ulong* ptr = addr as ulong*;
        *ptr = pattern;
        // 読み戻し
        ulong readback = *ptr;
        ulong ok = 0;
        if (readback == pattern) {
            ok = 1;
        }
        self.assert_true(ok, test_name);
    }

    /// テスト結果サマリーを出力
    void print_results() {
        DebugPort debug(0xE9);
        SerialPort serial(0x3F8);

        debug.puts("[TEST] results: " as void*);
        serial.puts("[TEST] results: " as void*);
        print_decimal(&serial, &debug, self.pass_count);
        debug.puts(" passed, " as void*);
        serial.puts(" passed, " as void*);
        print_decimal(&serial, &debug, self.fail_count);
        debug.println(" failed" as void*);
        serial.println(" failed" as void*);

        if (self.fail_count == 0) {
            debug.println("[TEST] ALL PASSED" as void*);
        } else {
            debug.println("[TEST] SOME FAILED" as void*);
        }
    }
}

// ============================================================
// ヘルパー関数
// ============================================================

/// ulongを10進数文字列として出力する（serialとdebug両方）
export void print_decimal(SerialPort* serial, DebugPort* debug, ulong value) {
    // 0の場合は即出力
    if (value == 0) {
        serial->putc(48);  // '0'
        debug->putc(48);
        return;
    }

    // 桁を逆順にバッファに格納
    ulong digits_buf = 0xC00;  // 一時バッファアドレス（20バイト）
    ulong* buf = digits_buf as ulong*;
    ulong count = 0;
    ulong tmp = value;

    while (tmp > 0) {
        ulong digit = tmp - (tmp / 10) * 10;  // tmp % 10 相当
        ulong* slot = (digits_buf + count * 8) as ulong*;
        *slot = digit + 48;  // '0' + digit
        count = count + 1;
        tmp = tmp / 10;
    }

    // 逆順に出力
    ulong i = count;
    while (i > 0) {
        i = i - 1;
        ulong* slot = (digits_buf + i * 8) as ulong*;
        ulong ch = *slot;
        serial->putc(ch);
        debug->putc(ch);
    }
}
