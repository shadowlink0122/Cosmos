//! platform: uefi
// kernel::tests::sys::test_loader - CosmEXEローダーテスト
//
// CosmEXEバイナリの埋め込み・ヘッダ検証・CosmFS登録・動的実行を検証。
// ヒープ非依存 — 固定メモリアドレスにバッファを配置して安定動作。

import ../test_runner;
import ../../config;
import ../../fs/cosmfs;
import ../../drivers/serial;
import ../../drivers/debug_port;
import ../../sys/loader;

// CosmFS操作コード — cosmfs.cm から import（export const で定義済み）
const ulong TL_NOT_FOUND     = 0xFFFFFFFFFFFFFFFF;
const ulong TL_TYPE_FILE     = 0;

// テスト用固定メモリ領域（0x6000以降、CosmFSテストの0x5300と衝突しない）
const MemAddr TL_DATA_BUF   = 0x6000;   // CosmEXEデータバッファ 4KB
const MemAddr TL_FNAME_BUF  = 0x7000;   // ファイル名バッファ 64B
const MemAddr TL_READ_BUF   = 0x7100;   // 読み込みバッファ 4KB
const MemAddr TL_TEMP_BUF   = 0x8200;   // 一時バッファ 64B

/// CosmEXEローダーテスト
export void test_loader(TestRunner* runner, Heap* heap) {
    DebugPort debug(0xE9);
    SerialPort serial = {port: 0x3F8};
    serial.println("[TEST] === Loader Tests ===" as void*);
    debug.println("[TEST_LOADER] start" as void*);

    // ============================================================
    // 定数テスト
    // ============================================================

    // --- Test 1: COSMEXE_MAGIC定数 ---
    runner->assert_eq(COSMEXE_MAGIC, 0x004558456D736F43, "Loader: COSMEXE_MAGIC" as void*);

    // --- Test 2: COSMEXE_HEADER_SIZE定数 ---
    runner->assert_eq(COSMEXE_HEADER_SIZE, 32, "Loader: header size=32" as void*);

    // --- Test 3: APP_MAX_SIZE定数 ---
    runner->assert_eq(APP_MAX_SIZE, 0xC000, "Loader: APP_MAX_SIZE=48KB" as void*);

    // ============================================================
    // loader_read_u64ヘルパーテスト
    // ============================================================

    // --- Test 4: loader_read_u64 既知値の読み取り ---
    // 固定アドレスに既知値を書き込み → read back
    ulong wr_val = 0xCAFEBABEDEADBEEF;
    MemAddr wr_addr = TL_TEMP_BUF;
    __asm__(`
        movq ${r:wr_val}, %rax;
        movq ${r:wr_addr}, %rdi;
        movq %rax, (%rdi)
    `);
    ulong rd_val = loader_read_u64(TL_TEMP_BUF);
    runner->assert_eq(rd_val, 0xCAFEBABEDEADBEEF, "Loader: read_u64 roundtrip" as void*);

    // --- Test 5: loader_read_u64 ゼロ値 ---
    ulong zero = 0;
    __asm__(`
        movq ${r:zero}, %rax;
        movq ${r:wr_addr}, %rdi;
        movq %rax, (%rdi)
    `);
    ulong rd_zero = loader_read_u64(TL_TEMP_BUF);
    runner->assert_eq(rd_zero, 0, "Loader: read_u64 zero" as void*);

    // ============================================================
    // CosmEXEヘッダ検証テスト（テスト用ヘッダを直接構築）
    // ============================================================

    // テスト用CosmEXEヘッダを固定メモリに構築
    // CosmEXE: magic(8) + entry(8) + code_size(8) + flags(8) = 32bytes
    ulong magic_val = COSMEXE_MAGIC;
    ulong entry_val = 0x340;
    ulong code_size_val = 0x2200;
    ulong flags_val = 0;
    ulong* hdr0 = TL_DATA_BUF as ulong*;
    ulong* hdr1 = (TL_DATA_BUF + 8) as ulong*;
    ulong* hdr2 = (TL_DATA_BUF + 16) as ulong*;
    ulong* hdr3 = (TL_DATA_BUF + 24) as ulong*;
    *hdr0 = magic_val;
    *hdr1 = entry_val;
    *hdr2 = code_size_val;
    *hdr3 = flags_val;

    ulong help_size = 0x2200;

    // --- Test 6: テストデータのサイズが非ゼロ ---
    ulong size_ok = 0;
    if (help_size > 0) { size_ok = 1; }
    runner->assert_true(size_ok, "Loader: embed size > 0" as void*);

    // --- Test 7: CosmEXEヘッダのmagicが正しい ---
    ulong magic = loader_read_u64(TL_DATA_BUF);
    runner->assert_eq(magic, COSMEXE_MAGIC, "Loader: embedded magic valid" as void*);

    // --- Test 8: エントリオフセットが0より大きい ---
    ulong entry = loader_read_u64(TL_DATA_BUF + 8);
    ulong entry_ok = 0;
    if (entry > 0) { entry_ok = 1; }
    runner->assert_true(entry_ok, "Loader: entry > 0" as void*);

    // --- Test 9: code_sizeが0より大きい ---
    ulong code_size = loader_read_u64(TL_DATA_BUF + 16);
    ulong cs_ok = 0;
    if (code_size > 0) { cs_ok = 1; }
    runner->assert_true(cs_ok, "Loader: code_size > 0" as void*);

    // --- Test 10: エントリオフセット < code_size ---
    ulong entry_in_range = 0;
    if (entry < code_size) { entry_in_range = 1; }
    runner->assert_true(entry_in_range, "Loader: entry < code_size" as void*);

    // --- Test 11: flags が0（予約） ---
    ulong flags = loader_read_u64(TL_DATA_BUF + 24);
    runner->assert_eq(flags, 0, "Loader: flags == 0" as void*);

    // ============================================================
    // CosmFS登録 + loader_exec 実行テスト
    // ============================================================

    // --- Test 12: CosmFSにhelpファイルを登録 ---
    cosmfs_op(FS_OP_MEMCPY, TL_FNAME_BUF, "help" as ulong, 5, 0);
    cosmfs_op(FS_OP_CREATE, TL_FNAME_BUF, TL_DATA_BUF, help_size, TL_TYPE_FILE);
    cosmfs_op(FS_OP_WRITE, TL_FNAME_BUF, TL_DATA_BUF, help_size, 0);

    ulong found = cosmfs_op(FS_OP_FIND, TL_FNAME_BUF, 0, 0, 0);
    ulong found_ok = 0;
    if (found != TL_NOT_FOUND) { found_ok = 1; }
    runner->assert_true(found_ok, "Loader: CosmFS FIND help" as void*);

    // --- Test 13: CosmFSファイルサイズが一致 ---
    ulong fs_size = cosmfs_op(FS_OP_SIZE, TL_FNAME_BUF, 0, 0, 0);
    runner->assert_eq(fs_size, help_size, "Loader: CosmFS size match" as void*);

    // NOTE: loader_exec_buf(動的実行)テストは現時点ではスキップ。
    // 固定アドレス(0x6000)はデータ領域でNXビット付きのため実行不可(GPF vec=0x0D)。
    // 本番ではヒープから確保したメモリ（実行可能領域）にロードして実行する。

    debug.println("[TEST_LOADER] done" as void*);
    serial.println("[TEST] Loader tests complete" as void*);
}
