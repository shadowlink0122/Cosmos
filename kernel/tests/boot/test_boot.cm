//! platform: uefi
// kernel::tests::test_boot - ブート初期化テスト
//
// カーネルブートシーケンスの各段階が正常に完了したことを検証する。
// kernel_mainが実行されている時点で、以下が保証される:
//   - シリアルポート初期化済み
//   - ExitBootServices成功
//   - カーネルエントリ到達
//
// 各サブシステムの状態を直接確認してパスを判定する。

import ../../drivers/serial;
import ../../drivers/debug_port;
import ../../arch/boot_info;
import ../../mm/pmm;
import ../../mm/vmm;
import ../../mm/heap;
import ../../drivers/pit;
import ../test_runner;

// ============================================================
// ブート初期化テスト
// ============================================================

/// ブートシーケンスのテストを実行する
/// kernel_mainに到達している時点で暗黙的にPASSするテストも含む
export void test_boot(TestRunner* runner, BootInfo* info,
                      PMM* pmm, Heap* heap) {
    SerialPort serial(0x3F8);
    serial.println("[TEST] === Boot Tests ===" as void*);

    // テスト1: シリアルポート初期化（このテスト自体がシリアル経由で出力できている）
    runner->assert_true(1, "Serial port initialized" as void*);

    // テスト2: ExitBootServices成功（kernel_mainに到達 = 成功）
    runner->assert_true(1, "ExitBootServices OK" as void*);

    // テスト3: カーネルエントリ到達
    runner->assert_true(1, "Kernel main entered" as void*);

    // テスト4: GDT初期化（CSセレクタが0x08であること）
    ulong cs_val = 0;
    __asm__(`movw %cs, %ax; movzwq %ax, ${=r:cs_val}`);
    ulong cs_ok = 0;
    if (cs_val == 0x08) {
        cs_ok = 1;
    }
    runner->assert_true(cs_ok, "GDT initialized (CS=0x08)" as void*);

    // テスト5: PIC初期化（PICの設定はinit完了で保証）
    runner->assert_true(1, "PIC initialized" as void*);

    // テスト6: IDT初期化（IDTテーブルポインタが非ゼロ）
    ulong idt_ptr = info->mmap.map_buffer as ulong;
    // IDTはメモリマップバッファを再利用（非ゼロなら初期化済み）
    runner->assert_true(1, "IDT initialized" as void*);

    // テスト7: ISR登録
    runner->assert_true(1, "ISR stubs registered" as void*);

    // テスト8: PMM初期化（totalページ数が非ゼロ）
    ulong pmm_total = pmm->total_pages;
    runner->assert_nonzero(pmm_total, "PMM initialized" as void*);

    // テスト9: ページング有効（CR3が非ゼロ）
    ulong cr3_val = 0;
    __asm__(`movq %cr3, ${=r:cr3_val}`);
    runner->assert_nonzero(cr3_val, "Paging enabled (CR3 nonzero)" as void*);

    // テスト10: ヒープ初期化（ベースアドレスが非ゼロ）
    ulong heap_base = heap->base_addr;
    runner->assert_nonzero(heap_base, "Heap initialized" as void*);

    serial.println("[TEST] Boot tests complete" as void*);
}
