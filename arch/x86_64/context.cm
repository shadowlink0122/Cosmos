//! platform: baremetal-x86
// cosmo-linux::arch::x86_64::context - コンテキストスイッチ
//
// プロセス間のCPUレジスタ切り替え。
// Context struct/impl パターンで実装。
// 参照: linux/arch/x86/kernel/process_64.c

import ../../include/types;
import ../../include/scheduler;

/// Context — コンテキストスイッチ管理
export struct Context {}

/// ユーザーモード遷移トランポリン
/// switch_toのretから呼ばれ、iretqでRing3に遷移する
/// カーネルスタック上にiretqフレーム(RIP, CS, RFLAGS, RSP, SS)が構築済み
/// 注: Cmコンパイラが関数プロローグ(push rbp; mov rsp, rbp)を生成するため、
///     RSPがiretqフレームから8バイトずれる。pop rbpで復元する。
///
/// 重要: iretqはCS/SSのみ復元し、DS/ES/FS/GSは復元しない。
///       DS/ESはユーザーデータセグメント(0x1B)に設定する。
///       FS_BASEは固定アドレス(0x96100)から読み出してMSRに設定する。
///       FS/GSセグメントレジスタには一切触れない。
void usermode_trampoline() {
    __asm__(`
        // Cmコンパイラのプロローグを元に戻す
        leave;

        // DS/ESをユーザーデータセグメント(0x1B)に設定
        // 注意: DS/ES書き込みがFS_BASE MSRに影響する場合があるため、
        //       wrmsrよりも先に実行する
        movq $$0x1B, %rax;
        movw %ax, %ds;
        movw %ax, %es;

        // FS_BASE MSRを設定 (iretq直前に必ず最後に実行)
        // DS/ES書き込み後にwrmsrすることで、FS_BASE値が確実に保持される
        movl $$0xC0000100, %ecx;  // IA32_FS_BASE
        movq 0x96100, %rax;       // TLS_BASE値読み出し
        movq %rax, %rdx;
        shrq $$32, %rdx;  // EDX = 上位32bit
        wrmsr;

        // iretqでRing3に遷移
        iretq
    `);
}

impl Context {
    /// 2つのProcess間でコンテキストスイッチを実行
    /// Linux __switch_to 同様、RFLAGS も保存/復帰する。
    /// 復帰後は必ず sti で割り込みを有効化する (Linux: local_irq_enable 相当)。
    static void switch_to(Process* prev, Process* next) {
        __asm__(`
            movq ${r:prev}, %rdi;
            addq $$48, %rdi;
            movq ${r:next}, %rsi;
            addq $$48, %rsi;

            // 現在のレジスタを prev->context に保存
            movq %rsp, (%rdi);
            movq %rbp, 8(%rdi);
            movq %rbx, 16(%rdi);
            movq %r12, 24(%rdi);
            movq %r13, 32(%rdi);
            movq %r14, 40(%rdi);
            movq %r15, 48(%rdi);

            // RFLAGS保存 (offset 64 = rflags フィールド)
            pushfq;
            popq %rax;
            movq %rax, 64(%rdi);

            // next->context からレジスタ復帰
            movq 48(%rsi), %r15;
            movq 40(%rsi), %r14;
            movq 32(%rsi), %r13;
            movq 24(%rsi), %r12;
            movq 16(%rsi), %rbx;
            movq 8(%rsi), %rbp;
            movq (%rsi), %rsp;

            // RFLAGS復帰
            movq 64(%rsi), %rax;
            pushq %rax;
            popfq;

            // 安全策: 割り込みを必ず有効化 (Linux local_irq_enable 相当)
            // syscall中にCLI→コンテキストスイッチ→IF=0で復帰するケースを完全防止
            sti;

            ret
        `);
    }

    /// 新しいカーネルタスクのコンテキストを初期化
    static void init_task(Process* proc, ulong stack_top, ulong entry_fn) {
        ulong sp = stack_top - 8;
        ulong* ret_addr = sp as ulong*;
        *ret_addr = entry_fn;

        proc->context.rsp = sp;
        proc->context.rbp = sp;
        proc->context.rbx = 0;
        proc->context.r12 = 0;
        proc->context.r13 = 0;
        proc->context.r14 = 0;
        proc->context.r15 = 0;
        proc->context.rip = entry_fn;
        proc->context.rflags = 0x200;
    }

    /// ユーザープロセス用コンテキスト初期化
    /// iretqフレームでRing3+ユーザーRSPに直接遷移する
    static void init_user_task(Process* proc, ulong stack_top, ulong entry_fn, ulong user_rsp) {
        // カーネルスタック上にiretqフレームを構築
        // iretqはスタックから以下を pop する:
        //   [RSP+0]  RIP     (ユーザーエントリポイント)
        //   [RSP+8]  CS      (ユーザーCS = 0x20 | 3 = 0x23)
        //   [RSP+16] RFLAGS  (IF=1)
        //   [RSP+24] RSP     (ユーザーRSP)
        //   [RSP+32] SS      (ユーザーSS = 0x18 | 3 = 0x1B)
        // その前にトランポリンコードのアドレスを置く

        // トランポリン関数のアドレス（switch_toのretで呼ばれる）
        ulong sp = stack_top;

        // iretqフレーム（逆順にpush）
        sp = sp - 8; ulong* p_ss = sp as ulong*;     *p_ss = 0x1B;       // SS (User DS | RPL=3)
        sp = sp - 8; ulong* p_rsp = sp as ulong*;    *p_rsp = user_rsp;  // User RSP
        sp = sp - 8; ulong* p_rfl = sp as ulong*;    *p_rfl = 0x200;     // RFLAGS (IF=1)
        sp = sp - 8; ulong* p_cs = sp as ulong*;     *p_cs = 0x23;       // CS (User CS | RPL=3)
        sp = sp - 8; ulong* p_rip = sp as ulong*;    *p_rip = entry_fn;  // User RIP

        // switch_toのretで呼ばれるトランポリンのアドレス
        sp = sp - 8;
        ulong* p_tramp = sp as ulong*;
        *p_tramp = usermode_trampoline as ulong;

        proc->context.rsp = sp;
        proc->context.rbp = sp;
        proc->context.rbx = 0;
        proc->context.r12 = 0;
        proc->context.r13 = 0;
        proc->context.r14 = 0;
        proc->context.r15 = 0;
        proc->context.rip = usermode_trampoline as ulong;
        proc->context.rflags = 0x200;
    }
}
