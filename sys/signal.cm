//! platform: baremetal-x86
// cosmo-linux::sys::signal - シグナル送受信
//
// Signal struct/impl — プロセス間シグナル送信とチェック。
// 参照: linux/kernel/signal.c

import ../include/types;
import ../include/scheduler;
import ../include/signal;
import ../include/errno;
import ../include/result;
import ../sched/process;
import ../sched/scheduler;

/// Signal — シグナル管理
export struct Signal {}

impl Signal {
    /// プロセスにシグナルを送信
    static long send(Pid target_pid, ulong sig) {
        if (sig == 0 || sig >= NSIG) { return 0 - EINVAL; }
        Process* proc = 0 as Process*;
        Option<ulong> proc_opt = ProcessTable::find_by_pid(target_pid);
        match (proc_opt) {
            Option::Some(v) => { proc = v as Process*; }
            Option::None => { return 0 - ESRCH; }
        }
        // SIGKILL / SIGSTOP は無視不可
        if (sig == SIGKILL) {
            // 即座にプロセスを終了
            ProcessTable::do_exit(proc, 0 - 9);  // シグナル番号を負値で記録
            return 0;
        }
        if (sig == SIGSTOP) {
            proc->state = TASK_STOPPED;
            return 0;
        }
        if (sig == SIGCONT) {
            if (proc->state == TASK_STOPPED) {
                proc->state = TASK_READY;
            }
            return 0;
        }
        // 通常シグナル: pending_signalにビットセット
        proc->pending_signal = proc->pending_signal | (1 << sig);
        // SIGTERM はデフォルト動作 = 終了
        if (sig == SIGTERM) {
            ProcessTable::do_exit(proc, 0 - 15);
        }
        return 0;
    }

    /// 保留中シグナルをチェック
    static ulong is_pending(Process* proc, ulong sig) {
        if (sig >= NSIG) { return 0; }
        return (proc->pending_signal >> sig) & 1;
    }

    /// シグナルをクリア
    static void clear(Process* proc, ulong sig) {
        if (sig < NSIG) {
            // ~(1 << sig) は Cm パーサーの優先度で (~1) << sig と解釈されるため
            // XOR で全ビット反転する方式を使用
            ulong bit = 1 << sig;
            ulong mask = bit ^ 0xFFFFFFFFFFFFFFFF;
            proc->pending_signal = proc->pending_signal & mask;
        }
    }
}
