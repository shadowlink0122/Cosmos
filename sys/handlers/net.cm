//! platform: baremetal-x86
// cosmo-linux::sys::syscall_net - ネットワーク関連syscall
//
// socket/connect/bind/listen/accept/sendto/recvfrom/
// setsockopt/getsockopt のLinux syscall → Socket APIブリッジ。
//
// 参照: linux/net/socket.c

import ../../include/types;
import ../../include/errno;
import ../../include/net;
import ../../net/transport/socket;
import ../../fs/fd_table;
import ../table;

// ============================================================
// sockaddr_in 構造体 (Linux)
// ============================================================
// struct sockaddr_in {
//     sa_family_t sin_family;  // 2バイト (AF_INET = 2)
//     in_port_t   sin_port;   // 2バイト (ネットワークバイトオーダー)
//     struct in_addr sin_addr; // 4バイト
//     uint8_t     sin_zero[8]; // パディング
// } // 合計 16バイト

// ============================================================
// SyscallNet — ネットワーク関連syscall
// ============================================================

export struct SyscallNet {}

impl SyscallNet {
    /// sys_socket: ソケット作成
    /// 戻り値: FD番号 (失敗時 -errno)
    static long do_socket(ulong domain, ulong sock_type, ulong protocol) {
        long sock_id = Socket::create(domain, sock_type, protocol);
        if (sock_id < 0) { return 0 - EMFILE; }
        // ソケットIDをFDテーブルに登録
        Fd fd = FdTable::alloc(sock_id as ulong, 0, FS_SOCKET);
        if (fd < 0) {
            Socket::close(sock_id as ulong);
            return 0 - EMFILE;
        }
        return fd;
    }

    /// sys_connect: ソケット接続
    static long do_connect(ulong fd, ulong addr_ptr, ulong addrlen) {
        if (FdTable::is_valid(fd as long) == 0) { return 0 - EBADF; }
        ulong fs_type = FdTable::get_fs_type(fd as long);
        if (fs_type != FS_SOCKET) { return 0 - ENOTSOCK; }

        ulong sock_id = FdTable::get_ino(fd as long) as ulong;
        if (addr_ptr == 0) { return 0 - EFAULT; }

        // sockaddr_in解析
        ulong ip = 0;
        ulong port = 0;
        SyscallNet::parse_sockaddr(addr_ptr, &ip, &port);

        return Socket::connect(sock_id, ip, port);
    }

    /// sys_bind: ソケットにアドレスをバインド
    static long do_bind(ulong fd, ulong addr_ptr, ulong addrlen) {
        if (FdTable::is_valid(fd as long) == 0) { return 0 - EBADF; }
        ulong fs_type = FdTable::get_fs_type(fd as long);
        if (fs_type != FS_SOCKET) { return 0 - ENOTSOCK; }

        ulong sock_id = FdTable::get_ino(fd as long) as ulong;
        if (addr_ptr == 0) { return 0 - EFAULT; }

        ulong ip = 0;
        ulong port = 0;
        SyscallNet::parse_sockaddr(addr_ptr, &ip, &port);

        return Socket::bind(sock_id, ip, port);
    }

    /// sys_listen: TCPリッスン
    static long do_listen(ulong fd, ulong backlog) {
        if (FdTable::is_valid(fd as long) == 0) { return 0 - EBADF; }
        ulong fs_type = FdTable::get_fs_type(fd as long);
        if (fs_type != FS_SOCKET) { return 0 - ENOTSOCK; }

        ulong sock_id = FdTable::get_ino(fd as long) as ulong;
        return Socket::listen(sock_id, backlog);
    }

    /// sys_accept: TCP接続受け入れ
    static long do_accept(ulong fd, ulong addr_ptr, ulong addrlen_ptr) {
        if (FdTable::is_valid(fd as long) == 0) { return 0 - EBADF; }
        // 簡易版: 新しいソケットを作成して返す
        ulong fs_type = FdTable::get_fs_type(fd as long);
        if (fs_type != FS_SOCKET) { return 0 - ENOTSOCK; }

        // 新しいソケットを作成
        long new_sock = Socket::create(AF_INET, SOCK_STREAM, 0);
        if (new_sock < 0) { return 0 - EMFILE; }

        Fd new_fd = FdTable::alloc(new_sock as ulong, 0, FS_SOCKET);
        if (new_fd < 0) {
            Socket::close(new_sock as ulong);
            return 0 - EMFILE;
        }
        return new_fd;
    }

    /// sys_sendto: データ送信
    static long do_sendto(ulong fd, ulong buf, ulong len, ulong flags,
        ulong dest_addr, ulong addrlen) {
        if (FdTable::is_valid(fd as long) == 0) { return 0 - EBADF; }
        ulong fs_type = FdTable::get_fs_type(fd as long);
        if (fs_type != FS_SOCKET) { return 0 - ENOTSOCK; }

        ulong sock_id = FdTable::get_ino(fd as long) as ulong;
        return Socket::send(sock_id, buf, len);
    }

    /// sys_recvfrom: データ受信
    static long do_recvfrom(ulong fd, ulong buf, ulong len, ulong flags,
        ulong src_addr, ulong addrlen_ptr) {
        if (FdTable::is_valid(fd as long) == 0) { return 0 - EBADF; }
        ulong fs_type = FdTable::get_fs_type(fd as long);
        if (fs_type != FS_SOCKET) { return 0 - ENOTSOCK; }

        ulong sock_id = FdTable::get_ino(fd as long) as ulong;
        return Socket::recv(sock_id, buf, len);
    }

    /// sys_setsockopt: ソケットオプション設定
    static long do_setsockopt(ulong fd, ulong level, ulong optname,
        ulong optval, ulong optlen) {
        if (FdTable::is_valid(fd as long) == 0) { return 0 - EBADF; }
        // 簡易版: 全てのオプションを受け入れる（成功を返す）
        return 0;
    }

    /// sys_getsockopt: ソケットオプション取得
    static long do_getsockopt(ulong fd, ulong level, ulong optname,
        ulong optval, ulong optlen_ptr) {
        if (FdTable::is_valid(fd as long) == 0) { return 0 - EBADF; }
        // 簡易版: 0を返す
        if (optval != 0 && optlen_ptr != 0) {
            ulong* len = optlen_ptr as ulong*;
            if (*len >= 4) {
                ulong* val = optval as ulong*;
                *val = 0;
            }
        }
        return 0;
    }

    /// sockaddr_in構造体を解析してIPアドレスとポートを取得
    static void parse_sockaddr(ulong addr, ulong* ip_out, ulong* port_out) {
        // sin_family (2バイト) → スキップ
        // sin_port (2バイト, ネットワークバイトオーダー=ビッグエンディアン)
        ulong p0 = 0;
        ulong p1 = 0;
        ulong port_addr = addr + 2;
        __asm__(`movq ${r:port_addr}, %rdi; xorq %rax,%rax; movzbl (%rdi),%eax; movq %rax, ${=r:p0}`);
        ulong port_addr2 = addr + 3;
        __asm__(`movq ${r:port_addr2}, %rdi; xorq %rax,%rax; movzbl (%rdi),%eax; movq %rax, ${=r:p1}`);
        *port_out = (p0 << 8) | p1;

        // sin_addr (4バイト, ネットワークバイトオーダー)
        ulong a0 = 0;
        ulong a1 = 0;
        ulong a2 = 0;
        ulong a3 = 0;
        ulong ip_addr = addr + 4;
        __asm__(`movq ${r:ip_addr}, %rdi; xorq %rax,%rax; movzbl (%rdi),%eax; movq %rax, ${=r:a0}`);
        ulong ip1 = addr + 5;
        __asm__(`movq ${r:ip1}, %rdi; xorq %rax,%rax; movzbl (%rdi),%eax; movq %rax, ${=r:a1}`);
        ulong ip2 = addr + 6;
        __asm__(`movq ${r:ip2}, %rdi; xorq %rax,%rax; movzbl (%rdi),%eax; movq %rax, ${=r:a2}`);
        ulong ip3 = addr + 7;
        __asm__(`movq ${r:ip3}, %rdi; xorq %rax,%rax; movzbl (%rdi),%eax; movq %rax, ${=r:a3}`);
        *ip_out = (a0 << 24) | (a1 << 16) | (a2 << 8) | a3;
    }
}
