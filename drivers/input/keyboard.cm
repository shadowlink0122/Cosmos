//! platform: baremetal-x86
// cosmo-linux::drivers::keyboard - PS/2 キーボードドライバ (JIS配列)
//
// IRQ1（ベクタ33）でスキャンコードを受信し、
// ASCII変換後にリングバッファに格納する。
// JIS 106キー配列対応、Shift修飾キー対応。
//
// 参照: linux/drivers/input/keyboard/atkbd.c
//       linux/drivers/tty/vt/keyboard.c

import ../../include/types;
import ../../include/config;
import ../../include/keycode;
import ../../arch/x86_64/idt;
import ../../drivers/serial;
import ../../lib/printk;

// ============================================================
// キーボード定数
// ============================================================

/// PS/2データポート
const ulong KBD_DATA = 0x60;

/// キーバッファ（固定メモリ、64バイトリングバッファ）
const PhysAddr KBD_BUF_ADDR  = 0x93000;  // バッファ本体 (64B)
const PhysAddr KBD_HEAD_ADDR = 0x93040;  // 読み取り位置
const PhysAddr KBD_TAIL_ADDR = 0x93048;  // 書き込み位置
const ulong KBD_BUF_SIZE = 64;

/// スキャンコード→ASCII変換テーブル（128エントリ × 2: 通常 + Shift）
const PhysAddr SCANCODE_TABLE_ADDR   = 0x93100;  // 通常テーブル (128B)
const PhysAddr SCANCODE_SHIFT_ADDR   = 0x93180;  // Shiftテーブル (128B)

/// 修飾キー状態（固定メモリ）
const PhysAddr KBD_SHIFT_ADDR  = 0x93200;  // Shift状態
const PhysAddr KBD_CTRL_ADDR   = 0x93208;  // Ctrl状態
const PhysAddr KBD_E0_ADDR     = 0x93210;  // E0プレフィクス状態

// ============================================================
// バイト読み書きヘルパー（Cm utiny*バグ回避）
// ============================================================

void kbd_write_byte(ulong addr, ulong val) {
    __asm__(`
        movq ${r:addr}, %r10;
        movq ${r:val}, %rax;
        movb %al, (%r10)
    `);
}

ulong kbd_read_byte(ulong addr) {
    ulong val = 0;
    __asm__(`
        movq ${r:addr}, %r10;
        xorq %rax, %rax;
        movzbl (%r10), %eax;
        movq %rax, ${=r:val}
    `);
    return val;
}

// ============================================================
// スキャンコード → ASCII 変換テーブル (JIS 106キー配列, Set 1)
// ============================================================

/// スキャンコードテーブルを初期化（JIS配列）
void init_scancode_table() {
    // 全エントリをゼロ初期化
    ulong i = 0;
    while (i < 128) {
        kbd_write_byte(SCANCODE_TABLE_ADDR + i, 0);
        kbd_write_byte(SCANCODE_SHIFT_ADDR + i, 0);
        i = i + 1;
    }

    // === 通常テーブル（JIS配列） ===

    // 数字行
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x02, Ascii::Digit1 as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x03, Ascii::Digit2 as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x04, Ascii::Digit3 as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x05, Ascii::Digit4 as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x06, Ascii::Digit5 as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x07, Ascii::Digit6 as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x08, Ascii::Digit7 as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x09, Ascii::Digit8 as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x0A, Ascii::Digit9 as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x0B, Ascii::Digit0 as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x0C, Ascii::Minus as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x0D, Ascii::Caret as ulong);

    // 特殊キー
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x0E, Key::Backspace as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x0F, Key::Tab as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x01, Key::Escape as ulong);

    // Q行
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x10, Ascii::LowerQ as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x11, Ascii::LowerW as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x12, Ascii::LowerE as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x13, Ascii::LowerR as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x14, Ascii::LowerT as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x15, Ascii::LowerY as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x16, Ascii::LowerU as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x17, Ascii::LowerI as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x18, Ascii::LowerO as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x19, Ascii::LowerP as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x1A, Ascii::At as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x1B, Ascii::BracketL as ulong);

    // Enter
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x1C, Key::Enter as ulong);

    // A行
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x1E, Ascii::LowerA as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x1F, Ascii::LowerS as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x20, Ascii::LowerD as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x21, Ascii::LowerF as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x22, Ascii::LowerG as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x23, Ascii::LowerH as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x24, Ascii::LowerJ as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x25, Ascii::LowerK as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x26, Ascii::LowerL as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x27, Ascii::Semicolon as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x28, Ascii::Colon as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x29, Ascii::Backtick as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x2B, Ascii::BracketR as ulong);

    // Z行
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x2C, Ascii::LowerZ as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x2D, Ascii::LowerX as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x2E, Ascii::LowerC as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x2F, Ascii::LowerV as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x30, Ascii::LowerB as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x31, Ascii::LowerN as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x32, Ascii::LowerM as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x33, Ascii::Comma as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x34, Ascii::Period as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x35, Ascii::Slash as ulong);
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x73, Ascii::Backslash as ulong);

    // スペース
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x39, Key::Space as ulong);

    // JIS追加キー
    kbd_write_byte(SCANCODE_TABLE_ADDR + 0x7D, Ascii::Backslash as ulong);

    // === Shiftテーブル（JIS配列） ===

    // 数字行 Shift
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x02, Ascii::Exclaim as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x03, Ascii::DQuote as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x04, Ascii::Hash as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x05, Ascii::Dollar as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x06, Ascii::Percent as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x07, Ascii::Ampersand as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x08, Ascii::SQuote as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x09, Ascii::ParenL as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x0A, Ascii::ParenR as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x0B, Ascii::Tilde as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x0C, Ascii::Equal as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x0D, Ascii::Tilde as ulong);

    // 特殊キー Shift
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x0E, Key::Backspace as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x0F, Key::Tab as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x01, Key::Escape as ulong);

    // Q行 Shift (大文字)
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x10, Ascii::UpperQ as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x11, Ascii::UpperW as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x12, Ascii::UpperE as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x13, Ascii::UpperR as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x14, Ascii::UpperT as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x15, Ascii::UpperY as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x16, Ascii::UpperU as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x17, Ascii::UpperI as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x18, Ascii::UpperO as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x19, Ascii::UpperP as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x1A, Ascii::Backtick as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x1B, Ascii::BraceL as ulong);

    // Enter
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x1C, Key::Enter as ulong);

    // A行 Shift (大文字)
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x1E, Ascii::UpperA as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x1F, Ascii::UpperS as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x20, Ascii::UpperD as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x21, Ascii::UpperF as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x22, Ascii::UpperG as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x23, Ascii::UpperH as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x24, Ascii::UpperJ as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x25, Ascii::UpperK as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x26, Ascii::UpperL as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x27, Ascii::Colon as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x28, Ascii::Asterisk as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x2B, Ascii::BraceR as ulong);

    // Z行 Shift (大文字)
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x2C, Ascii::UpperZ as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x2D, Ascii::UpperX as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x2E, Ascii::UpperC as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x2F, Ascii::UpperV as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x30, Ascii::UpperB as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x31, Ascii::UpperN as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x32, Ascii::UpperM as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x33, Ascii::LessThan as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x34, Ascii::GreaterThan as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x35, Ascii::Question as ulong);
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x73, Ascii::Underscore as ulong);

    // スペース
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x39, Key::Space as ulong);

    // JIS追加キー Shift
    kbd_write_byte(SCANCODE_SHIFT_ADDR + 0x7D, Ascii::Pipe as ulong);
}

// ============================================================
// キーバッファからASCIIコードを取得（0=空）
// ============================================================

/// Kbd — PS/2キーボードドライバ
export struct Kbd {}

impl Kbd {
    /// キーバッファからASCIIコードを取得（0=空）
    /// PS/2キーボードバッファを優先、空ならシリアルRX(COM1)をポーリング
    static ulong getchar() {
        // PS/2キーボードバッファチェック
        ulong* head_ptr = KBD_HEAD_ADDR as ulong*;
        ulong* tail_ptr = KBD_TAIL_ADDR as ulong*;
        ulong head = *head_ptr;
        ulong tail = *tail_ptr;

        if (head != tail) {
            ulong ch = kbd_read_byte(KBD_BUF_ADDR + head);
            *head_ptr = (head + 1) % KBD_BUF_SIZE;
            return ch;
        }

        // シリアルRXフォールバック (COM1: 0x3F8)
        // LSR (Line Status Register) bit0 = data ready
        // inb で直接読み取り（レジスタ干渉回避のため専用変数で受ける）
        ulong lsr = inb(0x3FD);
        if ((lsr & 1) != 0) {
            ulong ch = inb(0x3F8);
            // CR(0x0D) → LF(0x0A) 変換
            if (ch == 13) { ch = 10; }
            return ch;
        }

        return 0;  // 入力なし
    }
}

// ============================================================
// IRQ1 ハンドラ（関数ポインタとして使うためモジュールレベル）
// ============================================================

/// PS/2 キーボード IRQ1 ハンドラ (naked ASM)
void kbd_irq_handler() {
    __asm__(`
        pushq %rax;
        pushq %rbx;
        pushq %rcx;
        pushq %rdx;
        pushq %rdi;
        pushq %rsi;

        // スキャンコード読み取り
        xorq %rax, %rax;
        inb $$0x60, %al;
        movq %rax, %rsi;

        // E0プレフィクス: フラグをセットして待機
        cmpb $$0xE0, %sil;
        jne 10f;
        movq $$0x93210, %rdi;
        movq $$1, (%rdi);
        jmp 9f;
        10:;
        cmpb $$0xE1, %sil;
        je 9f;

        // E0フラグ確認
        movq $$0x93210, %rdi;
        movq (%rdi), %rcx;
        movq $$0, (%rdi);  // フラグクリア

        // E0拡張キーの処理
        testq %rcx, %rcx;
        jz 11f;
        // E0シーケンス: make/break判定
        testb $$0x80, %sil;
        jnz 9f;  // ブレークコードは無視
        // 上矢印 (0x48) → 0x80
        cmpb $$0x48, %sil;
        jne 12f;
        movq $$0x80, %rcx;
        jmp 42f;
        12:;
        // 下矢印 (0x50) → 0x81
        cmpb $$0x50, %sil;
        jne 14f;
        movq $$0x81, %rcx;
        jmp 42f;
        14:;
        // 左矢印 (0x4B) → 0x82
        cmpb $$0x4B, %sil;
        jne 15f;
        movq $$0x82, %rcx;
        jmp 42f;
        15:;
        // 右矢印 (0x4D) → 0x83
        cmpb $$0x4D, %sil;
        jne 9f;
        movq $$0x83, %rcx;
        // バッファに格納
        42:;
        movq $$0x93048, %rdi;
        movq (%rdi), %rax;
        movq %rax, %rdx;
        addq $$1, %rdx;
        andq $$63, %rdx;
        movq $$0x93040, %rbx;
        cmpq (%rbx), %rdx;
        je 9f;
        movq $$0x93000, %rbx;
        movb %cl, (%rbx,%rax,1);
        movq %rdx, (%rdi);
        jmp 9f;
        11:;

        // ブレークコード判定（bit 7 set = keyup）
        testb $$0x80, %sil;
        jnz 5f;

        // === make code（キー押下）===

        // LShift (0x2A) チェック
        cmpb $$0x2A, %sil;
        jne 1f;
        movq $$0x93200, %rdi;
        movq $$1, (%rdi);
        jmp 9f;
        1:;

        // RShift (0x36) チェック
        cmpb $$0x36, %sil;
        jne 2f;
        movq $$0x93200, %rdi;
        movq $$1, (%rdi);
        jmp 9f;
        2:;

        // LCtrl (0x1D) チェック
        cmpb $$0x1D, %sil;
        jne 3f;
        movq $$0x93208, %rdi;
        movq $$1, (%rdi);
        jmp 9f;
        3:;

        // CapsLock (0x3A), Alt (0x38), その他非文字キーは無視
        cmpb $$0x3A, %sil;
        je 9f;
        cmpb $$0x38, %sil;
        je 9f;

        // Shift状態を確認
        movq $$0x93200, %rdi;
        movq (%rdi), %rdx;

        // ASCII変換: Shift状態に応じてテーブルを選択
        movq %rsi, %rax;
        andq $$0x7F, %rax;
        testq %rdx, %rdx;
        jnz 4f;
        // 通常テーブル
        movq $$0x93100, %rbx;
        jmp 41f;
        4:;
        // Shiftテーブル
        movq $$0x93180, %rbx;
        41:;

        movzbq (%rbx,%rax,1), %rcx;
        testq %rcx, %rcx;
        jz 9f;

        // Ctrl修飾: a-z → コントロールコード (1-26)
        movq $$0x93208, %rdi;
        movq (%rdi), %rbx;
        testq %rbx, %rbx;
        jz 43f;
        // Ctrl押下時: ASCII 97-122 (a-z) → 1-26
        cmpq $$97, %rcx;
        jb 43f;
        cmpq $$122, %rcx;
        ja 43f;
        subq $$96, %rcx;
        43:;

        // バッファに格納
        movq $$0x93048, %rdi;
        movq (%rdi), %rax;
        movq %rax, %rdx;
        addq $$1, %rdx;
        andq $$63, %rdx;
        movq $$0x93040, %rbx;
        cmpq (%rbx), %rdx;
        je 9f;
        movq $$0x93000, %rbx;
        movb %cl, (%rbx,%rax,1);
        movq %rdx, (%rdi);
        jmp 9f;

        5:;
        // === break code（キーリリース）===
        movq %rsi, %rax;
        andb $$0x7F, %al;

        // LShift release
        cmpb $$0x2A, %al;
        jne 6f;
        movq $$0x93200, %rdi;
        movq $$0, (%rdi);
        jmp 9f;
        6:;

        // RShift release
        cmpb $$0x36, %al;
        jne 7f;
        movq $$0x93200, %rdi;
        movq $$0, (%rdi);
        jmp 9f;
        7:;

        // LCtrl release
        cmpb $$0x1D, %al;
        jne 9f;
        movq $$0x93208, %rdi;
        movq $$0, (%rdi);

        9:;
        // PIC EOI
        movb $$0x20, %al;
        outb %al, $$0x20;

        popq %rsi;
        popq %rdi;
        popq %rdx;
        popq %rcx;
        popq %rbx;
        popq %rax;
        iretq
    `);
}

// ============================================================
// キーボード初期化
// ============================================================

impl Kbd {
    /// PS/2キーボードを初期化（JIS 106キー配列）
    static void setup(SerialPort* w) {
        // スキャンコードテーブル初期化（JIS配列）
        init_scancode_table();

        // キーバッファ初期化
        ulong* head_ptr = KBD_HEAD_ADDR as ulong*;
        *head_ptr = 0;
        ulong* tail_ptr = KBD_TAIL_ADDR as ulong*;
        *tail_ptr = 0;

        // 修飾キー状態初期化
        ulong* shift_ptr = KBD_SHIFT_ADDR as ulong*;
        *shift_ptr = 0;
        ulong* ctrl_ptr = KBD_CTRL_ADDR as ulong*;
        *ctrl_ptr = 0;
        ulong* e0_ptr = KBD_E0_ADDR as ulong*;
        *e0_ptr = 0;

        // IRQ1ハンドラ登録（ベクタ33 = IRQ_BASE + 1）
        Idt::set_gate(33, kbd_irq_handler as ulong, GATE_INT);

        // PICでIRQ1のマスクを解除
        ulong mask = inb(PIC1_DATA);
        outb(PIC1_DATA, mask & 0xFD);

        pr_info(w, "PS/2 keyboard initialized (JIS 106-key, IRQ1 -> vector 33)" as void*);
    }
}
