    /// グリフデータ設定ヘルパー
    static void set_glyph(ulong ch, ulong r0, ulong r1, ulong r2, ulong r3,
                           ulong r4, ulong r5, ulong r6, ulong r7,
                           ulong r8, ulong r9, ulong r10, ulong r11,
                           ulong r12, ulong r13, ulong r14, ulong r15) {
        if (ch < 0x20 || ch > 0x7E) { return; }
        ulong base = FONT_DATA_ADDR + (ch - 0x20) * 16;

        // 配列で一括書き込み
        ulong[16] rows;
        rows[0] = r0; rows[1] = r1; rows[2] = r2; rows[3] = r3;
        rows[4] = r4; rows[5] = r5; rows[6] = r6; rows[7] = r7;
        rows[8] = r8; rows[9] = r9; rows[10] = r10; rows[11] = r11;
        rows[12] = r12; rows[13] = r13; rows[14] = r14; rows[15] = r15;

        ulong i = 0;
        while (i < 16) {
            ulong addr = base + i;
            ulong val = rows[i];
            __asm__(`
                movq ${r:addr}, %rdi;
                movq ${r:val}, %rax;
                movb %al, (%rdi)
            `);
            i = i + 1;
        }
    }

    /// 1文字描画
    static void draw_char(ulong x, ulong y, ulong ch, ulong fg, ulong bg) {
        if (ch < 0x20 || ch > 0x7E) { ch = 0x20; }  // 範囲外 → スペース
        ulong glyph_base = FONT_DATA_ADDR + (ch - 0x20) * 16;

        ulong row = 0;
        while (row < 16) {
            ulong addr = glyph_base + row;
            ulong bits = 0;
            __asm__(`
                movq ${r:addr}, %rdi;
                xorq %rax, %rax;
                movb (%rdi), %al;
                movq %rax, ${=r:bits}
            `);

            ulong col = 0;
            while (col < 8) {
                ulong mask = 0x80 >> col;
                if ((bits & mask) != 0) {
                    Fb::put_pixel(x + col, y + row, fg);
                } else {
                    if (bg != 0xFFFFFFFF) {  // 0xFFFFFFFF = 透明
                        Fb::put_pixel(x + col, y + row, bg);
                    }
                }
                col = col + 1;
            }
            row = row + 1;
        }
    }

    /// 文字列描画
    static void draw_string(ulong x, ulong y, void* str, ulong fg, ulong bg) {
        ulong src = str as ulong;
        ulong cx = x;
        ulong i = 0;
        while (true) {
            ulong addr = src + i;
            ulong ch = 0;
            __asm__(`
                movq ${r:addr}, %rdi;
                xorq %rax, %rax;
                movb (%rdi), %al;
                movq %rax, ${=r:ch}
            `);
            if (ch == 0) { return; }
            Font::draw_char(cx, y, ch, fg, bg);
            cx = cx + FONT_W;
            i = i + 1;
        }
    }
}
