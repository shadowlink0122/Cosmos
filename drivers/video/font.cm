//! platform: baremetal-x86
// cosmo-linux::drivers::video::font - ビットマップフォントレンダラ
//
// 8×16 ビットマップフォント。ASCII 32-126 (95文字) 対応。
// 各文字は16バイト（1行1バイト × 16行）のビットマップ。

import ../../include/types;
import ../../include/config;
import ../../drivers/video/framebuffer;

// ============================================================
// フォント定数
// ============================================================

/// フォント幅・高さ
export const ulong FONT_W = 8;
export const ulong FONT_H = 16;

/// フォントデータ格納アドレス (13.5MB地点, 最大 95*16 = 1520 バイト)
const PhysAddr FONT_DATA_ADDR = 0xD80000;

/// Font — ビットマップフォントレンダラ
export struct Font {}

impl Font {
    /// フォントデータ初期化（基本ASCII文字を書き込み）
    static void init() {
        // 簡潔なビットマップフォント生成
        // 各文字: 0x20 (スペース) ~ 0x7E (~) = 95文字
        // font_data[char_index * 16 + row] = ビットマップバイト

        ulong base = FONT_DATA_ADDR;

        // 全文字をゼロ初期化
        memzero(base as void*, 1536);

        // --- 基本文字のビットマップ定義 ---
        // 代表的な文字のみ手動定義し、残りは簡易生成

        // スペース (0x20) — 全ゼロ（初期値で OK）

        // '!' (0x21)
        Font::set_glyph(0x21, 0x18,0x18,0x18,0x18,0x18,0x18,0x18,0x00,0x18,0x18,0x00,0x00,0x00,0x00,0x00,0x00);

        // '0' (0x30)
        Font::set_glyph(0x30, 0x3C,0x66,0x66,0x66,0x66,0x66,0x66,0x66,0x66,0x3C,0x00,0x00,0x00,0x00,0x00,0x00);
        // '1'
        Font::set_glyph(0x31, 0x18,0x38,0x18,0x18,0x18,0x18,0x18,0x18,0x18,0x7E,0x00,0x00,0x00,0x00,0x00,0x00);
        // '2'
        Font::set_glyph(0x32, 0x3C,0x66,0x06,0x06,0x0C,0x18,0x30,0x60,0x66,0x7E,0x00,0x00,0x00,0x00,0x00,0x00);
        // '3'
        Font::set_glyph(0x33, 0x3C,0x66,0x06,0x06,0x1C,0x06,0x06,0x06,0x66,0x3C,0x00,0x00,0x00,0x00,0x00,0x00);
        // '4'
        Font::set_glyph(0x34, 0x0C,0x1C,0x2C,0x4C,0x4C,0x7E,0x0C,0x0C,0x0C,0x0C,0x00,0x00,0x00,0x00,0x00,0x00);
        // '5'
        Font::set_glyph(0x35, 0x7E,0x60,0x60,0x7C,0x06,0x06,0x06,0x06,0x66,0x3C,0x00,0x00,0x00,0x00,0x00,0x00);
        // '6'
        Font::set_glyph(0x36, 0x3C,0x66,0x60,0x60,0x7C,0x66,0x66,0x66,0x66,0x3C,0x00,0x00,0x00,0x00,0x00,0x00);
        // '7'
        Font::set_glyph(0x37, 0x7E,0x66,0x06,0x0C,0x18,0x18,0x18,0x18,0x18,0x18,0x00,0x00,0x00,0x00,0x00,0x00);
        // '8'
        Font::set_glyph(0x38, 0x3C,0x66,0x66,0x66,0x3C,0x66,0x66,0x66,0x66,0x3C,0x00,0x00,0x00,0x00,0x00,0x00);
        // '9'
        Font::set_glyph(0x39, 0x3C,0x66,0x66,0x66,0x3E,0x06,0x06,0x06,0x66,0x3C,0x00,0x00,0x00,0x00,0x00,0x00);

        // 大文字 A-Z
        Font::set_glyph(0x41, 0x18,0x3C,0x66,0x66,0x66,0x7E,0x66,0x66,0x66,0x66,0x00,0x00,0x00,0x00,0x00,0x00);
        Font::set_glyph(0x42, 0x7C,0x66,0x66,0x66,0x7C,0x66,0x66,0x66,0x66,0x7C,0x00,0x00,0x00,0x00,0x00,0x00);
