//! platform: baremetal-x86
// Cosmo Linux ユーザープログラム: fizzbuzz
// ビルド: make cm-build SRC=programs/fizzbuzz.cm

void sys_write(ulong fd, void* buf, ulong len) {
    ulong nr = 1;
    ulong ptr = buf as ulong;
    __asm__(`
        movq ${r:nr}, %rax;
        movq ${r:fd}, %rdi;
        movq ${r:ptr}, %rsi;
        movq ${r:len}, %rdx;
        syscall
    `);
}

void sys_exit(ulong code) {
    ulong nr = 60;
    __asm__(`
        movq ${r:nr}, %rax;
        movq ${r:code}, %rdi;
        syscall
    `);
}

void print_str(void* s, ulong len) {
    sys_write(1, s, len);
}

// 数値を出力（改行付き）
void print_num(ulong n) {
    // 数値→文字列変換: 逆順に格納して出力
    // 最大20桁+改行で十分
    ulong digits = 0;  // 桁バッファ（8バイト=8桁分）
    ulong digits2 = 0;
    ulong digits3 = 0;
    ulong* buf_ptr = &digits;
    ulong buf = buf_ptr as ulong;

    // 改行を最後に置く
    ulong idx = 0;

    if (n == 0) {
        // "0\n"
        sys_write(1, "0\n" as void*, 2);
        return;
    }

    // 桁を逆順に抽出
    ulong tmp = n;
    ulong count = 0;
    while (tmp > 0 && count < 20) {
        ulong digit = tmp - (tmp / 10) * 10;
        ulong ch = digit + 48;
        // バッファに格納
        ulong* p = (buf + count) as ulong*;
        *p = ch;
        count = count + 1;
        tmp = tmp / 10;
    }

    // 逆順に出力
    ulong i = count;
    while (i > 0) {
        i = i - 1;
        ulong* p = (buf + i) as ulong*;
        ulong ch = *p;
        ulong char_buf = ch;
        sys_write(1, &char_buf as void*, 1);
    }
    sys_write(1, "\n" as void*, 1);
}

export void _start() {
    ulong i = 1;
    while (i <= 30) {
        ulong mod3 = i - (i / 3) * 3;
        ulong mod5 = i - (i / 5) * 5;
        if (mod3 == 0 && mod5 == 0) {
            print_str("FizzBuzz\n" as void*, 9);
        } else if (mod3 == 0) {
            print_str("Fizz\n" as void*, 5);
        } else if (mod5 == 0) {
            print_str("Buzz\n" as void*, 5);
        } else {
            print_num(i);
        }
        i = i + 1;
    }
    sys_exit(0);
}
