//! platform: baremetal-x86
// cosmo-linux::ui::shell_util - 文字列ヘルパー
//
// StrUtil struct/impl — コマンドパースに使う比較関数。

import ../mem;

/// StrUtil — 文字列比較ユーティリティ
export struct StrUtil {}

impl StrUtil {
    /// 2つの文字列が等しいか比較
    static ulong eq(void* a_ptr, void* b_ptr) {
        ulong a_addr = a_ptr as ulong;
        ulong b_addr = b_ptr as ulong;
        ulong i = 0;
        while (true) {
            ulong ca = Mem::read_byte(a_addr + i);
            ulong cb = Mem::read_byte(b_addr + i);
            if (ca != cb) { return 0; }
            if (ca == 0) { return 1; }
            i = i + 1;
        }
        return 0;
    }

    /// 文字列が指定プレフィックスで始まるか確認
    static ulong starts_with(void* str, void* prefix) {
        ulong s_addr = str as ulong;
        ulong p_addr = prefix as ulong;
        ulong i = 0;
        while (true) {
            ulong pc = Mem::read_byte(p_addr + i);
            if (pc == 0) { return 1; }
            ulong sc = Mem::read_byte(s_addr + i);
            if (sc != pc) { return 0; }
            i = i + 1;
        }
        return 0;
    }
}

/// 後方互換ラッパー: streq
export ulong streq(void* a_ptr, void* b_ptr) {
    return StrUtil::eq(a_ptr, b_ptr);
}

/// 後方互換ラッパー: startswith
export ulong startswith(void* str, void* prefix) {
    return StrUtil::starts_with(str, prefix);
}
