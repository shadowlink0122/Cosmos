//! platform: baremetal-x86
// cosmo-linux::boot::multiboot - Multiboot1 情報パーサ
//
// QEMUから渡されるMultiboot1情報を解析し、
// BootInfo構造体に格納する。
// Multiboot struct/impl パターンで実装。
//
// Multiboot1 info 構造体レイアウト (オフセット):
//   0:  flags (u32)
//   4:  mem_lower (u32, KiB)
//   8:  mem_upper (u32, KiB)
//   44: mmap_length (u32)
//   48: mmap_addr (u32)
//
// 参照: Multiboot 仕様書

import ../include/types;
import ../drivers/serial;
import ../lib/printk;

// ============================================================
// Multiboot1 定数
// ============================================================

/// Multiboot1 応答マジック (EAXに渡される値)
export const ulong MB_MAGIC = 0x2BADB002;

/// flags ビット: メモリ情報あり
const ulong MB_FLAG_MEM  = 1;
/// flags ビット: メモリマップあり
const ulong MB_FLAG_MMAP = 64;

// メモリマップエントリタイプ
export const ulong MMAP_AVAILABLE = 1;

// ============================================================
// BootInfo 構造体
// ============================================================

/// カーネルブート情報（Multiboot1から抽出）
export struct BootInfo {
    // メモリマップ
    PhysAddr mmap_addr;
    Size     mmap_entry_size;
    Size     mmap_count;

    // フレームバッファ（Multiboot1では未対応、将来拡張用）
    PhysAddr fb_addr;
    U32      fb_width;
    U32      fb_height;
    U32      fb_pitch;
    U32      fb_bpp;

    // メモリ合計
    Size     total_memory;
}

/// Multiboot — Multiboot1パーサ
export struct Multiboot {}

impl Multiboot {
    /// Multiboot1情報を解析
    static void parse(ulong mb_info, BootInfo* info, SerialPort* w) {
        // BootInfo初期化
        info->mmap_addr = 0;
        info->mmap_entry_size = 0;
        info->mmap_count = 0;
        info->fb_addr = 0;
        info->fb_width = 0;
        info->fb_height = 0;
        info->fb_pitch = 0;
        info->fb_bpp = 0;
        info->total_memory = 0;

        // flags を読む
        ulong flags = 0;
        __asm__(`
            movq ${r:mb_info}, %rdi;
            xorq %rax, %rax;
            movl (%rdi), %eax;
            movq %rax, ${=r:flags}
        `);

        pr_info(w, "Parsing Multiboot1 info..." as void*);

        // メモリ情報 (flags bit 0)
        if ((flags & MB_FLAG_MEM) != 0) {
            ulong mem_lower = 0;
            ulong mem_upper = 0;
            __asm__(`
                movq ${r:mb_info}, %rdi;
                xorq %rax, %rax;
                movl 4(%rdi), %eax;
                movq %rax, ${=r:mem_lower};
                xorq %rax, %rax;
                movl 8(%rdi), %eax;
                movq %rax, ${=r:mem_upper}
            `);
            // mem_upper は 1MiB 以降のKiB数
            info->total_memory = (mem_upper + 1024) * 1024;

            w->puts("  Memory: " as void*);
            print_dec(w, info->total_memory / 1048576);
            w->puts(" MiB (lower " as void*);
            print_dec(w, mem_lower);
            w->puts(" KiB, upper " as void*);
            print_dec(w, mem_upper);
            w->puts(" KiB)" as void*);
            w->println("" as void*);
        }

        // メモリマップ (flags bit 6)
        if ((flags & MB_FLAG_MMAP) != 0) {
            ulong mmap_length = 0;
            ulong mmap_addr = 0;
            __asm__(`
                movq ${r:mb_info}, %rdi;
                xorq %rax, %rax;
                movl 44(%rdi), %eax;
                movq %rax, ${=r:mmap_length};
                xorq %rax, %rax;
                movl 48(%rdi), %eax;
                movq %rax, ${=r:mmap_addr}
            `);

            info->mmap_addr = mmap_addr;
            // Multiboot1 mmap entry: [size:u32][base:u64][length:u64][type:u32] = 24バイト
            info->mmap_entry_size = 24;

            // エントリをウォーク (各エントリの先頭4バイトがentryのsize)
            ulong e = mmap_addr;
            ulong end = mmap_addr + mmap_length;
            ulong count = 0;
            while (e < end) {
                ulong entry_size = 0;
                ulong base = 0;
                ulong length = 0;
                ulong mtype = 0;
                __asm__(`
                    movq ${r:e}, %rdi;
                    xorq %rax, %rax;
                    movl (%rdi), %eax;
                    movq %rax, ${=r:entry_size};
                    movq 4(%rdi), %rax;
                    movq %rax, ${=r:base};
                    movq 12(%rdi), %rax;
                    movq %rax, ${=r:length};
                    xorq %rax, %rax;
                    movl 20(%rdi), %eax;
                    movq %rax, ${=r:mtype}
                `);
                count = count + 1;
                // entry_size + 4 (size フィールド自体) = 次のエントリ
                e = e + entry_size + 4;
            }
            info->mmap_count = count;

            w->puts("  Memory map: " as void*);
            print_dec(w, count);
            w->puts(" entries" as void*);
            w->println("" as void*);
        }

        // VBE フレームバッファ情報 (flags bit 11)
        // Multiboot1 info 構造体:
        //   offset 72: vbe_control_info (u32)
        //   offset 76: vbe_mode_info (u32)
        //   offset 80: vbe_mode (u16)
        //   ...
        // VBE モード情報ブロック (vbe_mode_info が指すアドレス):
        //   offset 18: x_resolution (u16)
        //   offset 20: y_resolution (u16)
        //   offset 25: bits_per_pixel (u8)
        //   offset 40: phys_base_ptr (u32) — リニアフレームバッファアドレス
        //   offset 16: bytes_per_scanline (u16) — pitch
        ulong vbe_flag = flags & 0x800;  // bit 11
        if (vbe_flag != 0) {
            ulong vbe_mode_info_addr = 0;
            __asm__(`
                movq ${r:mb_info}, %rdi;
                xorq %rax, %rax;
                movl 76(%rdi), %eax;
                movq %rax, ${=r:vbe_mode_info_addr}
            `);

            if (vbe_mode_info_addr != 0) {
                ulong fb_addr = 0;
                ulong fb_width = 0;
                ulong fb_height = 0;
                ulong fb_pitch = 0;
                ulong fb_bpp = 0;
                __asm__(`
                    movq ${r:vbe_mode_info_addr}, %rdi;
                    xorq %rax, %rax;
                    movzwl 18(%rdi), %eax;
                    movq %rax, ${=r:fb_width};
                    xorq %rax, %rax;
                    movzwl 20(%rdi), %eax;
                    movq %rax, ${=r:fb_height};
                    xorq %rax, %rax;
                    movzbl 25(%rdi), %eax;
                    movq %rax, ${=r:fb_bpp};
                    xorq %rax, %rax;
                    movl 40(%rdi), %eax;
                    movq %rax, ${=r:fb_addr};
                    xorq %rax, %rax;
                    movzwl 16(%rdi), %eax;
                    movq %rax, ${=r:fb_pitch}
                `);

                info->fb_addr = fb_addr;
                info->fb_width = fb_width as U32;
                info->fb_height = fb_height as U32;
                info->fb_pitch = fb_pitch as U32;
                info->fb_bpp = fb_bpp as U32;

                w->puts("  Framebuffer: " as void*);
                print_dec(w, fb_width);
                w->puts("x" as void*);
                print_dec(w, fb_height);
                w->puts("x" as void*);
                print_dec(w, fb_bpp);
                w->puts(" @ 0x" as void*);
                // 16進アドレス出力
                Multiboot::print_hex(w, fb_addr);
                w->println("" as void*);
            }
        }

        pr_info(w, "Multiboot1 parsing complete" as void*);
    }

    /// 16進数出力ヘルパー
    static void print_hex(SerialPort* w, ulong val) {
        ulong i = 0;
        while (i < 8) {
            ulong nibble = (val >> (28 - i * 4)) & 0xF;
            if (nibble < 10) {
                w->putc(48 + nibble);
            } else {
                w->putc(55 + nibble);  // 'A'=65, 65-10=55
            }
            i = i + 1;
        }
    }
}

// 互換ラッパー
export void mb_parse(ulong mb_info, BootInfo* info, SerialPort* w) { Multiboot::parse(mb_info, info, w); }
