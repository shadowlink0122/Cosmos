//! platform: baremetal-x86
// cosmo-linux::drivers::pit - PIT 8254 タイマードライバ
//
// チャンネル0をレートジェネレータモードで設定し、
// IRQ0（ベクタ32）を定期的に発生させる。
// PIT struct/impl パターンで実装。
// 参照: linux/arch/x86/kernel/i8253.c

import ../include/types;
import ../include/config;
import ../arch/x86_64/cpu;
import ../arch/x86_64/idt;
import ../drivers/serial;
import ../lib/printk;

// PIT状態（固定メモリに配置）
const PhysAddr PIT_TICK_ADDR = 0x90000;
const PhysAddr PIT_NEED_SCHED_ADDR = 0x90008;

/// PIT IRQ0 ハンドラ（関数ポインタとして使うためモジュールレベル）
void pit_irq_handler() {
    __asm__(`
        // callee-savedレジスタ保存（sched_tickがcallするため）
        pushq %rax;
        pushq %rcx;
        pushq %rdx;
        pushq %rdi;
        pushq %rsi;
        pushq %r8;
        pushq %r9;
        pushq %r10;
        pushq %r11;
        pushq %rbx;
        pushq %rbp;
        pushq %r12;
        pushq %r13;
        pushq %r14;
        pushq %r15;

        // ティックカウンタをインクリメント
        movq $$0x90000, %rdi;
        movq (%rdi), %rax;
        addq $$1, %rax;
        movq %rax, (%rdi);

        // EOI送信（PIC）
        movb $$0x20, %al;
        outb %al, $$0x20;

        // 10tick毎にスケジューラtickを呼び出し
        movq $$0x90000, %rdi;
        movq (%rdi), %rax;
        xorq %rdx, %rdx;
        movq $$10, %rcx;
        divq %rcx;
        testq %rdx, %rdx;
        jnz 1f;

        // need_reschedフラグ設定（協調スケジューリング用）
        movq $$0x90008, %rdi;
        movq $$1, (%rdi);
        1:;

        // レジスタ復帰
        popq %r15;
        popq %r14;
        popq %r13;
        popq %r12;
        popq %rbp;
        popq %rbx;
        popq %r11;
        popq %r10;
        popq %r9;
        popq %r8;
        popq %rsi;
        popq %rdi;
        popq %rdx;
        popq %rcx;
        popq %rax;
        iretq
    `);
}

/// PIT — 8254 タイマードライバ
export struct PIT {}

impl PIT {
    /// PIT Ch0 をレートジェネレータモードで初期化 (100Hz)
    static void setup(SerialPort* w) {
        // PIC 8259A 初期化（IRQリマップ）
        outb(PIC1_CMD, 0x11);
        outb(PIC2_CMD, 0x11);
        outb(PIC1_DATA, 32);
        outb(PIC2_DATA, 40);
        outb(PIC1_DATA, 4);
        outb(PIC2_DATA, 2);
        outb(PIC1_DATA, 1);
        outb(PIC2_DATA, 1);
        outb(PIC1_DATA, 0xFF);
        outb(PIC2_DATA, 0xFF);

        pr_info(w, "PIC remapped (IRQ0-7 -> vec 32-39)" as void*);

        // PIT 8254 初期化
        outb(PIT_CMD, 0x34);
        ulong divisor = PIT_FREQ / PIT_HZ;
        outb(PIT_CH0, divisor & 0xFF);
        outb(PIT_CH0, (divisor >> 8) & 0xFF);

        // ティックカウンタ初期化
        ulong* tick_ptr = PIT_TICK_ADDR as ulong*;
        *tick_ptr = 0;
        ulong* sched_ptr = PIT_NEED_SCHED_ADDR as ulong*;
        *sched_ptr = 0;

        // IRQ0ハンドラ登録（ベクタ32）
        Idt::set_gate(32, pit_irq_handler as ulong, GATE_INT);

        // PICでIRQ0のマスクを解除
        ulong mask = inb(PIC1_DATA);
        outb(PIC1_DATA, mask & 0xFE);

        pr_info(w, "PIT initialized (100Hz, IRQ0 -> vector 32)" as void*);
    }

    /// 現在のティックカウントを取得
    static ulong get_ticks() {
        ulong* tick_ptr = PIT_TICK_ADDR as ulong*;
        return *tick_ptr;
    }

    /// スケジュール要求フラグを確認＆クリア
    static ulong check_resched() {
        ulong* sched_ptr = PIT_NEED_SCHED_ADDR as ulong*;
        ulong val = *sched_ptr;
        if (val != 0) {
            *sched_ptr = 0;
        }
        return val;
    }
}
