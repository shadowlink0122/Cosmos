//! platform: baremetal-x86
// cosmo-linux::arch::x86_64::idt - IDT設定
//
// 256ベクタのIDT。例外ハンドラ（#DE, #DF, #GP, #PF）を登録。
// Idt struct/impl パターンで実装。
// 参照: linux/arch/x86/kernel/idt.c

import ../../include/types;
import ../../include/config;
import ../../include/scheduler;
import ../../drivers/serial;
import ../../lib/printk;
import ../../sched/process;
import ../../sched/scheduler;
import ../../ui/shell_io;

// ゲートタイプ定数
export const ulong GATE_INT  = 0x8E;  // Interrupt Gate, DPL=0
export const ulong GATE_TRAP = 0x8F;  // Trap Gate, DPL=0
export const ulong GATE_USER = 0xEF;  // Trap Gate, DPL=3

// ============================================================
// 例外ハンドラ（関数ポインタとして使うためモジュールレベル）
// ============================================================

export void exc_default() {
    SerialPort serial(COM1);
    serial.println("!!! UNHANDLED EXCEPTION !!!" as void*);
    // TSS RSP0からフレーム情報を表示
    ulong* tss_rsp0_ptr = 0x83004 as ulong*;
    ulong tss_rsp0 = *tss_rsp0_ptr;
    ulong* rip_ptr = (tss_rsp0 - 40) as ulong*;
    ulong* cs_ptr = (tss_rsp0 - 32) as ulong*;
    ulong* err_ptr = (tss_rsp0 - 48) as ulong*;
    serial.puts("  RIP = " as void*);
    serial.print_hex(*rip_ptr);
    serial.puts("  CS = " as void*);
    serial.print_hex(*cs_ptr);
    serial.println("" as void*);

    // ユーザーモード例外ならSIGSEGV kill
    ulong cs_val = *cs_ptr;
    if ((cs_val & 3) != 0) {
        serial.println("[EXC] User process killed" as void*);
        __asm__(`sti; 1: hlt; jmp 1b`);
        return;
    }
    __asm__(`cli; 1: hlt; jmp 1b`);
}

export void exc_divide_error() {
    SerialPort serial(COM1);
    serial.println("!!! DIVIDE ERROR (#DE) !!!" as void*);
    __asm__(`cli; 1: hlt; jmp 1b`);
}

export void exc_double_fault() {
    SerialPort serial(COM1);
    serial.println("!!! DOUBLE FAULT (#DF) !!!" as void*);
    __asm__(`cli; 1: hlt; jmp 1b`);
}

export void exc_general_protection() {
    SerialPort serial(COM1);
    serial.println("!!! GENERAL PROTECTION (#GP) !!!" as void*);
    ulong rsp_val = 0;
    __asm__(`movq %rsp, %rax; movq %rax, ${=r:rsp_val}`);
    serial.puts("  RSP = " as void*);
    serial.print_hex(rsp_val);
    serial.println("" as void*);
    ulong i = 0;
    while (i < 8) {
        ulong* sp = (rsp_val + i * 8) as ulong*;
        serial.puts("  [RSP+" as void*);
        serial.print_hex(i * 8);
        serial.puts("] = " as void*);
        serial.print_hex(*sp);
        serial.println("" as void*);
        i = i + 1;
    }
    __asm__(`cli; 1: hlt; jmp 1b`);
}

/// PF後のアイドルループ
/// iretqで復帰した後、タイマー割り込みでスケジューラがシェルに切替
void pf_idle_loop() {
    __asm__(`sti; 1: hlt; jmp 1b`);
}

export void exc_page_fault() {
    SerialPort serial(COM1);
    serial.println("!!! PAGE FAULT (#PF) !!!" as void*);
    ulong cr2 = 0;
    __asm__(`movq %cr2, %rax; movq %rax, ${=r:cr2}`);
    serial.puts("  CR2 = " as void*);
    serial.print_hex(cr2);
    serial.println("" as void*);

    // TSS RSP0ベースで割り込みフレームを読み取り
    ulong* tss_rsp0_ptr = 0x83004 as ulong*;
    ulong tss_rsp0 = *tss_rsp0_ptr;

    ulong* err_ptr = (tss_rsp0 - 48) as ulong*;
    ulong* rip_ptr = (tss_rsp0 - 40) as ulong*;
    ulong* cs_ptr = (tss_rsp0 - 32) as ulong*;

    serial.puts("  RIP = " as void*);
    serial.print_hex(*rip_ptr);
    serial.puts("  CS = " as void*);
    serial.print_hex(*cs_ptr);
    serial.println("" as void*);

    // ユーザーモード#PF → プロセスkill (SIGSEGV = exit code 139)
    ulong cs_val = *cs_ptr;
    if ((cs_val & 3) != 0) {
        ulong* ursp_ptr = (tss_rsp0 - 16) as ulong*;
        serial.puts("  user_RSP = " as void*);
        serial.print_hex(*ursp_ptr);
        serial.puts("  err = " as void*);
        serial.print_hex(*err_ptr);
        serial.println("" as void*);
        // ユーザースタックダンプ (call chain)
        ulong ursp = *ursp_ptr;
        if (ursp > 0x400000) {
            ulong i = 0;
            while (i < 8) {
                ulong* ustack = (ursp + i * 8) as ulong*;
                serial.puts("  [ursp+" as void*);
                serial.print_hex(i * 8);
                serial.puts("] = " as void*);
                serial.print_hex(*ustack);
                serial.println("" as void*);
                i = i + 1;
            }
        }
        serial.println("[#PF] User process killed (SIGSEGV)" as void*);

        // VGA画面にエラー表示
        Shell::set_color(12, 0);
        Shell::writeln("Segmentation fault (core dumped)" as void*);
        Shell::set_color(7, 0);

        // プロセスを終了してスケジューラから除外
        Process* cur = Sched::current();
        ulong cur_addr = cur as ulong;
        if (cur_addr != 0) {
            Pid dying_pid = cur->pid;
            ProcessTable::do_exit(cur, 139);
            Sched::remove(dying_pid);
        }

        // 直接iretqでカーネルのidle loopに復帰
        // C関数のreturn経由ではerror_codeがRIPとして使われるため、
        // インラインasmで直接スタックをリセットしてiretqを実行
        ulong idle_rip = pf_idle_loop as ulong;
        __asm__(`
            // スタックをTSS RSP0にリセット（例外フレームをすべて破棄）
            movq ${r:tss_rsp0}, %rsp;
            // iretqフレーム構築: [SS, RSP, RFLAGS, CS, RIP]
            pushq $$0x10;              // SS = kernel DS
            pushq ${r:tss_rsp0};      // RSP = kernel stack
            pushq $$0x200;             // RFLAGS = IF=1
            pushq $$0x08;              // CS = kernel CS
            pushq ${r:idle_rip};       // RIP = pf_idle_loop
            iretq
        `);
    }

    // カーネルモード#PF → プロセスkill試行してidle復帰
    serial.puts("  err_code = " as void*);
    serial.print_hex(*err_ptr);
    serial.println("" as void*);
    serial.println("[#PF] Kernel PF - attempting recovery" as void*);

    // VGA画面にエラー表示
    Shell::set_color(12, 0);
    Shell::writeln("Segmentation fault (core dumped)" as void*);
    Shell::set_color(7, 0);

    // 現在プロセスをkillしてidle loopに復帰
    Process* cur = Sched::current();
    ulong cur_addr = cur as ulong;
    if (cur_addr != 0 && cur->pid > 1) {
        Pid dying_pid = cur->pid;
        ProcessTable::do_exit(cur, 139);
        Sched::remove(dying_pid);
    }

    ulong idle_rip = pf_idle_loop as ulong;
    __asm__(`
        movq ${r:tss_rsp0}, %rsp;
        pushq $$0x10;
        pushq ${r:tss_rsp0};
        pushq $$0x200;
        pushq $$0x08;
        pushq ${r:idle_rip};
        iretq
    `);
}

/// Idt — IDT管理
export struct Idt {}

impl Idt {
    /// IDTエントリを設定
    static void set_gate(Vector vec, ulong handler, ulong gate_type) {
        PhysAddr entry = IDT_ADDR + vec * 16;

        ulong low = 0;
        low = low | (handler & 0xFFFF);
        low = low | (0x08 << 16);
        low = low | (gate_type << 40);
        low = low | (((handler >> 16) & 0xFFFF) << 48);
        ulong* lp = entry as ulong*;
        *lp = low;

        ulong high = (handler >> 32) & 0xFFFFFFFF;
        ulong* hp = (entry + 8) as ulong*;
        *hp = high;
    }

    /// IDTを初期化してロード
    static void setup(SerialPort* w) {
        ulong i = 0;
        while (i < 256 * 16) {
            ulong* p = (IDT_ADDR + i) as ulong*;
            *p = 0;
            i = i + 8;
        }

        // 全ベクタにデフォルトハンドラ登録
        ulong def = exc_default as ulong;
        Vector v = 0;
        while (v < 256) {
            Idt::set_gate(v, def, GATE_INT);
            v = v + 1;
        }

        // 主要例外ハンドラ
        Idt::set_gate(0,  exc_divide_error as ulong,       GATE_TRAP);
        Idt::set_gate(8,  exc_double_fault as ulong,       GATE_TRAP);
        Idt::set_gate(13, exc_general_protection as ulong, GATE_TRAP);
        Idt::set_gate(14, exc_page_fault as ulong,         GATE_TRAP);

        // IDTR構築・ロード
        ulong* idtr_lim = IDTR_ADDR as ulong*;
        *idtr_lim = 256 * 16 - 1;
        ulong* idtr_base = (IDTR_ADDR + 2) as ulong*;
        *idtr_base = IDT_ADDR;

        ulong idtr = IDTR_ADDR;
        __asm__(`
            movq ${r:idtr}, %rax;
            lidt (%rax)
        `);

        pr_info(w, "IDT initialized (256 vectors)" as void*);
    }
}
