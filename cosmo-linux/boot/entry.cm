//! platform: baremetal-x86
// cosmo-linux::boot::entry - カーネルエントリポイント
//
// header.S → start_kernel() → 各サブシステム初期化 → shell
// 参照: linux/init/main.c

import ../include/types;
import ../include/config;
import ../include/scheduler;
import ../drivers/serial;
import ../drivers/pit;
import ../drivers/virtio_net;
import ../net/arp;
import ../net/ip;
import ../include/net;

import ../drivers/keyboard;
import ../lib/kstring;
import ../lib/printk;
import ../arch/x86_64/cpu;
import ../arch/x86_64/gdt;
import ../arch/x86_64/idt;
import ../arch/x86_64/context;
import ./multiboot2;
import ../mm/pmm;
import ../mm/vmm;
import ../mm/kmalloc;
import ../sched/process;
import ../sched/scheduler;
import ../sys/syscall;
import ../ui/shell;
import ../fs/ramfs;
import ../fs/fd_table;
import ../fs/pipe;
import ../fs/vfs;
import ../init/init;

// ============================================================
// start_kernel — エントリポイント
// ============================================================

void main(ulong mb2_info, ulong mb2_magic) {
    // === 1. シリアルコンソール確立 ===
    SerialPort serial(COM1);
    DebugPort debug(DEBUGCON);

    serial.println("" as void*);
    serial.println("========================================" as void*);
    serial.println("  Cosmo Linux v0.1.0" as void*);
    serial.println("  Written in Cm - A Linux reimagined" as void*);
    serial.println("========================================" as void*);
    serial.println("" as void*);

    pr_info(&serial, "start_kernel() entered" as void*);

    // === 2. Multiboot1マジック検証 ===
    if (mb2_magic != MB_MAGIC) {
        pr_err(&serial, "Invalid Multiboot1 magic!" as void*);
    }

    // === 3. ブート情報解析 ===
    BootInfo boot_info = {
        mmap_addr: 0,
        mmap_entry_size: 0,
        mmap_count: 0,
        fb_addr: 0,
        fb_width: 0,
        fb_height: 0,
        fb_pitch: 0,
        fb_bpp: 0,
        total_memory: 0
    };

    if (mb2_magic == MB_MAGIC) {
        Multiboot::parse(mb2_info, &boot_info, &serial);
    }

    // === 5. アーキテクチャ初期化 ===
    pr_info(&serial, "Initializing architecture..." as void*);
    Gdt::setup(&serial);
    Idt::setup(&serial);

    // === 6. メモリ管理初期化 ===
    pr_info(&serial, "Initializing memory management..." as void*);

    BuddyAllocator pmm();
    if (boot_info.mmap_count > 0) {
        Pmm::setup(&pmm, boot_info.mmap_addr, boot_info.mmap_entry_size,
        boot_info.mmap_count, &serial);
    }

    ulong cr3_val = 0;
    __asm__(`
        movq %cr3, %rax;
        movq %rax, ${=r:cr3_val}
    `);
    PageTable vmm(cr3_val);
    vmm_init(&vmm, &serial);

    KernelHeap heap();
    if (pmm.total_pages > 0) {
        kmalloc_init(&heap, &pmm, &serial);
    }

    // === 7. VFS初期化 ===
    pr_info(&serial, "Initializing VFS..." as void*);
    RamFs::setup(&serial);
    FdTable::setup();
    Cwd::setup();
    Pipe::setup();
    pr_info(&serial, "VFS initialized (ramfs + fd + cwd + pipe)" as void*);

    // === 8. プロセス管理初期化 ===
    pr_info(&serial, "Initializing process management..." as void*);

    ProcessTable::setup(&serial);

    Process idle(0, 0);
    ProcessTable::create_idle(&idle, &serial);

    RoundRobinScheduler sched();
    Sched::setup(&sched, &idle, &serial);

    // === 9. TSS初期化 ===
    Gdt::setup_tss(0x94000, &serial);

    // === 10. syscall初期化 ===
    Syscall::setup(&serial);

    // === 10. PIC/PIT/キーボード初期化 ===
    pr_info(&serial, "Initializing hardware drivers..." as void*);
    PIT::setup(&serial);
    Kbd::setup(&serial);

    // === 11. ネットワーク初期化 ===
    pr_info(&serial, "Initializing network..." as void*);
    VirtioNet::init(&serial);

    // === 12. initプロセス & シェルタスク生成 ===
    Init::banner(&serial);
    pr_info(&serial, "Creating shell task..." as void*);

    shell_init(&serial as ulong, &pmm as ulong);

    Process shell(ProcessTable::alloc_pid(), 0);
    shell.alloc_stack(&pmm);
    if (shell.kernel_stack != 0) {
        Context::init_task(&shell, shell.kernel_stack, shell_main as ulong);
        Sched::add(&shell);
        pr_info(&serial, "Shell task created" as void*);
    }

    // === 12. 初期化完了 ===
    serial.puts("  Memory: " as void*);
    print_dec(&serial, boot_info.total_memory / 1048576);
    serial.println(" MiB" as void*);

    pr_info(&serial, "Kernel initialization complete" as void*);
    pr_info(&serial, "Entering idle loop with scheduler..." as void*);

    // 割り込み有効化
    Cpu::sti();

    // idle loop（PIT割り込み + タイマーベーススケジューリング）
    while (true) {
        Cpu::hlt();

        ulong need_resched = PIT::check_resched();
        if (need_resched != 0) {
            Sched::tick();
        }
    }
}
