//! platform: baremetal-x86
// cosmo-linux::sys::syscall - syscall エントリポイント
//
// x86_64 LSTAR MSR を設定し、syscall命令でカーネルに遷移する。
// Syscall struct/impl パターンで実装。
// Linux ABI: RAX=番号, RDI/RSI/RDX/R10/R8/R9=引数
//
// 参照: linux/arch/x86/entry/entry_64.S

import ../include/types;
import ../include/config;
import ../include/errno;
import ../include/signal;
import ../drivers/serial;
import ../lib/printk;
import ../arch/x86_64/cpu;
import ./syscall_table;
import ./signal;
import ../fs/vfs;
import ../fs/fd_table;
import ../init/init;
import ../sched/process;
import ../sched/scheduler;
import ../mm/mmap;
import ../fs/devfs;
import ../fs/pipe;
// ABI拡張: 分野別syscall
import ./syscall_fs;
import ./syscall_proc;
import ./syscall_net;

// ============================================================
// MSR定数
// ============================================================

/// STAR MSR: syscall/sysret セグメント設定
const ulong MSR_STAR  = 0xC0000081;

/// LSTAR MSR: syscall エントリアドレス
const ulong MSR_LSTAR = 0xC0000082;

/// SFMASK MSR: syscall時のRFLAGSマスク
const ulong MSR_SFMASK = 0xC0000084;

/// EFER MSR: syscall有効化ビット
const ulong MSR_EFER = 0xC0000080;
const ulong EFER_SCE = 1;

// ============================================================
// Syscall結果
// ============================================================

/// Syscallディスパッチ結果
export struct SyscallResult {
    long value;
}

/// Syscall — syscall管理
export struct Syscall {}

impl Syscall {
    /// syscall/sysretを初期化
    static void setup(SerialPort* w) {
        // EFER.SCE (System Call Extension) を有効化
        ulong efer = Cpu::rdmsr(MSR_EFER);
        Cpu::wrmsr(MSR_EFER, efer | EFER_SCE);

        // STAR: syscall時のCS/SS = 0x08/0x10, sysret時のCS/SS base = 0x10
        // sysret: User DS = base+8 = 0x18|3, User CS(64) = base+16 = 0x20|3
        ulong star = (0x0010 << 48) | (0x0008 << 32);
        Cpu::wrmsr(MSR_STAR, star);

        // LSTAR: syscallエントリアドレス
        ulong entry = syscall_entry_stub as ulong;
        Cpu::wrmsr(MSR_LSTAR, entry);

        // SFMASK: syscall時にIFとDFをクリア
        Cpu::wrmsr(MSR_SFMASK, 0x700);

        pr_info(w, "Syscall initialized (LSTAR set)" as void*);
    }

    /// sys_write: fdに書き込み
    static long write(ulong fd, ulong buf_addr, ulong count) {
        // fd 1 (stdout) と fd 2 (stderr) → シリアルに出力
        if (fd == 1 || fd == 2) {
            SerialPort serial(COM1);
            ulong i = 0;
            while (i < count) {
                ulong ch = 0;
                ulong addr = buf_addr + i;
                __asm__(`
                    movq ${r:addr}, %rdi;
                    xorq %rax, %rax;
                    movb (%rdi), %al;
                    movq %rax, ${=r:ch}
                `);
                serial.putc(ch as utiny);
                i = i + 1;
            }
            return count as long;
        }
        // DevFSチェック
        ulong fs_type = FdTable::get_fs_type(fd as long);
        if (fs_type == FS_DEVFS) {
            ulong dev_id = FdTable::get_ino(fd as long) as ulong;
            return DevFs::write(dev_id, buf_addr, count);
        }
        if (fs_type == FS_PIPE) {
            ulong pipe_id = FdTable::get_ino(fd as long) as ulong;
            return Pipe::write(pipe_id, buf_addr, count);
        }
        return (0 - EBADF);
    }

    /// sys_read: fdから読み出し
    static long read(ulong fd, ulong buf_addr, ulong count) {
        if (fd == 0) { return 0; }
        // DevFSチェック
        ulong fs_type = FdTable::get_fs_type(fd as long);
        if (fs_type == FS_DEVFS) {
            ulong dev_id = FdTable::get_ino(fd as long) as ulong;
            return DevFs::read(dev_id, buf_addr, count);
        }
        if (fs_type == FS_PIPE) {
            ulong pipe_id = FdTable::get_ino(fd as long) as ulong;
            return Pipe::read(pipe_id, buf_addr, count);
        }
        // ramfsファイル → VFS経由
        return Vfs::read(fd as long, buf_addr, count);
    }

    /// sys_open: ファイルをオープン
    static long open(ulong name_addr, ulong flags) {
        // ルートディレクトリ "/" → ディレクトリFDを返す
        ulong is_root = 0;
        ulong* first_byte = name_addr as ulong*;
        ulong fb = 0;
        __asm__(`movq ${r:name_addr}, %rdi; xorq %rax,%rax; movb (%rdi),%al; movq %rax, ${=r:fb}`);
        if (fb == 0x2F) {
            // '/' の次が '\0' かチェック
            ulong sb = 0;
            ulong na1 = name_addr + 1;
            __asm__(`movq ${r:na1}, %rdi; xorq %rax,%rax; movb (%rdi),%al; movq %rax, ${=r:sb}`);
            if (sb == 0) {
                is_root = 1;
            }
        }
        if (is_root != 0) {
            return FdTable::alloc(ROOT_INO as long, flags, FS_DIR);
        }
        // /dev/ プレフィックスチェック
        if (startswith(name_addr as void*, "/dev/" as void*) != 0) {
            ulong dev_name = name_addr + 5;
            ulong dev_id = DevFs::lookup(dev_name as void*);
            if (dev_id != 0) {
                return FdTable::alloc(dev_id as long, flags, FS_DEVFS);
            }
            return 0 - ENOENT;
        }
        return Vfs::open(name_addr as void*, flags);
    }

    /// sys_close: FDを閉じる
    static long close(ulong fd) {
        if (FdTable::is_valid(fd as long) == 0) {
            return 0 - EBADF;
        }
        ulong fs_type = FdTable::get_fs_type(fd as long);
        if (fs_type == FS_DEVFS || fs_type == FS_PIPE) {
            // DevFS / Pipe: FDエントリのみ解放
            FdTable::free(fd as long);
            return 0;
        }
        return Vfs::close(fd as long);
    }

    /// sys_exit: プロセス終了
    static void exit(long code) {
        Process* cur = Sched::current();
        ulong cur_addr = cur as ulong;
        if (cur_addr != 0 && cur->pid != 0) {
            ProcessTable::do_exit(cur, code);
            // スケジュール実行して他のプロセスに切り替え
            Sched::run();
        }
        // idleプロセスまたはフォールバック
        __asm__(`cli; 1: hlt; jmp 1b`);
    }

    /// sys_getpid: PID取得
    static long getpid() {
        Process* cur = Sched::current();
        ulong cur_addr = cur as ulong;
        if (cur_addr != 0) { return cur->pid; }
        return 1;
    }

    /// sys_getppid: 親プロセスPID取得
    static long getppid() {
        Process* cur = Sched::current();
        ulong cur_addr = cur as ulong;
        if (cur_addr != 0) { return cur->parent_pid; }
        return 0;
    }

    /// sys_kill: シグナル送信
    static long kill(ulong pid, ulong sig) {
        return Signal::send(pid as long, sig);
    }

    /// sys_wait4: 子プロセス終了待ち
    static long wait4(long wait_pid) {
        Process* cur = Sched::current();
        ulong cur_addr = cur as ulong;
        if (cur_addr == 0) { return 0 - ECHILD; }
        return ProcessTable::do_wait(cur, wait_pid);
    }

    /// sys_uname: システム情報取得 (Linux utsname構造体に書き込み)
    static long uname(ulong buf_addr) {
        if (buf_addr == 0) { return 0 - EFAULT; }
        // Linux utsname: 5フィールド × 65バイト
        Syscall::uname_write(buf_addr, "Cosmo Linux" as void*);
        Syscall::uname_write(buf_addr + 65, "cosmo" as void*);
        Syscall::uname_write(buf_addr + 130, "0.2.0" as void*);
        Syscall::uname_write(buf_addr + 195, "Cm/LLVM" as void*);
        Syscall::uname_write(buf_addr + 260, "x86_64" as void*);
        return 0;
    }

    /// uname用文字列書き込みヘルパー
    static void uname_write(ulong dst, void* src) {
        ulong s = src as ulong;
        ulong i = 0;
        while (i < 64) {
            ulong ch = 0;
            ulong addr = s + i;
            __asm__(`movq ${r:addr}, %r10; xorq %rax,%rax; movzbl (%r10),%eax; movq %rax, ${=r:ch}`);
            __asm__(`movq ${r:dst}, %r10; addq ${r:i}, %r10; movq ${r:ch}, %rax; movb %al, (%r10)`);
            if (ch == 0) { return; }
            i = i + 1;
        }
    }

    /// sys_getcwd: カレントディレクトリ取得
    static long getcwd(ulong buf_addr, ulong size) {
        if (buf_addr == 0) { return 0 - EFAULT; }
        ulong cwd = Cwd::get();
        ulong i = 0;
        while (i < size - 1) {
            ulong ch = 0;
            ulong addr = cwd + i;
            __asm__(`movq ${r:addr}, %r10; xorq %rax,%rax; movzbl (%r10),%eax; movq %rax, ${=r:ch}`);
            __asm__(`movq ${r:buf_addr}, %r10; addq ${r:i}, %r10; movq ${r:ch}, %rax; movb %al, (%r10)`);
            if (ch == 0) { return (i + 1) as long; }
            i = i + 1;
        }
        return i as long;
    }

    /// sys_chdir: カレントディレクトリ変更
    static long chdir(ulong path_addr) {
        if (path_addr == 0) { return 0 - EFAULT; }
        Cwd::set(path_addr as void*);
        return 0;
    }

    /// sys_brk: ヒープ上限変更
    static long brk(ulong new_brk) {
        Process* cur = Sched::current();
        ulong cur_addr = cur as ulong;
        if (cur_addr == 0) { return 0 - ENOMEM; }
        ulong result = Mmap::do_brk(new_brk, cur);
        return result as long;
    }

    /// sys_mmap: メモリマッピング
    static long mmap(ulong addr, ulong length, ulong prot, ulong flags) {
        ulong result = Mmap::do_mmap(addr, length, prot, flags);
        if (result == MAP_FAILED) { return 0 - ENOMEM; }
        return result as long;
    }

    /// sys_munmap: メモリマッピング解除
    static long munmap(ulong addr, ulong length) {
        return Mmap::do_munmap(addr, length);
    }

    /// sys_pipe: パイプ作成
    /// pipefd[0] = 読み取り端, pipefd[1] = 書き込み端
    static long do_pipe(ulong pipefd_addr) {
        if (pipefd_addr == 0) { return 0 - EFAULT; }
        long pipe_id = Pipe::create();
        if (pipe_id < 0) { return 0 - EMFILE; }
        // 読み取り端FD
        Fd read_fd = FdTable::alloc(pipe_id, O_RDONLY, FS_PIPE);
        if (read_fd < 0) {
            Pipe::destroy(pipe_id as ulong);
            return 0 - EMFILE;
        }
        // 書き込み端FD
        Fd write_fd = FdTable::alloc(pipe_id, O_WRONLY, FS_PIPE);
        if (write_fd < 0) {
            FdTable::free(read_fd);
            Pipe::destroy(pipe_id as ulong);
            return 0 - EMFILE;
        }
        // pipefd配列に書き込み
        ulong* fd0 = pipefd_addr as ulong*;
        ulong* fd1 = (pipefd_addr + 8) as ulong*;
        *fd0 = read_fd as ulong;
        *fd1 = write_fd as ulong;
        return 0;
    }

    /// sys_dup2: FDコピー
    static long do_dup2(ulong oldfd, ulong newfd) {
        return FdTable::dup2(oldfd as long, newfd as long);
    }

    // ================================================================
    // MS2: Linux ABI拡張 — musl-libc対応syscall
    // ================================================================

    /// sys_arch_prctl: アーキテクチャ固有制御
    /// 参照: linux/arch/x86/kernel/process_64.c
    /// musl-libcはTLS(Thread Local Storage)セットアップに使用
    static long arch_prctl(ulong code, ulong addr) {
        // ARCH_SET_FS = 0x1002: FSベースレジスタ設定 (TLS用)
        if (code == 0x1002) {
            // [デバッグ] FSベースアドレス確認
            SerialPort dbg(COM1);
            dbg.puts("[TLS] SET_FS=0x" as void*);
            dbg.print_hex(addr);
            dbg.println("" as void*);
            Cpu::wrmsr(0xC0000100, addr);  // IA32_FS_BASE
            return 0;
        }
        // ARCH_GET_FS = 0x1003: FSベースレジスタ取得
        if (code == 0x1003) {
            ulong fs = Cpu::rdmsr(0xC0000100);
            ulong* out = addr as ulong*;
            *out = fs;
            return 0;
        }
        // ARCH_SET_GS = 0x1001
        if (code == 0x1001) {
            Cpu::wrmsr(0xC0000101, addr);  // IA32_GS_BASE
            return 0;
        }
        return 0 - EINVAL;
    }

    /// sys_set_tid_address: スレッドID設定
    static long set_tid_address(ulong tidptr) {
        Process* cur = Sched::current();
        ulong cur_addr = cur as ulong;
        if (cur_addr != 0) {
            return cur->pid;
        }
        return 1;
    }

    /// sys_mprotect: メモリ保護属性変更
    static long do_mprotect(ulong addr, ulong len, ulong prot) {
        return 0;
    }

    /// sys_writev: scatter write (iovec配列による書き込み)
    static long writev(ulong fd, ulong iov_addr, ulong iovcnt) {
        if (fd != 1 && fd != 2) {
            // 非stdout/stderr: 個別のwrite呼び出しに分解
            long total = 0;
            ulong i = 0;
            while (i < iovcnt) {
                ulong* base_ptr = (iov_addr + i * 16) as ulong*;
                ulong* len_ptr = (iov_addr + i * 16 + 8) as ulong*;
                ulong base = *base_ptr;
                ulong len = *len_ptr;
                if (len > 0) {
                    long ret = Syscall::write(fd, base, len);
                    if (ret < 0) { return ret; }
                    total = total + ret;
                }
                i = i + 1;
            }
            return total;
        }
        // stdout/stderr: シリアル出力
        SerialPort serial(COM1);
        long total = 0;
        ulong i = 0;
        while (i < iovcnt) {
            ulong* base_ptr = (iov_addr + i * 16) as ulong*;
            ulong* len_ptr = (iov_addr + i * 16 + 8) as ulong*;
            ulong base = *base_ptr;
            ulong len = *len_ptr;
            ulong j = 0;
            while (j < len) {
                ulong ch = 0;
                ulong addr = base + j;
                __asm__(`
                    movq ${r:addr}, %rdi;
                    xorq %rax, %rax;
                    movb (%rdi), %al;
                    movq %rax, ${=r:ch}
                `);
                serial.putc(ch as utiny);
                j = j + 1;
            }
            total = total + (len as long);
            i = i + 1;
        }
        return total;
    }

    /// sys_exit_group: プロセスグループ終了
    static void exit_group(long code) {
        Syscall::exit(code);
    }

    /// sys_ioctl: デバイス制御
    static long do_ioctl(ulong fd, ulong cmd, ulong arg) {
        // TIOCGWINSZ = 0x5413: ウィンドウサイズ取得
        if (cmd == 0x5413) {
            if (arg != 0) {
                ulong* ws = arg as ulong*;
                *ws = (80 << 16) | 25;
            }
            return 0;
        }
        // TCGETS = 0x5401: termios取得
        if (cmd == 0x5401) {
            return 0 - ENOTTY;
        }
        return 0 - ENOTTY;
    }
}

// ============================================================
// Syscallハンドラ（関数ポインタとして使われるためモジュールレベル）
// ============================================================

/// syscall エントリ（ASMスタブから呼ばれる）
export long syscall_handler(ulong nr, ulong arg0, ulong arg1, ulong arg2,
ulong arg3, ulong arg4, ulong arg5) {
    // [デバッグ] syscallトレース
    SerialPort trace_serial(COM1);
    trace_serial.puts("[SC] " as void*);
    print_dec(&trace_serial, nr);
    trace_serial.println("" as void*);

    // --- ファイルシステム基本 ---
    if (nr == SYS_READ) {
        return Syscall::read(arg0, arg1, arg2);
    }
    if (nr == SYS_WRITE) {
        return Syscall::write(arg0, arg1, arg2);
    }
    if (nr == SYS_OPEN) {
        return Syscall::open(arg0, arg1);
    }
    if (nr == SYS_CLOSE) {
        return Syscall::close(arg0);
    }
    if (nr == SYS_STAT) {
        // stat(path, buf) → newfstatat(AT_FDCWD, path, buf, 0)
        return SyscallFs::newfstatat(0 - 100, arg0, arg1, 0);
    }
    if (nr == SYS_LSTAT) {
        // lstat(path, buf) → newfstatat(AT_FDCWD, path, buf, AT_SYMLINK_NOFOLLOW)
        return SyscallFs::newfstatat(0 - 100, arg0, arg1, 0x100);
    }
    if (nr == SYS_FSTAT) {
        return SyscallFs::fstat(arg0, arg1);
    }
    if (nr == SYS_LSEEK) {
        return SyscallFs::lseek(arg0, arg1 as long, arg2);
    }
    if (nr == SYS_MMAP) {
        return Syscall::mmap(arg0, arg1, arg2, arg3);
    }
    if (nr == SYS_MPROTECT) {
        return Syscall::do_mprotect(arg0, arg1, arg2);
    }
    if (nr == SYS_MUNMAP) {
        return Syscall::munmap(arg0, arg1);
    }
    if (nr == SYS_BRK) {
        return Syscall::brk(arg0);
    }

    // --- シグナル ---
    if (nr == SYS_RT_SIGACTION) {
        return SyscallProc::rt_sigaction(arg0, arg1, arg2, arg3);
    }
    if (nr == SYS_RT_SIGPROCMASK) {
        return SyscallProc::rt_sigprocmask(arg0, arg1, arg2, arg3);
    }

    // --- ファイルシステム拡張 ---
    if (nr == SYS_IOCTL) {
        return Syscall::do_ioctl(arg0, arg1, arg2);
    }
    if (nr == SYS_PREAD64) {
        return SyscallFs::pread64(arg0, arg1, arg2, arg3);
    }
    if (nr == SYS_PWRITE64) {
        return SyscallFs::pwrite64(arg0, arg1, arg2, arg3);
    }
    if (nr == SYS_READV) {
        return SyscallFs::readv(arg0, arg1, arg2);
    }
    if (nr == SYS_WRITEV) {
        return Syscall::writev(arg0, arg1, arg2);
    }
    if (nr == SYS_ACCESS) {
        return 0 - ENOENT;
    }
    if (nr == SYS_PIPE) {
        return Syscall::do_pipe(arg0);
    }
    if (nr == SYS_DUP) {
        return SyscallFs::dup(arg0);
    }
    if (nr == SYS_DUP2) {
        return Syscall::do_dup2(arg0, arg1);
    }

    // --- タイマー ---
    if (nr == SYS_NANOSLEEP) {
        return SyscallProc::nanosleep(arg0, arg1);
    }

    // --- プロセス ---
    if (nr == SYS_GETPID) {
        return Syscall::getpid();
    }
    if (nr == SYS_GETPPID) {
        return Syscall::getppid();
    }
    if (nr == SYS_EXIT) {
        Syscall::exit(arg0 as long);
        return 0;
    }
    if (nr == SYS_WAIT4) {
        return Syscall::wait4(arg0 as long);
    }
    if (nr == SYS_KILL) {
        return Syscall::kill(arg0, arg1);
    }
    if (nr == SYS_UNAME) {
        return Syscall::uname(arg0);
    }
    if (nr == SYS_GETCWD) {
        return Syscall::getcwd(arg0, arg1);
    }
    if (nr == SYS_CHDIR) {
        return Syscall::chdir(arg0);
    }
    if (nr == SYS_FCNTL) {
        return SyscallFs::fcntl(arg0, arg1, arg2);
    }

    // --- ネットワーク ---
    if (nr == SYS_SOCKET) {
        return SyscallNet::do_socket(arg0, arg1, arg2);
    }
    if (nr == SYS_CONNECT) {
        return SyscallNet::do_connect(arg0, arg1, arg2);
    }
    if (nr == SYS_ACCEPT) {
        return SyscallNet::do_accept(arg0, arg1, arg2);
    }
    if (nr == SYS_SENDTO) {
        return SyscallNet::do_sendto(arg0, arg1, arg2, arg3, arg4, arg5);
    }
    if (nr == SYS_RECVFROM) {
        return SyscallNet::do_recvfrom(arg0, arg1, arg2, arg3, arg4, arg5);
    }
    if (nr == SYS_BIND) {
        return SyscallNet::do_bind(arg0, arg1, arg2);
    }
    if (nr == SYS_LISTEN) {
        return SyscallNet::do_listen(arg0, arg1);
    }
    if (nr == SYS_SETSOCKOPT) {
        return SyscallNet::do_setsockopt(arg0, arg1, arg2, arg3, arg4);
    }
    if (nr == SYS_GETSOCKOPT) {
        return SyscallNet::do_getsockopt(arg0, arg1, arg2, arg3, arg4);
    }

    // --- ユーザー/グループ ---
    if (nr == SYS_GETUID) {
        return SyscallProc::getuid();
    }
    if (nr == SYS_GETGID) {
        return SyscallProc::getgid();
    }
    if (nr == SYS_GETEUID) {
        return SyscallProc::geteuid();
    }
    if (nr == SYS_GETEGID) {
        return SyscallProc::getegid();
    }

    // --- アーキテクチャ固有 ---
    if (nr == SYS_ARCH_PRCTL) {
        return Syscall::arch_prctl(arg0, arg1);
    }
    if (nr == SYS_SET_TID_ADDRESS) {
        return Syscall::set_tid_address(arg0);
    }

    // --- 拡張syscall ---
    if (nr == SYS_GETDENTS64) {
        return SyscallFs::getdents64(arg0, arg1, arg2);
    }
    if (nr == SYS_CLOCK_GETTIME) {
        return SyscallProc::clock_gettime(arg0, arg1);
    }
    if (nr == SYS_EXIT_GROUP) {
        Syscall::exit_group(arg0 as long);
        return 0;
    }
    if (nr == SYS_OPENAT) {
        return SyscallFs::openat(arg0 as long, arg1, arg2, arg3);
    }
    if (nr == SYS_NEWFSTATAT) {
        return SyscallFs::newfstatat(arg0 as long, arg1, arg2, arg3);
    }
    if (nr == SYS_READLINKAT) {
        return SyscallFs::readlinkat(arg0 as long, arg1, arg2, arg3);
    }
    if (nr == SYS_FACCESSAT) {
        return SyscallFs::faccessat(arg0 as long, arg1, arg2, arg3);
    }
    if (nr == SYS_PRLIMIT64) {
        return SyscallProc::prlimit64(arg0, arg1, arg2, arg3);
    }
    if (nr == SYS_GETRANDOM) {
        return SyscallProc::getrandom(arg0, arg1, arg2);
    }

    // --- stub syscall（動作に影響なし、0を返却）---
    if (nr == SYS_SET_ROBUST_LIST) {
        return 0;  // futex robust list（スレッド未対応のため無視）
    }
    if (nr == SYS_RSEQ) {
        return 0;  // restartable sequences（未対応のため無視）
    }

    // 未実装syscall（デバッグログ出力）
    SerialPort serial_dbg(COM1);
    serial_dbg.puts("[WARN] unimplemented syscall: " as void*);
    print_dec(&serial_dbg, nr);
    serial_dbg.println("" as void*);
    return (0 - ENOSYS);
}

/// syscall ASMスタブ（Linux entry_SYSCALL_64 準拠）
/// 参照: linux/arch/x86/entry/entry_64.S
///
/// syscall命令実行時:
///   RCX = ユーザーRIP（戻りアドレス）
///   R11 = ユーザーRFLAGS
///   RAX = syscall番号
///   RDI, RSI, RDX, R10, R8, R9 = 引数0-5
///
/// Cm ABI (x86_64 SysV): RDI, RSI, RDX, RCX, R8, R9
export void syscall_entry_stub() {
    __asm__(`
        // === RSP切り替え: ユーザーRSP → カーネルRSP ===
        movq %rsp, 0x96008;          // SYSCALL_USER_RSP = user RSP
        movq 0x96000, %rsp;          // カーネルRSP → RSP

        // === ユーザーレジスタ全保存 ===
        // sysretqで復帰するもの: RCX(RIP), R11(RFLAGS)
        // カーネルが保存・復帰する義務があるもの: RDI,RSI,RDX,R10,R8,R9,RBX,RBP,R12-R15
        pushq %rcx;                  // [0] RIP
        pushq %r11;                  // [1] RFLAGS
        pushq %rdi;                  // [2] ユーザーRDI
        pushq %rsi;                  // [3] ユーザーRSI
        pushq %rdx;                  // [4] ユーザーRDX
        pushq %r10;                  // [5] ユーザーR10
        pushq %r8;                   // [6] ユーザーR8
        pushq %r9;                   // [7] ユーザーR9
        pushq %rbx;                  // [8] ユーザーRBX
        pushq %rbp;                  // [9] ユーザーRBP
        pushq %r12;                  // [10] ユーザーR12
        pushq %r13;                  // [11] ユーザーR13
        pushq %r14;                  // [12] ユーザーR14
        pushq %r15;                  // [13] ユーザーR15
        pushq %rax;                  // [14] syscall番号

        // === syscall_handler呼び出し準備 ===
        // Cm ABI: syscall_handler(nr, arg0, arg1, arg2, arg3, arg4, arg5)
        //   RDI=nr, RSI=arg0, RDX=arg1, RCX=arg2, R8=arg3, R9=arg4, stack=arg5
        // Linux ABI: RAX=nr, RDI=a0, RSI=a1, RDX=a2, R10=a3, R8=a4, R9=a5

        // スタック上の保存値を参照してCm ABI引数を構築
        // RSP+0 = RAX(nr), RSP+8 = R15, RSP+16 = R14, ...
        // pushq順序: RCX, R11, RDI, RSI, RDX, R10, R8, R9, RBX, RBP, R12, R13, R14, R15, RAX
        // → RSP+0=RAX, RSP+8=R15, RSP+16=R14, RSP+24=R13, RSP+32=R12,
        //   RSP+40=RBP, RSP+48=RBX, RSP+56=R9, RSP+64=R8, RSP+72=R10,
        //   RSP+80=RDX, RSP+88=RSI, RSP+96=RDI, RSP+104=R11, RSP+112=RCX

        movq (%rsp), %rdi;           // nr = RAX (syscall番号)
        movq 96(%rsp), %rsi;         // arg0 = ユーザーRDI
        movq 88(%rsp), %rdx;         // arg1 = ユーザーRSI
        movq 80(%rsp), %rcx;         // arg2 = ユーザーRDX
        movq 72(%rsp), %r8;          // arg3 = ユーザーR10
        movq 64(%rsp), %r9;          // arg4 = ユーザーR8
        pushq 56(%rsp);              // arg5 = ユーザーR9 → スタック

        // 16バイトアラインメント（arg5 push後、合計16push = 128バイト = 16の倍数）
        // push arg5で+8 → 合計15*8+8 = 128 → aligned

        call syscall_handler;

        addq $$8, %rsp;              // arg5 pop

        // === RAX = 戻り値（保持） ===

        // === ユーザーレジスタ全復帰 ===
        addq $$8, %rsp;              // RAX(syscall番号)をスキップ
        popq %r15;
        popq %r14;
        popq %r13;
        popq %r12;
        popq %rbp;
        popq %rbx;
        popq %r9;
        popq %r8;
        popq %r10;
        popq %rdx;
        popq %rsi;
        popq %rdi;
        popq %r11;                   // RFLAGS
        popq %rcx;                   // RIP

        // === RSP復帰 ===
        movq %rsp, 0x96000;          // カーネルRSPを保存
        movq 0x96008, %rsp;          // ユーザーRSPを復元

        sysretq
    `);
}

// 互換ラッパー
export void syscall_init(SerialPort* w) { Syscall::setup(w); }
