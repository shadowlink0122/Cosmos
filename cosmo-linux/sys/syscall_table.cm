export const ulong SYS_DUP3           = 292;
export const ulong SYS_MADVISE        = 28;
export const ulong SYS_UMASK          = 95;
export const ulong SYS_FCHMOD         = 91;
export const ulong SYS_FCHOWN         = 93;
