export const ulong SYS_ACCEPT     = 43;
export const ulong SYS_SENDTO     = 44;
export const ulong SYS_RECVFROM   = 45;
export const ulong SYS_BIND       = 49;
export const ulong SYS_LISTEN     = 50;
export const ulong SYS_SETSOCKOPT = 54;
export const ulong SYS_GETSOCKOPT = 55;
export const ulong SYS_CLONE      = 56;
export const ulong SYS_FORK       = 57;
export const ulong SYS_VFORK      = 58;
export const ulong SYS_EXECVE     = 59;
export const ulong SYS_EXIT       = 60;
export const ulong SYS_WAIT4      = 61;
export const ulong SYS_KILL       = 62;
export const ulong SYS_UNAME      = 63;
export const ulong SYS_FCNTL      = 72;
export const ulong SYS_GETCWD     = 79;
export const ulong SYS_CHDIR      = 80;
export const ulong SYS_MKDIR      = 83;
export const ulong SYS_RMDIR      = 84;
export const ulong SYS_UNLINK     = 87;

// --- ユーザー/グループ ---
export const ulong SYS_GETUID     = 102;
export const ulong SYS_GETGID     = 104;
export const ulong SYS_GETEUID    = 107;
export const ulong SYS_GETEGID    = 108;
export const ulong SYS_GETPPID    = 110;

// --- アーキテクチャ固有 ---
export const ulong SYS_ARCH_PRCTL = 158;

// --- 拡張 ---
export const ulong SYS_GETDENTS64 = 217;
export const ulong SYS_SET_TID_ADDRESS = 218;
export const ulong SYS_CLOCK_GETTIME = 228;
export const ulong SYS_EXIT_GROUP = 231;
export const ulong SYS_OPENAT     = 257;
export const ulong SYS_MKDIRAT    = 258;
export const ulong SYS_NEWFSTATAT = 262;
