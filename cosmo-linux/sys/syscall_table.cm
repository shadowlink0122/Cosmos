//! platform: baremetal-x86
// cosmo-linux::sys::syscall_table - Linux x86_64 syscall 番号定義
//
// Linux互換のsyscall番号テーブル。
// 参照: linux/arch/x86/entry/syscalls/syscall_64.tbl

import ../include/types;

// ============================================================
// Linux x86_64 Syscall 番号
// ============================================================

// --- ファイルシステム ---
export const ulong SYS_READ       = 0;
export const ulong SYS_WRITE      = 1;
export const ulong SYS_OPEN       = 2;
export const ulong SYS_CLOSE      = 3;
export const ulong SYS_STAT       = 4;
export const ulong SYS_FSTAT      = 5;
export const ulong SYS_LSTAT      = 6;
export const ulong SYS_POLL       = 7;
export const ulong SYS_LSEEK      = 8;
export const ulong SYS_MMAP       = 9;
export const ulong SYS_MPROTECT   = 10;
export const ulong SYS_MUNMAP     = 11;
export const ulong SYS_BRK        = 12;
export const ulong SYS_IOCTL      = 16;
export const ulong SYS_PREAD64    = 17;
export const ulong SYS_PWRITE64   = 18;
export const ulong SYS_READV      = 19;
export const ulong SYS_WRITEV     = 20;
export const ulong SYS_ACCESS     = 21;
export const ulong SYS_PIPE       = 22;
export const ulong SYS_DUP        = 32;
export const ulong SYS_DUP2       = 33;

// --- シグナル ---
export const ulong SYS_RT_SIGACTION   = 13;
export const ulong SYS_RT_SIGPROCMASK = 14;

// --- タイマー ---
export const ulong SYS_NANOSLEEP  = 35;

// --- プロセス ---
export const ulong SYS_GETPID     = 39;
export const ulong SYS_SOCKET     = 41;
