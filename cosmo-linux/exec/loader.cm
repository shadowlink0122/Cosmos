//! platform: baremetal-x86
// cosmo-linux::exec::loader - ELF ローダー
//
// RamFS上のELFファイルをメモリにロードし、
// カーネルスレッドとして実行する。
// musl-libc対応: スタック上にargc/argv/envp/auxvを構築。
//
// 参照: linux/fs/binfmt_elf.c

import ../include/types;
import ../include/config;
import ../include/scheduler;
import ../include/page_alloc;
import ../include/vfs;
import ../drivers/serial;
import ../lib/printk;
import ../lib/kstring;
import ../fs/ramfs;
import ../fs/ninepfs;
import ../mm/pmm;
import ../mm/vmm;
import ../sched/process;
import ../sched/scheduler;
import ../arch/x86_64/context;
import ../arch/x86_64/usermode;
import ./elf;

// ============================================================
// ローダー定数
// ============================================================

/// ELFロード先仮想アドレス (ユーザー空間ベース)
const VirtAddr ELF_LOAD_BASE = 0x400000;

/// PIEのロード先ベースアドレス
const VirtAddr PIE_LOAD_BASE = 0x400000;

/// ELFデータ読み込み一時バッファ
const PhysAddr ELF_TMP_BUF = 0x800000;
// ELFバッファ最大サイズ (ELF_TMP_BUF 0x800000 → INO_BASE 0x1000000 = 8MB)
const ulong ELF_MAX_SIZE = 0x800000;

/// ローダー用PMMポインタアドレス
const PhysAddr LOADER_PMM_PTR = 0x95010;

// ============================================================
// Auxiliary Vector (auxv) 定数
// ============================================================

/// AT_NULL: auxv終端
const ulong AT_NULL   = 0;
/// AT_PHDR: プログラムヘッダのアドレス
const ulong AT_PHDR   = 3;
/// AT_PHENT: プログラムヘッダエントリサイズ
const ulong AT_PHENT  = 4;
/// AT_PHNUM: プログラムヘッダ数
const ulong AT_PHNUM  = 5;
/// AT_PAGESZ: ページサイズ
const ulong AT_PAGESZ = 6;
/// AT_ENTRY: エントリポイント
const ulong AT_ENTRY  = 9;
/// AT_UID: 実UID
const ulong AT_UID    = 11;
/// AT_EUID: 実効UID
const ulong AT_EUID   = 12;
/// AT_GID: 実GID
const ulong AT_GID    = 13;
/// AT_EGID: 実効GID
const ulong AT_EGID   = 14;
/// AT_RANDOM: ランダムバイトのアドレス（16バイト）
const ulong AT_RANDOM = 25;

// ============================================================
// Loader struct/impl
// ============================================================

/// Loader — ELFローダー
export struct Loader {}

impl Loader {
    /// ELFファイルをcmdlineからロードしてプロセスとして実行
    /// cmdline: "busybox echo hello" のようなコマンドライン文字列
    /// 先頭ワードをファイル名として検索し、全体をargvとして構築
    /// 戻り値: 新プロセスのPID（失敗時 -1）
    static Pid exec(void* cmdline, SerialPort* w) {
        ulong fsize = 0;
        ulong loaded_from_9p = 0;
        ulong cmd = cmdline as ulong;

        // cmdlineから先頭ワード（ファイル名）の長さを計算
        ulong fname_len = 0;
        while (true) {
            ulong fch = Mem::read_byte(cmd + fname_len);
            if (fch == 0 || fch == 32) { break; }
            fname_len = fname_len + 1;
        }
        if (fname_len == 0) {
            pr_err(w, "exec: empty command" as void*);
            return 0 - 1;
        }

        // ファイル名をNULL終端の一時バッファにコピー（検索用）
        ulong fname_buf = 0x95200;  // 一時バッファ
        ulong fi_copy = 0;
        while (fi_copy < fname_len) {
            Mem::write_byte(fname_buf + fi_copy, Mem::read_byte(cmd + fi_copy));
            fi_copy = fi_copy + 1;
        }
        Mem::write_byte(fname_buf + fname_len, 0);  // NULL終端

        // RamFSからファイル検索
        Ino ino = RamFs::lookup(fname_buf as void*);
        if (ino != 0) {
            fsize = RamFs::file_size(ino);
            if (fsize < 64) {
                pr_err(w, "exec: file too small for ELF" as void*);
                return 0 - 1;
            }
            long bytes = RamFs::read(ino, ELF_TMP_BUF, 0, fsize);
            if (bytes <= 0) {
                pr_err(w, "exec: failed to read file" as void*);
                return 0 - 1;
            }
        } else {
            // 9pフォールバック
            ulong bytes_9p = NinePfs::read_file(fname_buf, ELF_TMP_BUF, ELF_MAX_SIZE);
            if (bytes_9p == 0) {
                pr_err(w, "exec: file not found (ramfs/9p)" as void*);
                return 0 - 1;
            }
            fsize = bytes_9p;
            loaded_from_9p = 1;
            w->puts("[INFO] Loaded from 9p: " as void*);
            print_dec(w, fsize);
            w->println(" bytes" as void*);
        }

        // ELFヘッダ検証
        if (Elf::validate(ELF_TMP_BUF) == 0) {
            pr_err(w, "exec: invalid ELF64 binary" as void*);
            return 0 - 1;
        }

        // エントリポイント取得
        ulong entry = Elf::get_entry(ELF_TMP_BUF);
        ulong phoff = Elf::get_phoff(ELF_TMP_BUF);
        ulong phentsize = Elf::get_phentsize(ELF_TMP_BUF);
        ulong phnum = Elf::get_phnum(ELF_TMP_BUF);

        // セグメント末尾を追跡（brk初期値用）
        ulong data_end = 0;

        // PIEの場合、ベースアドレスオフセットを計算
        ulong load_bias = 0;
        if (Elf::is_pie(ELF_TMP_BUF) != 0) {
            load_bias = PIE_LOAD_BASE;
            entry = entry + load_bias;
        }

        w->puts("[INFO] ELF entry=0x" as void*);
        w->print_hex(entry);
        w->puts(" phnum=" as void*);
        print_dec(w, phnum);
        if (load_bias != 0) {
            w->puts(" PIE bias=0x" as void*);
            w->print_hex(load_bias);
        }
        w->println("" as void*);

        // PMMを取得
        ulong* pmm_ptr = LOADER_PMM_PTR as ulong*;
        BuddyAllocator* pmm = (*pmm_ptr) as BuddyAllocator*;

        // CR3取得
        ulong cr3 = 0;
        __asm__(`movq %cr3, %rax; movq %rax, ${=r:cr3}`);
        PageTable pt(cr3);

        // PHDRのユーザー空間アドレス記録用
        ulong phdr_addr = 0;

        // PT_LOADセグメントをメモリにロード
        ulong i = 0;
        while (i < phnum) {
            ulong ph_addr = ELF_TMP_BUF + phoff + i * phentsize;
            ulong p_type = Elf::ph_type(ph_addr);


            if (p_type == PT_LOAD) {
                ulong p_offset = Elf::ph_offset(ph_addr);
                ulong p_vaddr  = Elf::ph_vaddr(ph_addr) + load_bias;
                ulong p_filesz = Elf::ph_filesz(ph_addr);
                ulong p_memsz  = Elf::ph_memsz(ph_addr);

                // 最初のPT_LOADにPHDRが含まれるか確認
                if (phdr_addr == 0 && p_offset == 0) {
                    phdr_addr = p_vaddr + phoff;
                }

                // ページマッピング
                ulong page_start = p_vaddr & ~0xFFF;
                ulong page_end = (p_vaddr + p_memsz + 0xFFF) & ~0xFFF;
                ulong page = page_start;
                while (page < page_end) {
                    PhysAddr phys_page = pmm->alloc_pages(0);
                    if (phys_page != 0) {
                        memzero(phys_page as void*, PAGE_SIZE);
                        // ユーザープロセス用: PRESENT | WRITE | USER = 7
                        pt.map_page(page, phys_page, 7, pmm);
                    }
                    page = page + PAGE_SIZE;
                }

                // ファイルデータをコピー
                ulong src = ELF_TMP_BUF + p_offset;
                ulong dst = p_vaddr;
                ulong j = 0;
                while (j < p_filesz) {
                    ulong byte_val = 0;
                    ulong s = src + j;
                    __asm__(`
                        movq ${r:s}, %rdi;
                        xorq %rax, %rax;
                        movb (%rdi), %al;
                        movq %rax, ${=r:byte_val}
                    `);
                    ulong d = dst + j;
                    __asm__(`
                        movq ${r:d}, %rdi;
                        movq ${r:byte_val}, %rax;
                        movb %al, (%rdi)
                    `);
                    j = j + 1;
                }

                w->puts("[INFO] Loaded segment: vaddr=0x" as void*);
                w->print_hex(p_vaddr);
                w->puts(" size=" as void*);
                print_dec(w, p_filesz);
                w->println("" as void*);

                // data_end を更新
                ulong seg_end = p_vaddr + p_memsz;
                if (seg_end > data_end) { data_end = seg_end; }
            }
            i = i + 1;
        }

        // data_endをページアラインメント
        data_end = (data_end + 0xFFF) & ~0xFFF;

        // プロセス作成
        Pid new_pid = ProcessTable::alloc_pid();
        // プロセス用メモリ確保（固定アドレスに配置）
        PhysAddr proc_mem = pmm->alloc_pages(0);
        if (proc_mem == 0) {
            pr_err(w, "exec: failed to allocate process memory" as void*);
            return 0 - 1;
        }
        memzero(proc_mem as void*, PAGE_SIZE);
        Process* proc = proc_mem as Process*;
        Process new_proc(new_pid, 1);  // parent=shell(PID 1)
        // 構造体コピー
        ulong k = 0;
        while (k < 16) {
            ulong* src_f = (((&new_proc) as ulong) + k * 8) as ulong*;
            ulong* dst_f = (proc_mem + k * 8) as ulong*;
            *dst_f = *src_f;
            k = k + 1;
        }

        // カーネルスタック割り当て
        proc->alloc_stack(pmm);
        proc->page_table = cr3;

        // ユーザースタック確保 (2ページ = 8KiB)
        proc->is_user = 1;
        proc->user_stack = Usermode::alloc_user_stack();

        // brk初期値をDATAセグメント末尾に設定
        // musl-libcのbrk(0)でヒープ開始アドレスとして返却される
        proc->brk_addr = data_end;

        // ============================================================
        // ユーザースタック上にargc/argv/envp/auxvを構築
        // cmdlineをスペースで分割して動的にargv[]を構築
        //
        // [高アドレス = スタックトップ]
        //   ランダムバイト (16B, AT_RANDOM用)
        //   argv文字列群 (各引数のNUL終端文字列)
        //   auxv[]: { AT_PAGESZ:4096, ... AT_NULL:0 }
        //   envp[0] = NULL
        //   argv[argc] = NULL
        //   argv[argc-1] → 文字列ポインタ
        //   ...
        //   argv[0] → 文字列ポインタ
        //   argc
        // [低アドレス = RSP]
        // ============================================================

        ulong sp = proc->user_stack;

        // --- ランダムバイト (16バイト) ---
        sp = sp - 16;
        ulong random_addr = sp;
        ulong ri = 0;
        while (ri < 16) {
            ulong val = (ri * 7 + 0x42) & 0xFF;
            ulong ra = random_addr + ri;
            __asm__(`movq ${r:ra}, %rdi; movq ${r:val}, %rax; movb %al, (%rdi)`);
            ri = ri + 1;
        }

        // --- cmdlineをスペースで分割し、各引数文字列をスタックにコピー ---
        // argv_strsにポインタを記録（最大16引数）
        ulong argv_strs_buf = 0x95300;  // 一時ポインタ配列(16*8=128B)
        ulong argc_val = 0;
        ulong ci = 0;
        while (argc_val < 16) {
            // 先頭スペースをスキップ
            while (Mem::read_byte(cmd + ci) == 32) { ci = ci + 1; }
            ulong ch = Mem::read_byte(cmd + ci);
            if (ch == 0) { break; }

            // 引数の開始位置
            ulong arg_start = ci;
            // 引数の終了位置を探す
            while (true) {
                ch = Mem::read_byte(cmd + ci);
                if (ch == 0 || ch == 32) { break; }
                ci = ci + 1;
            }
            ulong arg_len = ci - arg_start;

            // 引数文字列をスタックにコピー
            sp = sp - (arg_len + 1);
            sp = sp & ~7;  // 8バイトアラインメント
            ulong arg_str = sp;
            ulong ai = 0;
            while (ai < arg_len) {
                ulong src_ch = Mem::read_byte(cmd + arg_start + ai);
                ulong dst_a = arg_str + ai;
                __asm__(`movq ${r:dst_a}, %rdi; movq ${r:src_ch}, %rax; movb %al, (%rdi)`);
                ai = ai + 1;
            }
            // NUL終端
            ulong nul_a = arg_str + arg_len;
            __asm__(`movq ${r:nul_a}, %rdi; xorq %rax, %rax; movb %al, (%rdi)`);

            // ポインタを記録
            ulong* argv_slot = (argv_strs_buf + argc_val * 8) as ulong*;
            *argv_slot = arg_str;
            argc_val = argc_val + 1;
        }

        // --- auxiliary vector (auxv) ---
        // 16バイトアラインメント
        sp = sp & ~15;

        // AT_NULL = 終端
        sp = sp - 16;
        Loader::write_auxv(sp, 0, AT_NULL, 0);
        // AT_RANDOM
        sp = sp - 16;
        Loader::write_auxv(sp, 0, AT_RANDOM, random_addr);
        // AT_PHNUM
        sp = sp - 16;
        Loader::write_auxv(sp, 0, AT_PHNUM, phnum);
        // AT_PHENT
        sp = sp - 16;
        Loader::write_auxv(sp, 0, AT_PHENT, phentsize);
        // AT_PHDR
        sp = sp - 16;
        Loader::write_auxv(sp, 0, AT_PHDR, phdr_addr);
        // AT_ENTRY
        sp = sp - 16;
        Loader::write_auxv(sp, 0, AT_ENTRY, entry);
        // AT_EGID
        sp = sp - 16;
        Loader::write_auxv(sp, 0, AT_EGID, 0);
        // AT_GID
        sp = sp - 16;
        Loader::write_auxv(sp, 0, AT_GID, 0);
        // AT_EUID
        sp = sp - 16;
        Loader::write_auxv(sp, 0, AT_EUID, 0);
        // AT_UID
        sp = sp - 16;
        Loader::write_auxv(sp, 0, AT_UID, 0);
        // AT_PAGESZ
        sp = sp - 16;
        Loader::write_auxv(sp, 0, AT_PAGESZ, 4096);

        // --- envp[0] = NULL ---
        sp = sp - 8;
        ulong* envp_null = sp as ulong*;
        *envp_null = 0;

        // --- argv[argc] = NULL ---
        sp = sp - 8;
        ulong* argv_null = sp as ulong*;
        *argv_null = 0;

        // --- argv[argc-1] ... argv[0] (逆順push) ---
        ulong argi = argc_val;
        while (argi > 0) {
            argi = argi - 1;
            sp = sp - 8;
            ulong* argv_ptr = sp as ulong*;
            ulong* argv_src = (argv_strs_buf + argi * 8) as ulong*;
            *argv_ptr = *argv_src;
        }

        // --- argc ---
        sp = sp - 8;
        ulong* argc_ptr = sp as ulong*;
        *argc_ptr = argc_val;

        // ユーザースタックを構築済みのSPに更新
        proc->user_stack = sp;

        // syscall用カーネルRSPを設定（Ring3→Ring0のRSP切り替え用）
        ulong* syscall_krsp = 0x96000 as ulong*;
        *syscall_krsp = proc->kernel_stack;

        // コンテキスト初期化（iretqでRing3+ユーザーRSPに直接遷移）
        Context::init_user_task(proc, proc->kernel_stack, entry, sp);

        // スケジューラに登録
        Sched::add(proc);

        w->puts("[INFO] Process created: PID=" as void*);
        print_dec(w, new_pid as ulong);
        w->puts(" entry=0x" as void*);
        w->print_hex(entry);
        w->puts(" sp=0x" as void*);
        w->print_hex(sp);
        w->println("" as void*);

        return new_pid;
    }

    /// auxvエントリを書き込むヘルパ
    static void write_auxv(ulong base, ulong index, ulong atype, ulong value) {
        ulong offset = index * 16;
        ulong* type_ptr = (base + offset) as ulong*;
        ulong* val_ptr = (base + offset + 8) as ulong*;
        *type_ptr = atype;
        *val_ptr = value;
    }
}
