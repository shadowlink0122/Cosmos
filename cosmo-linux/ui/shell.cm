impl Mem {
    static ulong read_byte(ulong addr) {
        ulong val = 0;
        __asm__(`movq ${r:addr}, %r10; xorq %rax,%rax; movzbl (%r10),%eax; movq %rax, ${=r:val}`);
        return val;
    }

    static void write_byte(ulong addr, ulong val) {
        __asm__(`movq ${r:addr}, %r10; movq ${r:val}, %rax; movb %al, (%r10)`);
    }

    static void write_qword(ulong addr, ulong val) {
        __asm__(`movq ${r:addr}, %r10; movq ${r:val}, %rax; movq %rax, (%r10)`);
    }

    static ulong read_qword(ulong addr) {
        ulong val = 0;
        __asm__(`movq ${r:addr}, %r10; movq (%r10), %rax; movq %rax, ${=r:val}`);
        return val;
    }

    /// 文字列比較 (辞書順): 負=s1<s2, 0=等しい, 正=s1>s2
    static long strcmp(void* s1, void* s2) {
        ulong a = s1 as ulong;
        ulong b = s2 as ulong;
        ulong i = 0;
        while (true) {
            ulong c1 = Mem::read_byte(a + i);
            ulong c2 = Mem::read_byte(b + i);
            if (c1 != c2) {
                if (c1 < c2) { return 0 - 1; }
                return 1;
            }
            if (c1 == 0) { return 0; }
            i = i + 1;
        }
        return 0;
    }

}

impl Vga {
    /// 指定位置に文字を書き込み
    static void write_at(ulong row, ulong col, ulong ch, ulong color) {
        ulong offset = (row * VGA_COLS + col) * 2;
        Mem::write_byte(VGA_BUF + offset, ch & 0xFF);
        Mem::write_byte(VGA_BUF + offset + 1, color & 0xFF);
    }

    /// カーソル更新
    static void update_cursor() {
        ulong* col_ptr = SH_VGA_COL_ADDR as ulong*;
        ulong* row_ptr = SH_VGA_ROW_ADDR as ulong*;
        ulong pos = (*row_ptr) * VGA_COLS + (*col_ptr);
        outb(0x3D4, 0x0E);
        outb(0x3D5, (pos >> 8) & 0xFF);
        outb(0x3D4, 0x0F);
        outb(0x3D5, pos & 0xFF);
    }

    /// 1行スクロール
    static void scroll() {
        ulong r = 1;
        while (r < VGA_ROWS) {
            ulong c = 0;
            while (c < VGA_COLS) {
                ulong src_off = (r * VGA_COLS + c) * 2;
                ulong dst_off = ((r - 1) * VGA_COLS + c) * 2;
                ulong ch_val = Mem::read_byte(VGA_BUF + src_off);
                ulong at_val = Mem::read_byte(VGA_BUF + src_off + 1);
                Mem::write_byte(VGA_BUF + dst_off, ch_val);
                Mem::write_byte(VGA_BUF + dst_off + 1, at_val);
                c = c + 1;
            }
            r = r + 1;
        }
        ulong* color_ptr = SH_VGA_COLOR_ADDR as ulong*;
        ulong c = 0;
        while (c < VGA_COLS) {
            Vga::write_at(VGA_ROWS - 1, c, 32, *color_ptr);
            c = c + 1;
        }
    }

    /// 改行
    static void newline() {
        ulong* col_ptr = SH_VGA_COL_ADDR as ulong*;
        ulong* row_ptr = SH_VGA_ROW_ADDR as ulong*;
        *col_ptr = 0;
        ulong row = *row_ptr + 1;
        if (row >= VGA_ROWS) {
            Vga::scroll();
            row = VGA_ROWS - 1;
        }
        *row_ptr = row;
    }

    /// 1文字出力
    static void putc(ulong ch) {
        ulong* col_ptr = SH_VGA_COL_ADDR as ulong*;
        ulong* row_ptr = SH_VGA_ROW_ADDR as ulong*;
        ulong* color_ptr = SH_VGA_COLOR_ADDR as ulong*;

        if (ch == 10) {
            Vga::newline();
        } else if (ch == 8) {
            ulong col = *col_ptr;
            if (col > 0) {
                *col_ptr = col - 1;
                Vga::write_at(*row_ptr, col - 1, 32, *color_ptr);
            }
        } else if (ch >= 32) {
            Vga::write_at(*row_ptr, *col_ptr, ch, *color_ptr);
            ulong col = *col_ptr + 1;
            if (col >= VGA_COLS) {
                Vga::newline();
            } else {
                *col_ptr = col;
            }
        }
        Vga::update_cursor();
    }

    /// 文字列出力
    static void puts(void* msg) {
        ulong addr = msg as ulong;
        ulong i = 0;
        while (true) {
            ulong byte_val = Mem::read_byte(addr + i);
            if (byte_val == 0) { return; }
            Vga::putc(byte_val);
            i = i + 1;
        }
    }

    /// 画面クリア
    static void clear_screen() {
        ulong* color_ptr = SH_VGA_COLOR_ADDR as ulong*;
        ulong r = 0;
        while (r < VGA_ROWS) {
            ulong c = 0;
            while (c < VGA_COLS) {
                Vga::write_at(r, c, 32, *color_ptr);
                c = c + 1;
            }
            r = r + 1;
        }
        ulong* col_ptr = SH_VGA_COL_ADDR as ulong*;
        ulong* row_ptr = SH_VGA_ROW_ADDR as ulong*;
        *col_ptr = 0;
        *row_ptr = 0;
        Vga::update_cursor();
    }

}

impl Shell {
    static void putc(ulong ch) {
        Vga::putc(ch);
        ulong* ser_ptr = SHELL_SERIAL_ADDR as ulong*;
        SerialPort* ser = (*ser_ptr) as SerialPort*;
        ser->putc(ch);
    }

    static void write(void* msg) {
        Vga::puts(msg);
        ulong* ser_ptr = SHELL_SERIAL_ADDR as ulong*;
        SerialPort* ser = (*ser_ptr) as SerialPort*;
        ser->puts(msg);
    }

    static void writeln(void* msg) {
        Shell::write(msg);
        Shell::putc(10);
    }

    static void set_color(ulong fg, ulong bg) {
        ulong* color_ptr = SH_VGA_COLOR_ADDR as ulong*;
        *color_ptr = ((bg & 0x0F) << 4) | (fg & 0x0F);
    }

    static void print_dec(ulong value) {
        ulong* ser_ptr = SHELL_SERIAL_ADDR as ulong*;
        SerialPort* ser = (*ser_ptr) as SerialPort*;
        if (value == 0) {
            Vga::putc(48);
            ser->putc(48);
            return;
        }
        ulong buf0 = 0;
        ulong buf1 = 0;
        ulong buf2 = 0;
        ulong buf3 = 0;
        ulong buf4 = 0;
        ulong buf5 = 0;
        ulong buf6 = 0;
        ulong buf7 = 0;
        ulong buf8 = 0;
        ulong buf9 = 0;
        ulong count = 0;
        ulong tmp = value;
        while (tmp != 0) {
            ulong digit = tmp % 10;
            if (count == 0) { buf0 = digit; }
            if (count == 1) { buf1 = digit; }
            if (count == 2) { buf2 = digit; }
            if (count == 3) { buf3 = digit; }
            if (count == 4) { buf4 = digit; }
            if (count == 5) { buf5 = digit; }
            if (count == 6) { buf6 = digit; }
            if (count == 7) { buf7 = digit; }
            if (count == 8) { buf8 = digit; }
            if (count == 9) { buf9 = digit; }
            tmp = tmp / 10;
            count = count + 1;
        }
        ulong i = count;
        while (i != 0) {
            i = i - 1;
            ulong d = 0;
            if (i == 0) { d = buf0; }
            if (i == 1) { d = buf1; }
            if (i == 2) { d = buf2; }
            if (i == 3) { d = buf3; }
            if (i == 4) { d = buf4; }
            if (i == 5) { d = buf5; }
            if (i == 6) { d = buf6; }
            if (i == 7) { d = buf7; }
            if (i == 8) { d = buf8; }
            if (i == 9) { d = buf9; }
            Vga::putc(d + 48);
            ser->putc(d + 48);
        }
    }

    /// 1バイトぢ16進表示 (2桁)
    static void print_hex_byte(ulong val) {
        ulong hi = (val >> 4) & 0xF;
        ulong lo = val & 0xF;
        if (hi < 10) { Shell::putc(48 + hi); } else { Shell::putc(87 + hi); }
        if (lo < 10) { Shell::putc(48 + lo); } else { Shell::putc(87 + lo); }
    }

    /// 16進表示 (8桁)
    static void print_hex(ulong val) {
        ulong i = 0;
        while (i < 8) {
            ulong shift = (7 - i) * 4;
            ulong nibble = (val >> shift) & 0xF;
            if (nibble < 10) { Shell::putc(48 + nibble); } else { Shell::putc(87 + nibble); }
            i = i + 1;
        }
    }

}

impl Env {
    /// 環境変数初期化
    static void setup() {
        memzero(ENV_TABLE as void*, ENV_MAX * ENV_ENTRY_SIZE);
        // デフォルト変数設定
        Env::set("HOME" as void*, "/" as void*);
        Env::set("SHELL" as void*, "/bin/sh" as void*);
        Env::set("PATH" as void*, "/bin:/usr/bin" as void*);
    }

    /// 環境変数設定
    static void set(void* key, void* val) {
        ulong k_addr = key as ulong;
        ulong v_addr = val as ulong;
        // 既存エントリを検索
        ulong i = 0;
        while (i < ENV_MAX) {
            ulong entry = ENV_TABLE + i * ENV_ENTRY_SIZE;
            ulong first = Mem::read_byte(entry);
            if (first != 0) {
                if (streq(entry as void*, key) != 0) {
                    // 値を更新
                    ulong vdest = entry + ENV_KEY_LEN;
                    ulong j = 0;
                    while (j < ENV_VAL_LEN - 1) {
                        ulong c = Mem::read_byte(v_addr + j);
                        Mem::write_byte(vdest + j, c);
                        if (c == 0) { break; }
                        j = j + 1;
                    }
                    Mem::write_byte(vdest + j, 0);
                    return;
                }
            }
            i = i + 1;
        }
        // 空きエントリに追加
        i = 0;
        while (i < ENV_MAX) {
            ulong entry = ENV_TABLE + i * ENV_ENTRY_SIZE;
            if (Mem::read_byte(entry) == 0) {
                // キーコピー
                ulong j = 0;
                while (j < ENV_KEY_LEN - 1) {
                    ulong c = Mem::read_byte(k_addr + j);
                    Mem::write_byte(entry + j, c);
                    if (c == 0) { break; }
                    j = j + 1;
                }
                Mem::write_byte(entry + j, 0);
                // 値コピー
                ulong vdest = entry + ENV_KEY_LEN;
                j = 0;
                while (j < ENV_VAL_LEN - 1) {
                    ulong c = Mem::read_byte(v_addr + j);
                    Mem::write_byte(vdest + j, c);
                    if (c == 0) { break; }
                    j = j + 1;
                }
                Mem::write_byte(vdest + j, 0);
                return;
            }
            i = i + 1;
        }
    }

    /// 環境変数取得 (見つからない場合は0を返す)
    static ulong get(void* key) {
        ulong i = 0;
        while (i < ENV_MAX) {
            ulong entry = ENV_TABLE + i * ENV_ENTRY_SIZE;
            if (Mem::read_byte(entry) != 0) {
                if (streq(entry as void*, key) != 0) {
                    return entry + ENV_KEY_LEN;
                }
            }
            i = i + 1;
        }
        return 0;
    }

}

impl History {
    /// 履歴初期化
    static void setup() {
        memzero(HIST_BASE as void*, HIST_MAX * HIST_ENTRY_SIZE);
        ulong* count = HIST_COUNT as ulong*;
        *count = 0;
        ulong* index = HIST_INDEX as ulong*;
        *index = 0;
    }

    /// コマンドを履歴に追加
    static void add(ulong cmd_addr, ulong len) {
        if (len == 0) { return; }
        ulong* count = HIST_COUNT as ulong*;
        ulong idx = *count % HIST_MAX;
        ulong dest = HIST_BASE + idx * HIST_ENTRY_SIZE;
        // コピー
        ulong i = 0;
        while (i < len) {
            if (i < HIST_ENTRY_SIZE - 1) {
                ulong ch = Mem::read_byte(cmd_addr + i);
                Mem::write_byte(dest + i, ch);
            }
            i = i + 1;
        }
        Mem::write_byte(dest + len, 0);
        *count = *count + 1;
    }

    /// 履歴から取得（最新からoffset番目: 0=最新）
    /// 戻り値: 履歴エントリのアドレス。0なら範囲外。
    static ulong get(ulong offset) {
        ulong* count = HIST_COUNT as ulong*;
        if (*count == 0) { return 0; }
        if (offset >= *count) { return 0; }
        if (offset >= HIST_MAX) { return 0; }
        ulong actual = (*count - 1 - offset) % HIST_MAX;
        return HIST_BASE + actual * HIST_ENTRY_SIZE;
    }

    /// 履歴エントリをコマンドバッファにコピーして表示
    static void restore(ulong hist_addr) {
        // 現在の入力をクリア
        ulong* len_ptr = CMD_LEN_ADDR as ulong*;
        ulong old_len = *len_ptr;
        // バックスペースで消去
        ulong k = 0;
        while (k < old_len) {
            Vga::putc(8);
            k = k + 1;
        }
        // 履歴コピー
        ulong i = 0;
        while (true) {
            ulong ch = Mem::read_byte(hist_addr + i);
            if (ch == 0) { break; }
            Mem::write_byte(CMD_BUF_ADDR + i, ch);
            Shell::putc(ch);
            i = i + 1;
        }
        *len_ptr = i;
    }

}

/// 2つの文字列を比較
ulong streq(void* a_ptr, void* b_ptr) {
    ulong a_addr = a_ptr as ulong;
    ulong b_addr = b_ptr as ulong;
    ulong i = 0;
    while (true) {
        ulong ca = Mem::read_byte(a_addr + i);
        ulong cb = Mem::read_byte(b_addr + i);
        if (ca != cb) { return 0; }
        if (ca == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

/// 文字列が指定プレフィックスで始まるか確認
ulong startswith(void* str, void* prefix) {
    ulong s_addr = str as ulong;
    ulong p_addr = prefix as ulong;
    ulong i = 0;
    while (true) {
        ulong pc = Mem::read_byte(p_addr + i);
        if (pc == 0) { return 1; }
        ulong sc = Mem::read_byte(s_addr + i);
        if (sc != pc) { return 0; }
        i = i + 1;
    }
    return 0;
}

impl Cmd {

    static void help() {
        Shell::set_color(11, 0);
        Shell::writeln("=== Cosmo Linux Shell (Ctrl+C: cancel) ===" as void*);
        Shell::set_color(7, 0);
        Shell::writeln("  help ps free uptime uname date clear reboot" as void*);
        Shell::writeln("  ls cat touch write cp mv rm mkdir head wc hexdump" as void*);
        Shell::writeln("  echo cd pwd grep sort env export cmd>file" as void*);
        Shell::writeln("  [Up/Down]=history Ctrl+C=cancel Ctrl+L=clear" as void*);
    }

    static void ps() {
        Shell::writeln("" as void*);
        Shell::writeln("  PID  STATE    NAME" as void*);
        Shell::writeln("  ---  -------  --------" as void*);

        ulong* sched_ptr_addr = 0x91000 as ulong*;
        RoundRobinScheduler* sched = (*sched_ptr_addr) as RoundRobinScheduler*;

        ulong i = 0;
        while (i < sched->count) {
            ulong proc_addr = sched->get_proc(i);
            if (proc_addr != 0) {
                Process* proc = proc_addr as Process*;
                Shell::write("  " as void*);
                Shell::print_dec(proc->pid as ulong);
                Shell::write("    " as void*);

                if (proc->state == TASK_RUNNING) {
                    Shell::write("RUNNING  " as void*);
                }
                if (proc->state == TASK_READY) {
                    Shell::write("READY    " as void*);
                }
                if (proc->state == TASK_BLOCKED) {
                    Shell::write("BLOCKED  " as void*);
                }
                if (proc->state == TASK_ZOMBIE) {
                    Shell::write("ZOMBIE   " as void*);
                }

                if (proc->pid == 0) { Shell::writeln("idle" as void*); }
                if (proc->pid == 1) { Shell::writeln("shell" as void*); }
                if (proc->pid > 1) { Shell::writeln("task" as void*); }
            }
            i = i + 1;
        }
        Shell::writeln("" as void*);
    }

    static void free_mem() {
        ulong* pmm_addr_ptr = SHELL_PMM_ADDR as ulong*;
        BuddyAllocator* pmm = (*pmm_addr_ptr) as BuddyAllocator*;
        ulong total = pmm->total_pages;
        ulong free_p = pmm->free_pages;
        ulong used = total - free_p;
        Shell::writeln("" as void*);
        Shell::write("  Total:  " as void*);
        Shell::print_dec(total * 4);
        Shell::writeln(" KiB" as void*);
        Shell::write("  Used:   " as void*);
        Shell::print_dec(used * 4);
        Shell::writeln(" KiB" as void*);
        Shell::write("  Free:   " as void*);
        Shell::print_dec(free_p * 4);
        Shell::writeln(" KiB" as void*);
        Shell::writeln("" as void*);
    }

    static void uptime() {
        ulong ticks = PIT::get_ticks();
        ulong seconds = ticks / 100;
        ulong minutes = seconds / 60;
        ulong secs = seconds % 60;
        Shell::writeln("" as void*);
        Shell::write("  Uptime: " as void*);
        Shell::print_dec(minutes);
        Shell::write("m " as void*);
        Shell::print_dec(secs);
        Shell::writeln("s" as void*);
        Shell::write("  Ticks:  " as void*);
        Shell::print_dec(ticks);
        Shell::writeln("" as void*);
        Shell::writeln("" as void*);
    }

    static void reboot() {
        Shell::writeln("Rebooting..." as void*);
        outb(0x64, 0xFE);
        __asm__(`cli; 1: hlt; jmp 1b`);
    }

    /// コマンドバッファから最初のスペース以降の引数アドレスを取得
    /// 戻り値: 引数の開始アドレス（0なら引数なし）
    static ulong arg(ulong buf_addr) {
        ulong i = 0;
        // 最初のスペースを探す
        while (true) {
            ulong ch = Mem::read_byte(buf_addr + i);
            if (ch == 0) { return 0; }  // 引数なし
            if (ch == 32) {
                // スペース後の非スペースを探す
                while (true) {
                    i = i + 1;
                    ulong ch2 = Mem::read_byte(buf_addr + i);
                    if (ch2 == 0) { return 0; }
                    if (ch2 != 32) {
                        return buf_addr + i;
                    }
                }
            }
            i = i + 1;
        }
        return 0;
    }

    /// 第2引数（第1引数の後のスペース以降）のアドレスを取得
    static ulong arg2(ulong buf_addr) {
        ulong first = Cmd::arg(buf_addr);
        if (first == 0) { return 0; }
        return Cmd::arg(first);
    }

    /// ls コマンド: ファイル一覧表示
    static void ls() {
        ulong count = RamFs::dir_count();
        Shell::writeln("" as void*);
        if (count == 0) {
            Shell::writeln("  (no files)" as void*);
        } else {
            ulong i = 0;
            while (i < count) {
                ulong name_addr = RamFs::dir_name(i);
                if (name_addr != 0) {
                    ulong dtype = RamFs::dir_type(i);
                    Ino ino = RamFs::dir_ino(i);
                    Shell::write("  " as void*);

                    // ディレクトリは色変更
                    if (dtype == S_IFDIR) {
                        Shell::set_color(11, 0);  // 黄色
                        Shell::write(name_addr as void*);
                        Shell::write("/" as void*);
                        Shell::set_color(7, 0);
                    } else {
                        // ファイルサイズ表示
                        Shell::write(name_addr as void*);
                        ulong fsize = RamFs::file_size(ino);
                        Shell::write("  (" as void*);
                        Shell::print_dec(fsize);
                        Shell::write(" bytes)" as void*);
                    }
                    Shell::putc(10);
                }
                i = i + 1;
            }
        }
        Shell::writeln("" as void*);
    }

    /// cat コマンド: ファイル内容表示
    static void cat(ulong name_addr) {
        if (name_addr == 0) {
            Shell::writeln("Usage: cat <filename>" as void*);
            return;
        }

        // /proc/ パスの処理
        if (startswith(name_addr as void*, "/proc/" as void*) != 0) {
            ulong proc_name = name_addr + 6;  // "/proc/" の後
            ulong read_buf = 0x94100;
            ulong bytes = ProcFs::read_file(proc_name as void*, read_buf);
            if (bytes > 0) {
                Shell::writeln(read_buf as void*);
            } else {
                Shell::write("cat: unknown proc file: " as void*);
                Shell::writeln(proc_name as void*);
            }
            return;
        }

        Ino ino = RamFs::lookup(name_addr as void*);
        if (ino == 0) {
            Shell::write("cat: file not found: " as void*);
            Shell::writeln(name_addr as void*);
            return;
        }

        ulong fsize = RamFs::file_size(ino);
        if (fsize == 0) {
            Shell::writeln("(empty file)" as void*);
            return;
        }

        // 読み出しバッファ: CMD_BUFの後半を使用 (0x94100)
        ulong read_buf = 0x94100;
        long bytes_read = RamFs::read(ino, read_buf, 0, fsize);
        if (bytes_read > 0) {
            // ヌル終端して出力
            Mem::write_byte(read_buf + (bytes_read as ulong), 0);
            Shell::writeln(read_buf as void*);
        }
    }

    /// touch コマンド: 空ファイル作成
    static void touch(ulong name_addr) {
        if (name_addr == 0) {
            Shell::writeln("Usage: touch <filename>" as void*);
            return;
        }

        ulong* pmm_addr_ptr = SHELL_PMM_ADDR as ulong*;
        BuddyAllocator* pmm = (*pmm_addr_ptr) as BuddyAllocator*;
        ulong data_page = pmm->alloc_pages(0);
        if (data_page != 0) {
            memzero(data_page as void*, PAGE_SIZE);
        }

        Ino ino = RamFs::create(name_addr as void*, S_IFREG | 0x1B6, data_page);
        if (ino == 0) {
            Shell::writeln("touch: failed to create file" as void*);
        } else {
            Shell::write("Created: " as void*);
            Shell::writeln(name_addr as void*);
        }
    }

    /// write コマンド: ファイルにテキスト書き込み
    static void write_file(ulong name_addr, ulong text_addr) {
        if (name_addr == 0) {
            Shell::writeln("Usage: write <filename> <text>" as void*);
            return;
        }
        if (text_addr == 0) {
            Shell::writeln("Usage: write <filename> <text>" as void*);
            return;
        }

        // ファイルがなければ作成
        ulong* pmm_addr_ptr = SHELL_PMM_ADDR as ulong*;
        BuddyAllocator* pmm = (*pmm_addr_ptr) as BuddyAllocator*;
        ulong data_page = pmm->alloc_pages(0);
        if (data_page != 0) {
            memzero(data_page as void*, PAGE_SIZE);
        }
        Ino ino = RamFs::create(name_addr as void*, S_IFREG | 0x1B6, data_page);
        if (ino == 0) {
            Shell::writeln("write: failed to create file" as void*);
            return;
        }

        // テキストの長さを計算
        ulong text_len = 0;
        while (true) {
            ulong ch = Mem::read_byte(text_addr + text_len);
            if (ch == 0) { break; }
            text_len = text_len + 1;
        }

        // 書き込み（先頭から上書き）
        RamFs::truncate(ino);
        long written = RamFs::write(ino, text_addr, 0, text_len);
        if (written > 0) {
            Shell::write("Wrote " as void*);
            Shell::print_dec(written as ulong);
            Shell::write(" bytes to " as void*);
            Shell::writeln(name_addr as void*);
        } else {
            Shell::writeln("write: failed" as void*);
        }
    }

    /// echo コマンド: テキスト出力
    static void echo(ulong text_addr) {
        if (text_addr != 0) {
            Shell::writeln(text_addr as void*);
        } else {
            Shell::putc(10);
        }
    }

    /// rm コマンド: ファイル削除
    static void rm(ulong name_addr) {
        if (name_addr == 0) {
            Shell::writeln("Usage: rm <filename>" as void*);
            return;
        }
        long result = RamFs::unlink(name_addr as void*);
        if (result == 0) {
            Shell::write("Removed: " as void*);
            Shell::writeln(name_addr as void*);
        } else if (result == (0 - 21)) {
            Shell::writeln("rm: cannot remove directory" as void*);
        } else {
            Shell::write("rm: file not found: " as void*);
            Shell::writeln(name_addr as void*);
        }
    }

    /// mkdir コマンド: ディレクトリ作成
    static void mkdir(ulong name_addr) {
        if (name_addr == 0) {
            Shell::writeln("Usage: mkdir <dirname>" as void*);
            return;
        }
        Ino ino = RamFs::mkdir(name_addr as void*);
        if (ino != 0) {
            Shell::write("Created directory: " as void*);
            Shell::writeln(name_addr as void*);
        } else {
            Shell::writeln("mkdir: failed to create directory" as void*);
        }
    }

    /// wc コマンド: バイト/行数カウント
    static void wc(ulong name_addr) {
        if (name_addr == 0) {
            Shell::writeln("Usage: wc <filename>" as void*);
            return;
        }
        Ino ino = RamFs::lookup(name_addr as void*);
        if (ino == 0) {
            Shell::write("wc: file not found: " as void*);
            Shell::writeln(name_addr as void*);
            return;
        }
        ulong fsize = RamFs::file_size(ino);
        // 行数カウント: ファイルを読み出して\nを数える
        ulong lines = 0;
        ulong read_buf = 0x94100;
        if (fsize > 0) {
            long bytes = RamFs::read(ino, read_buf, 0, fsize);
            if (bytes > 0) {
                ulong j = 0;
                while (j < (bytes as ulong)) {
                    ulong ch = Mem::read_byte(read_buf + j);
                    if (ch == 10) { lines = lines + 1; }
                    j = j + 1;
                }
                // 末尾が\nでない場合も１行と数える
                if (bytes > 0) {
                    ulong last = Mem::read_byte(read_buf + (bytes as ulong) - 1);
                    if (last != 10) { lines = lines + 1; }
                }
            }
        }
        Shell::write("  " as void*);
        Shell::print_dec(lines);
        Shell::write(" lines, " as void*);
        Shell::print_dec(fsize);
        Shell::write(" bytes  " as void*);
        Shell::writeln(name_addr as void*);
    }

    /// hexdump コマンド: 16進ダンプ
    static void hexdump(ulong name_addr) {
        if (name_addr == 0) {
            Shell::writeln("Usage: hexdump <filename>" as void*);
            return;
        }
        Ino ino = RamFs::lookup(name_addr as void*);
        if (ino == 0) {
            Shell::write("hexdump: file not found: " as void*);
            Shell::writeln(name_addr as void*);
            return;
        }
        ulong fsize = RamFs::file_size(ino);
        if (fsize == 0) {
            Shell::writeln("(empty file)" as void*);
            return;
        }
        // 最大256バイトまで表示
        ulong show_size = fsize;
        if (show_size > 256) { show_size = 256; }
        ulong read_buf = 0x94100;
        long bytes = RamFs::read(ino, read_buf, 0, show_size);
        if (bytes <= 0) { return; }
        ulong row = 0;
        while (row < (bytes as ulong)) {
            // オフセット表示 (8桁hex)
            Shell::print_hex(row);
            Shell::write("  " as void*);
            // 16バイトずつ表示
            ulong col = 0;
            while (col < 16) {
                if (row + col < (bytes as ulong)) {
                    ulong b = Mem::read_byte(read_buf + row + col);
                    Shell::print_hex_byte(b);
                    Shell::putc(32);  // スペース
                } else {
                    Shell::write("   " as void*);
                }
                col = col + 1;
            }
            Shell::write(" |" as void*);
            // ASCII表示
            col = 0;
            while (col < 16) {
                if (row + col < (bytes as ulong)) {
                    ulong b = Mem::read_byte(read_buf + row + col);
                    if (b >= 32) {
                        if (b < 127) {
                            Shell::putc(b);
                        } else {
                            Shell::putc(46);  // '.'
                        }
                    } else {
                        Shell::putc(46);  // '.'
                    }
                }
                col = col + 1;
            }
            Shell::writeln("|" as void*);
            row = row + 16;
        }
        if (fsize > 256) {
            Shell::writeln("... (truncated)" as void*);
        }
    }

    /// uname コマンド: システム情報表示
    static void uname(ulong flags_addr) {
        // uname -a の場合: 全情報表示
        if (flags_addr != 0) {
            if (startswith(flags_addr as void*, "-a" as void*) != 0) {
                Shell::writeln("Cosmo Linux 0.1.0 cosmo x86_64 Cm/LLVM" as void*);
                return;
            }
        }
        Shell::writeln("Cosmo Linux" as void*);
    }

    /// date コマンド: 時刻表示（PIT ticksからの簡易計算）
    static void date() {
        ulong ticks = PIT::get_ticks();
        ulong total_secs = ticks / 100;
        ulong hours = total_secs / 3600;
        ulong mins = (total_secs % 3600) / 60;
        ulong secs = total_secs % 60;
        Shell::write("Up " as void*);
        Shell::print_dec(hours);
        Shell::write(":" as void*);
        if (mins < 10) { Shell::write("0" as void*); }
        Shell::print_dec(mins);
        Shell::write(":" as void*);
        if (secs < 10) { Shell::write("0" as void*); }
        Shell::print_dec(secs);
        Shell::write(" (" as void*);
        Shell::print_dec(ticks);
        Shell::writeln(" ticks)" as void*);
    }

    /// cp コマンド: ファイルコピー
    static void cp(ulong src_addr, ulong dst_addr) {
        if (src_addr == 0) {
            Shell::writeln("Usage: cp <src> <dst>" as void*);
            return;
        }
        if (dst_addr == 0) {
            Shell::writeln("Usage: cp <src> <dst>" as void*);
            return;
        }
        // srcのファイル名をNUL終端（スペースで区切り）
        ulong end = dst_addr - 1;
        ulong done_s = 0;
        while (done_s == 0) {
            if (end <= src_addr) { done_s = 1; }
            else {
                ulong c = Mem::read_byte(end - 1);
                if (c != 32) { done_s = 1; }
                else { end = end - 1; }
            }
        }
        Mem::write_byte(end, 0);

        // ソース検索
        Ino src_ino = RamFs::lookup(src_addr as void*);
        if (src_ino == 0) {
            Shell::write("cp: source not found: " as void*);
            Shell::writeln(src_addr as void*);
            return;
        }
        ulong fsize = RamFs::file_size(src_ino);

        // デスティネーション作成
        ulong* pmm_addr_ptr = SHELL_PMM_ADDR as ulong*;
        BuddyAllocator* pmm = (*pmm_addr_ptr) as BuddyAllocator*;
        ulong data_page = pmm->alloc_pages(0);
        if (data_page != 0) {
            memzero(data_page as void*, PAGE_SIZE);
        }
        Ino dst_ino = RamFs::create(dst_addr as void*, S_IFREG | 0x1B6, data_page);
        if (dst_ino == 0) {
            Shell::writeln("cp: failed to create destination" as void*);
            return;
        }

        // データコピー
        if (fsize > 0) {
            ulong read_buf = 0x94100;
            long bytes = RamFs::read(src_ino, read_buf, 0, fsize);
            if (bytes > 0) {
                RamFs::write(dst_ino, read_buf, 0, bytes as ulong);
            }
        }
        Shell::write("Copied: " as void*);
        Shell::write(src_addr as void*);
        Shell::write(" -> " as void*);
        Shell::writeln(dst_addr as void*);
    }

    /// mv コマンド: ファイル移動/リネーム（cp + rm）
    static void mv(ulong src_addr, ulong dst_addr) {
        if (src_addr == 0) {
            Shell::writeln("Usage: mv <src> <dst>" as void*);
            return;
        }
        if (dst_addr == 0) {
            Shell::writeln("Usage: mv <src> <dst>" as void*);
            return;
        }
        // srcのファイル名をNUL終端
        ulong end = dst_addr - 1;
        ulong done_s = 0;
        while (done_s == 0) {
            if (end <= src_addr) { done_s = 1; }
            else {
                ulong c = Mem::read_byte(end - 1);
                if (c != 32) { done_s = 1; }
                else { end = end - 1; }
            }
        }
        Mem::write_byte(end, 0);

        // cpと同じ処理
        Ino src_ino = RamFs::lookup(src_addr as void*);
        if (src_ino == 0) {
            Shell::write("mv: source not found: " as void*);
            Shell::writeln(src_addr as void*);
            return;
        }
        ulong fsize = RamFs::file_size(src_ino);

        ulong* pmm_addr_ptr = SHELL_PMM_ADDR as ulong*;
        BuddyAllocator* pmm = (*pmm_addr_ptr) as BuddyAllocator*;
        ulong data_page = pmm->alloc_pages(0);
        if (data_page != 0) {
            memzero(data_page as void*, PAGE_SIZE);
        }
        Ino dst_ino = RamFs::create(dst_addr as void*, S_IFREG | 0x1B6, data_page);
        if (dst_ino == 0) {
            Shell::writeln("mv: failed to create destination" as void*);
            return;
        }
        if (fsize > 0) {
            ulong read_buf = 0x94100;
            long bytes = RamFs::read(src_ino, read_buf, 0, fsize);
            if (bytes > 0) {
                RamFs::write(dst_ino, read_buf, 0, bytes as ulong);
            }
        }
        // ソース削除
        RamFs::unlink(src_addr as void*);
        Shell::write("Moved: " as void*);
        Shell::write(src_addr as void*);
        Shell::write(" -> " as void*);
        Shell::writeln(dst_addr as void*);
    }

    /// head コマンド: 先頭10行表示
    static void head(ulong name_addr) {
        if (name_addr == 0) {
            Shell::writeln("Usage: head <filename>" as void*);
            return;
        }
        Ino ino = RamFs::lookup(name_addr as void*);
        if (ino == 0) {
            Shell::write("head: file not found: " as void*);
            Shell::writeln(name_addr as void*);
            return;
        }
        ulong fsize = RamFs::file_size(ino);
        if (fsize == 0) {
            Shell::writeln("(empty file)" as void*);
            return;
        }
        ulong read_buf = 0x94100;
        long bytes = RamFs::read(ino, read_buf, 0, fsize);
        if (bytes > 0) {
            ulong lines = 0;
            ulong j = 0;
            while (j < (bytes as ulong)) {
                ulong ch = Mem::read_byte(read_buf + j);
                Shell::putc(ch);
                if (ch == 10) {
                    lines = lines + 1;
                    if (lines >= 10) { break; }
                }
                j = j + 1;
            }
            // 末尾改行がなければ追加
            if (lines < 10) {
                ulong last = Mem::read_byte(read_buf + (bytes as ulong) - 1);
                if (last != 10) { Shell::putc(10); }
            }
        }
    }

    /// cd コマンド: ディレクトリ変更
    static void cd(ulong dir_addr) {
        if (dir_addr == 0) {
            // cd のみ → ルートに移動
            Cwd::set("/" as void*);
            return;
        }
        // "/" は常に存在
        ulong ch0 = Mem::read_byte(dir_addr);
        if (ch0 == 47) {
            // 絶対パス
            Cwd::set(dir_addr as void*);
            return;
        }
        // ".." → 親ディレクトリ
        if (ch0 == 46) {
            ulong ch1 = Mem::read_byte(dir_addr + 1);
            if (ch1 == 46) {
                ulong ch2 = Mem::read_byte(dir_addr + 2);
                if (ch2 == 0) {
                    Cwd::set("/" as void*);
                    return;
                }
            }
            if (ch1 == 0) {
                // "." → 何もしない
                return;
            }
        }
        // 相対パス → CWD + "/" + dir で合成（簡易版: ルート直下のみ）
        // ramfsでディレクトリ存在確認
        Ino ino = RamFs::lookup(dir_addr as void*);
        if (ino == 0) {
            Shell::write("cd: no such directory: " as void*);
            Shell::writeln(dir_addr as void*);
            return;
        }
        // "/" + name に合成
        ulong tmp_buf = 0x94200;
        Mem::write_byte(tmp_buf, 47);  // '/'
        ulong j = 0;
        while (true) {
            ulong c = Mem::read_byte(dir_addr + j);
            if (c == 0) { break; }
            Mem::write_byte(tmp_buf + 1 + j, c);
            j = j + 1;
        }
        Mem::write_byte(tmp_buf + 1 + j, 0);
        Cwd::set(tmp_buf as void*);
    }

    /// pwd コマンド: カレントディレクトリ表示
    static void pwd() {
        ulong addr = Cwd::get();
        Shell::writeln(addr as void*);
    }

    /// env コマンド: 環境変数一覧表示
    static void env() {
        ulong i = 0;
        while (i < ENV_MAX) {
            ulong entry = ENV_TABLE + i * ENV_ENTRY_SIZE;
            if (Mem::read_byte(entry) != 0) {
                Shell::write(entry as void*);
                Shell::putc(61);  // '='
                Shell::writeln((entry + ENV_KEY_LEN) as void*);
            }
            i = i + 1;
        }
    }

    /// export コマンド: 環境変数設定 (export KEY=VALUE)
    static void export_var(ulong arg_addr) {
        if (arg_addr == 0) { Cmd::env(); return; }
        // '=' を探す
        ulong pos = 0;
        while (true) {
            ulong c = Mem::read_byte(arg_addr + pos);
            if (c == 0) { break; }
            if (c == 61) {  // '='
                Mem::write_byte(arg_addr + pos, 0);
                Env::set(arg_addr as void*, (arg_addr + pos + 1) as void*);
                return;
            }
            pos = pos + 1;
        }
        // '=' がない場合: 値を表示
        ulong val = Env::get(arg_addr as void*);
        if (val != 0) {
            Shell::write(arg_addr as void*);
            Shell::putc(61);
            Shell::writeln(val as void*);
        } else {
            Shell::writeln("undefined" as void*);
        }
    }

    static void grep(ulong pat_addr, ulong file_addr) {
        if (pat_addr == 0 || file_addr == 0) {
            Shell::writeln("Usage: grep <pattern> <file>" as void*);
            return;
        }
        // パターン長
        ulong pat_len = 0;
        while (Mem::read_byte(pat_addr + pat_len) != 0) { pat_len = pat_len + 1; }
        if (pat_len == 0) { return; }
        // ファイル読み出し
        Ino ino = RamFs::lookup(file_addr as void*);
        if (ino == 0) { Shell::write("grep: not found: " as void*); Shell::writeln(file_addr as void*); return; }
        ulong fsize = RamFs::file_size(ino);
        if (fsize == 0) { return; }
        ulong buf = 0x94100;
        long bytes = RamFs::read(ino, buf, 0, fsize);
        if (bytes <= 0) { return; }
        // 行ごと検索
        ulong ls = 0;
        ulong p = 0;
        while (p <= (bytes as ulong)) {
            ulong ch = 0;
            if (p < (bytes as ulong)) { ch = Mem::read_byte(buf + p); }
            if (ch == 10 || p == (bytes as ulong)) {
                ulong ll = p - ls;
                if (ll >= pat_len) {
                    ulong s = 0;
                    while (s <= ll - pat_len) {
                        ulong m = 1;
                        ulong k = 0;
                        while (k < pat_len) {
                            if (Mem::read_byte(buf + ls + s + k) != Mem::read_byte(pat_addr + k)) { m = 0; break; }
                            k = k + 1;
                        }
                        if (m != 0) {
                            ulong q = ls;
                            while (q < p) { Shell::putc(Mem::read_byte(buf + q)); q = q + 1; }
                            Shell::putc(10);
                            break;
                        }
                        s = s + 1;
                    }
                }
                ls = p + 1;
            }
            p = p + 1;
        }
    }

    static void sort(ulong file_addr) {
        if (file_addr == 0) { Shell::writeln("Usage: sort <file>" as void*); return; }
        Ino ino = RamFs::lookup(file_addr as void*);
        if (ino == 0) { Shell::write("sort: not found: " as void*); Shell::writeln(file_addr as void*); return; }
        ulong fsize = RamFs::file_size(ino);
        if (fsize == 0) { return; }
        ulong buf = 0x94100;
        long bytes = RamFs::read(ino, buf, 0, fsize);
        if (bytes <= 0) { return; }
        // 行開始アドレスを収集 (max 64行)
        ulong line_starts = 0x96000;
        ulong line_count = 0;
        Mem::write_qword(line_starts, buf);
        line_count = 1;
        ulong i = 0;
        while (i < (bytes as ulong)) {
            if (Mem::read_byte(buf + i) == 10 && i + 1 < (bytes as ulong) && line_count < 64) {
                Mem::write_byte(buf + i, 0);
                Mem::write_qword(line_starts + line_count * 8, buf + i + 1);
                line_count = line_count + 1;
            }
            i = i + 1;
        }
        // 最後の改行をNULに
        if (bytes > 0 && Mem::read_byte(buf + (bytes as ulong) - 1) == 10) {
            Mem::write_byte(buf + (bytes as ulong) - 1, 0);
        }
        // バブルソート
        ulong n = line_count;
        ulong a = 0;
        while (a < n) {
            ulong b = 0;
            while (b < n - 1 - a) {
                ulong s1 = Mem::read_qword(line_starts + b * 8);
                ulong s2 = Mem::read_qword(line_starts + (b + 1) * 8);
                if (Mem::strcmp(s1 as void*, s2 as void*) > 0) {
                    Mem::write_qword(line_starts + b * 8, s2);
                    Mem::write_qword(line_starts + (b + 1) * 8, s1);
                }
                b = b + 1;
            }
            a = a + 1;
        }
        // 出力
        i = 0;
        while (i < line_count) {
            ulong addr = Mem::read_qword(line_starts + i * 8);
            Shell::writeln(addr as void*);
            i = i + 1;
        }
    }

    /// writeコマンドの引数パース＆実行
    static void dispatch_write() {
        ulong arg1 = Cmd::arg(CMD_BUF_ADDR);
        ulong arg2 = Cmd::arg2(CMD_BUF_ADDR);
        if (arg2 != 0) {
            // ファイル名部分をNUL終端（スペースまで遡る）
            ulong end = arg2 - 1;
            ulong done = 0;
            while (done == 0) {
                if (end <= arg1) { done = 1; }
                else {
                    ulong c = Mem::read_byte(end - 1);
                    if (c != 32) { done = 1; }
                    else { end = end - 1; }
                }
            }
            Mem::write_byte(end, 0);
        }
        Cmd::write_file(arg1, arg2);
    }

    /// cp/mvコマンドの引数パース分離
    static void dispatch_cp() {
        ulong arg1 = Cmd::arg(CMD_BUF_ADDR);
        ulong arg2 = Cmd::arg2(CMD_BUF_ADDR);
        Cmd::cp(arg1, arg2);
    }

    static void dispatch_mv() {
        ulong arg1 = Cmd::arg(CMD_BUF_ADDR);
        ulong arg2 = Cmd::arg2(CMD_BUF_ADDR);
        Cmd::mv(arg1, arg2);
    }

    /// コマンドディスパッチ（早期return方式）
    static void dispatch() {
        if (streq(CMD_BUF_ADDR as void*, "help" as void*) != 0) {
            Cmd::help();
            return;
        }
        if (streq(CMD_BUF_ADDR as void*, "ps" as void*) != 0) {
            Cmd::ps();
            return;
        }
        if (streq(CMD_BUF_ADDR as void*, "free" as void*) != 0) {
            Cmd::free_mem();
            return;
        }
        if (streq(CMD_BUF_ADDR as void*, "uptime" as void*) != 0) {
            Cmd::uptime();
            return;
        }
        if (streq(CMD_BUF_ADDR as void*, "clear" as void*) != 0) {
            Vga::clear_screen();
            return;
        }
        if (streq(CMD_BUF_ADDR as void*, "reboot" as void*) != 0) {
            Cmd::reboot();
            return;
        }
        if (streq(CMD_BUF_ADDR as void*, "uname" as void*) != 0) {
            Cmd::uname(0);
            return;
        }
        if (startswith(CMD_BUF_ADDR as void*, "uname " as void*) != 0) {
            ulong arg = Cmd::arg(CMD_BUF_ADDR);
            Cmd::uname(arg);
            return;
        }
        if (streq(CMD_BUF_ADDR as void*, "date" as void*) != 0) {
            Cmd::date();
            return;
        }
        if (streq(CMD_BUF_ADDR as void*, "ls" as void*) != 0) {
            Cmd::ls();
            return;
        }
        if (startswith(CMD_BUF_ADDR as void*, "cat " as void*) != 0) {
            ulong arg = Cmd::arg(CMD_BUF_ADDR);
            Cmd::cat(arg);
            return;
        }
        if (startswith(CMD_BUF_ADDR as void*, "touch " as void*) != 0) {
            ulong arg = Cmd::arg(CMD_BUF_ADDR);
            Cmd::touch(arg);
            return;
        }
        if (startswith(CMD_BUF_ADDR as void*, "write " as void*) != 0) {
            Cmd::dispatch_write();
            return;
        }
        if (startswith(CMD_BUF_ADDR as void*, "cp " as void*) != 0) {
            Cmd::dispatch_cp();
            return;
        }
        if (startswith(CMD_BUF_ADDR as void*, "mv " as void*) != 0) {
            Cmd::dispatch_mv();
            return;
        }
        if (startswith(CMD_BUF_ADDR as void*, "head " as void*) != 0) {
            ulong arg = Cmd::arg(CMD_BUF_ADDR);
            Cmd::head(arg);
            return;
        }
        if (startswith(CMD_BUF_ADDR as void*, "echo " as void*) != 0) {
            ulong arg = Cmd::arg(CMD_BUF_ADDR);
            Cmd::echo(arg);
            return;
        }
        if (streq(CMD_BUF_ADDR as void*, "echo" as void*) != 0) {
            Cmd::echo(0);
            return;
        }
        if (startswith(CMD_BUF_ADDR as void*, "rm " as void*) != 0) {
            ulong arg = Cmd::arg(CMD_BUF_ADDR);
            Cmd::rm(arg);
            return;
        }
        if (startswith(CMD_BUF_ADDR as void*, "mkdir " as void*) != 0) {
            ulong arg = Cmd::arg(CMD_BUF_ADDR);
            Cmd::mkdir(arg);
            return;
        }
        if (startswith(CMD_BUF_ADDR as void*, "wc " as void*) != 0) {
            ulong arg = Cmd::arg(CMD_BUF_ADDR);
            Cmd::wc(arg);
            return;
        }
        if (startswith(CMD_BUF_ADDR as void*, "hexdump " as void*) != 0) {
            ulong arg = Cmd::arg(CMD_BUF_ADDR);
            Cmd::hexdump(arg);
            return;
        }
        if (streq(CMD_BUF_ADDR as void*, "cd" as void*) != 0) {
            Cmd::cd(0);
            return;
        }
        if (startswith(CMD_BUF_ADDR as void*, "cd " as void*) != 0) {
            ulong arg = Cmd::arg(CMD_BUF_ADDR);
            Cmd::cd(arg);
            return;
        }
        if (streq(CMD_BUF_ADDR as void*, "pwd" as void*) != 0) {
            Cmd::pwd();
            return;
        }
        if (streq(CMD_BUF_ADDR as void*, "env" as void*) != 0) {
            Cmd::env();
            return;
        }
        if (startswith(CMD_BUF_ADDR as void*, "export " as void*) != 0) {
            ulong arg = Cmd::arg(CMD_BUF_ADDR);
            Cmd::export_var(arg);
            return;
        }
        if (streq(CMD_BUF_ADDR as void*, "export" as void*) != 0) {
            Cmd::env();
            return;
        }
        if (startswith(CMD_BUF_ADDR as void*, "grep " as void*) != 0) {
            ulong arg1 = Cmd::arg(CMD_BUF_ADDR);
            ulong arg2 = Cmd::arg2(CMD_BUF_ADDR);
            Cmd::grep(arg1, arg2);
            return;
        }
        if (startswith(CMD_BUF_ADDR as void*, "sort " as void*) != 0) {
            ulong arg = Cmd::arg(CMD_BUF_ADDR);
            Cmd::sort(arg);
            return;
        }
        Shell::write("Unknown command: " as void*);
        Shell::writeln(CMD_BUF_ADDR as void*);
    }

}

export void shell_main() {
    // VGA画面クリア＆ウェルカムバナー
    Shell::set_color(7, 0);
    Vga::clear_screen();

    Shell::set_color(11, 0);
    Shell::writeln("========================================" as void*);
    Shell::writeln("  Cosmo Linux v0.1.0" as void*);
    Shell::writeln("  Written in Cm - A Linux reimagined" as void*);
    Shell::writeln("========================================" as void*);

    Shell::set_color(7, 0);
    Shell::writeln("" as void*);
    Shell::writeln("Welcome to Cosmo Linux!" as void*);
    Shell::writeln("Type 'help' for available commands." as void*);
    Shell::writeln("" as void*);

    // コマンドバッファ長初期化
    ulong* len_ptr = CMD_LEN_ADDR as ulong*;
    *len_ptr = 0;

    // 履歴初期化
    History::setup();

    // 環境変数初期化
    Env::setup();

    // 履歴ナビゲーション位置
    ulong hist_pos = 0;

    // REPLループ
    while (true) {
        // プロンプト表示
        Shell::set_color(10, 0);
        Shell::write("cosmo" as void*);
        Shell::set_color(14, 0);
        Shell::write(":" as void*);
        Shell::set_color(12, 0);
        Shell::write("/" as void*);
        Shell::set_color(7, 0);
        Shell::write("$ " as void*);

        // 履歴ポジションリセット
        hist_pos = 0;

        // キー入力ループ
        ulong input_done = 0;
        while (input_done == 0) {
            ulong ch = Kbd::getchar();
            if (ch == 0) {
                __asm__(`hlt`);
            } else if (ch == 10) {
                // Enter: コマンド実行
                Shell::putc(10);
                ulong len = *len_ptr;
                Mem::write_byte(CMD_BUF_ADDR + len, 0);
                if (len > 0) {
                    // 履歴に追加
                    History::add(CMD_BUF_ADDR, len);
                    Cmd::dispatch();
                }
                *len_ptr = 0;
                input_done = 1;
            } else if (ch == 8) {
                // Backspace
                ulong len = *len_ptr;
                if (len > 0) {
                    *len_ptr = len - 1;
                    Vga::putc(8);
                    ulong* ser_ptr = SHELL_SERIAL_ADDR as ulong*;
                    SerialPort* ser = (*ser_ptr) as SerialPort*;
                    ser->putc(8);
                    ser->putc(32);
                    ser->putc(8);
                }
            } else if (ch == 0x80) {
                // 上矢印キー（キーボードドライバから0x80）
                ulong addr = History::get(hist_pos);
                if (addr != 0) {
                    History::restore(addr);
                    hist_pos = hist_pos + 1;
                }
            } else if (ch == 0x81) {
                // 下矢印キー（キーボードドライバから0x81）
                if (hist_pos > 0) {
                    hist_pos = hist_pos - 1;
                    if (hist_pos > 0) {
                        ulong addr = History::get(hist_pos - 1);
                        if (addr != 0) {
                            History::restore(addr);
                        }
                    } else {
                        // 最新位置: バッファクリア
                        ulong old_len = *len_ptr;
                        ulong k = 0;
                        while (k < old_len) {
                            Vga::putc(8);
                            k = k + 1;
                        }
                        *len_ptr = 0;
                    }
                }
            } else if (ch == 3) {
                // Ctrl+C: 入力キャンセル
                Shell::set_color(9, 0);
                Shell::write("^C" as void*);
                Shell::set_color(7, 0);
                Shell::putc(10);
                *len_ptr = 0;
                input_done = 1;
            } else if (ch == 12) {
                // Ctrl+L: 画面クリア
                Vga::clear_screen();
                *len_ptr = 0;
                input_done = 1;
            } else {
                // 表示可能文字
                ulong len = *len_ptr;
                if (len < CMD_BUF_SIZE - 1) {
                    Mem::write_byte(CMD_BUF_ADDR + len, ch & 0xFF);
                    *len_ptr = len + 1;
                    Shell::putc(ch);
                }
            }
        }
    }
}

/// シェル初期化
export void shell_init(ulong serial_addr, ulong pmm_addr) {
    ulong* ser_ptr = SHELL_SERIAL_ADDR as ulong*;
    *ser_ptr = serial_addr;
    ulong* pmm_ptr = SHELL_PMM_ADDR as ulong*;
    *pmm_ptr = pmm_addr;
    ulong* col_ptr = SH_VGA_COL_ADDR as ulong*;
    *col_ptr = 0;
    ulong* row_ptr = SH_VGA_ROW_ADDR as ulong*;
    *row_ptr = 0;
    ulong* color_ptr = SH_VGA_COLOR_ADDR as ulong*;
    *color_ptr = 0x07;
    ulong* len_ptr = CMD_LEN_ADDR as ulong*;
    *len_ptr = 0;
}
