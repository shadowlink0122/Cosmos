//! platform: baremetal-x86
// cosmo-linux::ui::shell - カーネルシェル
//
// VGA直接バッファ操作 + シリアル出力 + キーボード入力
// Cm言語のutiny*ポインタ読み取りバグを回避するため全て
// インラインASM (movzbl) でバイト読み取りを行う
//
// 参照: linux/kernel/sys.c

import ../include/types;
import ../include/config;
import ../include/scheduler;
import ../drivers/serial;
import ../drivers/pit;
import ../drivers/keyboard;
import ../sched/scheduler;
import ../mm/pmm;
import ../lib/printk;
import ../include/vfs;
import ../fs/ramfs;
import ../fs/procfs;
import ../init/init;

// ============================================================
// シェル用固定メモリ
// ============================================================

const PhysAddr SHELL_SERIAL_ADDR = 0x95008;
const PhysAddr SHELL_PMM_ADDR = 0x95010;

/// VGA直接操作用状態
const PhysAddr SH_VGA_COL_ADDR   = 0x95020;
const PhysAddr SH_VGA_ROW_ADDR   = 0x95028;
const PhysAddr SH_VGA_COLOR_ADDR = 0x95030;

/// コマンドバッファ
const PhysAddr CMD_BUF_ADDR = 0x94000;
const PhysAddr CMD_LEN_ADDR = 0x94080;
const ulong CMD_BUF_SIZE = 128;

/// コマンド履歴
const PhysAddr HIST_BASE = 0x95100;   // 8エントリ × 128バイト = 1024バイト
const PhysAddr HIST_COUNT = 0x95500;
const PhysAddr HIST_INDEX = 0x95508;
const ulong HIST_MAX = 8;
const ulong HIST_ENTRY_SIZE = 128;

/// VGAスクロールバックバッファ (50行×80文字=4000B)
const PhysAddr SCROLL_BUF = 0x97000;
const PhysAddr SCROLL_HEAD = 0x97FA0;
const PhysAddr SCROLL_COUNT = 0x97FA8;
const ulong SCROLL_MAX = 50;
const ulong SCROLL_COLS = 80;

/// VGAバッファ
const PhysAddr VGA_BUF = 0xB8000;
const ulong VGA_COLS = 80;
const ulong VGA_ROWS = 25;

// （read_byte / write_byte はローカル定義）

ulong read_byte(ulong addr) {
    ulong val = 0;
    __asm__(`movq ${r:addr}, %r10; xorq %rax,%rax; movzbl (%r10),%eax; movq %rax, ${=r:val}`);
    return val;
}

void write_byte(ulong addr, ulong val) {
    __asm__(`movq ${r:addr}, %r10; movq ${r:val}, %rax; movb %al, (%r10)`);
}

// ============================================================
// VGA直接バッファ操作
// ============================================================

/// 指定位置に文字を書き込み
void vga_write_at(ulong row, ulong col, ulong ch, ulong color) {
    ulong offset = (row * VGA_COLS + col) * 2;
    write_byte(VGA_BUF + offset, ch & 0xFF);
    write_byte(VGA_BUF + offset + 1, color & 0xFF);
}

/// カーソル更新
void vga_update_cursor() {
    ulong* col_ptr = SH_VGA_COL_ADDR as ulong*;
    ulong* row_ptr = SH_VGA_ROW_ADDR as ulong*;
    ulong pos = (*row_ptr) * VGA_COLS + (*col_ptr);
    outb(0x3D4, 0x0E);
    outb(0x3D5, (pos >> 8) & 0xFF);
    outb(0x3D4, 0x0F);
    outb(0x3D5, pos & 0xFF);
}

/// 1行スクロール
void vga_scroll() {
    ulong r = 1;
    while (r < VGA_ROWS) {
        ulong c = 0;
        while (c < VGA_COLS) {
            ulong src_off = (r * VGA_COLS + c) * 2;
            ulong dst_off = ((r - 1) * VGA_COLS + c) * 2;
            ulong ch_val = read_byte(VGA_BUF + src_off);
            ulong at_val = read_byte(VGA_BUF + src_off + 1);
            write_byte(VGA_BUF + dst_off, ch_val);
            write_byte(VGA_BUF + dst_off + 1, at_val);
            c = c + 1;
        }
        r = r + 1;
    }
    ulong* color_ptr = SH_VGA_COLOR_ADDR as ulong*;
    ulong c = 0;
    while (c < VGA_COLS) {
        vga_write_at(VGA_ROWS - 1, c, 32, *color_ptr);
        c = c + 1;
    }
}

/// 改行
void vga_newline() {
    ulong* col_ptr = SH_VGA_COL_ADDR as ulong*;
    ulong* row_ptr = SH_VGA_ROW_ADDR as ulong*;
    *col_ptr = 0;
    ulong row = *row_ptr + 1;
    if (row >= VGA_ROWS) {
        vga_scroll();
        row = VGA_ROWS - 1;
    }
    *row_ptr = row;
}

/// 1文字出力
void vga_putc(ulong ch) {
    ulong* col_ptr = SH_VGA_COL_ADDR as ulong*;
    ulong* row_ptr = SH_VGA_ROW_ADDR as ulong*;
    ulong* color_ptr = SH_VGA_COLOR_ADDR as ulong*;

    if (ch == 10) {
        vga_newline();
    } else if (ch == 8) {
        ulong col = *col_ptr;
        if (col > 0) {
            *col_ptr = col - 1;
            vga_write_at(*row_ptr, col - 1, 32, *color_ptr);
        }
    } else if (ch >= 32) {
        vga_write_at(*row_ptr, *col_ptr, ch, *color_ptr);
        ulong col = *col_ptr + 1;
        if (col >= VGA_COLS) {
            vga_newline();
        } else {
            *col_ptr = col;
        }
    }
    vga_update_cursor();
}

/// 文字列出力
void vga_puts(void* msg) {
    ulong addr = msg as ulong;
    ulong i = 0;
    while (true) {
        ulong byte_val = read_byte(addr + i);
        if (byte_val == 0) { return; }
        vga_putc(byte_val);
        i = i + 1;
    }
}

/// 画面クリア
void vga_clear_screen() {
    ulong* color_ptr = SH_VGA_COLOR_ADDR as ulong*;
    ulong r = 0;
    while (r < VGA_ROWS) {
        ulong c = 0;
        while (c < VGA_COLS) {
            vga_write_at(r, c, 32, *color_ptr);
            c = c + 1;
        }
        r = r + 1;
    }
    ulong* col_ptr = SH_VGA_COL_ADDR as ulong*;
    ulong* row_ptr = SH_VGA_ROW_ADDR as ulong*;
    *col_ptr = 0;
    *row_ptr = 0;
    vga_update_cursor();
}

// ============================================================
// シェル出力ヘルパー（VGA + シリアル同時出力）
// ============================================================

void sh_putc(ulong ch) {
    vga_putc(ch);
    ulong* ser_ptr = SHELL_SERIAL_ADDR as ulong*;
    SerialPort* ser = (*ser_ptr) as SerialPort*;
    ser->putc(ch);
}

void sh_print(void* msg) {
    vga_puts(msg);
    ulong* ser_ptr = SHELL_SERIAL_ADDR as ulong*;
    SerialPort* ser = (*ser_ptr) as SerialPort*;
    ser->puts(msg);
}

void sh_println(void* msg) {
    sh_print(msg);
    sh_putc(10);
}

void sh_set_color(ulong fg, ulong bg) {
    ulong* color_ptr = SH_VGA_COLOR_ADDR as ulong*;
    *color_ptr = ((bg & 0x0F) << 4) | (fg & 0x0F);
}

void sh_print_dec(ulong value) {
    ulong* ser_ptr = SHELL_SERIAL_ADDR as ulong*;
    SerialPort* ser = (*ser_ptr) as SerialPort*;
    if (value == 0) {
        vga_putc(48);
        ser->putc(48);
        return;
    }
    ulong buf0 = 0; ulong buf1 = 0; ulong buf2 = 0; ulong buf3 = 0;
    ulong buf4 = 0; ulong buf5 = 0; ulong buf6 = 0; ulong buf7 = 0;
    ulong buf8 = 0; ulong buf9 = 0;
    ulong count = 0;
    ulong tmp = value;
    while (tmp != 0) {
        ulong digit = tmp % 10;
        if (count == 0) { buf0 = digit; }
        if (count == 1) { buf1 = digit; }
        if (count == 2) { buf2 = digit; }
        if (count == 3) { buf3 = digit; }
        if (count == 4) { buf4 = digit; }
        if (count == 5) { buf5 = digit; }
        if (count == 6) { buf6 = digit; }
        if (count == 7) { buf7 = digit; }
        if (count == 8) { buf8 = digit; }
        if (count == 9) { buf9 = digit; }
        tmp = tmp / 10;
        count = count + 1;
    }
    ulong i = count;
    while (i != 0) {
        i = i - 1;
        ulong d = 0;
        if (i == 0) { d = buf0; }
        if (i == 1) { d = buf1; }
        if (i == 2) { d = buf2; }
        if (i == 3) { d = buf3; }
        if (i == 4) { d = buf4; }
        if (i == 5) { d = buf5; }
        if (i == 6) { d = buf6; }
        if (i == 7) { d = buf7; }
        if (i == 8) { d = buf8; }
        if (i == 9) { d = buf9; }
        vga_putc(d + 48);
        ser->putc(d + 48);
    }
}

// ============================================================
// 文字列比較（ASMベースのバイト読み取り）
// ============================================================

ulong streq(void* a_ptr, void* b_ptr) {
    ulong a_addr = a_ptr as ulong;
    ulong b_addr = b_ptr as ulong;
    ulong i = 0;
    while (true) {
        ulong ca = read_byte(a_addr + i);
        ulong cb = read_byte(b_addr + i);
        if (ca != cb) { return 0; }
        if (ca == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

// ============================================================
// 組み込みコマンド
// ============================================================

void cmd_help() {
    sh_set_color(11, 0);
    sh_println("=== Cosmo Linux Shell (Ctrl+C: cancel) ===" as void*);
    sh_set_color(7, 0);
    sh_println("  help ps free uptime uname date clear reboot" as void*);
    sh_println("  ls cat touch write cp mv rm mkdir head wc hexdump" as void*);
    sh_println("  echo cd pwd cat /proc/* [Up/Down]=history" as void*);
}

void cmd_ps() {
    sh_println("" as void*);
    sh_println("  PID  STATE    NAME" as void*);
    sh_println("  ---  -------  --------" as void*);

    ulong* sched_ptr_addr = 0x91000 as ulong*;
    RoundRobinScheduler* sched = (*sched_ptr_addr) as RoundRobinScheduler*;

    ulong i = 0;
    while (i < sched->count) {
        ulong proc_addr = sched->get_proc(i);
        if (proc_addr != 0) {
            Process* proc = proc_addr as Process*;
            sh_print("  " as void*);
            sh_print_dec(proc->pid as ulong);
            sh_print("    " as void*);

            if (proc->state == TASK_RUNNING) {
                sh_print("RUNNING  " as void*);
            }
            if (proc->state == TASK_READY) {
                sh_print("READY    " as void*);
            }
            if (proc->state == TASK_BLOCKED) {
                sh_print("BLOCKED  " as void*);
            }
            if (proc->state == TASK_ZOMBIE) {
                sh_print("ZOMBIE   " as void*);
            }

            if (proc->pid == 0) { sh_println("idle" as void*); }
            if (proc->pid == 1) { sh_println("shell" as void*); }
            if (proc->pid > 1) { sh_println("task" as void*); }
        }
        i = i + 1;
    }
    sh_println("" as void*);
}

void cmd_free() {
    ulong* pmm_addr_ptr = SHELL_PMM_ADDR as ulong*;
    BuddyAllocator* pmm = (*pmm_addr_ptr) as BuddyAllocator*;
    ulong total = pmm->total_pages;
    ulong free_p = pmm->free_pages;
    ulong used = total - free_p;
    sh_println("" as void*);
    sh_print("  Total:  " as void*);
    sh_print_dec(total * 4);
    sh_println(" KiB" as void*);
    sh_print("  Used:   " as void*);
    sh_print_dec(used * 4);
    sh_println(" KiB" as void*);
    sh_print("  Free:   " as void*);
    sh_print_dec(free_p * 4);
    sh_println(" KiB" as void*);
    sh_println("" as void*);
}

void cmd_uptime() {
    ulong ticks = pit_get_ticks();
    ulong seconds = ticks / 100;
    ulong minutes = seconds / 60;
    ulong secs = seconds % 60;
    sh_println("" as void*);
    sh_print("  Uptime: " as void*);
    sh_print_dec(minutes);
    sh_print("m " as void*);
    sh_print_dec(secs);
    sh_println("s" as void*);
    sh_print("  Ticks:  " as void*);
    sh_print_dec(ticks);
    sh_println("" as void*);
    sh_println("" as void*);
}

void cmd_reboot() {
    sh_println("Rebooting..." as void*);
    outb(0x64, 0xFE);
    __asm__(`cli; 1: hlt; jmp 1b`);
}

// ============================================================
// 文字列ヘルパー（コマンド引数パース用）
// ============================================================

/// 文字列が指定プレフィックスで始まるか確認
ulong startswith(void* str, void* prefix) {
    ulong s_addr = str as ulong;
    ulong p_addr = prefix as ulong;
    ulong i = 0;
    while (true) {
        ulong pc = read_byte(p_addr + i);
        if (pc == 0) { return 1; }  // プレフィックス全体が一致
        ulong sc = read_byte(s_addr + i);
        if (sc != pc) { return 0; }
        i = i + 1;
    }
    return 0;
}

/// コマンドバッファから最初のスペース以降の引数アドレスを取得
/// 戻り値: 引数の開始アドレス（0なら引数なし）
ulong cmd_arg(ulong buf_addr) {
    ulong i = 0;
    // 最初のスペースを探す
    while (true) {
        ulong ch = read_byte(buf_addr + i);
        if (ch == 0) { return 0; }  // 引数なし
        if (ch == 32) {
            // スペース後の非スペースを探す
            while (true) {
                i = i + 1;
                ulong ch2 = read_byte(buf_addr + i);
                if (ch2 == 0) { return 0; }
                if (ch2 != 32) {
                    return buf_addr + i;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

/// 第2引数（第1引数の後のスペース以降）のアドレスを取得
ulong cmd_arg2(ulong buf_addr) {
    ulong first = cmd_arg(buf_addr);
    if (first == 0) { return 0; }
    return cmd_arg(first);
}

// ============================================================
// ファイル操作コマンド
// ============================================================

/// ls コマンド: ファイル一覧表示
void cmd_ls() {
    ulong count = ramfs_dir_count();
    sh_println("" as void*);
    if (count == 0) {
        sh_println("  (no files)" as void*);
    } else {
        ulong i = 0;
        while (i < count) {
            ulong name_addr = ramfs_dir_name(i);
            if (name_addr != 0) {
                ulong dtype = ramfs_dir_type(i);
                Ino ino = ramfs_dir_ino(i);
                sh_print("  " as void*);

                // ディレクトリは色変更
                if (dtype == S_IFDIR) {
                    sh_set_color(11, 0);  // 黄色
                    sh_print(name_addr as void*);
                    sh_print("/" as void*);
                    sh_set_color(7, 0);
                } else {
                    // ファイルサイズ表示
                    sh_print(name_addr as void*);
                    ulong fsize = ramfs_file_size(ino);
                    sh_print("  (" as void*);
                    sh_print_dec(fsize);
                    sh_print(" bytes)" as void*);
                }
                sh_putc(10);
            }
            i = i + 1;
        }
    }
    sh_println("" as void*);
}

/// cat コマンド: ファイル内容表示
void cmd_cat(ulong name_addr) {
    if (name_addr == 0) {
        sh_println("Usage: cat <filename>" as void*);
        return;
    }

    // /proc/ パスの処理
    if (startswith(name_addr as void*, "/proc/" as void*) != 0) {
        ulong proc_name = name_addr + 6;  // "/proc/" の後
        ulong read_buf = 0x94100;
        ulong bytes = procfs_read_file(proc_name as void*, read_buf);
        if (bytes > 0) {
            sh_println(read_buf as void*);
        } else {
            sh_print("cat: unknown proc file: " as void*);
            sh_println(proc_name as void*);
        }
        return;
    }

    Ino ino = ramfs_lookup(name_addr as void*);
    if (ino == 0) {
        sh_print("cat: file not found: " as void*);
        sh_println(name_addr as void*);
        return;
    }

    ulong fsize = ramfs_file_size(ino);
    if (fsize == 0) {
        sh_println("(empty file)" as void*);
        return;
    }

    // 読み出しバッファ: CMD_BUFの後半を使用 (0x94100)
    ulong read_buf = 0x94100;
    long bytes_read = ramfs_read(ino, read_buf, 0, fsize);
    if (bytes_read > 0) {
        // ヌル終端して出力
        write_byte(read_buf + (bytes_read as ulong), 0);
        sh_println(read_buf as void*);
    }
}

/// touch コマンド: 空ファイル作成
void cmd_touch(ulong name_addr) {
    if (name_addr == 0) {
        sh_println("Usage: touch <filename>" as void*);
        return;
    }

    ulong* pmm_addr_ptr = SHELL_PMM_ADDR as ulong*;
    BuddyAllocator* pmm = (*pmm_addr_ptr) as BuddyAllocator*;
    ulong data_page = pmm->alloc_pages(0);
    if (data_page != 0) {
        memzero(data_page as void*, PAGE_SIZE);
    }

    Ino ino = ramfs_create(name_addr as void*, S_IFREG | 0x1B6, data_page);
    if (ino == 0) {
        sh_println("touch: failed to create file" as void*);
    } else {
        sh_print("Created: " as void*);
        sh_println(name_addr as void*);
    }
}

/// write コマンド: ファイルにテキスト書き込み
void cmd_write(ulong name_addr, ulong text_addr) {
    if (name_addr == 0) {
        sh_println("Usage: write <filename> <text>" as void*);
        return;
    }
    if (text_addr == 0) {
        sh_println("Usage: write <filename> <text>" as void*);
        return;
    }

    // ファイルがなければ作成
    ulong* pmm_addr_ptr = SHELL_PMM_ADDR as ulong*;
    BuddyAllocator* pmm = (*pmm_addr_ptr) as BuddyAllocator*;
    ulong data_page = pmm->alloc_pages(0);
    if (data_page != 0) {
        memzero(data_page as void*, PAGE_SIZE);
    }
    Ino ino = ramfs_create(name_addr as void*, S_IFREG | 0x1B6, data_page);
    if (ino == 0) {
        sh_println("write: failed to create file" as void*);
        return;
    }

    // テキストの長さを計算
    ulong text_len = 0;
    while (true) {
        ulong ch = read_byte(text_addr + text_len);
        if (ch == 0) { break; }
        text_len = text_len + 1;
    }

    // 書き込み（先頭から上書き）
    ramfs_truncate(ino);
    long written = ramfs_write(ino, text_addr, 0, text_len);
    if (written > 0) {
        sh_print("Wrote " as void*);
        sh_print_dec(written as ulong);
        sh_print(" bytes to " as void*);
        sh_println(name_addr as void*);
    } else {
        sh_println("write: failed" as void*);
    }
}

// ============================================================
// 新コマンド (Phase 3C)
// ============================================================

/// echo コマンド: テキスト出力
void cmd_echo(ulong text_addr) {
    if (text_addr != 0) {
        sh_println(text_addr as void*);
    } else {
        sh_putc(10);
    }
}

/// rm コマンド: ファイル削除
void cmd_rm(ulong name_addr) {
    if (name_addr == 0) {
        sh_println("Usage: rm <filename>" as void*);
        return;
    }
    long result = ramfs_unlink(name_addr as void*);
    if (result == 0) {
        sh_print("Removed: " as void*);
        sh_println(name_addr as void*);
    } else if (result == (0 - 21)) {
        sh_println("rm: cannot remove directory" as void*);
    } else {
        sh_print("rm: file not found: " as void*);
        sh_println(name_addr as void*);
    }
}

/// mkdir コマンド: ディレクトリ作成
void cmd_mkdir(ulong name_addr) {
    if (name_addr == 0) {
        sh_println("Usage: mkdir <dirname>" as void*);
        return;
    }
    Ino ino = ramfs_mkdir(name_addr as void*);
    if (ino != 0) {
        sh_print("Created directory: " as void*);
        sh_println(name_addr as void*);
    } else {
        sh_println("mkdir: failed to create directory" as void*);
    }
}

/// wc コマンド: バイト/行数カウント
void cmd_wc(ulong name_addr) {
    if (name_addr == 0) {
        sh_println("Usage: wc <filename>" as void*);
        return;
    }
    Ino ino = ramfs_lookup(name_addr as void*);
    if (ino == 0) {
        sh_print("wc: file not found: " as void*);
        sh_println(name_addr as void*);
        return;
    }
    ulong fsize = ramfs_file_size(ino);
    // 行数カウント: ファイルを読み出して\nを数える
    ulong lines = 0;
    ulong read_buf = 0x94100;
    if (fsize > 0) {
        long bytes = ramfs_read(ino, read_buf, 0, fsize);
        if (bytes > 0) {
            ulong j = 0;
            while (j < (bytes as ulong)) {
                ulong ch = read_byte(read_buf + j);
                if (ch == 10) { lines = lines + 1; }
                j = j + 1;
            }
            // 末尾が\nでない場合も１行と数える
            if (bytes > 0) {
                ulong last = read_byte(read_buf + (bytes as ulong) - 1);
                if (last != 10) { lines = lines + 1; }
            }
        }
    }
    sh_print("  " as void*);
    sh_print_dec(lines);
    sh_print(" lines, " as void*);
    sh_print_dec(fsize);
    sh_print(" bytes  " as void*);
    sh_println(name_addr as void*);
}

/// hexdump コマンド: 16進ダンプ
void cmd_hexdump(ulong name_addr) {
    if (name_addr == 0) {
        sh_println("Usage: hexdump <filename>" as void*);
        return;
    }
    Ino ino = ramfs_lookup(name_addr as void*);
    if (ino == 0) {
        sh_print("hexdump: file not found: " as void*);
        sh_println(name_addr as void*);
        return;
    }
    ulong fsize = ramfs_file_size(ino);
    if (fsize == 0) {
        sh_println("(empty file)" as void*);
        return;
    }
    // 最大256バイトまで表示
    ulong show_size = fsize;
    if (show_size > 256) { show_size = 256; }
    ulong read_buf = 0x94100;
    long bytes = ramfs_read(ino, read_buf, 0, show_size);
    if (bytes <= 0) { return; }
    ulong row = 0;
    while (row < (bytes as ulong)) {
        // オフセット表示 (8桁hex)
        sh_print_hex(row);
        sh_print("  " as void*);
        // 16バイトずつ表示
        ulong col = 0;
        while (col < 16) {
            if (row + col < (bytes as ulong)) {
                ulong b = read_byte(read_buf + row + col);
                sh_print_hex_byte(b);
                sh_putc(32);  // スペース
            } else {
                sh_print("   " as void*);
            }
            col = col + 1;
        }
        sh_print(" |" as void*);
        // ASCII表示
        col = 0;
        while (col < 16) {
            if (row + col < (bytes as ulong)) {
                ulong b = read_byte(read_buf + row + col);
                if (b >= 32) {
                    if (b < 127) {
                        sh_putc(b);
                    } else {
                        sh_putc(46);  // '.'
                    }
                } else {
                    sh_putc(46);  // '.'
                }
            }
            col = col + 1;
        }
        sh_println("|" as void*);
        row = row + 16;
    }
    if (fsize > 256) {
        sh_println("... (truncated)" as void*);
    }
}

/// 1バイトぢ16進表示 (2桁)
void sh_print_hex_byte(ulong val) {
    ulong hi = (val >> 4) & 0xF;
    ulong lo = val & 0xF;
    if (hi < 10) { sh_putc(48 + hi); } else { sh_putc(87 + hi); }
    if (lo < 10) { sh_putc(48 + lo); } else { sh_putc(87 + lo); }
}

/// 16進表示 (8桁)
void sh_print_hex(ulong val) {
    ulong i = 0;
    while (i < 8) {
        ulong shift = (7 - i) * 4;
        ulong nibble = (val >> shift) & 0xF;
        if (nibble < 10) { sh_putc(48 + nibble); } else { sh_putc(87 + nibble); }
        i = i + 1;
    }
}

// ============================================================
// 新コマンド (Phase 5)
// ============================================================

/// uname コマンド: システム情報表示
void cmd_uname(ulong flags_addr) {
    // uname -a の場合: 全情報表示
    if (flags_addr != 0) {
        if (startswith(flags_addr as void*, "-a" as void*) != 0) {
            sh_println("Cosmo Linux 0.1.0 cosmo x86_64 Cm/LLVM" as void*);
            return;
        }
    }
    sh_println("Cosmo Linux" as void*);
}

/// date コマンド: 時刻表示（PIT ticksからの簡易計算）
void cmd_date() {
    ulong ticks = pit_get_ticks();
    ulong total_secs = ticks / 100;
    ulong hours = total_secs / 3600;
    ulong mins = (total_secs % 3600) / 60;
    ulong secs = total_secs % 60;
    sh_print("Up " as void*);
    sh_print_dec(hours);
    sh_print(":" as void*);
    if (mins < 10) { sh_print("0" as void*); }
    sh_print_dec(mins);
    sh_print(":" as void*);
    if (secs < 10) { sh_print("0" as void*); }
    sh_print_dec(secs);
    sh_print(" (" as void*);
    sh_print_dec(ticks);
    sh_println(" ticks)" as void*);
}

/// cp コマンド: ファイルコピー
void cmd_cp(ulong src_addr, ulong dst_addr) {
    if (src_addr == 0) {
        sh_println("Usage: cp <src> <dst>" as void*);
        return;
    }
    if (dst_addr == 0) {
        sh_println("Usage: cp <src> <dst>" as void*);
        return;
    }
    // srcのファイル名をNUL終端（スペースで区切り）
    ulong end = dst_addr - 1;
    ulong done_s = 0;
    while (done_s == 0) {
        if (end <= src_addr) { done_s = 1; }
        else {
            ulong c = read_byte(end - 1);
            if (c != 32) { done_s = 1; }
            else { end = end - 1; }
        }
    }
    write_byte(end, 0);

    // ソース検索
    Ino src_ino = ramfs_lookup(src_addr as void*);
    if (src_ino == 0) {
        sh_print("cp: source not found: " as void*);
        sh_println(src_addr as void*);
        return;
    }
    ulong fsize = ramfs_file_size(src_ino);

    // デスティネーション作成
    ulong* pmm_addr_ptr = SHELL_PMM_ADDR as ulong*;
    BuddyAllocator* pmm = (*pmm_addr_ptr) as BuddyAllocator*;
    ulong data_page = pmm->alloc_pages(0);
    if (data_page != 0) {
        memzero(data_page as void*, PAGE_SIZE);
    }
    Ino dst_ino = ramfs_create(dst_addr as void*, S_IFREG | 0x1B6, data_page);
    if (dst_ino == 0) {
        sh_println("cp: failed to create destination" as void*);
        return;
    }

    // データコピー
    if (fsize > 0) {
        ulong read_buf = 0x94100;
        long bytes = ramfs_read(src_ino, read_buf, 0, fsize);
        if (bytes > 0) {
            ramfs_write(dst_ino, read_buf, 0, bytes as ulong);
        }
    }
    sh_print("Copied: " as void*);
    sh_print(src_addr as void*);
    sh_print(" -> " as void*);
    sh_println(dst_addr as void*);
}

/// mv コマンド: ファイル移動/リネーム（cp + rm）
void cmd_mv(ulong src_addr, ulong dst_addr) {
    if (src_addr == 0) {
        sh_println("Usage: mv <src> <dst>" as void*);
        return;
    }
    if (dst_addr == 0) {
        sh_println("Usage: mv <src> <dst>" as void*);
        return;
    }
    // srcのファイル名をNUL終端
    ulong end = dst_addr - 1;
    ulong done_s = 0;
    while (done_s == 0) {
        if (end <= src_addr) { done_s = 1; }
        else {
            ulong c = read_byte(end - 1);
            if (c != 32) { done_s = 1; }
            else { end = end - 1; }
        }
    }
    write_byte(end, 0);

    // cpと同じ処理
    Ino src_ino = ramfs_lookup(src_addr as void*);
    if (src_ino == 0) {
        sh_print("mv: source not found: " as void*);
        sh_println(src_addr as void*);
        return;
    }
    ulong fsize = ramfs_file_size(src_ino);

    ulong* pmm_addr_ptr = SHELL_PMM_ADDR as ulong*;
    BuddyAllocator* pmm = (*pmm_addr_ptr) as BuddyAllocator*;
    ulong data_page = pmm->alloc_pages(0);
    if (data_page != 0) {
        memzero(data_page as void*, PAGE_SIZE);
    }
    Ino dst_ino = ramfs_create(dst_addr as void*, S_IFREG | 0x1B6, data_page);
    if (dst_ino == 0) {
        sh_println("mv: failed to create destination" as void*);
        return;
    }
    if (fsize > 0) {
        ulong read_buf = 0x94100;
        long bytes = ramfs_read(src_ino, read_buf, 0, fsize);
        if (bytes > 0) {
            ramfs_write(dst_ino, read_buf, 0, bytes as ulong);
        }
    }
    // ソース削除
    ramfs_unlink(src_addr as void*);
    sh_print("Moved: " as void*);
    sh_print(src_addr as void*);
    sh_print(" -> " as void*);
    sh_println(dst_addr as void*);
}

/// head コマンド: 先頭10行表示
void cmd_head(ulong name_addr) {
    if (name_addr == 0) {
        sh_println("Usage: head <filename>" as void*);
        return;
    }
    Ino ino = ramfs_lookup(name_addr as void*);
    if (ino == 0) {
        sh_print("head: file not found: " as void*);
        sh_println(name_addr as void*);
        return;
    }
    ulong fsize = ramfs_file_size(ino);
    if (fsize == 0) {
        sh_println("(empty file)" as void*);
        return;
    }
    ulong read_buf = 0x94100;
    long bytes = ramfs_read(ino, read_buf, 0, fsize);
    if (bytes > 0) {
        ulong lines = 0;
        ulong j = 0;
        while (j < (bytes as ulong)) {
            ulong ch = read_byte(read_buf + j);
            sh_putc(ch);
            if (ch == 10) {
                lines = lines + 1;
                if (lines >= 10) { break; }
            }
            j = j + 1;
        }
        // 末尾改行がなければ追加
        if (lines < 10) {
            ulong last = read_byte(read_buf + (bytes as ulong) - 1);
            if (last != 10) { sh_putc(10); }
        }
    }
}

// ============================================================
// 新コマンド (Phase 6)
// ============================================================

/// cd コマンド: ディレクトリ変更
void cmd_cd(ulong dir_addr) {
    if (dir_addr == 0) {
        // cd のみ → ルートに移動
        cwd_set("/" as void*);
        return;
    }
    // "/" は常に存在
    ulong ch0 = read_byte(dir_addr);
    if (ch0 == 47) {
        // 絶対パス
        cwd_set(dir_addr as void*);
        return;
    }
    // ".." → 親ディレクトリ
    if (ch0 == 46) {
        ulong ch1 = read_byte(dir_addr + 1);
        if (ch1 == 46) {
            ulong ch2 = read_byte(dir_addr + 2);
            if (ch2 == 0) {
                cwd_set("/" as void*);
                return;
            }
        }
        if (ch1 == 0) {
            // "." → 何もしない
            return;
        }
    }
    // 相対パス → CWD + "/" + dir で合成（簡易版: ルート直下のみ）
    // ramfsでディレクトリ存在確認
    Ino ino = ramfs_lookup(dir_addr as void*);
    if (ino == 0) {
        sh_print("cd: no such directory: " as void*);
        sh_println(dir_addr as void*);
        return;
    }
    // "/" + name に合成
    ulong tmp_buf = 0x94200;
    write_byte(tmp_buf, 47);  // '/'
    ulong j = 0;
    while (true) {
        ulong c = read_byte(dir_addr + j);
        if (c == 0) { break; }
        write_byte(tmp_buf + 1 + j, c);
        j = j + 1;
    }
    write_byte(tmp_buf + 1 + j, 0);
    cwd_set(tmp_buf as void*);
}

/// pwd コマンド: カレントディレクトリ表示
void cmd_pwd() {
    ulong addr = cwd_get();
    sh_println(addr as void*);
}


// ============================================================
// コマンド履歴
// ============================================================

/// 履歴初期化
void hist_init() {
    memzero(HIST_BASE as void*, HIST_MAX * HIST_ENTRY_SIZE);
    ulong* count = HIST_COUNT as ulong*;  *count = 0;
    ulong* index = HIST_INDEX as ulong*;  *index = 0;
}

/// コマンドを履歴に追加
void hist_add(ulong cmd_addr, ulong len) {
    if (len == 0) { return; }
    ulong* count = HIST_COUNT as ulong*;
    ulong idx = *count % HIST_MAX;
    ulong dest = HIST_BASE + idx * HIST_ENTRY_SIZE;
    // コピー
    ulong i = 0;
    while (i < len) {
        if (i < HIST_ENTRY_SIZE - 1) {
            ulong ch = read_byte(cmd_addr + i);
            write_byte(dest + i, ch);
        }
        i = i + 1;
    }
    write_byte(dest + len, 0);
    *count = *count + 1;
}

/// 履歴から取得（最新からoffset番目: 0=最新）
/// 戻り値: 履歴エントリのアドレス。0なら範囲外。
ulong hist_get(ulong offset) {
    ulong* count = HIST_COUNT as ulong*;
    if (*count == 0) { return 0; }
    if (offset >= *count) { return 0; }
    if (offset >= HIST_MAX) { return 0; }
    ulong actual = (*count - 1 - offset) % HIST_MAX;
    return HIST_BASE + actual * HIST_ENTRY_SIZE;
}

/// 履歴エントリをコマンドバッファにコピーして表示
void hist_restore(ulong hist_addr) {
    // 現在の入力をクリア
    ulong* len_ptr = CMD_LEN_ADDR as ulong*;
    ulong old_len = *len_ptr;
    // バックスペースで消去
    ulong k = 0;
    while (k < old_len) {
        vga_putc(8);
        k = k + 1;
    }
    // 履歴コピー
    ulong i = 0;
    while (true) {
        ulong ch = read_byte(hist_addr + i);
        if (ch == 0) { break; }
        write_byte(CMD_BUF_ADDR + i, ch);
        sh_putc(ch);
        i = i + 1;
    }
    *len_ptr = i;
}

// ============================================================
// コマンドディスパッチ（LLVM domination error回避のため関数分離）
// ============================================================

/// writeコマンドの引数パース＆実行
void dispatch_write() {
    ulong arg1 = cmd_arg(CMD_BUF_ADDR);
    ulong arg2 = cmd_arg2(CMD_BUF_ADDR);
    if (arg2 != 0) {
        // ファイル名部分をNUL終端（スペースまで遡る）
        ulong end = arg2 - 1;
        ulong done = 0;
        while (done == 0) {
            if (end <= arg1) { done = 1; }
            else {
                ulong c = read_byte(end - 1);
                if (c != 32) { done = 1; }
                else { end = end - 1; }
            }
        }
        write_byte(end, 0);
    }
    cmd_write(arg1, arg2);
}

/// cp/mvコマンドの引数パース分離
void dispatch_cp() {
    ulong arg1 = cmd_arg(CMD_BUF_ADDR);
    ulong arg2 = cmd_arg2(CMD_BUF_ADDR);
    cmd_cp(arg1, arg2);
}

void dispatch_mv() {
    ulong arg1 = cmd_arg(CMD_BUF_ADDR);
    ulong arg2 = cmd_arg2(CMD_BUF_ADDR);
    cmd_mv(arg1, arg2);
}

/// コマンドディスパッチ（早期return方式）
void dispatch_cmd() {
    if (streq(CMD_BUF_ADDR as void*, "help" as void*) != 0) {
        cmd_help();
        return;
    }
    if (streq(CMD_BUF_ADDR as void*, "ps" as void*) != 0) {
        cmd_ps();
        return;
    }
    if (streq(CMD_BUF_ADDR as void*, "free" as void*) != 0) {
        cmd_free();
        return;
    }
    if (streq(CMD_BUF_ADDR as void*, "uptime" as void*) != 0) {
        cmd_uptime();
        return;
    }
    if (streq(CMD_BUF_ADDR as void*, "clear" as void*) != 0) {
        vga_clear_screen();
        return;
    }
    if (streq(CMD_BUF_ADDR as void*, "reboot" as void*) != 0) {
        cmd_reboot();
        return;
    }
    if (streq(CMD_BUF_ADDR as void*, "uname" as void*) != 0) {
        cmd_uname(0);
        return;
    }
    if (startswith(CMD_BUF_ADDR as void*, "uname " as void*) != 0) {
        ulong arg = cmd_arg(CMD_BUF_ADDR);
        cmd_uname(arg);
        return;
    }
    if (streq(CMD_BUF_ADDR as void*, "date" as void*) != 0) {
        cmd_date();
        return;
    }
    if (streq(CMD_BUF_ADDR as void*, "ls" as void*) != 0) {
        cmd_ls();
        return;
    }
    if (startswith(CMD_BUF_ADDR as void*, "cat " as void*) != 0) {
        ulong arg = cmd_arg(CMD_BUF_ADDR);
        cmd_cat(arg);
        return;
    }
    if (startswith(CMD_BUF_ADDR as void*, "touch " as void*) != 0) {
        ulong arg = cmd_arg(CMD_BUF_ADDR);
        cmd_touch(arg);
        return;
    }
    if (startswith(CMD_BUF_ADDR as void*, "write " as void*) != 0) {
        dispatch_write();
        return;
    }
    if (startswith(CMD_BUF_ADDR as void*, "cp " as void*) != 0) {
        dispatch_cp();
        return;
    }
    if (startswith(CMD_BUF_ADDR as void*, "mv " as void*) != 0) {
        dispatch_mv();
        return;
    }
    if (startswith(CMD_BUF_ADDR as void*, "head " as void*) != 0) {
        ulong arg = cmd_arg(CMD_BUF_ADDR);
        cmd_head(arg);
        return;
    }
    if (startswith(CMD_BUF_ADDR as void*, "echo " as void*) != 0) {
        ulong arg = cmd_arg(CMD_BUF_ADDR);
        cmd_echo(arg);
        return;
    }
    if (streq(CMD_BUF_ADDR as void*, "echo" as void*) != 0) {
        cmd_echo(0);
        return;
    }
    if (startswith(CMD_BUF_ADDR as void*, "rm " as void*) != 0) {
        ulong arg = cmd_arg(CMD_BUF_ADDR);
        cmd_rm(arg);
        return;
    }
    if (startswith(CMD_BUF_ADDR as void*, "mkdir " as void*) != 0) {
        ulong arg = cmd_arg(CMD_BUF_ADDR);
        cmd_mkdir(arg);
        return;
    }
    if (startswith(CMD_BUF_ADDR as void*, "wc " as void*) != 0) {
        ulong arg = cmd_arg(CMD_BUF_ADDR);
        cmd_wc(arg);
        return;
    }
    if (startswith(CMD_BUF_ADDR as void*, "hexdump " as void*) != 0) {
        ulong arg = cmd_arg(CMD_BUF_ADDR);
        cmd_hexdump(arg);
        return;
    }
    if (streq(CMD_BUF_ADDR as void*, "cd" as void*) != 0) {
        cmd_cd(0);
        return;
    }
    if (startswith(CMD_BUF_ADDR as void*, "cd " as void*) != 0) {
        ulong arg = cmd_arg(CMD_BUF_ADDR);
        cmd_cd(arg);
        return;
    }
    if (streq(CMD_BUF_ADDR as void*, "pwd" as void*) != 0) {
        cmd_pwd();
        return;
    }
    sh_print("Unknown command: " as void*);
    sh_println(CMD_BUF_ADDR as void*);
}

// ============================================================
// シェルメインループ
// ============================================================

export void shell_main() {
    // VGA画面クリア＆ウェルカムバナー
    sh_set_color(7, 0);
    vga_clear_screen();

    sh_set_color(11, 0);
    sh_println("========================================" as void*);
    sh_println("  Cosmo Linux v0.1.0" as void*);
    sh_println("  Written in Cm - A Linux reimagined" as void*);
    sh_println("========================================" as void*);

    sh_set_color(7, 0);
    sh_println("" as void*);
    sh_println("Welcome to Cosmo Linux!" as void*);
    sh_println("Type 'help' for available commands." as void*);
    sh_println("" as void*);

    // コマンドバッファ長初期化
    ulong* len_ptr = CMD_LEN_ADDR as ulong*;
    *len_ptr = 0;

    // 履歴初期化
    hist_init();

    // 履歴ナビゲーション位置
    ulong hist_pos = 0;

    // REPLループ
    while (true) {
        // プロンプト表示
        sh_set_color(10, 0);
        sh_print("cosmo" as void*);
        sh_set_color(14, 0);
        sh_print(":" as void*);
        sh_set_color(12, 0);
        sh_print("/" as void*);
        sh_set_color(7, 0);
        sh_print("$ " as void*);

        // 履歴ポジションリセット
        hist_pos = 0;

        // キー入力ループ
        ulong input_done = 0;
        while (input_done == 0) {
            ulong ch = kbd_getchar();
            if (ch == 0) {
                __asm__(`hlt`);
            } else if (ch == 10) {
                // Enter: コマンド実行
                sh_putc(10);
                ulong len = *len_ptr;
                write_byte(CMD_BUF_ADDR + len, 0);
                if (len > 0) {
                    // 履歴に追加
                    hist_add(CMD_BUF_ADDR, len);
                    dispatch_cmd();
                }
                *len_ptr = 0;
                input_done = 1;
            } else if (ch == 8) {
                // Backspace
                ulong len = *len_ptr;
                if (len > 0) {
                    *len_ptr = len - 1;
                    vga_putc(8);
                    ulong* ser_ptr = SHELL_SERIAL_ADDR as ulong*;
                    SerialPort* ser = (*ser_ptr) as SerialPort*;
                    ser->putc(8);
                    ser->putc(32);
                    ser->putc(8);
                }
            } else if (ch == 0x80) {
                // 上矢印キー（キーボードドライバから0x80）
                ulong addr = hist_get(hist_pos);
                if (addr != 0) {
                    hist_restore(addr);
                    hist_pos = hist_pos + 1;
                }
            } else if (ch == 0x81) {
                // 下矢印キー（キーボードドライバから0x81）
                if (hist_pos > 0) {
                    hist_pos = hist_pos - 1;
                    if (hist_pos > 0) {
                        ulong addr = hist_get(hist_pos - 1);
                        if (addr != 0) {
                            hist_restore(addr);
                        }
                    } else {
                        // 最新位置: バッファクリア
                        ulong old_len = *len_ptr;
                        ulong k = 0;
                        while (k < old_len) {
                            vga_putc(8);
                            k = k + 1;
                        }
                        *len_ptr = 0;
                    }
                }
            } else if (ch == 3) {
                // Ctrl+C: 入力キャンセル
                sh_set_color(9, 0);
                sh_print("^C" as void*);
                sh_set_color(7, 0);
                sh_putc(10);
                *len_ptr = 0;
                input_done = 1;
            } else if (ch == 12) {
                // Ctrl+L: 画面クリア
                vga_clear_screen();
                *len_ptr = 0;
                input_done = 1;
            } else {
                // 表示可能文字
                ulong len = *len_ptr;
                if (len < CMD_BUF_SIZE - 1) {
                    write_byte(CMD_BUF_ADDR + len, ch & 0xFF);
                    *len_ptr = len + 1;
                    sh_putc(ch);
                }
            }
        }
    }
}

/// シェル初期化
export void shell_init(ulong serial_addr, ulong pmm_addr) {
    ulong* ser_ptr = SHELL_SERIAL_ADDR as ulong*;
    *ser_ptr = serial_addr;
    ulong* pmm_ptr = SHELL_PMM_ADDR as ulong*;
    *pmm_ptr = pmm_addr;
    ulong* col_ptr = SH_VGA_COL_ADDR as ulong*;
    *col_ptr = 0;
    ulong* row_ptr = SH_VGA_ROW_ADDR as ulong*;
    *row_ptr = 0;
    ulong* color_ptr = SH_VGA_COLOR_ADDR as ulong*;
    *color_ptr = 0x07;
    ulong* len_ptr = CMD_LEN_ADDR as ulong*;
    *len_ptr = 0;
}
