//! platform: baremetal-x86
// cosmo-linux::ui::shell - カーネルシェル

/// Mem — メモリ読み書きユーティリティ
export struct Mem {}
/// Vga — VGAテキストモードドライバ
export struct Vga {}
/// Shell — シェル出力ユーティリティ
export struct Shell {}
/// Env — 環境変数管理
export struct Env {}
/// History — コマンド履歴管理
export struct History {}
/// Cmd — シェルコマンド群
export struct Cmd {}

//
// VGA直接バッファ操作 + シリアル出力 + キーボード入力
// Cm言語のutiny*ポインタ読み取りバグを回避するため全て
// インラインASM (movzbl) でバイト読み取りを行う
//
// 参照: linux/kernel/sys.c

import ../include/types;
import ../include/config;
import ../include/scheduler;
import ../drivers/serial;
import ../drivers/pit;
import ../drivers/keyboard;
import ../sched/scheduler;
import ../mm/pmm;
import ../lib/printk;
import ../include/vfs;
import ../fs/ramfs;
import ../fs/procfs;
import ../init/init;

// ============================================================
// シェル用固定メモリ
// ============================================================

const PhysAddr SHELL_SERIAL_ADDR = 0x95008;
const PhysAddr SHELL_PMM_ADDR = 0x95010;

/// VGA直接操作用状態
const PhysAddr SH_VGA_COL_ADDR   = 0x95020;
const PhysAddr SH_VGA_ROW_ADDR   = 0x95028;
const PhysAddr SH_VGA_COLOR_ADDR = 0x95030;

/// コマンドバッファ
const PhysAddr CMD_BUF_ADDR = 0x94000;
const PhysAddr CMD_LEN_ADDR = 0x94080;
const ulong CMD_BUF_SIZE = 128;

/// コマンド履歴
const PhysAddr HIST_BASE = 0x95100;  // 8エントリ × 128バイト = 1024バイト
const PhysAddr HIST_COUNT = 0x95500;
const PhysAddr HIST_INDEX = 0x95508;
const ulong HIST_MAX = 8;
const ulong HIST_ENTRY_SIZE = 128;

/// VGAスクロールバックバッファ (50行×80文字=4000B)
const PhysAddr SCROLL_BUF = 0x97000;
const PhysAddr SCROLL_HEAD = 0x97FA0;
const PhysAddr SCROLL_COUNT = 0x97FA8;
const ulong SCROLL_MAX = 50;
const ulong SCROLL_COLS = 80;

/// 環境変数テーブル (16エントリ × 128バイト = 2048B)
const PhysAddr ENV_TABLE = 0x98000;
const ulong ENV_MAX = 16;
const ulong ENV_KEY_LEN = 32;
const ulong ENV_VAL_LEN = 96;
const ulong ENV_ENTRY_SIZE = 128;  // key(32) + val(96)

/// VGAバッファ
const PhysAddr VGA_BUF = 0xB8000;
const ulong VGA_COLS = 80;
const ulong VGA_ROWS = 25;

// （read_byte / write_byte はローカル定義）

// ============================================================
// VGA直接バッファ操作

// ============================================================
// シェル出力ヘルパー（VGA + シリアル同時出力）

// ============================================================
