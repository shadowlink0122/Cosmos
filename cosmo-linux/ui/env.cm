//! platform: baremetal-x86
// cosmo-linux::ui::env - 環境変数管理
//
// Env struct/impl — KEY=VALUE ペアのテーブル管理。

import ./shell_const;
import ./mem;
import ./shell_util;
import ../lib/kstring;

/// Env — 環境変数管理
export struct Env {}

impl Env {
    /// 環境変数初期化
    static void setup() {
        memzero(ENV_TABLE as void*, ENV_MAX * ENV_ENTRY_SIZE);
        // デフォルト変数設定
        Env::set("HOME" as void*, "/" as void*);
        Env::set("SHELL" as void*, "/bin/sh" as void*);
        Env::set("PATH" as void*, "/bin:/usr/bin" as void*);
    }

    /// 環境変数設定
    static void set(void* key, void* val) {
        ulong k_addr = key as ulong;
        ulong v_addr = val as ulong;
        // 既存エントリを検索
        ulong i = 0;
        while (i < ENV_MAX) {
            ulong entry = ENV_TABLE + i * ENV_ENTRY_SIZE;
            ulong first = Mem::read_byte(entry);
            if (first != 0) {
                if (streq(entry as void*, key) != 0) {
                    // 値を更新
                    ulong vdest = entry + ENV_KEY_LEN;
                    ulong j = 0;
                    while (j < ENV_VAL_LEN - 1) {
                        ulong c = Mem::read_byte(v_addr + j);
                        Mem::write_byte(vdest + j, c);
                        if (c == 0) { break; }
                        j = j + 1;
                    }
                    Mem::write_byte(vdest + j, 0);
                    return;
                }
            }
            i = i + 1;
        }
        // 空きエントリに追加
        i = 0;
        while (i < ENV_MAX) {
            ulong entry = ENV_TABLE + i * ENV_ENTRY_SIZE;
            if (Mem::read_byte(entry) == 0) {
                // キーコピー
                ulong j = 0;
                while (j < ENV_KEY_LEN - 1) {
                    ulong c = Mem::read_byte(k_addr + j);
                    Mem::write_byte(entry + j, c);
                    if (c == 0) { break; }
                    j = j + 1;
                }
                Mem::write_byte(entry + j, 0);
                // 値コピー
                ulong vdest = entry + ENV_KEY_LEN;
                j = 0;
                while (j < ENV_VAL_LEN - 1) {
                    ulong c = Mem::read_byte(v_addr + j);
                    Mem::write_byte(vdest + j, c);
                    if (c == 0) { break; }
                    j = j + 1;
                }
                Mem::write_byte(vdest + j, 0);
                return;
            }
            i = i + 1;
        }
    }

    /// 環境変数取得 (見つからない場合は0を返す)
    static ulong get(void* key) {
        ulong i = 0;
        while (i < ENV_MAX) {
            ulong entry = ENV_TABLE + i * ENV_ENTRY_SIZE;
            if (Mem::read_byte(entry) != 0) {
                if (streq(entry as void*, key) != 0) {
                    return entry + ENV_KEY_LEN;
                }
            }
            i = i + 1;
        }
        return 0;
    }

}
