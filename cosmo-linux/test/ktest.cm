//! platform: baremetal-x86
// cosmo-linux::test::ktest - カーネルテストフレームワーク
//
// カーネル内ユニットテストを実行し結果をシリアルとVGAに表示。
// 参照: linux/lib/kunit

import ../include/types;
import ../include/config;
import ../include/vfs;
import ../net/http;
import ../net/http_server;
import ../include/errno;
import ../include/scheduler;
import ../include/signal;
import ../drivers/serial;
import ../drivers/keyboard;
import ../drivers/mouse;
import ../lib/printk;
import ../lib/kstring;
import ../fs/devfs;
import ../fs/pipe;
import ../fs/fd_table;
import ../sys/signal;
import ../sched/process;
import ../mm/mmap;
import ../include/net;
import ../net/loopback;
import ../net/socket;
import ../net/tcp;
import ../net/ip;
import ../net/icmp;
import ../ui/mem;
import ./test_io;

// ============================================================
// テスト結果カウンタ
// ============================================================

/// テスト統計アドレス (pass/fail/total)
const PhysAddr KTEST_STATS = 0x9C000;

/// KTest — カーネルテストフレームワーク
export struct KTest {}

impl KTest {
    /// テスト統計初期化
    static void reset() {
        ulong* pass  = KTEST_STATS as ulong*;
        ulong* fail  = (KTEST_STATS + 8) as ulong*;
        ulong* total = (KTEST_STATS + 16) as ulong*;
        *pass  = 0;
        *fail  = 0;
        *total = 0;
    }

    /// テストパス記録
    static void pass(void* name) {
        ulong* p = KTEST_STATS as ulong*;
        ulong* t = (KTEST_STATS + 16) as ulong*;
        *p = *p + 1;
        *t = *t + 1;
        TestIO::set_color(10, 0);  // 緑
        TestIO::write("  [PASS] " as void*);
        TestIO::set_color(7, 0);
        TestIO::writeln(name);
        // シリアルにも出力
        SerialPort s(COM1);
        s.puts("  [PASS] " as void*);
        s.println(name);
    }

    /// テストフェイル記録
    static void fail(void* name) {
        ulong* f = (KTEST_STATS + 8) as ulong*;
        ulong* t = (KTEST_STATS + 16) as ulong*;
        *f = *f + 1;
        *t = *t + 1;
        TestIO::set_color(12, 0);  // 赤
        TestIO::write("  [FAIL] " as void*);
        TestIO::set_color(7, 0);
        TestIO::writeln(name);
        // シリアルにも出力
        SerialPort s(COM1);
        s.puts("  [FAIL] " as void*);
        s.println(name);
    }

    /// アサート: 条件が真であることを検証
    static void assert_true(ulong cond, void* name) {
        if (cond != 0) {
            KTest::pass(name);
        } else {
            KTest::fail(name);
        }
    }

    /// アサート: 値が等しいことを検証
    static void assert_eq(ulong actual, ulong expected, void* name) {
        if (actual == expected) {
            KTest::pass(name);
        } else {
            KTest::fail(name);
            TestIO::write("    expected=" as void*);
            TestIO::print_dec(expected);
            TestIO::write(" actual=" as void*);
            TestIO::print_dec(actual);
            TestIO::putc(10);
        }
    }

    /// アサート: 値がゼロでないことを検証
    static void assert_nonzero(ulong val, void* name) {
        if (val != 0) {
            KTest::pass(name);
        } else {
            KTest::fail(name);
        }
    }

    /// テスト結果サマリ表示
    static void summary() {
        ulong* pass  = KTEST_STATS as ulong*;
        ulong* fail  = (KTEST_STATS + 8) as ulong*;
        ulong* total = (KTEST_STATS + 16) as ulong*;

        TestIO::writeln("" as void*);
        if (*fail == 0) {
            TestIO::set_color(10, 0);
            TestIO::write("All tests passed: " as void*);
        } else {
            TestIO::set_color(12, 0);
            TestIO::write("Tests failed: " as void*);
        }
        TestIO::print_dec(*pass);
        TestIO::write("/" as void*);
        TestIO::print_dec(*total);
        TestIO::write(" passed, " as void*);
        TestIO::print_dec(*fail);
        TestIO::writeln(" failed" as void*);
        TestIO::set_color(7, 0);

        // シリアル出力: Makefile結果判定用マーカー
        SerialPort serial(COM1);
        if (*fail == 0) {
            serial.println("KTEST_RESULT:PASS" as void*);
        } else {
            serial.println("KTEST_RESULT:FAIL" as void*);
        }
    }

    // ============================================================
    // テストスイート
    // ============================================================

    /// 全テスト実行
    static void run_all() {
        KTest::reset();
        TestIO::writeln("" as void*);
        TestIO::set_color(11, 0);
        TestIO::writeln("=== Cosmo Linux Kernel Tests ===" as void*);
        TestIO::set_color(7, 0);

        KTest::test_input();
        KTest::test_devfs();
        KTest::test_pipe();
        KTest::test_signal();
        KTest::test_fd_table();
        KTest::test_vma();
        KTest::test_process();
        KTest::test_loopback();
        KTest::test_socket();
        KTest::test_ipv4();
        KTest::test_tcp_conn();
        KTest::test_icmp();

        KTest::summary();
    }

    // ============================================================
    // DevFS テスト
    // ============================================================

    static void test_devfs() {
        TestIO::set_color(14, 0);
        TestIO::writeln("[DevFS]" as void*);
        TestIO::set_color(7, 0);

        // /dev/null lookup
        ulong dev = DevFs::lookup("null" as void*);
        KTest::assert_eq(dev, DEV_NULL, "lookup /dev/null" as void*);

        dev = DevFs::lookup("zero" as void*);
        KTest::assert_eq(dev, DEV_ZERO, "lookup /dev/zero" as void*);

        dev = DevFs::lookup("random" as void*);
        KTest::assert_eq(dev, DEV_RANDOM, "lookup /dev/random" as void*);

        dev = DevFs::lookup("nonexistent" as void*);
        KTest::assert_eq(dev, 0, "lookup nonexistent returns 0" as void*);

        // /dev/null read → EOF (0)
        ulong buf_addr = 0x9D000;  // テスト用一時バッファ
        long n = DevFs::read(DEV_NULL, buf_addr, 64);
        KTest::assert_eq(n as ulong, 0, "/dev/null read returns 0 (EOF)" as void*);

        // /dev/null write → count
        n = DevFs::write(DEV_NULL, buf_addr, 100);
        KTest::assert_eq(n as ulong, 100, "/dev/null write returns count" as void*);

        // /dev/zero read → fills zeros
        // バッファに0xFF埋め
        ulong i = 0;
        while (i < 16) {
            ulong addr = buf_addr + i;
            __asm__(`
                movq ${r:addr}, %rdi;
                movb $$0xFF, (%rdi)
            `);
            i = i + 1;
        }
        n = DevFs::read(DEV_ZERO, buf_addr, 16);
        KTest::assert_eq(n as ulong, 16, "/dev/zero read returns count" as void*);
        // 最初のバイトがゼロか確認
        ulong first_byte = 0;
        __asm__(`
            movq ${r:buf_addr}, %rdi;
            xorq %rax, %rax;
            movb (%rdi), %al;
            movq %rax, ${=r:first_byte}
        `);
        KTest::assert_eq(first_byte, 0, "/dev/zero fills with zeros" as void*);

        // /dev/random read → nonzero return
        n = DevFs::read(DEV_RANDOM, buf_addr, 32);
        KTest::assert_eq(n as ulong, 32, "/dev/random read returns count" as void*);
    }

    // ============================================================
    // Pipe テスト
    // ============================================================

    static void test_pipe() {
        TestIO::set_color(14, 0);
        TestIO::writeln("[Pipe]" as void*);
        TestIO::set_color(7, 0);

        // パイプ作成
        long pipe_id = Pipe::create();
        if (pipe_id >= 0) {
            KTest::assert_true(1, "pipe create succeeds" as void*);
        } else {
            KTest::assert_true(0, "pipe create succeeds" as void*);
        }

        // 空パイプから読み込み → 0
        ulong buf = 0x9D100;
        long n = Pipe::read(pipe_id as ulong, buf, 32);
        KTest::assert_eq(n as ulong, 0, "empty pipe read returns 0" as void*);

        // 書き込み
        ulong msg_addr = "Hello" as ulong;
        n = Pipe::write(pipe_id as ulong, msg_addr, 5);
        KTest::assert_eq(n as ulong, 5, "pipe write 5 bytes" as void*);

        // 読み込み
        memzero(buf as void*, 32);
        n = Pipe::read(pipe_id as ulong, buf, 32);
        KTest::assert_eq(n as ulong, 5, "pipe read returns 5 bytes" as void*);

        // 読み込みデータ検証 (先頭バイト = 'H' = 72)
        ulong first = 0;
        __asm__(`
            movq ${r:buf}, %rdi;
            xorq %rax, %rax;
            movb (%rdi), %al;
            movq %rax, ${=r:first}
        `);
        KTest::assert_eq(first, 72, "pipe data integrity (H=72)" as void*);

        // パイプ解放
        Pipe::destroy(pipe_id as ulong);
        KTest::pass("pipe destroy" as void*);
    }

    // ============================================================
    // Signal テスト
    // ============================================================

    static void test_signal() {
        TestIO::set_color(14, 0);
        TestIO::writeln("[Signal]" as void*);
        TestIO::set_color(7, 0);

        // シグナル定数
        KTest::assert_eq(SIGKILL, 9, "SIGKILL = 9" as void*);
        KTest::assert_eq(SIGTERM, 15, "SIGTERM = 15" as void*);
        KTest::assert_eq(SIGCHLD, 17, "SIGCHLD = 17" as void*);

        // is_pending / clear on current process
        Process* cur = Sched::current();
        ulong cur_addr = cur as ulong;
        if (cur_addr != 0) {
            cur->pending_signal = 0;  // クリア
            KTest::assert_eq(Signal::is_pending(cur, SIGUSR1), 0,
            "no pending SIGUSR1" as void*);
            // SIGUSR1をセット
            cur->pending_signal = cur->pending_signal | (1 << SIGUSR1);
            KTest::assert_eq(Signal::is_pending(cur, SIGUSR1), 1,
            "SIGUSR1 pending after set" as void*);
            // クリア
            Signal::clear(cur, SIGUSR1);
            KTest::assert_eq(Signal::is_pending(cur, SIGUSR1), 0,
            "SIGUSR1 cleared" as void*);
        }
    }

    // ============================================================
    // FDテーブル テスト
    // ============================================================

    static void test_fd_table() {
        TestIO::set_color(14, 0);
        TestIO::writeln("[FdTable]" as void*);
        TestIO::set_color(7, 0);

        // stdin/stdout/stderr は有効
        KTest::assert_eq(FdTable::is_valid(0), 1, "fd 0 (stdin) valid" as void*);
        KTest::assert_eq(FdTable::is_valid(1), 1, "fd 1 (stdout) valid" as void*);
        KTest::assert_eq(FdTable::is_valid(2), 1, "fd 2 (stderr) valid" as void*);

        // 未使用FDは無効
        KTest::assert_eq(FdTable::is_valid(15), 0, "fd 15 invalid" as void*);

        // alloc/free サイクル
        Fd fd = FdTable::alloc(42, O_RDWR, FS_DEVFS);
        if (fd >= 3) {
            KTest::assert_true(1, "alloc returns fd >= 3" as void*);
        } else {
            KTest::assert_true(0, "alloc returns fd >= 3" as void*);
        }
        KTest::assert_eq(FdTable::is_valid(fd), 1, "allocated fd valid" as void*);
        KTest::assert_eq(FdTable::get_fs_type(fd), FS_DEVFS, "fs_type = FS_DEVFS" as void*);

        // dup2
        Fd dup_fd = FdTable::dup2(fd, 10);
        KTest::assert_eq(dup_fd as ulong, 10, "dup2 returns newfd" as void*);
        KTest::assert_eq(FdTable::is_valid(10), 1, "dup2 target valid" as void*);
        KTest::assert_eq(FdTable::get_fs_type(10), FS_DEVFS, "dup2 target fs_type" as void*);

        // クリーンアップ
        FdTable::free(fd);
        FdTable::free(10);
    }

    // ============================================================
    // VMA テスト
    // ============================================================

    static void test_vma() {
        TestIO::set_color(14, 0);
        TestIO::writeln("[VMA/Mmap]" as void*);
        TestIO::set_color(7, 0);

        // 初期VMA数
        ulong initial = Mmap::count();
        KTest::pass("initial VMA count read" as void*);

        // mmap — 匿名マッピング
        ulong addr = Mmap::do_mmap(0, 4096, PROT_READ | PROT_WRITE,
        MAP_PRIVATE | MAP_ANONYMOUS);
        if (addr != MAP_FAILED) {
            KTest::assert_true(1, "mmap anonymous succeeds" as void*);
        } else {
            KTest::assert_true(0, "mmap anonymous succeeds" as void*);
        }
        KTest::assert_eq(Mmap::count(), initial + 1, "VMA count +1" as void*);

        // find_vma
        Vma* vma = Mmap::find_vma(addr);
        ulong vma_addr = vma as ulong;
        KTest::assert_nonzero(vma_addr, "find_vma returns valid" as void*);

        // munmap
        long ret = Mmap::do_munmap(addr, 4096);
        KTest::assert_eq(ret as ulong, 0, "munmap returns 0" as void*);
        KTest::assert_eq(Mmap::count(), initial, "VMA count restored" as void*);
    }

    // ============================================================
    // Process テスト
    // ============================================================

    static void test_process() {
        TestIO::set_color(14, 0);
        TestIO::writeln("[Process]" as void*);
        TestIO::set_color(7, 0);

        // 現在のプロセス
        Process* cur = Sched::current();
        ulong cur_addr = cur as ulong;
        KTest::assert_nonzero(cur_addr, "current process exists" as void*);

        if (cur_addr != 0) {
            if (cur->pid >= 0) {
                KTest::assert_true(1, "current PID >= 0" as void*);
            } else {
                KTest::assert_true(0, "current PID >= 0" as void*);
            }
        }

        // PID 0 (idle) を検索
        Process* idle = ProcessTable::find_by_pid(0);
        ulong idle_addr = idle as ulong;
        KTest::assert_nonzero(idle_addr, "find PID 0 (idle)" as void*);

        // 存在しないPID
        Process* ghost = ProcessTable::find_by_pid(999);
        ulong ghost_addr = ghost as ulong;
        KTest::assert_eq(ghost_addr, 0, "find PID 999 returns null" as void*);
    }

    // ============================================================
    // Loopback テスト
    // ============================================================

    static void test_loopback() {
        TestIO::set_color(14, 0);
        TestIO::writeln("[Loopback]" as void*);
        TestIO::set_color(7, 0);

        Loopback::setup();
        KTest::assert_eq(1, 1, "Loopback setup" as void*);

        ulong buf = 0x9E000;
        ulong i = 0;
        while (i < 64) {
            ulong addr = buf + i;
            ulong val = (i + 0x41) & 0xFF;
            __asm__(`movq ${r:addr}, %rdi; movq ${r:val}, %rax; movb %al, (%rdi)`);
            i = i + 1;
        }
        Loopback::send(buf, 64);
        KTest::assert_eq(1, 1, "Loopback send 64B" as void*);

        ulong rx_buf = 0x9E100;
        ulong rx_len = Loopback::recv(rx_buf, 64);
        KTest::assert_eq(rx_len, 64, "Loopback recv 64B" as void*);

        ulong first_byte = 0;
        __asm__(`movq ${r:rx_buf}, %rdi; xorq %rax, %rax; movb (%rdi), %al; movq %rax, ${=r:first_byte}`);
        KTest::assert_eq(first_byte, 0x41, "Loopback data[0]=0x41" as void*);
    }

    // ============================================================
    // Socket テスト
    // ============================================================

    static void test_socket() {
        TestIO::set_color(14, 0);
        TestIO::writeln("[Socket]" as void*);
        TestIO::set_color(7, 0);

        Socket::setup();
        long fd = Socket::create(AF_INET, SOCK_STREAM, 0);
        ulong fd_ok = 0;
        if (fd >= 0) { fd_ok = 1; }
        KTest::assert_eq(fd_ok, 1, "Socket create" as void*);

        ulong valid = Socket::is_valid(fd as ulong);
        KTest::assert_eq(valid, 1, "Socket is_valid" as void*);

        Socket::close(fd as ulong);
        ulong after_close = Socket::is_valid(fd as ulong);
        KTest::assert_eq(after_close, 0, "Socket closed" as void*);
    }

    // ============================================================
    // IPv4 テスト
    // ============================================================

    static void test_ipv4() {
        TestIO::set_color(14, 0);
        TestIO::writeln("[IPv4]" as void*);
        TestIO::set_color(7, 0);

        ulong pkt = 0x9E200;
        Mem::write_byte(pkt, 0x45); Mem::write_byte(pkt+1, 0);
        Mem::write_byte(pkt+2, 0); Mem::write_byte(pkt+3, 20);
        Mem::write_byte(pkt+4, 0); Mem::write_byte(pkt+5, 0);
        Mem::write_byte(pkt+6, 0); Mem::write_byte(pkt+7, 0);
        Mem::write_byte(pkt+8, 64); Mem::write_byte(pkt+9, 6);
        Mem::write_byte(pkt+10, 0); Mem::write_byte(pkt+11, 0);
        Mem::write_byte(pkt+12, 127); Mem::write_byte(pkt+13, 0);
        Mem::write_byte(pkt+14, 0); Mem::write_byte(pkt+15, 1);
        Mem::write_byte(pkt+16, 127); Mem::write_byte(pkt+17, 0);
        Mem::write_byte(pkt+18, 0); Mem::write_byte(pkt+19, 1);

        IpHeader hdr = { version: 0, ihl: 0, tos: 0, total_len: 0, id: 0, flags: 0, frag_off: 0, ttl: 0, protocol: 0, checksum: 0, src_addr: 0, dst_addr: 0 };
        Ip::parse(pkt, &hdr);
        KTest::assert_eq(hdr.version, 4, "IP version=4" as void*);
        KTest::assert_eq(hdr.ihl, 5, "IP ihl=5" as void*);
        KTest::assert_eq(hdr.ttl, 64, "IP ttl=64" as void*);
        KTest::assert_eq(hdr.protocol, 6, "IP proto=TCP(6)" as void*);

        // チェックサムフィールド=0でチェックサム計算 → 正しいチェックサム値が得られる
        Mem::write_byte(pkt+10, 0); Mem::write_byte(pkt+11, 0);
        ulong computed = Ip::checksum(pkt, 20);
        ulong ck_ok = 0;
        if (computed > 0) { ck_ok = 1; }
        KTest::assert_eq(ck_ok, 1, "IP checksum computed>0" as void*);

        // チェックサム値を書き込んで再計算 → 0になるべき（正当性検証）
        Mem::write_byte(pkt+10, (computed >> 8) & 0xFF);
        Mem::write_byte(pkt+11, computed & 0xFF);
        ulong verify = Ip::checksum(pkt, 20);
        KTest::assert_eq(verify, 0, "IP checksum verified=0" as void*);

        KTest::assert_eq((hdr.src_addr >> 24) & 0xFF, 127, "IP src[0]=127" as void*);
        KTest::assert_eq((hdr.dst_addr >> 24) & 0xFF, 127, "IP dst[0]=127" as void*);
        KTest::assert_eq(hdr.total_len, 20, "IP total_len=20" as void*);
    }

    // ============================================================
    // TCP 接続テスト
    // ============================================================

    static void test_tcp_conn() {
        TestIO::set_color(14, 0);
        TestIO::writeln("[TCP]" as void*);
        TestIO::set_color(7, 0);

        Tcp::setup();
        long server_fd = Socket::create(AF_INET, SOCK_STREAM, 0);
        ulong sf_ok = 0;
        if (server_fd >= 0) { sf_ok = 1; }
        KTest::assert_eq(sf_ok, 1, "TCP server socket" as void*);

        long bind_r = Socket::bind(server_fd as ulong, 0, 8080);
        ulong bind_ok = 0;
        if (bind_r >= 0) { bind_ok = 1; }
        KTest::assert_eq(bind_ok, 1, "TCP bind :8080" as void*);

        long listen_r = Socket::listen(server_fd as ulong, 5);
        ulong listen_ok = 0;
        if (listen_r >= 0) { listen_ok = 1; }
        KTest::assert_eq(listen_ok, 1, "TCP listen" as void*);

        long client_fd = Socket::create(AF_INET, SOCK_STREAM, 0);
        ulong cf_ok = 0;
        if (client_fd >= 0) { cf_ok = 1; }
        KTest::assert_eq(cf_ok, 1, "TCP client socket" as void*);

        // 127.0.0.1 = 0x7F000001
        long conn_r = Socket::connect(client_fd as ulong, 0x7F000001, 8080);
        ulong conn_ok = 0;
        if (conn_r >= 0) { conn_ok = 1; }
        KTest::assert_eq(conn_ok, 1, "TCP connect" as void*);

        ulong msg = 0x9E400;
        Mem::write_byte(msg, 72); Mem::write_byte(msg+1, 105); Mem::write_byte(msg+2, 0);
        long send_r = Socket::send(client_fd as ulong, msg, 2);
        ulong send_ok = 0;
        if (send_r >= 0) { send_ok = 1; }
        KTest::assert_eq(send_ok, 1, "TCP send" as void*);

        // recvテスト（server側で受信）
        ulong recv_buf = 0x9E500;
        long recv_r = Socket::recv(server_fd as ulong, recv_buf, 64);
        ulong recv_ok = 0;
        if (recv_r >= 0) { recv_ok = 1; }
        KTest::assert_eq(recv_ok, 1, "TCP recv" as void*);

        Socket::close(client_fd as ulong);
        Socket::close(server_fd as ulong);
    }

    // ============================================================
    // ICMP テスト
    // ============================================================

    static void test_icmp() {
        TestIO::set_color(14, 0);
        TestIO::writeln("[ICMP]" as void*);
        TestIO::set_color(7, 0);

        ulong echo_buf = 0x9E600;
        IcmpHeader echo_hdr = { icmp_type: ICMP_ECHO_REQUEST, code: 0, checksum: 0, id: 0x1234, seq: 1 };
        Icmp::build(echo_buf, &echo_hdr);
        KTest::assert_eq(Mem::read_byte(echo_buf), ICMP_ECHO_REQUEST, "ICMP type=8" as void*);
        KTest::assert_eq(Mem::read_byte(echo_buf + 1), 0, "ICMP code=0" as void*);

        ulong ck_h = Mem::read_byte(echo_buf + 2);
        ulong ck_l = Mem::read_byte(echo_buf + 3);
        ulong ck_val = (ck_h * 256) + ck_l;
        // build後のチェックサムは0（build内では計算しない）
        KTest::assert_eq(ck_val, 0, "ICMP checksum=0 (no calc in build)" as void*);

        IcmpHeader parsed = { icmp_type: 0, code: 0, checksum: 0, id: 0, seq: 0 };
        Icmp::parse(echo_buf, &parsed);
        KTest::assert_eq(parsed.icmp_type, ICMP_ECHO_REQUEST, "ICMP parse type=8" as void*);
        KTest::assert_eq(parsed.id, 0x1234, "ICMP id=0x1234" as void*);
        KTest::assert_eq(parsed.seq, 1, "ICMP seq=1" as void*);

        ulong reply_buf = 0x9E700;
        Icmp::handle_echo(echo_buf, 8, reply_buf);
        KTest::assert_eq(Mem::read_byte(reply_buf), ICMP_ECHO_REPLY, "ICMP reply type=0" as void*);

        IcmpHeader reply_hdr = { icmp_type: 0, code: 0, checksum: 0, id: 0, seq: 0 };
        Icmp::parse(reply_buf, &reply_hdr);
        KTest::assert_eq(reply_hdr.id, 0x1234, "ICMP reply id=0x1234" as void*);
        KTest::assert_eq(reply_hdr.seq, 1, "ICMP reply seq=1" as void*);
    }

    // ============================================================
    // Input (キーボード・マウス) テスト
    // ============================================================

    static void test_input() {
        TestIO::set_color(14, 0);
        TestIO::writeln("[Input]" as void*);
        TestIO::set_color(7, 0);

        // --- キーボードバッファ テスト ---
        // head/tailを直接操作してバッファの読み書きを検証
        ulong* head_ptr = 0x93040 as ulong*;  // KBD_HEAD_ADDR
        ulong* tail_ptr = 0x93048 as ulong*;  // KBD_TAIL_ADDR
        ulong old_head = *head_ptr;
        ulong old_tail = *tail_ptr;

        // バッファをリセット
        *head_ptr = 0;
        *tail_ptr = 0;

        // 空バッファからの読み取り → 0 (入力なし)
        ulong ch = Kbd::getchar();
        KTest::assert_eq(ch, 0, "KBD empty buffer returns 0" as void*);

        // バッファに直接書き込み ('A' = 65)
        Mem::write_byte(0x93000, 65);  // KBD_BUF_ADDR[0] = 'A'
        *tail_ptr = 1;  // tail=1にすることでデータあり
        ch = Kbd::getchar();
        KTest::assert_eq(ch, 65, "KBD read 'A' from buffer" as void*);

        // 読み取り後はheadが進んでバッファが空に
        KTest::assert_eq(*head_ptr, *tail_ptr, "KBD buffer empty after read" as void*);

        // 複数バイト書き込みテスト
        Mem::write_byte(0x93000, 72);  // 'H'
        Mem::write_byte(0x93001, 105); // 'i'
        *head_ptr = 0;
        *tail_ptr = 2;
        ulong c1 = Kbd::getchar();
        ulong c2 = Kbd::getchar();
        KTest::assert_eq(c1, 72, "KBD multi-byte read[0]='H'" as void*);
        KTest::assert_eq(c2, 105, "KBD multi-byte read[1]='i'" as void*);

        // バッファ復元
        *head_ptr = old_head;
        *tail_ptr = old_tail;

        // --- PS/2コントローラ CCB テスト ---
        // CCBを読み取ってIRQ1/IRQ12ビットが正しく設定されているか検証
        // 割り込み無効化してCCBを読み取り
        __asm__(`cli`);

        // Output Bufferフラッシュ
        ulong fi = 0;
        while (fi < 16) {
            ulong st = 0;
            __asm__(`inb $$0x64, %al; movzbq %al, %rax; movq %rax, ${=r:st}`);
            if ((st & 1) == 0) { break; }
            __asm__(`inb $$0x60, %al`);
            fi = fi + 1;
        }

        // CCB読み取りコマンド
        mouse_wait_input();
        __asm__(`movb $$0x20, %al; outb %al, $$0x64`);
        ulong ccb = mouse_read_data();

        __asm__(`sti`);

        // bit 0 = IRQ1有効
        KTest::assert_eq(ccb & 1, 1, "CCB bit0 IRQ1 enabled" as void*);
        // bit 1 = IRQ12有効
        KTest::assert_eq(ccb & 2, 2, "CCB bit1 IRQ12 enabled" as void*);
        // bit 4 = 第1ポートクロック (0=有効)
        KTest::assert_eq(ccb & 0x10, 0, "CCB bit4 kbd clock enabled" as void*);
        // bit 5 = 第2ポートクロック (0=有効)
        KTest::assert_eq(ccb & 0x20, 0, "CCB bit5 aux clock enabled" as void*);

        // --- PICマスク テスト ---
        // マスターPICマスク読み取り
        ulong pic1_mask = 0;
        __asm__(`inb $$0x21, %al; movzbq %al, %rax; movq %rax, ${=r:pic1_mask}`);
        // IRQ1 (キーボード) がアンマスクされている (bit 1 = 0)
        KTest::assert_eq(pic1_mask & 2, 0, "PIC1 IRQ1 unmasked" as void*);
        // IRQ2 (カスケード) がアンマスクされている (bit 2 = 0)
        KTest::assert_eq(pic1_mask & 4, 0, "PIC1 IRQ2 cascade unmasked" as void*);

        // スレーブPICマスク読み取り
        ulong pic2_mask = 0;
        __asm__(`inb $$0xA1, %al; movzbq %al, %rax; movq %rax, ${=r:pic2_mask}`);
        // IRQ12 (マウス) がアンマスクされている (bit 4 = 0)
        KTest::assert_eq(pic2_mask & 0x10, 0, "PIC2 IRQ12 unmasked" as void*);

        // --- マウスパケット状態 テスト ---
        ulong* mouse_phase = 0x93310 as ulong*;  // MOUSE_PHASE_ADDR
        ulong* mouse_scroll = 0x93318 as ulong*;  // MOUSE_SCROLL_ADDR
        // phaseは0-3を循環（IRQでインクリメントされる可能性がある）
        ulong phase_val = *mouse_phase;
        ulong phase_ok = 0;
        if (phase_val < 4) { phase_ok = 1; }
        KTest::assert_eq(phase_ok, 1, "Mouse phase in valid range (0-3)" as void*);
        KTest::assert_eq(*mouse_scroll as ulong, 0, "Mouse scroll initialized to 0" as void*);

        // Mouse::get_scroll() テスト
        *mouse_scroll = 1;  // スクロール上をシミュレート
        long sv = Mouse::get_scroll();
        KTest::assert_eq(sv as ulong, 1, "Mouse get_scroll returns 1" as void*);
        // 読み取り後にリセットされているか
        KTest::assert_eq(*mouse_scroll as ulong, 0, "Mouse scroll reset after read" as void*);
    }
}
