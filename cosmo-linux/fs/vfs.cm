//! platform: baremetal-x86
// cosmo-linux::fs::vfs - VFS コア API
//
// ファイルシステム抽象化レイヤ。
// FDテーブルとramfsを統合し、open/read/write/close APIを提供。
// 参照: linux/fs/open.c, linux/fs/read_write.c

import ../include/types;
import ../include/config;
import ../include/vfs;
import ../include/errno;
import ./fd_table;
import ./ramfs;
import ../lib/kstring;

/// Vfs — 仮想ファイルシステムAPI
export struct Vfs {}

impl Vfs {
    /// ファイルをオープンしFDを返す
    /// 成功=fd番号(≥0)、失敗=負のerrno
    static Fd open(void* name, ulong flags) {
        if (name as ulong == 0) { return 0 - EINVAL; }

        // ramfsで検索
        Ino ino = RamFs::lookup(name);

        if (ino == 0) {
            if ((flags & O_CREAT) != 0) {
                ino = RamFs::create(name, S_IFREG | 0x1B6, 0);
                if (ino == 0) { return 0 - ENOSPC; }
            } else {
                return 0 - ENOENT;
            }
        }

        // FD割り当て
        Fd fd = FdTable::alloc(ino, flags, FS_RAMFS);
        if (fd < 0) { return fd; }

        // O_TRUNC: ファイル切り詰め
        if ((flags & O_TRUNC) != 0) {
            RamFs::truncate(ino);
        }

        // O_APPEND: オフセットをファイル末尾に設定
        if ((flags & O_APPEND) != 0) {
            ulong fsize = RamFs::file_size(ino);
            FdTable::set_offset(fd, fsize);
        }

        return fd;
    }

    /// FDからデータを読み出し
    static long read(Fd fd, ulong buf, ulong count) {
        if (FdTable::is_valid(fd) == 0) { return 0 - EBADF; }

        ulong fs_type = FdTable::get_fs_type(fd);

        // コンソール (stdin) — 未実装: 0を返す
        if (fs_type == FS_CONSOLE) { return 0; }

        // ramfs
        if (fs_type == FS_RAMFS) {
            Ino ino = FdTable::get_ino(fd);
            ulong offset = FdTable::get_offset(fd);
            long bytes = RamFs::read(ino, buf, offset, count);
            if (bytes > 0) {
                FdTable::set_offset(fd, offset + (bytes as ulong));
            }
            return bytes;
        }

        return 0 - EBADF;
    }

    /// FDにデータを書き込み
    static long write(Fd fd, ulong buf, ulong count) {
        if (FdTable::is_valid(fd) == 0) { return 0 - EBADF; }

        ulong fs_type = FdTable::get_fs_type(fd);

        // コンソール (stdout/stderr) — シリアル出力
        if (fs_type == FS_CONSOLE) {
            return count as long;
        }

        // ramfs
        if (fs_type == FS_RAMFS) {
            Ino ino = FdTable::get_ino(fd);
            ulong offset = FdTable::get_offset(fd);
            long bytes = RamFs::write(ino, buf, offset, count);
            if (bytes > 0) {
                FdTable::set_offset(fd, offset + (bytes as ulong));
            }
            return bytes;
        }

        return 0 - EBADF;
    }

    /// FDを閉じる
    static long close(Fd fd) {
        if (FdTable::is_valid(fd) == 0) { return 0 - EBADF; }
        FdTable::free(fd);
        return 0;
    }

    /// ディレクトリエントリを読み出し（簡易版）
    static ulong readdir(ulong idx) {
        return RamFs::dir_name(idx);
    }
}
