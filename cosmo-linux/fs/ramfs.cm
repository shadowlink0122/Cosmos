//! platform: baremetal-x86
// cosmo-linux::fs::ramfs - メモリ上ファイルシステム + VFS
//
// RamFs struct/impl パターンで実装

import ../include/types;
import ../include/config;
import ../include/vfs;
import ../drivers/serial;
import ../lib/printk;
import ../lib/kstring;

// バイトアクセス
ulong rb(ulong a) {
    ulong v = 0;
    __asm__(`movq ${r:a}, %r10; xorq %rax,%rax; movzbl (%r10),%eax; movq %rax, ${=r:v}`);
    return v;
}

void wb(ulong a, ulong v) {
    __asm__(`movq ${r:a}, %r10; movq ${r:v}, %rax; movb %al, (%r10)`);
}

// メモリレイアウト（0x1000000 = 16MBから配置: ELF vaddr 0x400000との衝突回避）
const PhysAddr INO_BASE  = 0x1000000;   // inode配列 (256 * 56 = 14KB)
const PhysAddr DIR_BASE  = 0x1004000;   // ディレクトリ配列 (64 * 32 = 2KB)
const PhysAddr NAME_BASE = 0x1005000;   // ファイル名領域 (64 * 32 = 2KB)
const PhysAddr NEXT_INO  = 0x1006000;   // 次のinode番号
const PhysAddr DIR_CNT   = 0x1006008;   // ディレクトリエントリ数

// ファイルデータバッファプール (2MB領域)
// 最大64ファイル × 64KB/ファイル = 4MB → 2MBで十分(実際は小さいファイルが多い)
const PhysAddr DATA_POOL_BASE = 0x1100000;   // 17MB地点
const PhysAddr DATA_POOL_NEXT = 0x1006010;   // 次の割り当てオフセット
const ulong    DATA_POOL_SIZE = 0x200000;     // 2MB

// 内部ヘルパー
ulong find_ino(Ino ino) {
    ulong i = 0;
    while (i < MAX_INODES) {
        ulong o = i * 56;
        ulong* u = (INO_BASE + o + 48) as ulong*;
        if (*u != 0) {
            ulong* p = (INO_BASE + o) as ulong*;
            if (*p == ino as ulong) { return o; }
        }
        i = i + 1;
    }
    return 0xFFFFFFFFFFFFFFFF;
}

Ino alloc_ino(ulong mode, ulong data) {
    // data == 0 の場合、データプールから割り当て
    if (data == 0 && (mode & S_IFMT) == S_IFREG) {
        ulong* pool_next = DATA_POOL_NEXT as ulong*;
        ulong offset = *pool_next;
        if (offset + MAX_FILE_SIZE <= DATA_POOL_SIZE) {
            data = DATA_POOL_BASE + offset;
            *pool_next = offset + MAX_FILE_SIZE;
            // バッファをゼロクリア
            memzero(data as void*, MAX_FILE_SIZE);
        }
    }
    ulong i = 0;
    while (i < MAX_INODES) {
        ulong o = i * 56;
        ulong* u = (INO_BASE + o + 48) as ulong*;
        if (*u == 0) {
            ulong* ni = NEXT_INO as ulong*;
            Ino ino = (*ni) as long;
            *ni = *ni + 1;
            ulong* q0 = (INO_BASE + o) as ulong*;      *q0 = ino as ulong;
            ulong* q1 = (INO_BASE + o + 8) as ulong*;  *q1 = mode;
            ulong* q2 = (INO_BASE + o + 16) as ulong*; *q2 = 0;
            ulong* q3 = (INO_BASE + o + 24) as ulong*; *q3 = 1;
            ulong* q4 = (INO_BASE + o + 32) as ulong*; *q4 = data;
            ulong* q5 = (INO_BASE + o + 40) as ulong*; *q5 = FS_RAMFS;
            *u = 1;
            return ino;
        }
        i = i + 1;
    }
    return 0;
}

/// 2つのヌル終端文字列を比較（一致=1、不一致=0）
ulong name_eq(ulong a, ulong b) {
    ulong i = 0;
    while (i < MAX_NAME_LEN) {
        ulong ca = rb(a + i);
        ulong cb = rb(b + i);
        if (ca != cb) { return 0; }
        if (ca == 0) { return 1; }
        i = i + 1;
    }
    return 1;
}

/// RamFS — メモリ上ファイルシステム
export struct RamFs {}

impl RamFs {
    /// VFS初期化
    static void setup(SerialPort* w) {
        memzero(INO_BASE as void*, MAX_INODES * 56);
        memzero(DIR_BASE as void*, MAX_DIR_ENTRIES * 32);
        memzero(NAME_BASE as void*, MAX_DIR_ENTRIES * MAX_NAME_LEN);
        ulong* ni = NEXT_INO as ulong*; *ni = 2;
        ulong* dc = DIR_CNT as ulong*;  *dc = 0;
        // データプール初期化
        ulong* pool_next = DATA_POOL_NEXT as ulong*;
        *pool_next = 0;
        // ルートinode
        ulong* p0 = INO_BASE as ulong*;             *p0 = 1;
        ulong* p1 = (INO_BASE + 8) as ulong*;       *p1 = S_IFDIR | 0x1FF;
        ulong* p2 = (INO_BASE + 16) as ulong*;      *p2 = 0;
        ulong* p3 = (INO_BASE + 24) as ulong*;      *p3 = 2;
        ulong* p4 = (INO_BASE + 32) as ulong*;      *p4 = 0;
        ulong* p5 = (INO_BASE + 40) as ulong*;      *p5 = FS_RAMFS;
        ulong* p6 = (INO_BASE + 48) as ulong*;      *p6 = 1;

        // よく使うディレクトリを事前作成
        RamFs::mkdir("tmp" as void*);
        RamFs::mkdir("usr" as void*);
        RamFs::mkdir("usr/local" as void*);
        RamFs::mkdir("usr/local/bin" as void*);
        RamFs::mkdir("proc" as void*);
        RamFs::mkdir("dev" as void*);

        pr_info(w, "VFS initialized (ramfs + /tmp + data pool)" as void*);
    }

    /// 名前からinode検索
    static Ino lookup(void* name) {
        ulong* dc = DIR_CNT as ulong*;
        ulong i = 0;
        while (i < *dc) {
            ulong o = i * 32;
            ulong* u = (DIR_BASE + o + 24) as ulong*;
            if (*u != 0) {
                ulong* na = (DIR_BASE + o) as ulong*;
                if (name_eq(*na, name as ulong) != 0) {
                    ulong* ip = (DIR_BASE + o + 8) as ulong*;
                    return (*ip) as long;
                }
            }
            i = i + 1;
        }
        return 0;
    }

    /// ファイル作成
    static Ino create(void* name, ulong mode, ulong data_addr) {
        Ino ex = RamFs::lookup(name);
        if (ex != 0) { return ex; }
        ulong* dc = DIR_CNT as ulong*;
        if (*dc >= MAX_DIR_ENTRIES) { return 0; }
        Ino ino = alloc_ino(mode, data_addr);
        if (ino == 0) { return 0; }
        ulong cnt = *dc;
        ulong o = cnt * 32;
        ulong ns = NAME_BASE + cnt * MAX_NAME_LEN;
        // 名前コピー
        ulong k = 0;
        ulong done = 0;
        while (k < MAX_NAME_LEN - 1) {
            if (done == 0) {
                ulong c = rb((name as ulong) + k);
                wb(ns + k, c);
                if (c == 0) { done = 1; }
            }
            k = k + 1;
        }
        wb(ns + MAX_NAME_LEN - 1, 0);
        ulong* dn = (DIR_BASE + o) as ulong*;      *dn = ns;
        ulong* di = (DIR_BASE + o + 8) as ulong*;  *di = ino as ulong;
        ulong* dt = (DIR_BASE + o + 16) as ulong*; *dt = mode & S_IFMT;
        ulong* du = (DIR_BASE + o + 24) as ulong*; *du = 1;
        *dc = cnt + 1;
        return ino;
    }

    /// ファイル読み出し
    static long read(Ino ino, ulong buf, ulong off, ulong cnt) {
        ulong io = find_ino(ino);
        if (io == 0xFFFFFFFFFFFFFFFF) { return -1; }
        ulong* sp = (INO_BASE + io + 16) as ulong*;
        if (off >= *sp) { return 0; }
        ulong av = *sp - off;
        if (cnt > av) { cnt = av; }
        ulong* dp = (INO_BASE + io + 32) as ulong*;
        if (*dp == 0) { return 0; }
        ulong i = 0;
        while (i < cnt) {
            wb(buf + i, rb(*dp + off + i));
            i = i + 1;
        }
        return cnt as long;
    }

    /// ファイル書き込み
    static long write(Ino ino, ulong buf, ulong off, ulong cnt) {
        ulong io = find_ino(ino);
        if (io == 0xFFFFFFFFFFFFFFFF) { return -1; }
        if (off + cnt > MAX_FILE_SIZE) { cnt = MAX_FILE_SIZE - off; }
        if (cnt == 0) { return 0; }
        ulong* dp = (INO_BASE + io + 32) as ulong*;
        if (*dp == 0) { return -1; }
        ulong i = 0;
        while (i < cnt) {
            wb(*dp + off + i, rb(buf + i));
            i = i + 1;
        }
        ulong* sp = (INO_BASE + io + 16) as ulong*;
        ulong ne = off + cnt;
        if (ne > *sp) { *sp = ne; }
        return cnt as long;
    }

    /// ファイル内容の切り詰め
    static void truncate(Ino ino) {
        ulong io = find_ino(ino);
        if (io != 0xFFFFFFFFFFFFFFFF) {
            ulong* sp = (INO_BASE + io + 16) as ulong*;
            *sp = 0;
        }
    }

    /// ディレクトリエントリ数
    static ulong dir_count() {
        ulong* dc = DIR_CNT as ulong*;
        return *dc;
    }

    /// ディレクトリエントリの名前
    static ulong dir_name(ulong idx) {
        ulong* dc = DIR_CNT as ulong*;
        if (idx >= *dc) { return 0; }
        ulong o = idx * 32;
        ulong* u = (DIR_BASE + o + 24) as ulong*;
        if (*u == 0) { return 0; }
        ulong* n = (DIR_BASE + o) as ulong*;
        return *n;
    }

    /// ディレクトリエントリのタイプ
    static ulong dir_type(ulong idx) {
        ulong* dc = DIR_CNT as ulong*;
        if (idx >= *dc) { return 0; }
        ulong* t = (DIR_BASE + idx * 32 + 16) as ulong*;
        return *t;
    }

    /// ディレクトリエントリのinode番号
    static Ino dir_ino(ulong idx) {
        ulong* dc = DIR_CNT as ulong*;
        if (idx >= *dc) { return 0; }
        ulong* ip = (DIR_BASE + idx * 32 + 8) as ulong*;
        return (*ip) as long;
    }

    /// ファイルサイズ取得
    static ulong file_size(Ino ino) {
        ulong io = find_ino(ino);
        if (io == 0xFFFFFFFFFFFFFFFF) { return 0; }
        ulong* sp = (INO_BASE + io + 16) as ulong*;
        return *sp;
    }

    /// ファイルモード取得 (S_IFREG, S_IFDIR等のビットマスク含む)
    static ulong get_mode(Ino ino) {
        ulong io = find_ino(ino);
        if (io == 0xFFFFFFFFFFFFFFFF) { return 0; }
        ulong* mp = (INO_BASE + io + 8) as ulong*;
        return *mp;
    }

    /// ファイル削除（inode解放 + direntry削除）
    static long unlink(void* name) {
        ulong* dc = DIR_CNT as ulong*;
        ulong i = 0;
        while (i < *dc) {
            ulong o = i * 32;
            ulong* u = (DIR_BASE + o + 24) as ulong*;
            if (*u != 0) {
                ulong* na = (DIR_BASE + o) as ulong*;
                if (name_eq(*na, name as ulong) != 0) {
                    // ディレクトリは削除不可
                    ulong* dt = (DIR_BASE + o + 16) as ulong*;
                    if (*dt == S_IFDIR) { return 0 - 21; }  // -EISDIR

                    // inode解放
                    ulong* ip = (DIR_BASE + o + 8) as ulong*;
                    Ino ino = (*ip) as long;
                    ulong io = find_ino(ino);
                    if (io != 0xFFFFFFFFFFFFFFFF) {
                        ulong* iu = (INO_BASE + io + 48) as ulong*;
                        *iu = 0;  // used = 0
                    }

                    // direntry削除
                    *u = 0;
                    return 0;
                }
            }
            i = i + 1;
        }
        return 0 - 2;  // -ENOENT
    }

    /// ディレクトリ作成
    static Ino mkdir(void* name) {
        Ino ex = RamFs::lookup(name);
        if (ex != 0) { return ex; }
        return RamFs::create(name, S_IFDIR | 0x1FF, 0);
    }

    /// ファイル名変更 (rename)
    static long rename(void* oldname, void* newname) {
        // 既存の新名前エントリを削除
        Ino new_exist = RamFs::lookup(newname);
        if (new_exist != 0) {
            RamFs::unlink(newname);
        }

        // 旧名前エントリを検索して名前を差し替え
        ulong* dc = DIR_CNT as ulong*;
        ulong i = 0;
        while (i < *dc) {
            ulong o = i * 32;
            ulong* u = (DIR_BASE + o + 24) as ulong*;
            if (*u != 0) {
                ulong* na = (DIR_BASE + o) as ulong*;
                if (name_eq(*na, oldname as ulong) != 0) {
                    // 名前領域にnewnameをコピー
                    ulong ns = *na;
                    ulong k = 0;
                    ulong done = 0;
                    while (k < MAX_NAME_LEN - 1) {
                        if (done == 0) {
                            ulong c = rb((newname as ulong) + k);
                            wb(ns + k, c);
                            if (c == 0) { done = 1; }
                        }
                        k = k + 1;
                    }
                    wb(ns + MAX_NAME_LEN - 1, 0);
                    return 0;
                }
            }
            i = i + 1;
        }
        return 0 - 2;  // -ENOENT
    }
}

