/// ゴミ箱アイコン枠線
export const Rgb ICON_TRASH_BORDER = 0x636366;
/// ゴミ箱アイコン文字色
export const Rgb ICON_TRASH_FG     = 0x3A3A3C;

// ============================================================
// ターミナル
// ============================================================

/// ターミナル背景色
export const Rgb TERM_BG_COLOR     = 0x000000;
/// ターミナルテキスト色（デフォルト: 明灰）
export const Rgb TERM_FG_COLOR     = 0xCCCCCC;

// ============================================================
// VGAパレット (16色)
// ============================================================

export const Rgb VGA_BLACK         = 0x000000;
export const Rgb VGA_BLUE          = 0x0000AA;
export const Rgb VGA_GREEN         = 0x00AA00;
export const Rgb VGA_CYAN          = 0x00AAAA;
export const Rgb VGA_RED           = 0xAA0000;
export const Rgb VGA_MAGENTA       = 0xAA00AA;
export const Rgb VGA_BROWN         = 0xAA5500;
export const Rgb VGA_LIGHT_GRAY    = 0xAAAAAA;
export const Rgb VGA_DARK_GRAY     = 0x555555;
export const Rgb VGA_LIGHT_BLUE    = 0x5555FF;
export const Rgb VGA_LIGHT_GREEN   = 0x55FF55;
export const Rgb VGA_LIGHT_CYAN    = 0x55FFFF;
export const Rgb VGA_LIGHT_RED     = 0xFF5555;
export const Rgb VGA_LIGHT_MAGENTA = 0xFF55FF;
export const Rgb VGA_YELLOW        = 0xFFFF55;
export const Rgb VGA_WHITE         = 0xFFFFFF;

