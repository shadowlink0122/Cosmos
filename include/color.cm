export const ulong VGA_IDX_DARK_GRAY     = 8;
export const ulong VGA_IDX_LIGHT_BLUE    = 9;
export const ulong VGA_IDX_LIGHT_GREEN   = 10;
export const ulong VGA_IDX_LIGHT_CYAN    = 11;
export const ulong VGA_IDX_LIGHT_RED     = 12;
export const ulong VGA_IDX_LIGHT_MAGENTA = 13;
export const ulong VGA_IDX_YELLOW        = 14;
export const ulong VGA_IDX_WHITE         = 15;

