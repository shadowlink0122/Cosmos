//! platform: baremetal-x86
// cosmo-linux::include::result - Result/Option型定義
//
// ベアメタル環境で使用するジェネリクスADT型。
// Cmコンパイラ組み込みResult/Optionを明示的にenum定義し、
// match式・バリアントコンストラクタを有効にする。
// 参照: Rust std::result::Result, std::option::Option

// ============================================================
// Result<T, E> — 成功または失敗を表す型
// ============================================================

/// Result<T, E> — 成功(Ok)または失敗(Err)を表すジェネリクス型
export enum Result<T, E> {
    Ok(T),
    Err(E)
}

// ============================================================
// Option<T> — 値の有無を表す型
// ============================================================

/// Option<T> — 値がある(Some)またはない(None)を表すジェネリクス型
export enum Option<T> {
    Some(T),
    None
}
