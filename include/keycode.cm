//! platform: baremetal-x86
// cosmo-linux::include::keycode - キーコード・ASCII定数
//
// シェル・キーボードドライバで使用するEnum定数。
// マジックナンバーを型安全なEnum定数に置換。

// ============================================================
// Key — 制御キー・特殊キーEnum
// ============================================================

/// Key — 制御・特殊キーコード
export enum Key {
    Null      = 0,
    CtrlC     = 3,
    Backspace = 8,
    Tab       = 9,
    Enter     = 10,
    CtrlL     = 12,
    CR        = 13,
    Escape    = 27,
    Space     = ' ',
    Delete    = 127,
    Up        = 128,
    Down      = 129,
    Left      = 130,
    Right     = 131
}

// ============================================================
// Ascii — 印字可能文字 (JIS 106キー配列)
// ============================================================

/// Ascii — 印字可能ASCII文字定数
export enum Ascii {
    // 数字
    Digit0 = '0',
    Digit1,  // '1' (オートインクリメント)
    Digit2,  // '2'
    Digit3,  // '3'
    Digit4,  // '4'
    Digit5,  // '5'
    Digit6,  // '6'
    Digit7,  // '7'
    Digit8,  // '8'
    Digit9,  // '9'

    // 大文字アルファベット
    UpperA = 'A',
    UpperB,    UpperC,    UpperD,    UpperE,    UpperF,
    UpperG,    UpperH,    UpperI,    UpperJ,    UpperK,
    UpperL,    UpperM,    UpperN,    UpperO,    UpperP,
    UpperQ,    UpperR,    UpperS,    UpperT,    UpperU,
    UpperV,    UpperW,    UpperX,    UpperY,    UpperZ,

    // 小文字アルファベット
    LowerA = 'a',
    LowerB,    LowerC,    LowerD,    LowerE,    LowerF,
    LowerG,    LowerH,    LowerI,    LowerJ,    LowerK,
    LowerL,    LowerM,    LowerN,    LowerO,    LowerP,
    LowerQ,    LowerR,    LowerS,    LowerT,    LowerU,
    LowerV,    LowerW,    LowerX,    LowerY,    LowerZ,

    // 記号 (通常)
    Minus     = '-',
    Caret     = '^',
    At        = '@',
    BracketL  = '[',
    Backslash,  // '\' (92, オートインクリメント)
    BracketR,   // ']' (93)
    Semicolon = ';',
    Colon     = ':',
    Backtick  = '`',
    Comma     = ',',
    Period    = '.',
    Slash     = '/',
    Pipe      = '|',

    // 記号 (Shift)
    Exclaim   = '!',
    DQuote    = '"',
    Hash      = '#',
    Dollar    = '$',
    Percent   = '%',
    Ampersand = '&',
    SQuote    = 39,  // '\'' — シングルクォートはリテラル不可
    ParenL    = '(',
    ParenR    = ')',
    Tilde     = '~',
    Equal     = '=',
    BraceL    = '{',
    BraceR    = '}',
    Asterisk  = '*',
    LessThan  = '<',
    GreaterThan = '>',
    Question  = '?',
    Underscore = '_'
}

// ============================================================
// 後方互換: 既存コードで使用されるconst定数
// ============================================================

// 制御キー (Key enum → ulong)
export const ulong KEY_CTRL_C    = 3;
export const ulong KEY_BACKSPACE = 8;
export const ulong KEY_TAB       = 9;
export const ulong KEY_ENTER     = 10;
export const ulong KEY_CTRL_L    = 12;
export const ulong KEY_CR        = 13;
export const ulong KEY_ESCAPE    = 27;
export const ulong KEY_SPACE     = 32;
export const ulong KEY_DELETE    = 127;
export const ulong KEY_UP        = 0x80;
export const ulong KEY_DOWN      = 0x81;
export const ulong KEY_LEFT      = 0x82;
export const ulong KEY_RIGHT     = 0x83;

// ASCII文字定数 (Ascii enum → ulong)
export const ulong CHAR_PIPE     = 124;
export const ulong CHAR_SLASH    = 47;
export const ulong CHAR_DOT      = 46;
export const ulong CHAR_NULL     = 0;
