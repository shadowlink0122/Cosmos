//! platform: baremetal-x86
// cosmo-linux::include::keycode - キーコード・ASCII定数
//
// シェル・キーボードドライバで使用するEnum定数。
// マジックナンバーを型安全なEnum定数に置換。

// ============================================================
// Key — 制御キー・特殊キーEnum
// ============================================================

/// Key — 制御・特殊キーコード
export enum Key {
    Null      = 0,
    CtrlC     = 3,
    Backspace = 8,
    Tab       = 9,
    Enter     = 10,
    CtrlL     = 12,
    CR        = 13,
    Escape    = 27,
    Space     = ' ',
    Delete    = 127,
    Up        = 128,
    Down      = 129,
    Left      = 130,
    Right     = 131
}

// ============================================================
// Ascii — 印字可能文字 (JIS 106キー配列)
// ============================================================

/// Ascii — 印字可能ASCII文字定数
export enum Ascii {
    // 数字
    Digit0 = '0',
    Digit1,  // '1' (オートインクリメント)
    Digit2,  // '2'
    Digit3,  // '3'
    Digit4,  // '4'
    Digit5,  // '5'
    Digit6,  // '6'
    Digit7,  // '7'
    Digit8,  // '8'
    Digit9,  // '9'

    // 大文字アルファベット
    UpperA = 'A',
    UpperB,    UpperC,    UpperD,    UpperE,    UpperF,
    UpperG,    UpperH,    UpperI,    UpperJ,    UpperK,
    UpperL,    UpperM,    UpperN,    UpperO,    UpperP,
    UpperQ,    UpperR,    UpperS,    UpperT,    UpperU,
    UpperV,    UpperW,    UpperX,    UpperY,    UpperZ,

    // 小文字アルファベット
    LowerA = 'a',
    LowerB,    LowerC,    LowerD,    LowerE,    LowerF,
    LowerG,    LowerH,    LowerI,    LowerJ,    LowerK,
    LowerL,    LowerM,    LowerN,    LowerO,    LowerP,
    LowerQ,    LowerR,    LowerS,    LowerT,    LowerU,
    LowerV,    LowerW,    LowerX,    LowerY,    LowerZ,

    // 記号 (通常)
    Minus     = '-',
    Caret     = '^',
    At        = '@',
    BracketL  = '[',
    Backslash,  // '\' (92, オートインクリメント)
    BracketR,   // ']' (93)
    Semicolon = ';',
    Colon     = ':',
    Backtick  = '`',
    Comma     = ',',
    Period    = '.',
    Slash     = '/',
    Pipe      = '|',

    // 記号 (Shift)
    Exclaim   = '!',
    DQuote    = '"',
    Hash      = '#',
    Dollar    = '$',
    Percent   = '%',
    Ampersand = '&',
    SQuote    = 39,  // '\'' — シングルクォートはリテラル不可
    ParenL    = '(',
    ParenR    = ')',
    Tilde     = '~',
    Equal     = '=',
    BraceL    = '{',
    BraceR    = '}',
    Asterisk  = '*',
    LessThan  = '<',
    GreaterThan = '>',
    Question  = '?',
    Underscore = '_'
}
