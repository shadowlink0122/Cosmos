//! platform: baremetal-x86
// cosmo-linux::include::keycode - キーコード・ASCII定数
//
// シェル・キーボードドライバで使用するEnum定数。
// マジックナンバーを型安全なEnum定数に置換。

// ============================================================
// Key — 制御キー・特殊キーEnum
// ============================================================

/// Key — 制御・特殊キーコード
export enum Key {
    Null      = 0,      // ヌル (入力なし)
    CtrlC     = 3,      // Ctrl+C (割り込み)
    Backspace = 8,      // バックスペース
    Tab       = 9,      // タブ
    Enter     = 10,     // 改行 (LF)
    CtrlL     = 12,     // Ctrl+L (画面クリア)
    CR        = 13,     // キャリッジリターン
    Escape    = 27,     // Escape
    Space     = 32,     // スペース
    Delete    = 127,    // Delete
    Up        = 128,    // 上矢印 (0x80, E0変換済み)
    Down      = 129,    // 下矢印 (0x81)
    Left      = 130,    // 左矢印 (0x82)
    Right     = 131     // 右矢印 (0x83)
}

// ============================================================
// Ascii — 印字可能文字 (JIS 106キー配列)
// ============================================================

/// Ascii — 印字可能ASCII文字定数
export enum Ascii {
    // 数字
    Digit0 = 48,   // '0'
    Digit1 = 49,   // '1'
    Digit2 = 50,   // '2'
    Digit3 = 51,   // '3'
    Digit4 = 52,   // '4'
    Digit5 = 53,   // '5'
    Digit6 = 54,   // '6'
    Digit7 = 55,   // '7'
    Digit8 = 56,   // '8'
    Digit9 = 57,   // '9'

    // 小文字アルファベット
    LowerA = 97,   // 'a'
    LowerB = 98,   // 'b'
    LowerC = 99,   // 'c'
    LowerD = 100,  // 'd'
    LowerE = 101,  // 'e'
    LowerF = 102,  // 'f'
    LowerG = 103,  // 'g'
    LowerH = 104,  // 'h'
    LowerI = 105,  // 'i'
    LowerJ = 106,  // 'j'
    LowerK = 107,  // 'k'
    LowerL = 108,  // 'l'
    LowerM = 109,  // 'm'
    LowerN = 110,  // 'n'
    LowerO = 111,  // 'o'
    LowerP = 112,  // 'p'
    LowerQ = 113,  // 'q'
    LowerR = 114,  // 'r'
    LowerS = 115,  // 's'
    LowerT = 116,  // 't'
    LowerU = 117,  // 'u'
    LowerV = 118,  // 'v'
    LowerW = 119,  // 'w'
    LowerX = 120,  // 'x'
    LowerY = 121,  // 'y'
    LowerZ = 122,  // 'z'

    // 大文字アルファベット
    UpperA = 65,   // 'A'
    UpperB = 66,   // 'B'
    UpperC = 67,   // 'C'
    UpperD = 68,   // 'D'
    UpperE = 69,   // 'E'
    UpperF = 70,   // 'F'
    UpperG = 71,   // 'G'
    UpperH = 72,   // 'H'
    UpperI = 73,   // 'I'
    UpperJ = 74,   // 'J'
    UpperK = 75,   // 'K'
    UpperL = 76,   // 'L'
    UpperM = 77,   // 'M'
    UpperN = 78,   // 'N'
    UpperO = 79,   // 'O'
    UpperP = 80,   // 'P'
    UpperQ = 81,   // 'Q'
    UpperR = 82,   // 'R'
    UpperS = 83,   // 'S'
    UpperT = 84,   // 'T'
    UpperU = 85,   // 'U'
    UpperV = 86,   // 'V'
    UpperW = 87,   // 'W'
    UpperX = 88,   // 'X'
    UpperY = 89,   // 'Y'
    UpperZ = 90,   // 'Z'

    // 記号 (通常)
    Minus     = 45,   // '-'
    Caret     = 94,   // '^'
    At        = 64,   // '@'
    BracketL  = 91,   // '['
    BracketR  = 93,   // ']'
    Semicolon = 59,   // ';'
    Colon     = 58,   // ':'
    Backtick  = 96,   // '`'
    Comma     = 44,   // ','
    Period    = 46,   // '.'
    Slash     = 47,   // '/'
    Backslash = 92,   // '\'
    Pipe      = 124,  // '|'

    // 記号 (Shift)
    Exclaim   = 33,   // '!'
    DQuote    = 34,   // '"'
    Hash      = 35,   // '#'
    Dollar    = 36,   // '$'
    Percent   = 37,   // '%'
    Ampersand = 38,   // '&'
    SQuote    = 39,   // '''
    ParenL    = 40,   // '('
    ParenR    = 41,   // ')'
    Tilde     = 126,  // '~'
    Equal     = 61,   // '='
    BraceL    = 123,  // '{'
    BraceR    = 125,  // '}'
    Asterisk  = 42,   // '*'
    LessThan  = 60,   // '<'
    GreaterThan = 62, // '>'
    Question  = 63,   // '?'
    Underscore = 95   // '_'
}

// ============================================================
// 後方互換: 既存コードで使用されるconst定数
// ============================================================

// 制御キー (Key enum → ulong)
export const ulong KEY_CTRL_C    = 3;
export const ulong KEY_BACKSPACE = 8;
export const ulong KEY_TAB       = 9;
export const ulong KEY_ENTER     = 10;
export const ulong KEY_CTRL_L    = 12;
export const ulong KEY_CR        = 13;
export const ulong KEY_ESCAPE    = 27;
export const ulong KEY_SPACE     = 32;
export const ulong KEY_DELETE    = 127;
export const ulong KEY_UP        = 0x80;
export const ulong KEY_DOWN      = 0x81;
export const ulong KEY_LEFT      = 0x82;
export const ulong KEY_RIGHT     = 0x83;

// ASCII文字定数 (Ascii enum → ulong)
export const ulong CHAR_PIPE     = 124;
export const ulong CHAR_SLASH    = 47;
export const ulong CHAR_DOT      = 46;
export const ulong CHAR_NULL     = 0;
