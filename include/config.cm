//! platform: baremetal-x86
// cosmo-linux::include::config - カーネル設定定数
//
// 全カーネルモジュールが参照する定数を一元管理する。

import ./types;

// ============================================================
// カーネルバージョン
// ============================================================

export const ulong VERSION_MAJOR = 0;
export const ulong VERSION_MINOR = 1;
export const ulong VERSION_PATCH = 0;

// ============================================================
// I/Oポート定数（ulong化 — Cm ABI互換）
// ============================================================

/// COM1 シリアルポート
export const ulong COM1 = 0x3F8;

/// QEMUデバッグコンソール
export const ulong DEBUGCON = 0xE9;

/// QEMU isa-debug-exit ポート
export const ulong QEMU_EXIT_PORT = 0xF4;

// ============================================================
// PIC (8259A) 定数
// ============================================================

export const ulong PIC1_CMD  = 0x20;
export const ulong PIC1_DATA = 0x21;
export const ulong PIC2_CMD  = 0xA0;
export const ulong PIC2_DATA = 0xA1;

/// IRQリマップ先ベクタ
export const Vector IRQ_BASE = 32;

// ============================================================
// PIT (8254) 定数
// ============================================================

export const ulong PIT_CH0 = 0x40;
export const ulong PIT_CMD = 0x43;
export const ulong PIT_FREQ = 1193182;
export const ulong PIT_HZ   = 100;

// ============================================================
// メモリレイアウト定数
// ============================================================

/// GDTテーブル配置アドレス
export const PhysAddr GDT_ADDR = 0x80000;

/// IDTテーブル配置アドレス
export const PhysAddr IDT_ADDR = 0x81000;

/// IDTRアドレス（IDT直後: 0x81000 + 256*16 = 0x82000）
export const PhysAddr IDTR_ADDR = 0x82000;

/// カーネルスタックサイズ
export const Size KERNEL_STACK_SIZE = 16384;

// ============================================================
// GUI画面・ウィンドウ定数
// ============================================================

/// 画面解像度
export const ulong SCREEN_WIDTH  = 1024;
export const ulong SCREEN_HEIGHT = 768;

/// デフォルトターミナルウィンドウサイズ（画面の50%）
export const ulong DEFAULT_TERM_W = 512;
export const ulong DEFAULT_TERM_H = 384;

/// デフォルトターミナルウィンドウ位置（中央配置）
export const ulong DEFAULT_TERM_X = 256;
export const ulong DEFAULT_TERM_Y = 70;
