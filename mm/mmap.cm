//! platform: baremetal-x86
// cosmo-linux::mm::mmap - 仮想メモリ領域管理 (VMA)
//
// Mmap struct/impl — mmap/munmap/brk の実装。
// VMA テーブルで仮想アドレス範囲を管理し、
// Demand Paging と連携して物理ページを遅延割当する。
//
// 参照: linux/mm/mmap.c

import ../include/types;
import ../include/config;
import ../include/page_alloc;
import ../include/errno;
import ../include/result;
import ../include/scheduler;
import ../mm/vmm;
import ../mm/pmm;
import ../lib/kstring;

// ============================================================
// VMA定数
// ============================================================

/// 匿名マッピング (ファイルなし)
export const ulong MAP_ANONYMOUS = 0x20;

/// プライベートマッピング
export const ulong MAP_PRIVATE   = 0x02;

/// 固定アドレスマッピング
export const ulong MAP_FIXED     = 0x10;

/// マッピング失敗
export const ulong MAP_FAILED    = 0xFFFFFFFFFFFFFFFF;

/// 保護フラグ
export const ulong PROT_NONE  = 0;
export const ulong PROT_READ  = 1;
export const ulong PROT_WRITE = 2;
export const ulong PROT_EXEC  = 4;

/// VMAテーブル最大エントリ数
const ulong VMA_MAX = 32;

/// VMAテーブル固定メモリアドレス (各エントリ32バイト: start/end/flags/used)
const PhysAddr VMA_TABLE_ADDR = 0x9A000;

/// mmapの開始仮想アドレス (ユーザー空間上位)
const VirtAddr MMAP_BASE = 0x40000000;  // 1GB超: identity map外 (2MB splitting対応済みだが安全策)

/// ヒープ開始アドレス
export const VirtAddr HEAP_BASE = 0x800000;

/// PMMポインタアドレス
const PhysAddr PMM_PTR_ADDR = 0x95010;

/// ページテーブルポインタアドレス
const PhysAddr VMM_PTR_ADDR = 0x91020;

// ============================================================
// VMA構造体 (メモリ上レイアウト: 32バイト)
// ============================================================

/// 仮想メモリ領域
export struct Vma {
    ulong start;  // 開始仮想アドレス
    ulong end;    // 終了仮想アドレス（排他）
    ulong flags;  // MAP_ANONYMOUS | PROT_*
    ulong used;   // 1=使用中, 0=空き
}

// ============================================================
// Mmap struct/impl
// ============================================================

/// Mmap — 仮想メモリ領域管理
export struct Mmap {}

impl Mmap {
    /// VMAテーブル初期化
    static void setup() {
        memzero(VMA_TABLE_ADDR as void*, VMA_MAX * 32);
    }

    /// VMAエントリを取得
    static Vma* get_vma(ulong index) {
        ulong addr = VMA_TABLE_ADDR + index * 32;
        return addr as Vma*;
    }

    /// 空きVMAスロットを検索
    static long find_free_slot() {
        ulong i = 0;
        while (i < VMA_MAX) {
            Vma* vma = Mmap::get_vma(i);
            if (vma->used == 0) { return i as long; }
            i = i + 1;
        }
        return 0 - ENOMEM;
    }

    /// 仮想アドレスが属するVMAを検索
    static Option<ulong> find_vma(ulong addr) {
        ulong i = 0;
        while (i < VMA_MAX) {
            Vma* vma = Mmap::get_vma(i);
            if (vma->used != 0) {
                if (addr >= vma->start && addr < vma->end) {
                    return Option::Some(vma as ulong);
                }
            }
            i = i + 1;
        }
        return Option::None;
    }

    /// 使用されていない仮想アドレス範囲を検索
    static ulong find_free_region(ulong size) {
        ulong candidate = MMAP_BASE;
        ulong aligned_size = (size + 0xFFF) & ~0xFFF;  // ページアラインメント

        // 全VMAと衝突しない候補を探す
        ulong retry = 0;
        while (retry < VMA_MAX) {
            ulong conflict = 0;
            ulong i = 0;
            while (i < VMA_MAX) {
                Vma* vma = Mmap::get_vma(i);
                if (vma->used != 0) {
                    // 候補が既存VMAと重なるか
                    if (candidate < vma->end && (candidate + aligned_size) > vma->start) {
                        candidate = (vma->end + 0xFFF) & ~0xFFF;
                        conflict = 1;
                    }
                }
                i = i + 1;
            }
            if (conflict == 0) { return candidate; }
            retry = retry + 1;
        }
        return 0;
    }

    /// mmap: 匿名メモリマッピング
    /// 戻り値: マッピング開始アドレス (失敗時 MAP_FAILED)
    static ulong do_mmap(ulong addr, ulong length, ulong prot, ulong flags) {
        if (length == 0) { return MAP_FAILED; }

        ulong aligned_len = (length + 0xFFF) & ~0xFFF;

        // アドレス決定
        ulong map_addr = addr;
        if (map_addr == 0) {
            map_addr = Mmap::find_free_region(aligned_len);
            if (map_addr == 0) { return MAP_FAILED; }
        } else {
            map_addr = map_addr & ~0xFFF;
        }

        // 空きスロット確保
        long slot = Mmap::find_free_slot();
        if (slot < 0) { return MAP_FAILED; }

        // VMA登録
        Vma* vma = Mmap::get_vma(slot as ulong);
        vma->start = map_addr;
        vma->end = map_addr + aligned_len;
        vma->flags = flags | prot;
        vma->used = 1;

        // 即時マッピング（Demand Pagingではなく即時確保）
        ulong* pmm_ptr = PMM_PTR_ADDR as ulong*;
        BuddyAllocator* pmm = (*pmm_ptr) as BuddyAllocator*;

        ulong cr3 = 0;
        __asm__(`movq %cr3, %rax; movq %rax, ${=r:cr3}`);
        PageTable pt(cr3);

        // 物理ページ割り当て
        // MAP_FIXED: 既存ページはスキップ（brk metadata保護）
        // 未マッピング: 新規ページ割当
        ulong offset = 0;
        while (offset < aligned_len) {
            ulong target_va = map_addr + offset;
            PhysAddr existing = pt.translate(target_va);
            if (existing == 0) {
                // 未マッピング → 新規ページ割当
                PhysAddr page = pmm->alloc_pages(0);
                if (page == 0) { return MAP_FAILED; }
                memzero(page as void*, PAGE_SIZE);
                pt.map_page(target_va, page, 7, pmm);
            }
            // 既存マッピング → スキップ（データ保護）
            offset = offset + PAGE_SIZE;
        }

        return map_addr;
    }

    /// munmap: メモリマッピング解除
    static Result<long, long> do_munmap(ulong addr, ulong length) {
        if (length == 0) { return Result::Err(EINVAL); }

        Vma* vma = 0 as Vma*;
        Option<ulong> vma_opt = Mmap::find_vma(addr);
        match (vma_opt) {
            Option::Some(v) => { vma = v as Vma*; }
            Option::None => { return Result::Err(EINVAL); }
        }

        // PMMを取得してページ解放
        ulong* pmm_ptr = PMM_PTR_ADDR as ulong*;
        BuddyAllocator* pmm = (*pmm_ptr) as BuddyAllocator*;

        ulong cr3 = 0;
        __asm__(`movq %cr3, %rax; movq %rax, ${=r:cr3}`);
        PageTable pt(cr3);

        ulong offset = 0;
        ulong total = vma->end - vma->start;
        while (offset < total) {
            ulong va = vma->start + offset;
            // 物理ページを取得して解放
            PhysAddr phys = pt.translate(va);
            if (phys != 0) {
                pmm->free_pages(phys, 0);
            }
            pt.unmap_page(va);
            offset = offset + PAGE_SIZE;
        }

        // VMAスロット解放
        vma->used = 0;
        return Result::Ok(0);
    }

    /// brk: ヒープ上限変更
    static ulong do_brk(ulong new_brk, Process* proc) {
        if (new_brk == 0) { return proc->brk_addr; }
        // new_brkが現在のbrk以下の場合は現在値を返す
        if (new_brk < proc->brk_addr) { return proc->brk_addr; }

        ulong old_brk = proc->brk_addr;
        ulong aligned_new = (new_brk + 0xFFF) & ~0xFFF;
        ulong aligned_old = (old_brk + 0xFFF) & ~0xFFF;

        if (aligned_new > aligned_old) {
            // ヒープ拡張: 新しいページをマッピング
            ulong* pmm_ptr = PMM_PTR_ADDR as ulong*;
            BuddyAllocator* pmm = (*pmm_ptr) as BuddyAllocator*;

            ulong cr3 = 0;
            __asm__(`movq %cr3, %rax; movq %rax, ${=r:cr3}`);
            PageTable pt(cr3);

            ulong page_addr = aligned_old;
            while (page_addr < aligned_new) {
                PhysAddr page = pmm->alloc_pages(0);
                if (page == 0) { return old_brk; }
                memzero(page as void*, PAGE_SIZE);
                // ユーザープロセス用: PRESENT | WRITE | USER = 7
                pt.map_page(page_addr, page, 7, pmm);
                page_addr = page_addr + PAGE_SIZE;
            }
        }

        proc->brk_addr = new_brk;
        return new_brk;
    }

    /// VMA数を取得
    static ulong count() {
        ulong cnt = 0;
        ulong i = 0;
        while (i < VMA_MAX) {
            Vma* vma = Mmap::get_vma(i);
            if (vma->used != 0) { cnt = cnt + 1; }
            i = i + 1;
        }
        return cnt;
    }

    /// ページクリーンアップヘルパー（汎用）
    /// identity-mapped(phys == virt)のページは解放せず、
    /// PMM割当ページ(phys != virt)のみ解放してunmapする
    static void cleanup_page(PageTable* pt, BuddyAllocator* pmm, ulong va) {
        PhysAddr phys = pt->translate(va);
        if (phys != 0) {
            ulong phys_base = phys & ~0xFFF;
            ulong va_base = va & ~0xFFF;
            // PMM割当ページのみ解放（identity-mapped sub-pagesは解放しない）
            if (phys_base != va_base) {
                pmm->free_pages(phys_base, 0);
            }
        }
        pt->unmap_page(va);
    }

    /// ユーザーマッピング専用クリーンアップヘルパー
    /// exec時に明示的にマッピングしたページ(TLS, スタック等)を解放
    /// split PT内のidentity-mapped sub-pagesには触れない
    static void cleanup_user_page(PageTable* pt, BuddyAllocator* pmm, ulong va) {
        // PD entryを確認 — huge pageの場合はスキップ（ユーザーページではない）
        ulong pml4_idx = pt->pml4_index(va);
        ulong pml4_entry = pt->read_entry(pt->pml4, pml4_idx);
        if (pt->entry_present(pml4_entry) == 0) { return; }

        PhysAddr pdpt = pt->entry_addr(pml4_entry);
        ulong pdpt_idx = pt->pdpt_index(va);
        ulong pdpt_entry = pt->read_entry(pdpt, pdpt_idx);
        if (pt->entry_present(pdpt_entry) == 0) { return; }

        PhysAddr pd = pt->entry_addr(pdpt_entry);
        ulong pd_idx = pt->pd_index(va);
        ulong pd_entry = pt->read_entry(pd, pd_idx);
        if (pt->entry_present(pd_entry) == 0) { return; }
        // huge pageの場合はユーザーマッピングではないのでスキップ
        if ((pd_entry & PTE_HUGE) != 0) { return; }

        // 4KB PT内のエントリを確認
        PhysAddr the_pt = pt->entry_addr(pd_entry);
        ulong pt_idx = pt->pt_index(va);
        ulong pte = pt->read_entry(the_pt, pt_idx);
        if (pt->entry_present(pte) == 0) { return; }

        PhysAddr phys = pt->entry_addr(pte);
        // PMM割当ページ(>= 0x3400000)のみ解放
        if (phys >= 0x3400000) {
            pmm->free_pages(phys, 0);
        }
        // 注意: PTエントリはここではゼロ化しない
        // free_pagesがidentity mappingを使って解放済みページに書き込むため、
        // 同じsplit PT上の他のエントリをゼロ化するとPFが発生する
        // → restore_huge_pagesが split PT全体を解放してhuge page復元時に一括クリーンアップ
    }

    /// ユーザー空間の全ページ解放（exec時のクリーンアップ）
    /// ELFセグメント(0x400000-data_end), brk領域, mmap VMA, ユーザースタックを解放
    static void cleanup_all() {
        // ページテーブル操作中はプリエンプション禁止
        __asm__(`cli`);
        ulong* pmm_ptr = PMM_PTR_ADDR as ulong*;
        BuddyAllocator* pmm = (*pmm_ptr) as BuddyAllocator*;

        ulong cr3 = 0;
        __asm__(`movq %cr3, %rax; movq %rax, ${=r:cr3}`);
        PageTable pt(cr3);

        // 1. ELFセグメント領域の解放 (0x400000 - 0x800000)
        ulong va = ELF_BASE_VADDR;
        while (va < 0x800000) {
            Mmap::cleanup_page(&pt, pmm, va);
            va = va + 0x1000;
        }

        // 2. brk(ヒープ)領域の解放 (0x800000 - 0xA00000)
        va = HEAP_BASE;
        while (va < 0xA00000) {
            Mmap::cleanup_page(&pt, pmm, va);
            va = va + 0x1000;
        }

        // 3. mmap VMA領域の解放
        ulong i = 0;
        while (i < VMA_MAX) {
            Vma* vma = Mmap::get_vma(i);
            if (vma->used != 0) {
                ulong mva = vma->start;
                while (mva < vma->end) {
                    Mmap::cleanup_page(&pt, pmm, mva);
                    mva = mva + 0x1000;
                }
                vma->used = 0;
            }
            i = i + 1;
        }

        // 4. TLS (0x7FFC0000, 1ページ) + ユーザースタック (0x7FFD0000, 8ページ)
        // split PTのidentity-mapped sub-pagesは解放しない
        Mmap::cleanup_user_page(&pt, pmm, 0x7FFC0000);
        ulong si = 0;
        while (si < 8) {
            Mmap::cleanup_user_page(&pt, pmm, 0x7FFD0000 + si * 0x1000);
            si = si + 1;
        }

        // 5. split済み2MB huge pageを復元
        Mmap::restore_huge_pages(&pt, 0x400000, 0xA00000, pmm);
        Mmap::restore_huge_pages(&pt, 0x7FA00000, 0x80000000, pmm);

        // 6. TLBフルフラッシュ + 割込み復元
        __asm__(`movq %cr3, %rax; movq %rax, %cr3`);
        __asm__(`sti`);
    }

    /// split済み2MB huge pageを復元するヘルパー
    /// 指定範囲のPDエントリを確認し、4KB PTに分割されていた場合は
    /// PTを解放して元の2MB huge page(identity map: phys=virt)に戻す
    static void restore_huge_pages(PageTable* pt, ulong range_start, ulong range_end, BuddyAllocator* pmm) {
        // 2MBアラインメント
        ulong va = range_start & ~0x1FFFFF;
        while (va < range_end) {
            // PD entryを直接確認
            ulong pml4_idx = pt->pml4_index(va);
            ulong pml4_entry = pt->read_entry(pt->pml4, pml4_idx);
            if (pt->entry_present(pml4_entry) != 0) {
                PhysAddr pdpt = pt->entry_addr(pml4_entry);
                ulong pdpt_idx = pt->pdpt_index(va);
                ulong pdpt_entry = pt->read_entry(pdpt, pdpt_idx);
                if (pt->entry_present(pdpt_entry) != 0) {
                    PhysAddr pd = pt->entry_addr(pdpt_entry);
                    ulong pd_idx = pt->pd_index(va);
                    ulong pd_entry = pt->read_entry(pd, pd_idx);

                    // PD entryがpresentかつnon-huge(= 分割済み4KB PT)の場合
                    if (pt->entry_present(pd_entry) != 0 && (pd_entry & PTE_HUGE) == 0) {
                        // 分割されたPTのアドレス
                        PhysAddr split_pt = pt->entry_addr(pd_entry);

                        // PTをPMMに返却
                        pmm->free_pages(split_pt, 0);

                        // 元の2MB huge page PDエントリを復元
                        // identity mapping: phys == virt (2MBアラインメント)
                        PhysAddr huge_phys = va & ~0x1FFFFF;
                        // Present + Write + User + HugePage = 0x87
                        pt->write_entry(pd, pd_idx, huge_phys | 0x87);
                    }
                }
            }
            va = va + 0x200000;  // 次の2MBページ
        }

        // TLBフラッシュ: 4KB→2MB huge page復元後のstale TLBエントリを無効化
        // Linux: flush_tlb_mm() に相当
        __asm__(`movq %cr3, %rax; movq %rax, %cr3`);
    }
}
