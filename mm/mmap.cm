//! platform: baremetal-x86
// cosmo-linux::mm::mmap - 仮想メモリ領域管理 (VMA)
//
// Mmap struct/impl — mmap/munmap/brk の実装。
// VMA テーブルで仮想アドレス範囲を管理し、
// Demand Paging と連携して物理ページを遅延割当する。
//
// 参照: linux/mm/mmap.c

import ../include/types;
import ../include/config;
import ../include/page_alloc;
import ../include/errno;
import ../include/result;
import ../include/scheduler;
import ../mm/vmm;
import ../mm/pmm;
import ../lib/kstring;

// ============================================================
// VMA定数
// ============================================================

/// 匿名マッピング (ファイルなし)
export const ulong MAP_ANONYMOUS = 0x20;

/// プライベートマッピング
export const ulong MAP_PRIVATE   = 0x02;

/// 固定アドレスマッピング
export const ulong MAP_FIXED     = 0x10;

/// マッピング失敗
export const ulong MAP_FAILED    = 0xFFFFFFFFFFFFFFFF;

/// 保護フラグ
export const ulong PROT_NONE  = 0;
export const ulong PROT_READ  = 1;
export const ulong PROT_WRITE = 2;
export const ulong PROT_EXEC  = 4;

/// VMAテーブル最大エントリ数
const ulong VMA_MAX = 32;

/// VMAテーブル固定メモリアドレス (各エントリ32バイト: start/end/flags/used)
const PhysAddr VMA_TABLE_ADDR = 0x9A000;

/// mmapの開始仮想アドレス (ユーザー空間上位)
const VirtAddr MMAP_BASE = 0x40000000;  // 1GB超: identity map外 (2MB splitting対応済みだが安全策)

/// ヒープ開始アドレス
export const VirtAddr HEAP_BASE = 0x800000;

/// PMMポインタアドレス
const PhysAddr PMM_PTR_ADDR = 0x95010;

/// ページテーブルポインタアドレス
const PhysAddr VMM_PTR_ADDR = 0x91020;

// ============================================================
// VMA構造体 (メモリ上レイアウト: 32バイト)
// ============================================================

/// 仮想メモリ領域
export struct Vma {
    ulong start;  // 開始仮想アドレス
    ulong end;    // 終了仮想アドレス（排他）
    ulong flags;  // MAP_ANONYMOUS | PROT_*
    ulong used;   // 1=使用中, 0=空き
}

// ============================================================
// Mmap struct/impl
// ============================================================

/// Mmap — 仮想メモリ領域管理
export struct Mmap {}

impl Mmap {
    /// VMAテーブル初期化
    static void setup() {
        memzero(VMA_TABLE_ADDR as void*, VMA_MAX * 32);
    }

    /// VMAエントリを取得
    static Vma* get_vma(ulong index) {
        ulong addr = VMA_TABLE_ADDR + index * 32;
        return addr as Vma*;
    }

    /// 空きVMAスロットを検索
    static long find_free_slot() {
        ulong i = 0;
        while (i < VMA_MAX) {
            Vma* vma = Mmap::get_vma(i);
            if (vma->used == 0) { return i as long; }
            i = i + 1;
        }
        return 0 - ENOMEM;
    }

    /// 仮想アドレスが属するVMAを検索
    static Option<ulong> find_vma(ulong addr) {
        ulong i = 0;
        while (i < VMA_MAX) {
            Vma* vma = Mmap::get_vma(i);
            if (vma->used != 0) {
                if (addr >= vma->start && addr < vma->end) {
                    return Option::Some(vma as ulong);
                }
            }
            i = i + 1;
        }
        return Option::None;
    }

    /// 使用されていない仮想アドレス範囲を検索
    static ulong find_free_region(ulong size) {
        ulong candidate = MMAP_BASE;
        ulong aligned_size = (size + 0xFFF) & ~0xFFF;  // ページアラインメント

        // 全VMAと衝突しない候補を探す
        ulong retry = 0;
        while (retry < VMA_MAX) {
            ulong conflict = 0;
            ulong i = 0;
            while (i < VMA_MAX) {
                Vma* vma = Mmap::get_vma(i);
                if (vma->used != 0) {
                    // 候補が既存VMAと重なるか
                    if (candidate < vma->end && (candidate + aligned_size) > vma->start) {
                        candidate = (vma->end + 0xFFF) & ~0xFFF;
                        conflict = 1;
                    }
                }
                i = i + 1;
            }
            if (conflict == 0) { return candidate; }
            retry = retry + 1;
        }
        return 0;
    }

    /// mmap: 匿名メモリマッピング
    /// 戻り値: マッピング開始アドレス (失敗時 MAP_FAILED)
    static ulong do_mmap(ulong addr, ulong length, ulong prot, ulong flags) {
        if (length == 0) { return MAP_FAILED; }

        ulong aligned_len = (length + 0xFFF) & ~0xFFF;

        // アドレス決定
        ulong map_addr = addr;
        if (map_addr == 0) {
            map_addr = Mmap::find_free_region(aligned_len);
            if (map_addr == 0) { return MAP_FAILED; }
        } else {
            map_addr = map_addr & ~0xFFF;
        }

        // 空きスロット確保
        long slot = Mmap::find_free_slot();
        if (slot < 0) { return MAP_FAILED; }

        // VMA登録
        Vma* vma = Mmap::get_vma(slot as ulong);
        vma->start = map_addr;
        vma->end = map_addr + aligned_len;
        vma->flags = flags | prot;
        vma->used = 1;

        // 即時マッピング（Demand Pagingではなく即時確保）
        ulong* pmm_ptr = PMM_PTR_ADDR as ulong*;
        BuddyAllocator* pmm = (*pmm_ptr) as BuddyAllocator*;

        ulong cr3 = 0;
        __asm__(`movq %cr3, %rax; movq %rax, ${=r:cr3}`);
        PageTable pt(cr3);

        // 物理ページ割り当て
        // MAP_FIXED: 既存ページはスキップ（brk metadata保護）
        // 未マッピング: 新規ページ割当
        ulong offset = 0;
        while (offset < aligned_len) {
            ulong target_va = map_addr + offset;
            PhysAddr existing = pt.translate(target_va);
            if (existing == 0) {
                // 未マッピング → 新規ページ割当
                PhysAddr page = pmm->alloc_pages(0);
                if (page == 0) { return MAP_FAILED; }
                memzero(page as void*, PAGE_SIZE);
                pt.map_page(target_va, page, 7, pmm);
            }
            // 既存マッピング → スキップ（データ保護）
            offset = offset + PAGE_SIZE;
        }

        return map_addr;
    }

    /// munmap: メモリマッピング解除
    static Result<long, long> do_munmap(ulong addr, ulong length) {
        if (length == 0) { return Result::Err(EINVAL); }

        Vma* vma = 0 as Vma*;
        Option<ulong> vma_opt = Mmap::find_vma(addr);
        match (vma_opt) {
            Option::Some(v) => { vma = v as Vma*; }
            Option::None => { return Result::Err(EINVAL); }
        }

        // PMMを取得してページ解放
        ulong* pmm_ptr = PMM_PTR_ADDR as ulong*;
        BuddyAllocator* pmm = (*pmm_ptr) as BuddyAllocator*;

        ulong cr3 = 0;
        __asm__(`movq %cr3, %rax; movq %rax, ${=r:cr3}`);
        PageTable pt(cr3);

        ulong offset = 0;
        ulong total = vma->end - vma->start;
        while (offset < total) {
            ulong va = vma->start + offset;
            // 物理ページを取得して解放
            PhysAddr phys = pt.translate(va);
            if (phys != 0) {
                pmm->free_pages(phys, 0);
            }
            pt.unmap_page(va);
            offset = offset + PAGE_SIZE;
        }

        // VMAスロット解放
        vma->used = 0;
        return Result::Ok(0);
    }

    /// brk: ヒープ上限変更
    static ulong do_brk(ulong new_brk, Process* proc) {
        if (new_brk == 0) { return proc->brk_addr; }
        // new_brkが現在のbrk以下の場合は現在値を返す
        if (new_brk < proc->brk_addr) { return proc->brk_addr; }

        ulong old_brk = proc->brk_addr;
        ulong aligned_new = (new_brk + 0xFFF) & ~0xFFF;
        ulong aligned_old = (old_brk + 0xFFF) & ~0xFFF;

        if (aligned_new > aligned_old) {
            // ヒープ拡張: 新しいページをマッピング
            ulong* pmm_ptr = PMM_PTR_ADDR as ulong*;
            BuddyAllocator* pmm = (*pmm_ptr) as BuddyAllocator*;

            ulong cr3 = 0;
            __asm__(`movq %cr3, %rax; movq %rax, ${=r:cr3}`);
            PageTable pt(cr3);

            ulong page_addr = aligned_old;
            while (page_addr < aligned_new) {
                PhysAddr page = pmm->alloc_pages(0);
                if (page == 0) { return old_brk; }
                memzero(page as void*, PAGE_SIZE);
                // ユーザープロセス用: PRESENT | WRITE | USER = 7
                pt.map_page(page_addr, page, 7, pmm);
                page_addr = page_addr + PAGE_SIZE;
            }
        }

        proc->brk_addr = new_brk;
        return new_brk;
    }

    /// VMA数を取得
    static ulong count() {
        ulong cnt = 0;
        ulong i = 0;
        while (i < VMA_MAX) {
            Vma* vma = Mmap::get_vma(i);
            if (vma->used != 0) { cnt = cnt + 1; }
            i = i + 1;
        }
        return cnt;
    }

    /// ユーザー空間の全ページ解放（exec時のクリーンアップ）
    /// ELFセグメント(0x400000-data_end), brk領域, mmap VMA, ユーザースタックを解放
    static void cleanup_all() {
        ulong* pmm_ptr = PMM_PTR_ADDR as ulong*;
        BuddyAllocator* pmm = (*pmm_ptr) as BuddyAllocator*;

        ulong cr3 = 0;
        __asm__(`movq %cr3, %rax; movq %rax, ${=r:cr3}`);
        PageTable pt(cr3);

        // 1. ELFセグメント領域の解放 (0x400000 - 0x800000)
        //    最大バイナリのセグメント範囲をカバー(git=0x7F5000等)
        ulong va = 0x400000;
        while (va < 0x800000) {
            PhysAddr phys = pt.translate(va);
            if (phys != 0) {
                // identity map範囲(0-1GiB)のページは解放しない
                if (phys >= 0x10000000) {
                    pmm->free_pages(phys & ~0xFFF, 0);
                }
            }
            pt.unmap_page(va);
            va = va + 0x1000;
        }

        // 2. brk(ヒープ)領域の解放 (0x800000 - 0xA00000)
        va = HEAP_BASE;
        while (va < 0xA00000) {
            PhysAddr phys = pt.translate(va);
            if (phys != 0) {
                if (phys >= 0x10000000) {
                    pmm->free_pages(phys & ~0xFFF, 0);
                }
            }
            pt.unmap_page(va);
            va = va + 0x1000;
        }

        // 3. mmap VMA領域の解放
        ulong i = 0;
        while (i < VMA_MAX) {
            Vma* vma = Mmap::get_vma(i);
            if (vma->used != 0) {
                ulong mva = vma->start;
                while (mva < vma->end) {
                    PhysAddr phys = pt.translate(mva);
                    if (phys != 0) {
                        if (phys >= 0x10000000) {
                            pmm->free_pages(phys & ~0xFFF, 0);
                        }
                    }
                    pt.unmap_page(mva);
                    mva = mva + 0x1000;
                }
                vma->used = 0;
            }
            i = i + 1;
        }

        // 4. ユーザースタック領域の解放 (0x7FFB0000 - 0x80000000)
        va = 0x7FFB0000;
        while (va < 0x80000000) {
            PhysAddr phys = pt.translate(va);
            if (phys != 0) {
                if (phys >= 0x10000000) {
                    pmm->free_pages(phys & ~0xFFF, 0);
                }
            }
            pt.unmap_page(va);
            va = va + 0x1000;
        }

        // 5. TLBフルフラッシュ
        __asm__(`movq %cr3, %rax; movq %rax, %cr3`);
    }
}
